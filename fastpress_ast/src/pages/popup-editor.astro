      function updateSelectedElementUI(comp) {
        const tagEl = document.getElementById('selectedElementTag');
        const classEl = document.getElementById('selectedElementClasses');
        const traitsBadge = document.getElementById('traitsSelectedBadge');
        const btnParent = document.getElementById('btnSelectParent');
        const btnDup = document.getElementById('btnDuplicateEl');
        const btnTraits = document.getElementById('btnEditTraits');
        const btnDel = document.getElementById('btnDeleteEl');

        if (!comp || comp.is('wrapper')) {
          if (tagEl) tagEl.textContent = 'Select an element to style';
          if (classEl) classEl.textContent = 'Canvas';
          if (traitsBadge) traitsBadge.textContent = 'None';
          if (btnParent) btnParent.disabled = true;
          if (btnDup) btnDup.disabled = true;
          if (btnTraits) btnTraits.disabled = true;
          if (btnDel) btnDel.disabled = true;
          const btnCustomCode = document.getElementById('btnEditCustomCode');
          if (btnCustomCode) { btnCustomCode.style.display = 'none'; btnCustomCode.disabled = true; }
