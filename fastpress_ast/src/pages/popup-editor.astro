---
import WorkspaceSwitcher from '../components/admin/WorkspaceSwitcher.astro';
import Layout from '../layouts/Layout.astro';
import { getActiveThemeName, getThemePages } from '../core/theme';
import fs from 'node:fs/promises';
import path from 'node:path';

export const prerender = false;

const activeTheme = getActiveThemeName();

// Load data server-side
const POPUPS_FILE = path.join(process.cwd(), 'src', 'data', 'popups.json');
const POSTS_FILE = path.join(process.cwd(), 'src', 'data', 'posts.json');
const CATEGORIES_FILE = path.join(process.cwd(), 'src', 'data', 'categories.json');

async function readJsonSafe(filePath: string, fallback: any) {
  try {
    const raw = await fs.readFile(filePath, 'utf-8');
    return JSON.parse(raw);
  } catch {
    return fallback;
  }
}

const initialPopups = await readJsonSafe(POPUPS_FILE, []);
const rawPages = getThemePages(activeTheme);
const initialPosts = await readJsonSafe(POSTS_FILE, []);
const initialCategories = await readJsonSafe(CATEGORIES_FILE, []);

const pagesList = Object.entries(rawPages).map(([slug, p]: [string, any]) => ({
  slug,
  title: p.title || (slug === 'home' ? 'Homepage (Root /)' : slug),
  url: slug === 'home' ? '/' : `/${slug}`
}));
if (!pagesList.some(p => p.slug === 'home')) {
  pagesList.unshift({ slug: 'home', title: 'Homepage (Root /)', url: '/' });
}

const postsList = initialPosts.map((post: any) => ({
  slug: post.slug,
  title: post.title || post.slug,
  category: post.category || '',
  categories: post.categories || [post.category].filter(Boolean)
}));

const categoriesList = initialCategories.map((cat: any) => ({
  id: cat.id || cat.slug,
  slug: cat.slug || cat.id,
  name: cat.name || cat.slug
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Popup Builder (Block-Based) - BUGMEGA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/src/styles/global.css" />

    <!-- GrapesJS Core CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/grapesjs@0.23.9/dist/css/grapes.min.css" />
    <link rel="stylesheet" href="/editor-container-layout.css" />
    <script is:inline src="https://unpkg.com/grapesjs@0.23.9/dist/grapes.min.js"></script>
    <script is:inline src="/editor-container-layout.js"></script>
    <script is:inline src="/editor-file-manager.js"></script>
    <script is:inline src="/editor-custom-code.js"></script>

    <style is:global>
      :root {
        --builder-bg: #0b0e14;
        --toolbar-bg: #11141c;
        --border-color: #242b38;
        --accent-color: #ff5e3a;
        --accent-hover: #ff7555;
        --text-primary: #f3f4f6;
        --text-muted: #9ca3af;
        --card-bg: #161b24;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
        background: var(--builder-bg);
        color: var(--text-primary);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        display: flex;
        flex-direction: column;
      }

      /* TOP NAVBAR */
      .builder-navbar {
        height: 52px;
        background: var(--toolbar-bg);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 14px;
        z-index: 100;
        flex-shrink: 0;
      }

      .navbar-left, .navbar-center, .navbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .brand-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.05em;
        color: #ffffff;
        text-decoration: none;
        margin-right: 4px;
      }

      /* BUILDER MODE SWITCHER DROPDOWN */
      .builder-switcher-wrap { position: relative; }
      .builder-switcher-btn {
        background: #1c212b;
        border: 1px solid #2d3342;
        color: #f3f4f6;
        padding: 5px 11px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .builder-switcher-btn:hover { background: #252b38; border-color: #3b4354; }

      .builder-switcher-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        width: 260px;
        max-height: calc(100vh - 70px);
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: #374151 #141822;
        background: #141822;
        border: 1px solid #2a3242;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        padding: 6px;
        display: none;
        z-index: 1000;
      }
      .builder-switcher-menu::-webkit-scrollbar {
        width: 6px;
      }
      .builder-switcher-menu::-webkit-scrollbar-thumb {
        background: #2f3849;
        border-radius: 4px;
      }
      .builder-switcher-menu.show { display: block; }
      .switcher-menu-header {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
        padding: 6px 10px 4px 10px;
      }
      .switcher-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 6px;
        text-decoration: none;
        color: #d1d5db;
        transition: background 0.15s;
      }
      .switcher-item:hover { background: #1e2430; color: #ffffff; }
      .switcher-item.active { background: rgba(255, 94, 58, 0.12); color: #ff5e3a; font-weight: 600; }
      .switcher-item-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1c212b;
      }
      .switcher-item-title { font-size: 0.8rem; font-weight: 600; }
      .switcher-item-desc { font-size: 0.68rem; color: #9ca3af; }

      /* POPUP SELECTOR DROPDOWN */
      .popup-selector-wrap { position: relative; }
      .popup-selector-btn {
        background: #161b24;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
      }
      .popup-selector-btn:hover { border-color: #3f4758; }
      .popup-selector-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        width: 320px;
        background: #141822;
        border: 1px solid #2a3242;
        border-radius: 8px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.6);
        padding: 6px;
        display: none;
        z-index: 1000;
        max-height: 400px;
        overflow-y: auto;
      }
      .popup-selector-menu.show { display: block; }
      .popup-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 7px 10px;
        border-radius: 6px;
        cursor: pointer;
        color: #d1d5db;
        transition: background 0.15s;
      }
      .popup-item-row:hover { background: #1e2430; }
      .popup-item-row.active { background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); }
      .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
      .status-dot.published { background: #10b981; box-shadow: 0 0 6px rgba(16,185,129,0.5); }
      .status-dot.draft { background: #6b7280; }

      .btn-add-popup {
        width: 100%;
        margin-top: 6px;
        background: #1e2430;
        border: 1px dashed #374151;
        color: #e5e7eb;
        padding: 7px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .btn-add-popup:hover { background: #28303f; border-color: #6366f1; color: #ffffff; }

      /* BUTTONS */
      .btn-nav-action {
        background: #161b24;
        border: 1px solid var(--border-color);
        color: #d1d5db;
        padding: 5px 11px;
        border-radius: 6px;
        font-size: 0.76rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-nav-action:hover { background: #202735; border-color: #3b4557; color: #ffffff; }
      .btn-nav-action.primary { background: var(--accent-color); border-color: var(--accent-color); color: #ffffff; }
      .btn-nav-action.primary:hover { background: var(--accent-hover); }

      .device-switch-wrap {
        display: flex;
        background: #0f1218;
        border: 1px solid #242b38;
        border-radius: 6px;
        padding: 2px;
      }
      .device-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        padding: 4px 9px;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        font-weight: 600;
      }
      .device-btn.active { background: #1f2634; color: #ffffff; }

      /* WORKSPACE BODY */
      .builder-workspace {
        flex: 1;
        display: flex;
        overflow: hidden;
        position: relative;
      }

      /* RESET GRAPESJS DEFAULT CANVAS OFFSETS (REMOVES 40px TOP GAP AND OFF-CENTER VOID) */
      :root,
      .builder-workspace,
      #gjs-canvas {
        --gjs-left-width: 0px !important;
        --gjs-canvas-top: 0px !important;
      }

      /* CANVAS PREVIEW AREA (GRAPESJS CANVAS WRAPPER) */
      .canvas-stage {
        flex: 1;
        background: #080a0f;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      /* SIMULATED WEBSITE BACKDROP UNDER CANVAS */
      .website-sim-backdrop {
        position: absolute;
        inset: 0;
        background: #090c12;
        display: flex;
        flex-direction: column;
        pointer-events: none;
        user-select: none;
        z-index: 1;
        overflow: hidden;
        transition: opacity 0.25s ease;
      }

      .sim-navbar {
        height: 52px;
        background: #0f131a;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        box-sizing: border-box;
      }

      .sim-hero {
        padding: 48px 32px 32px 32px;
        text-align: center;
        background: radial-gradient(circle at 50% 30%, rgba(255, 94, 58, 0.09), transparent 70%);
      }

      .sim-dim-overlay {
        position: absolute;
        inset: 0;
        background: rgba(7, 9, 14, 0.72);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        z-index: 2;
        transition: opacity 0.25s ease;
      }

      .stage-info-pill {
        position: absolute;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(17, 20, 28, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(10px);
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.72rem;
        color: #d1d5db;
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 10;
        box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        pointer-events: none;
        white-space: nowrap;
        transition: top 0.2s ease, bottom 0.2s ease;
      }
      .stage-info-pill.pill-bottom {
        top: auto;
        bottom: 14px;
      }

      .pulse-indicator {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
        animation: pulseDot 2s infinite;
      }

      @keyframes pulseDot {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
      }

      #gjs-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 5;
      }

      /* GRAPESJS CUSTOM CANVAS STYLES - COMPACT POPUP MODAL PRESENTATION */
      .gjs-cv-canvas {
        box-sizing: border-box !important;
        width: 100% !important;
        height: 100% !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        position: absolute !important;
        background: transparent !important;
      }

      /* When studio grid mode is active */
      .canvas-stage.studio-grid-mode .website-sim-backdrop {
        opacity: 0;
      }
      .canvas-stage.studio-grid-mode {
        background-color: #080a0f !important;
        background-image: 
          radial-gradient(#1c2230 1px, transparent 1px),
          radial-gradient(#1c2230 1px, #080a0f 1px) !important;
        background-size: 24px 24px !important;
      }

      /* FRAME CONTAINER - FORCE PERFECT CENTER ALIGNMENT */
      .gjs-cv-canvas__frames {
        width: 100% !important;
        height: 100% !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        position: absolute !important;
      }

      .gjs-frames {
        width: 100% !important;
        height: 100% !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        position: absolute !important;
      }

      /* Exact Popup Modal Box Frame - Supports Center, Sticky Top/Bottom, Full Screen, Custom Height & Margins */
      .gjs-frame-wrapper {
        position: absolute !important;
        top: 50px !important;
        bottom: 30px !important;
        left: 0 !important;
        right: 0 !important;
        margin: auto !important;
        border-radius: var(--fp-popup-radius, 16px) !important;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 255, 255, 0.12) !important;
        overflow: hidden !important;
        max-height: calc(100vh - 190px) !important;
        transition: width 0.25s ease, height 0.25s ease, top 0.25s ease, bottom 0.25s ease, left 0.25s ease, right 0.25s ease, max-width 0.25s ease, border-radius 0.2s ease !important;
        background: #11141c;
      }

      .gjs-frame {
        border-radius: var(--fp-popup-radius, 16px) !important;
        background: #11141c !important;
        height: 100% !important;
        border: none !important;
        box-shadow: none !important;
      }

      /* RIGHT SIDEBAR INSPECTOR */
      .builder-sidebar {
        width: 350px;
        background: var(--card-bg);
        border-left: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        flex-shrink: 0;
      }

      .sidebar-tabs {
        display: flex;
        border-bottom: 1px solid var(--border-color);
        background: #11141c;
      }
      .sidebar-tab-btn {
        flex: 1;
        background: transparent;
        border: none;
        color: #9ca3af;
        padding: 12px 4px;
        font-size: 0.74rem;
        font-weight: 700;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all 0.15s;
        text-align: center;
      }
      .sidebar-tab-btn:hover { color: #ffffff; }
      .sidebar-tab-btn.active {
        color: var(--accent-color);
        border-bottom-color: var(--accent-color);
        background: rgba(255, 94, 58, 0.04);
      }

      .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
      }
      .sidebar-tab-pane { display: none; }
      .sidebar-tab-pane.active { display: block; }

      /* GrapesJS Block Manager Overrides */
      #blocks-container,
      .gjs-blocks-cs,
      .gjs-block-categories {
        display: flex !important;
        flex-direction: column !important;
        width: 100% !important;
        background: transparent !important;
        gap: 10px !important;
      }
      .gjs-blocks-no-cat {
        display: none !important;
      }
      .gjs-block-category {
        width: 100% !important;
        background: transparent !important;
        border: none !important;
      }
      .gjs-block-category .gjs-title {
        background: #161b24 !important;
        color: #e5e7eb !important;
        font-family: 'Montserrat', sans-serif !important;
        font-size: 0.76rem !important;
        font-weight: 700 !important;
        border: 1px solid #283142 !important;
        border-radius: 6px !important;
        padding: 9px 12px !important;
        letter-spacing: 0.03em !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        user-select: none !important;
        transition: all 0.15s ease !important;
      }
      .gjs-block-category .gjs-title:hover {
        background: #1e2430 !important;
        border-color: #ff5e3a !important;
        color: #ffffff !important;
      }
      .gjs-block-category.gjs-open .gjs-title {
        border-bottom-left-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
        border-bottom-color: #242936 !important;
      }
      .gjs-block-category .gjs-caret-icon {
        margin-right: 8px !important;
        font-size: 0.75rem !important;
        display: inline-block !important;
        transition: transform 0.2s ease !important;
      }
      .gjs-block-category:not(.gjs-open) .gjs-caret-icon {
        transform: rotate(-90deg) !important;
      }
      .gjs-block-category .gjs-blocks-c {
        background-color: #11141c !important;
        border: 1px solid #283142 !important;
        border-top: none !important;
        border-bottom-left-radius: 6px !important;
        border-bottom-right-radius: 6px !important;
        padding: 10px 8px !important;
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 8px !important;
        box-sizing: border-box !important;
        width: 100% !important;
      }
      .gjs-block-category:not(.gjs-open) .gjs-blocks-c,
      .gjs-blocks-c[style*="display: none"] {
        display: none !important;
      }
      .gjs-block {
        background: #161b24 !important;
        border: 1px solid #283142 !important;
        color: #d1d5db !important;
        border-radius: 8px !important;
        width: 100% !important;
        min-height: 80px !important;
        padding: 12px 6px !important;
        margin: 0 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        cursor: grab !important;
        transition: all 0.15s ease !important;
        box-shadow: none !important;
        box-sizing: border-box !important;
        gap: 6px !important;
      }
      .gjs-block.gjs-block-basic {
        width: 100% !important;
        min-height: 82px !important;
        box-sizing: border-box !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        padding: 12px 6px !important;
        background-color: #161b24 !important;
        border: 1px solid #283142 !important;
        border-radius: 8px !important;
        gap: 6px !important;
        cursor: grab !important;
      }
      .gjs-block:hover,
      .gjs-block.gjs-block-basic:hover {
        background: #1e2430 !important;
        border-color: #ff5e3a !important;
        color: #ffffff !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 4px 14px rgba(255, 94, 58, 0.2) !important;
      }
      .gjs-block__media {
        width: 32px !important;
        height: 32px !important;
        min-width: 32px !important;
        background-color: transparent !important;
        border: none !important;
        color: #d1d5db !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        pointer-events: none !important;
      }
      .gjs-block__media svg {
        width: 22px !important;
        height: 22px !important;
        stroke: currentColor !important;
      }
      .gjs-block:hover .gjs-block__media {
        color: #ff7e5f !important;
      }
      .gjs-block-label {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-size: 0.74rem !important;
        font-weight: 600 !important;
        color: #d1d5db !important;
        text-align: center !important;
        line-height: 1.2 !important;
        margin: 0 !important;
        flex: none !important;
        white-space: normal !important;
        pointer-events: none !important;
      }
      .gjs-block:hover .gjs-block-label {
        color: #ffffff !important;
      }

      /* Style Manager Overrides */
      .gjs-sm-sectors { width: 100% !important; }
      .gjs-sm-sector { width: 100% !important; margin-bottom: 8px !important; }
      .gjs-sm-sector .gjs-sm-sector-title {
        background: #161b24 !important;
        border: 1px solid #283142 !important;
        border-radius: 6px !important;
        color: #e5e7eb !important;
        font-size: 0.74rem !important;
        font-weight: 700 !important;
        padding: 9px 12px !important;
      }
      .gjs-sm-sector.gjs-sm-open .gjs-sm-sector-title {
        border-bottom-left-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
      }
      .gjs-sm-properties {
        background: #0d1017 !important;
        border: 1px solid #283142 !important;
        border-top: none !important;
        border-bottom-left-radius: 6px !important;
        border-bottom-right-radius: 6px !important;
        padding: 10px !important;
        box-sizing: border-box !important;
      }

      /* Style Manager Input Fields & Labels */
      .gjs-field {
        background-color: #0f1217 !important;
        border: 1px solid #283142 !important;
        border-radius: 4px !important;
        color: #f3f4f6 !important;
      }
      .gjs-field:focus-within {
        border-color: #ff5e3a !important;
      }
      .gjs-sm-label {
        font-size: 0.72rem !important;
        color: #9ca3af !important;
        font-weight: 600 !important;
      }

      /* Native Color Picker & Quick Swatches */
      .gjs-field-color {
        position: relative !important;
      }
      .gjs-field-colorp {
        cursor: pointer !important;
        position: absolute !important;
        right: 0 !important;
        top: 0 !important;
        height: 100% !important;
        width: 32px !important;
        border-left: 1px solid #283142 !important;
        padding: 3px !important;
        border-radius: 0 4px 4px 0 !important;
        box-sizing: border-box !important;
        background: #141820 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: all 0.15s ease !important;
      }
      .gjs-field-colorp:hover {
        border-left-color: #ff5e3a !important;
        background: #1c222d !important;
      }
      .gjs-field-colorp .gjs-field-color-picker {
        border-radius: 3px !important;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18), inset 0 0 2px rgba(0, 0, 0, 0.5) !important;
        width: 100% !important;
        height: 100% !important;
      }
      .gjs-native-color-picker {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        opacity: 0 !important;
        cursor: pointer !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        z-index: 25 !important;
      }
      .gjs-quick-swatches {
        display: flex !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 5px !important;
        margin-top: 5px !important;
        padding: 5px 6px !important;
        background: #0d1015 !important;
        border: 1px solid #212632 !important;
        border-radius: 6px !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      .gjs-swatch-btn {
        width: 14px !important;
        height: 14px !important;
        min-width: 14px !important;
        border-radius: 50% !important;
        border: 1.5px solid rgba(255, 255, 255, 0.22) !important;
        padding: 0 !important;
        cursor: pointer !important;
        transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease !important;
        position: relative !important;
        outline: none !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
      }
      .gjs-swatch-btn:hover {
        transform: scale(1.22) !important;
        border-color: #ffffff !important;
        box-shadow: 0 0 6px rgba(255, 255, 255, 0.5) !important;
        z-index: 2 !important;
      }
      .gjs-swatch-btn.transparent-swatch {
        background: #1f2937 !important;
        font-size: 8px !important;
        color: #9ca3af !important;
        line-height: 1 !important;
      }
      .gjs-swatch-eyedropper {
        margin-left: auto !important;
        background: transparent !important;
        border: none !important;
        color: #9ca3af !important;
        cursor: pointer !important;
        padding: 2px 4px !important;
        display: flex !important;
        align-items: center !important;
        border-radius: 3px !important;
      }
      .gjs-swatch-eyedropper:hover {
        color: #ff5e3a !important;
        background: rgba(255, 94, 58, 0.15) !important;
      }

      /* Selected Element Banner in Style Tab */
      .selected-element-banner {
        background: #151922;
        border: 1px solid #262e3d;
        border-radius: 8px;
        padding: 10px 12px;
        margin-bottom: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .element-info-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }
      .element-pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 94, 58, 0.12);
        border: 1px solid rgba(255, 94, 58, 0.3);
        color: #ff7e5f;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        max-width: 170px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .pill-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #ff5e3a;
        box-shadow: 0 0 6px #ff5e3a;
        flex-shrink: 0;
      }
      .element-class-badge {
        font-size: 0.68rem;
        color: #9ca3af;
        font-family: monospace;
        background: #0f1218;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #242c3a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 110px;
      }
      .element-action-btns {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 5px;
      }
      .btn-element-action {
        background: #0f131a;
        border: 1px solid #283142;
        color: #d1d5db;
        border-radius: 5px;
        padding: 5px 4px;
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        transition: all 0.15s ease;
      }
      .btn-element-action:hover:not(:disabled) {
        background: #1c2331;
        border-color: #3b475e;
        color: #ffffff;
      }
      .btn-element-action:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .btn-element-action.danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.2);
        border-color: #ef4444;
        color: #fca5a5;
      }

      /* Layer Actions Toolbar & Context Menu */
      .layer-active-badge {
        font-size: 0.65rem;
        font-weight: 700;
        color: #ff5e3a;
        background: rgba(255, 94, 58, 0.12);
        border: 1px solid rgba(255, 94, 58, 0.3);
        border-radius: 4px;
        padding: 2px 7px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        max-width: 130px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .layer-actions-toolbar {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 5px;
        background: #11141c;
        border: 1px solid #232936;
        border-radius: 8px;
        padding: 5px;
        margin-bottom: 10px;
      }

      .btn-layer-tool {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        padding: 6px 3px;
        background: #181d28;
        border: 1px solid #2b3344;
        border-radius: 6px;
        color: #9ca3af;
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
      }

      .btn-layer-tool:hover:not(:disabled) {
        background: #232a3a;
        color: #f3f4f6;
        border-color: #3f4a60;
        transform: translateY(-1px);
      }

      .btn-layer-tool:active:not(:disabled) {
        transform: translateY(0);
      }

      .btn-layer-tool:disabled {
        opacity: 0.35;
        cursor: not-allowed;
        background: #131720;
        border-color: #1f2532;
        color: #6b7280;
      }

      .btn-layer-tool.primary:hover:not(:disabled) {
        background: rgba(255, 94, 58, 0.12);
        color: #ff7e5f;
        border-color: rgba(255, 94, 58, 0.4);
      }

      .btn-layer-tool.success:hover:not(:disabled) {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.4);
      }

      .btn-layer-tool.inside:hover:not(:disabled) {
        background: rgba(59, 130, 246, 0.12);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.4);
      }

      .btn-layer-tool.duplicate:hover:not(:disabled) {
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border-color: rgba(245, 158, 11, 0.4);
      }

      .btn-layer-tool.danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.4);
      }

      /* Cross-Page Clipboard Banner */
      .layer-clipboard-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.25);
        border-radius: 6px;
        padding: 6px 10px;
        margin-bottom: 10px;
        animation: fadeInClipboard 0.2s ease-out;
      }

      @keyframes fadeInClipboard {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .clipboard-banner-left {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
      }

      .clipboard-banner-icon {
        font-size: 0.95rem;
        flex-shrink: 0;
      }

      .clipboard-banner-info {
        display: flex;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
      }

      .clipboard-banner-title {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        color: #d1fae5;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .clipboard-banner-title strong {
        color: #34d399;
        font-weight: 700;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .clipboard-source-pill {
        font-size: 0.62rem;
        color: #6ee7b7;
        background: rgba(16, 185, 129, 0.2);
        border-radius: 3px;
        padding: 1px 4px;
        font-weight: 500;
      }

      .clipboard-banner-desc {
        font-size: 0.65rem;
        color: #9ca3af;
      }

      .btn-clipboard-clear {
        background: none;
        border: none;
        color: #6ee7b7;
        cursor: pointer;
        padding: 2px 6px;
        font-size: 1rem;
        line-height: 1;
        border-radius: 4px;
        transition: all 0.15s ease;
      }

      .btn-clipboard-clear:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
      }

      /* Context Menu for Layers & Canvas */
      .layer-context-menu {
        position: fixed;
        z-index: 999999;
        min-width: 185px;
        background: #141720;
        border: 1px solid #2b3344;
        border-radius: 8px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05);
        padding: 5px;
        font-family: inherit;
        backdrop-filter: blur(8px);
      }

      .context-menu-header {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px 6px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .ctx-layer-icon {
        font-size: 0.8rem;
      }

      .ctx-layer-name {
        color: #ff7e5f;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .context-menu-divider {
        height: 1px;
        background: #232936;
        margin: 4px 0;
      }

      .ctx-menu-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 7px 9px;
        border-radius: 5px;
        background: transparent;
        border: none;
        color: #d1d5db;
        font-size: 0.76rem;
        font-weight: 500;
        cursor: pointer;
        text-align: left;
        transition: all 0.12s ease;
      }

      .ctx-menu-item:hover:not(:disabled) {
        background: #232b3b;
        color: #fff;
      }

      .ctx-menu-item:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .ctx-item-left {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .ctx-shortcut {
        font-size: 0.65rem;
        color: #6b7280;
        font-family: monospace;
      }

      .ctx-menu-item.danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
      }

      /* Traits (Block Attributes) Styles */
      .gjs-trt-traits {
        padding: 6px 0 !important;
        background-color: transparent !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 10px !important;
      }
      .gjs-trt-trait {
        display: flex !important;
        flex-direction: column !important;
        gap: 5px !important;
        padding: 0 0 8px 0 !important;
        border-bottom: 1px solid #1f2634 !important;
      }
      .gjs-trt-trait .gjs-label {
        font-size: 0.7rem !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.04em !important;
        color: #9ca3af !important;
      }
      .gjs-trt-trait input,
      .gjs-trt-trait select,
      .gjs-trt-trait textarea {
        background-color: #0b0e14 !important;
        border: 1px solid #283142 !important;
        border-radius: 6px !important;
        color: #ffffff !important;
        padding: 7px 10px !important;
        font-family: inherit !important;
        font-size: 0.78rem !important;
        width: 100% !important;
        box-sizing: border-box !important;
        outline: none !important;
      }
      .gjs-trt-trait input:focus,
      .gjs-trt-trait select:focus,
      .gjs-trt-trait textarea:focus {
        border-color: #ff5e3a !important;
      }
      #traits-container:empty::before,
      .gjs-trt-traits:empty::before {
        content: 'Select any element on canvas or layers to configure its settings and traits.';
        display: block;
        padding: 18px 10px;
        color: #6b7280;
        font-size: 0.73rem;
        text-align: center;
        font-style: italic;
        line-height: 1.5;
      }

      /* ========================================================= */
      /* Dynamic Image Controls Card in Style Tab                 */
      /* ========================================================= */
      .image-controls-card {
        background: #141824;
        border: 1px solid rgba(255, 94, 58, 0.4);
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
        animation: fadeIn 0.15s ease-out;
      }
      .image-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
      }
      .image-card-preview-row {
        display: flex;
        gap: 10px;
        align-items: center;
      }
      .image-thumb-box {
        width: 62px;
        height: 62px;
        border-radius: 6px;
        overflow: hidden;
        background: #090c12;
        border: 1px solid #283244;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .image-thumb-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .image-quick-buttons {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .btn-change-image {
        width: 100%;
        background: #ff5e3a;
        border: 1px solid #ff5e3a;
        color: #ffffff;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.15s;
      }
      .btn-change-image:hover {
        background: #ff7555;
        border-color: #ff7555;
        transform: translateY(-1px);
      }
      .btn-quick-preset {
        width: 100%;
        background: #1e2535;
        border: 1px solid #2d384c;
        color: #cbd5e1;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: all 0.15s;
      }
      .btn-quick-preset:hover {
        background: #283348;
        color: #ffffff;
        border-color: #ff5e3a;
      }

      /* ========================================================= */
      /* Close Button Styling Card in Style Tab                   */
      /* ========================================================= */
      .close-btn-controls-card {
        background: #141824;
        border: 1px solid rgba(255, 94, 58, 0.4);
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
        animation: fadeIn 0.15s ease-out;
      }
      .close-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        padding-bottom: 8px;
        border-bottom: 1px solid #1f2737;
      }
      .close-control-label {
        display: block;
        font-size: 0.67rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #9ca3af;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
      }
      .close-presets-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
      }
      .close-preset-pill {
        background: #0d1017;
        border: 1px solid #232c3d;
        color: #cbd5e1;
        padding: 4px 6px;
        border-radius: 5px;
        font-size: 0.69rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: all 0.15s;
        white-space: nowrap;
      }
      .close-preset-pill:hover {
        border-color: #ff5e3a;
        color: #ffffff;
      }
      .close-preset-pill.active {
        background: rgba(255, 94, 58, 0.18);
        border-color: #ff5e3a;
        color: #ffffff;
      }
      .close-choice-pill {
        background: #0d1017;
        border: 1px solid #232c3d;
        color: #9ca3af;
        padding: 4px 6px;
        border-radius: 4px;
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        flex: 1;
        transition: all 0.15s;
      }
      .close-choice-pill:hover {
        color: #ffffff;
        border-color: #3b475d;
      }
      .close-choice-pill.active {
        background: #ff5e3a;
        border-color: #ff5e3a;
        color: #ffffff;
      }
      .close-size-pills, .close-radius-pills {
        display: flex;
        gap: 4px;
      }
      .close-color-field {
        display: flex;
        flex-direction: column;
      }
      .close-color-picker-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #0a0d14;
        border: 1px solid #232b3a;
        border-radius: 6px;
        padding: 2px 6px;
      }
      .close-color-input {
        width: 22px;
        height: 22px;
        padding: 0;
        border: none;
        background: transparent;
        cursor: pointer;
        border-radius: 4px;
        flex-shrink: 0;
      }
      .close-text-input {
        flex: 1;
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 0.72rem;
        font-family: monospace;
        outline: none;
        min-width: 0;
      }
      .close-select-input {
        width: 100%;
        background: #0a0d14;
        border: 1px solid #232b3a;
        border-radius: 6px;
        padding: 5px 8px;
        color: #ffffff;
        font-size: 0.72rem;
        outline: none;
        cursor: pointer;
      }
      .close-symbol-chip {
        flex: 1;
        background: #0d1017;
        border: 1px solid #232c3d;
        color: #cbd5e1;
        padding: 4px 6px;
        border-radius: 5px;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
        transition: all 0.15s;
      }
      .close-symbol-chip:hover {
        border-color: #ff5e3a;
        color: #ffffff;
      }
      .close-symbol-chip.active {
        background: rgba(255, 94, 58, 0.2);
        border-color: #ff5e3a;
        color: #ffffff;
      }
      .btn-jump-close-style:hover {
        background: rgba(255, 94, 58, 0.22) !important;
        border-color: #ff5e3a !important;
      }

      /* ========================================================= */
      /* Popup Background Settings in Settings Tab                */
      /* ========================================================= */
      .bg-mode-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        padding: 6px 8px;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        transition: all 0.15s;
      }
      .bg-mode-btn:hover {
        color: #ffffff;
      }
      .bg-mode-btn.active {
        background: #ff5e3a;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(255, 94, 58, 0.35);
      }
      .bg-swatch-chip {
        width: 24px;
        height: 24px;
        border-radius: 5px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        cursor: pointer;
        transition: transform 0.15s, border-color 0.15s;
        padding: 0;
      }
      .bg-swatch-chip:hover {
        transform: scale(1.15);
        border-color: #ff5e3a;
      }
      .bg-gradient-preset, .bg-video-preset {
        font-size: 0.69rem !important;
        padding: 5px 6px !important;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .bg-blur-chip {
        flex: 1;
        font-size: 0.68rem !important;
        padding: 4px 6px !important;
        text-align: center;
      }

      /* Media Library & Image Chooser Modal */
      .media-modal-card {
        width: 760px;
        max-width: 95vw;
        max-height: 85vh;
        background: #11151e;
        border: 1px solid #283244;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
      }
      .media-tabs-nav {
        display: flex;
        background: #090c12;
        border-bottom: 1px solid #1f2736;
        padding: 0 16px;
      }
      .media-tab-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        padding: 12px 16px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all 0.15s;
      }
      .media-tab-btn:hover { color: #ffffff; }
      .media-tab-btn.active {
        color: #ff5e3a;
        border-bottom-color: #ff5e3a;
        background: rgba(255, 94, 58, 0.05);
      }
      .media-tab-pane {
        display: none;
        padding: 18px;
        overflow-y: auto;
        max-height: 480px;
      }
      .media-tab-pane.active { display: block; }

      .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
      }
      .media-item-card {
        background: #151a26;
        border: 1px solid #252e3e;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        flex-direction: column;
      }
      .media-item-card:hover {
        border-color: #ff5e3a;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(255, 94, 58, 0.25);
      }
      .media-item-thumb {
        width: 100%;
        height: 94px;
        object-fit: cover;
        background: #0d1017;
        display: block;
      }
      .media-item-info {
        padding: 8px;
      }
      .media-item-name {
        font-size: 0.68rem;
        font-weight: 600;
        color: #ffffff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .media-item-size {
        font-size: 0.62rem;
        color: #9ca3af;
        margin-top: 2px;
      }

      .upload-dropzone-box {
        border: 2px dashed #374151;
        border-radius: 10px;
        padding: 40px 20px;
        text-align: center;
        background: #0d1017;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .upload-dropzone-box:hover,
      .upload-dropzone-box.dragover {
        border-color: #ff5e3a;
        background: rgba(255, 94, 58, 0.06);
      }

      /* ========================================================= */
      /* Layer Manager Overrides (GrapesJS Layers in Sidebar)      */
      /* ========================================================= */
      #layers-container {
        font-family: inherit;
        --gjs-primary-color: #131722;
        --gjs-main-dark-color: #1f2533;
        --gjs-secondary-dark-color: #131722;
        --gjs-main-light-color: #131722; /* Keep dark default so GrapesJS descendant selector doesn't turn child items orange */
      }
      .gjs-layers { padding: 4px 0; }
      .gjs-layer { background-color: transparent !important; font-size: 0.78rem !important; }

      /* Inactive (Default) Layer Row: DARK background for ALL rows */
      #layers-container .gjs-layer-item,
      #layers-container .gjs-layer-item.gjs-one-bg,
      #layers-container .gjs-layer .gjs-layer-item,
      #layers-container .gjs-layer-children .gjs-layer .gjs-layer-item,
      #layers-container .gjs-layer.gjs-selected .gjs-layer-children .gjs-layer:not(.gjs-selected) .gjs-layer-item {
        background: #131722 !important;
        background-color: #131722 !important;
        color: #9ca3af !important;
        border-bottom: 1px solid #1f2533 !important;
        border-left: 3px solid transparent !important;
        padding: 7px 8px !important;
        cursor: pointer !important;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease !important;
        gap: 6px !important;
        box-shadow: none !important;
      }
      #layers-container .gjs-layer-name,
      #layers-container .gjs-layer.gjs-selected .gjs-layer-children .gjs-layer:not(.gjs-selected) .gjs-layer-name {
        color: #d1d5db !important;
        font-size: 0.78rem !important;
        font-weight: 500 !important;
        text-shadow: none !important;
        transition: color 0.15s ease !important;
      }
      #layers-container .gjs-layer__icon svg,
      #layers-container .gjs-layer.gjs-selected .gjs-layer-children .gjs-layer:not(.gjs-selected) .gjs-layer__icon svg {
        fill: #9ca3af !important;
        filter: none !important;
        transition: fill 0.15s ease !important;
      }
      #layers-container .gjs-layer-caret,
      #layers-container .gjs-layer.gjs-selected .gjs-layer-children .gjs-layer:not(.gjs-selected) .gjs-layer-caret {
        color: #6b7280 !important;
        opacity: 0.8 !important;
      }
      #layers-container .gjs-layer-vis,
      #layers-container .gjs-layer.gjs-selected .gjs-layer-children .gjs-layer:not(.gjs-selected) .gjs-layer-vis {
        color: #6b7280 !important;
        opacity: 0.7 !important;
        transition: opacity 0.15s ease, color 0.15s ease !important;
      }
      #layers-container .gjs-layer-vis:hover { opacity: 1 !important; color: #e5e7eb !important; }

      /* Suppress ACTIVE badge on unselected children when a parent/body is selected */
      #layers-container .gjs-layer.gjs-selected .gjs-layer-children .gjs-layer:not(.gjs-selected) .gjs-layer-title-inn::after {
        display: none !important;
      }

      /* Hover State: Subtle Highlight */
      #layers-container .gjs-layer-item:hover,
      #layers-container .gjs-layer:hover > .gjs-layer-item,
      #layers-container .gjs-layer.gjs-hovered > .gjs-layer-item {
        background: #1c2230 !important;
        background-color: #1c2230 !important;
        color: #f3f4f6 !important;
        border-left: 3px solid #4b5563 !important;
      }
      #layers-container .gjs-layer-item:hover .gjs-layer-name,
      #layers-container .gjs-layer:hover > .gjs-layer-item .gjs-layer-name { color: #ffffff !important; }
      #layers-container .gjs-layer-item:hover .gjs-layer__icon svg,
      #layers-container .gjs-layer:hover > .gjs-layer-item .gjs-layer__icon svg { fill: #ff7e5f !important; }

      /* Active / Clicked Layer State (SELECTED): LIGHT / VIBRANT HIGHLIGHT ONLY ON THE DIRECT SELECTED ITEM */
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item.gjs-one-bg,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-title-c > .gjs-layer-item,
      #layers-container .gjs-layer.gjs-selected > [data-toggle-select],
      #layers-container .gjs-layer-item.gjs-selected {
        background: linear-gradient(90deg, #ff5e3a 0%, #ff7043 100%) !important;
        background-color: #ff5e3a !important;
        color: #ffffff !important;
        border-left: 4px solid #ffffff !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 4px 14px rgba(255, 94, 58, 0.45) !important;
      }
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item *,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-title-c > .gjs-layer-item *,
      #layers-container .gjs-layer.gjs-selected > [data-toggle-select] *,
      #layers-container .gjs-layer-item.gjs-selected * {
        color: #ffffff !important;
      }
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-name,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-title-c > .gjs-layer-item .gjs-layer-name,
      #layers-container .gjs-layer-item.gjs-selected .gjs-layer-name {
        color: #ffffff !important;
        font-weight: 700 !important;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer__icon svg,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-title-c > .gjs-layer-item .gjs-layer__icon svg,
      #layers-container .gjs-layer-item.gjs-selected .gjs-layer__icon svg {
        fill: #ffffff !important;
        filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35)) !important;
      }
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-caret,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-vis,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-title-c > .gjs-layer-item .gjs-layer-caret,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-title-c > .gjs-layer-item .gjs-layer-vis {
        color: #ffffff !important;
        opacity: 1 !important;
      }
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-title-inn::after,
      #layers-container .gjs-layer.gjs-selected > .gjs-layer-title-c > .gjs-layer-item .gjs-layer-title-inn::after {
        content: 'ACTIVE';
        display: inline-block;
        font-size: 8px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        color: #ffffff;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 2px 5px;
        border-radius: 3px;
        margin-left: 6px;
      }

      /* TEMPLATES MODAL */
      .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.82);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
      }
      .modal-card {
        background: #11151e;
        border: 1px solid #262f3f;
        border-radius: 14px;
        width: 95%;
        max-width: 780px;
        max-height: 90vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 25px 60px rgba(0,0,0,0.8);
      }
      .modal-header {
        padding: 14px 20px;
        border-bottom: 1px solid #202736;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .modal-body {
        padding: 20px;
        overflow-y: auto;
      }
      .modal-footer {
        padding: 12px 20px;
        border-top: 1px solid #202736;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        background: #0c0f16;
      }
      .code-tab-btn {
        background: #151a24;
        border: 1px solid #283142;
        color: #9ca3af;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .code-tab-btn:hover {
        background: #1c2230;
        color: #ffffff;
      }
      .code-tab-btn.active {
        background: rgba(56, 189, 248, 0.15);
        border-color: #38bdf8;
        color: #38bdf8;
      }
      .code-tab-btn.active.tab-css {
        background: rgba(168, 85, 247, 0.15);
        border-color: #a855f7;
        color: #c084fc;
      }
      .code-tab-btn.active.tab-js {
        background: rgba(245, 158, 11, 0.15);
        border-color: #f59e0b;
        color: #fbbf24;
      }
      .code-tab-btn.active.tab-unified {
        background: rgba(52, 211, 153, 0.15);
        border-color: #34d399;
        color: #34d399;
      }
      .snippet-btn {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 4px 10px;
        background: #151a24;
        border: 1px solid #283142;
        border-radius: 5px;
        color: #cbd5e1;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .snippet-btn:hover {
        background: #232d3f;
        color: #ffffff;
        border-color: #4a5568;
      }

      /* TEMPLATE CARDS IN GALLERY */
      .template-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      .template-card {
        background: #161b24;
        border: 1px solid #283142;
        border-radius: 10px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
      }
      .template-card:hover {
        border-color: #ff5e3a;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255, 94, 58, 0.15);
      }
      .template-card-preview {
        height: 110px;
        background: #0d1017;
        padding: 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #232b3a;
        text-align: center;
      }
      .template-card-info {
        padding: 12px;
      }
      .template-card-title {
        font-size: 0.82rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 4px;
      }
      .template-card-desc {
        font-size: 0.72rem;
        color: #9ca3af;
        line-height: 1.4;
      }

      /* TARGETING FORM STYLES */
      .control-group { margin-bottom: 14px; }
      .control-label {
        font-size: 0.74rem;
        font-weight: 700;
        color: #d1d5db;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .control-input, .control-select {
        width: 100%;
        background: #0d1017;
        border: 1px solid #232b3a;
        color: #ffffff;
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 0.78rem;
        outline: none;
      }
      .chips-row { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
      .chip-btn {
        background: #0f131a;
        border: 1px solid #252d3d;
        color: #9ca3af;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s;
      }
      .chip-btn:hover { background: #1b2230; color: #ffffff; }
      .chip-btn.active {
        background: rgba(255, 94, 58, 0.18);
        border-color: #ff5e3a;
        color: #ff5e3a;
        font-weight: 700;
      }

      /* SETTINGS TAB SPECIAL CONTROLS */
      .settings-card-section {
        background: #0d1017;
        border: 1px solid #232b3a;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 12px;
      }
      .close-pos-button-group {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 6px;
        margin-top: 6px;
      }
      .close-pos-btn {
        background: #141822;
        border: 1px solid #283142;
        color: #9ca3af;
        padding: 8px 6px;
        border-radius: 6px;
        font-size: 0.74rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .close-pos-btn:hover {
        background: #1e2533;
        color: #ffffff;
        border-color: #3b465c;
      }
      .close-pos-btn.active {
        background: rgba(255, 94, 58, 0.18);
        border-color: #ff5e3a;
        color: #ff5e3a;
        font-weight: 700;
        box-shadow: 0 0 0 1px #ff5e3a;
      }

      .switch-toggle {
        position: relative;
        display: inline-block;
        width: 36px;
        height: 20px;
      }
      .switch-toggle input { opacity: 0; width: 0; height: 0; }
      .switch-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #283142;
        transition: .2s;
        border-radius: 20px;
      }
      .switch-slider:before {
        position: absolute;
        content: "";
        height: 14px;
        width: 14px;
        left: 3px;
        bottom: 3px;
        background-color: #ffffff;
        transition: .2s;
        border-radius: 50%;
      }
      .switch-toggle input:checked + .switch-slider {
        background-color: #ff5e3a;
      }
      .switch-toggle input:checked + .switch-slider:before {
        transform: translateX(16px);
      }

      .targeting-list-box {
        max-height: 130px;
        overflow-y: auto;
        background: #0b0e14;
        border: 1px solid #202735;
        border-radius: 6px;
        padding: 6px;
        margin-top: 6px;
      }
      .target-check-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 6px;
        border-radius: 4px;
        font-size: 0.74rem;
        color: #d1d5db;
        cursor: pointer;
      }
      .target-check-item:hover { background: #161b25; }

      /* TOAST NOTIFICATION */
      #toastNotify {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: #10b981;
        color: #ffffff;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        display: none;
        z-index: 99999;
        align-items: center;
        gap: 8px;
      }

      /* ========================================================
         STYLE MANAGER STATE SWITCHER: NORMAL vs HOVER
         ======================================================== */
      .gjs-sm-state-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        background: #0f131a;
        border-bottom: 1px solid #1e2638;
        margin-bottom: 8px;
        border-radius: 6px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        gap: 8px;
      }
      .gjs-sm-state-left {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .gjs-sm-state-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
      }
      .gjs-sm-state-pills, .gjs-sector-state-switch {
        display: inline-flex;
        background: #0b0e14;
        border: 1px solid #232c3d;
        border-radius: 6px;
        padding: 2px;
        gap: 2px;
        margin-left: auto;
      }
      .gjs-state-btn, .gjs-master-state-btn {
        background: transparent;
        border: none;
        color: #8b9bb4;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: lowercase;
        padding: 2px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
        line-height: 1.2;
      }
      .gjs-master-state-btn {
        text-transform: none;
        padding: 3px 10px;
        font-size: 0.72rem;
      }
      .gjs-state-btn:hover, .gjs-master-state-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
      }
      .gjs-state-btn.is-active, .gjs-master-state-btn.is-active {
        background: #ff5e3a !important;
        color: #ffffff !important;
        box-shadow: 0 2px 6px rgba(255, 94, 58, 0.4);
      }
      .gjs-state-btn[data-state="normal"].is-active,
      .gjs-master-state-btn[data-state="normal"].is-active {
        background: #252e3e !important;
        color: #ffffff !important;
        box-shadow: none;
      }
      .gjs-sm-state-badge {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        background: #18202d;
        color: #94a3b8;
        border: 1px solid #232c3d;
        white-space: nowrap;
      }
      .gjs-sm-state-badge.is-hover {
        background: rgba(255, 94, 58, 0.15);
        color: #ff5e3a;
        border-color: rgba(255, 94, 58, 0.4);
      }
      .gjs-sm-sector-title {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        position: relative;
        padding-right: 8px !important;
      }
      .gjs-sm-sector-label {
        flex: 1;
      }
    </style>
  </head>
  <body>
    <!-- TOP TOOLBAR -->
    <header class="builder-navbar">
      <div class="navbar-left">
        <a href="/editor" class="brand-title" title="BUGMEGA Studio">
          <span>BUGMEGA</span>
        </a>

        <!-- BUILDER MODE SWITCHER DROPDOWN -->
        <WorkspaceSwitcher activeApp="popup-builder" />

        <!-- Active Theme Pill -->
        <div class="active-theme-pill" title={`Active Theme: ${activeTheme}`} style="display: inline-flex; align-items: center; gap: 6px; background: #191f2c; border: 1px solid #313d54; border-radius: 9999px; padding: 4px 10px; font-size: 0.72rem; color: #94a3b8; margin-right: 6px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #10b981; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);"></span>
          <span style="text-transform: uppercase; font-weight: 600; font-size: 0.66rem; color: #64748b;">Theme:</span>
          <strong style="color: #f1f5f9; font-weight: 700; text-transform: capitalize;">{activeTheme}</strong>
        </div>

        <!-- POPUP SELECTOR (SWITCH BETWEEN POPUPS) -->
        <div class="popup-selector-wrap" id="popupSelectorWrap">
          <button type="button" class="popup-selector-btn" id="btnPopupSelector">
            <span class="status-dot published" id="activePopupStatusDot"></span>
            <span id="activePopupTitleText">Welcome Newsletter</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>

          <div class="popup-selector-menu" id="popupSelectorMenu">
            <div style="font-size: 0.68rem; font-weight: 700; color: #6b7280; text-transform: uppercase; padding: 4px 6px;">Manage Popups</div>
            <div id="popupsListContainer"></div>
            <button type="button" class="btn-add-popup" id="btnCreateNewPopup">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>+ Create New Popup</span>
            </button>
          </div>
        </div>

        <!-- TEMPLATES GALLERY BUTTON -->
        <button type="button" class="btn-nav-action" id="btnOpenTemplatesGallery" title="Pick from ready-to-use sample popups">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
          <span>Sample Templates</span>
        </button>
      </div>

      <!-- CENTER: DEVICE PREVIEW TOGGLE (POPUP SIZES) & BACKDROP VIEW -->
      <div class="navbar-center">
