      let activeImageTarget = null;
      let activeImageForBg = false;

      function openImageChooserModal(targetComp, forBg = false) {
        activeImageForBg = !!forBg;
        if (activeImageForBg && !targetComp) {
          targetComp = getModalPopupBoxComp();
        }
        activeImageTarget = targetComp || editor?.getSelected();

        if (window.FastPressFileManager) {
          window.FastPressFileManager.open({
            target: activeImageTarget,
            onSelect: (url) => {
              applySelectedImage(url);
            }
          });
          return;
        }

        const modal = document.getElementById('modalImageChooser');
        if (modal) modal.style.display = 'flex';

        // Load project media from /api/upload
        loadProjectMediaLibrary();
        populateStockPresetsGrid();

        // Populate direct URL input if image has current URL
        let currentUrl = '';
        if (activeImageTarget) {
          if (activeImageForBg) {
            const bg = activeImageTarget.getStyle()['background-image'] || '';
            const match = bg.match(/url\(["']?([^"']+)["']?\)/);
            if (match) currentUrl = match[1];
          } else {
            currentUrl = activeImageTarget.getAttributes()?.src || activeImageTarget.get('src') || '';
          }
        }
        const inpUrl = document.getElementById('inpDirectUrlModal');
        if (inpUrl) inpUrl.value = currentUrl;
        updateDirectUrlPreview(currentUrl);
      }

      function closeImageChooserModal() {
        const modal = document.getElementById('modalImageChooser');
        if (modal) modal.style.display = 'none';
        const statusText = document.getElementById('uploadStatusText');
        if (statusText) statusText.style.display = 'none';
      }

      function updateDirectUrlPreview(url) {
        const previewBox = document.getElementById('urlPreviewBox');
        if (!previewBox) return;
        if (url && (url.startsWith('http') || url.startsWith('/'))) {
          previewBox.innerHTML = `<img src="${url}" style="width: 100%; height: 100%; object-fit: contain;" onerror="this.parentElement.innerHTML='<span style=\\'color:#ef4444;font-size:0.75rem;\\'>Failed to load preview</span>'" />`;
        } else {
          previewBox.innerHTML = `<span style="color: #6b7280; font-size: 0.75rem;">Image preview will appear here</span>`;
        }
      }

      function applySelectedImage(imageUrl) {
        if (!imageUrl || !activeImageTarget) return;

        if (activeImageForBg) {
          const inp = document.getElementById('inpModalBgImageUrl');
          if (inp) inp.value = imageUrl;
          const thumb = document.getElementById('modalBgThumbPreview');
          if (thumb) thumb.innerHTML = `<img src="${imageUrl}" style="width: 100%; height: 100%; object-fit: cover;" />`;

          document.querySelectorAll('.bg-mode-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.bgmode === 'image');
          });
          document.querySelectorAll('.bg-subpane').forEach(p => p.style.display = 'none');
          const paneImg = document.getElementById('paneBgImage');
          if (paneImg) paneImg.style.display = 'block';
          const badge = document.getElementById('badgeBgType');
          if (badge) badge.textContent = 'image';

          const size = document.getElementById('selModalBgSize')?.value || 'cover';
          const position = document.getElementById('selModalBgPosition')?.value || 'center center';
          const overlayOpacity = parseInt(document.getElementById('rngImageOverlayOpacity')?.value, 10) || 50;

          applyModalBackground('image', {
            imageUrl,
            size,
            position,
            overlayOpacity
          });
          showToast('Modal background image updated!');
        } else {
          const attrs = activeImageTarget.getAttributes() || {};
          attrs.src = imageUrl;
          activeImageTarget.set('attributes', attrs);
          activeImageTarget.set('src', imageUrl);

          // Update image controls in style tab
          const thumb = document.getElementById('imageThumbPreview');
          if (thumb) thumb.src = imageUrl;
          const inp = document.getElementById('inpImageUrlStyle');
          if (inp) inp.value = imageUrl;

          showToast('Image updated successfully!');
        }

        closeImageChooserModal();
      }

      async function loadProjectMediaLibrary() {
        const grid = document.getElementById('projectMediaGrid');
        if (!grid) return;

        grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; color: #9ca3af; padding: 25px; font-size: 0.75rem;">Scanning uploaded media...</div>';

        try {
          const res = await fetch('/api/upload');
          const data = await res.json();
          const items = Array.isArray(data) ? data : (data.media || []);

          if (items.length === 0) {
            grid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; color: #6b7280; padding: 30px; font-size: 0.76rem;">No images uploaded yet. Switch to "Upload New" or "Stock Presets" to add one!</div>';
            return;
          }

          grid.innerHTML = '';
          items.forEach(item => {
            const card = document.createElement('div');
            card.className = 'media-item-card';
            card.innerHTML = `
              <img src="${item.url}" class="media-item-thumb" alt="${item.fileName || 'Image'}" loading="lazy" />
              <div class="media-item-info">
                <div class="media-item-name" title="${item.fileName || ''}">${item.fileName || 'Image'}</div>
                <div class="media-item-size">${item.size || ''}</div>
              </div>
            `;
            card.addEventListener('click', () => applySelectedImage(item.url));
            grid.appendChild(card);
          });
        } catch (err) {
          grid.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; color: #ef4444; padding: 20px; font-size: 0.75rem;">Failed to load media library: ${err.message}</div>`;
        }
      }

      function populateStockPresetsGrid() {
        const grid = document.getElementById('stockPresetsGrid');
        if (!grid || grid.children.length > 0) return;

        grid.innerHTML = '';
        STOCK_IMAGE_PRESETS.forEach(item => {
          const card = document.createElement('div');
          card.className = 'media-item-card';
          card.innerHTML = `
            <img src="${item.url}" class="media-item-thumb" alt="${item.title}" loading="lazy" />
            <div class="media-item-info">
              <div class="media-item-name">${item.title}</div>
              <div class="media-item-size" style="color: #ff5e3a;">${item.category}</div>
            </div>
          `;
          card.addEventListener('click', () => applySelectedImage(item.url));
          grid.appendChild(card);
        });
      }

      async function uploadImageFile(file) {
        if (!file) return;

        if (file.size > 200 * 1024) {
          showToast(`Image "${file.name}" exceeds the 200 KB limit (${(file.size / 1024).toFixed(1)} KB). Maximum allowed size is 200 KB.`, true);
          return;
        }

        const statusText = document.getElementById('uploadStatusText');
        if (statusText) {
          statusText.style.display = 'block';
          statusText.style.color = '#ff5e3a';
          statusText.textContent = `Uploading "${file.name}"...`;
        }

        const formData = new FormData();
        formData.append('file', file);

        try {
          const res = await fetch('/api/upload', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.success && data.url) {
            if (statusText) {
              statusText.style.color = '#10b981';
              statusText.textContent = 'Upload successful!';
            }
            applySelectedImage(data.url);
          } else {
            alert('Upload failed: ' + (data.error || 'Server error'));
            if (statusText) statusText.style.display = 'none';
          }
        } catch (err) {
          alert('Network error during upload: ' + err.message);
          if (statusText) statusText.style.display = 'none';
        }
      }

