          } else {
            btnCustomCode.style.display = 'none';
            btnCustomCode.disabled = true;
          }
        }
        if (isCloseBtn) displayName = 'Close Button (×)';
        else if (tagName.startsWith('H') && tagName.length === 2) displayName = `Heading (${tagName})`;
        else if (tagName === 'BUTTON') displayName = 'Action Button';
        else if (tagName === 'INPUT') displayName = 'Input Field';
        else if (tagName === 'IMG') displayName = 'Image';
        else if (tagName === 'FORM') displayName = 'Form Container';
        else if (tagName === 'P') displayName = 'Paragraph';
        else if (tagName === 'SPAN') displayName = 'Text / Badge';
        else if (tagName === 'DIV') displayName = 'Container Section';

