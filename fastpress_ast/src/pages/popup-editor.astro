                  'box-shadow',
                  'opacity',
                  'overflow',
                  'cursor'
                ]
              }
            ]
          },
          traitManager: {
            appendTo: '#traits-container'
          },
          layerManager: {
            appendTo: '#layers-container'
          }
        });
        window.editor = editor;

        // Rich Text Editor (RTE) formatBlock additions (H1-H5, P)
        try {
          ['h1', 'h2', 'h3', 'h4', 'h5'].forEach((tag, idx) => {
            editor.RichTextEditor.add(tag, {
              icon: `<b style="font-size: 11px; font-weight: 800; font-family: monospace;">H${idx + 1}</b>`,
              attributes: { title: `Heading ${idx + 1}` },
              result: rte => rte.exec('formatBlock', `<${tag}>`)
            });
          });
          editor.RichTextEditor.add('p-block', {
            icon: `<b style="font-size: 11px; font-weight: 800; font-family: monospace;">P</b>`,
            attributes: { title: 'Paragraph' },
            result: rte => rte.exec('formatBlock', '<p>')
          });
        } catch (e) {
          console.warn('RTE additions warning:', e);
        }

        // Extend 'default' component so any Div/Section is named 'Section' in Layers and droppable/draggable
        const defaultType = editor.DomComponents.getType('default');
        const defaultModel = defaultType.model;

        editor.DomComponents.addType('default', {
          model: {
            defaults: {
              droppable: true,
              draggable: true
            },
            getName() {
              const custom = this.get('custom-name');
              if (custom) return custom;
              const tag = (this.get('tagName') || '').toLowerCase();
              const cls = this.getClasses ? this.getClasses() : [];
              if (tag === 'div' || tag === 'section') {
                if (cls.includes('popup-box')) return 'Section (Popup Box)';
                if (cls.includes('popup-video-bg-wrap')) return 'Section (Video Background)';
                if (cls.includes('popup-section')) return 'Section';
                return 'Section';
              }
              if (/^h[1-6]$/i.test(tag)) return 'Heading';
              if (tag === 'p') return 'Text';
              if (tag === 'img') return 'Image';
              if (cls.includes('popup-dismiss-link')) return 'Dismiss Link';
              if (tag === 'button' && (cls.includes('popup-close-trigger') || cls.includes('fastpress-popup-close-btn') || cls.includes('popup-close-corner-btn'))) return 'Close Button (×)';
              if (tag === 'form') return 'Subscribe Form';
              if (tag === 'a' || (tag === 'button' && this.getAttributes && this.getAttributes()['type'] === 'submit')) return 'Action Button';
              if (tag === 'button') return 'Button';
              return defaultModel.prototype.getName.apply(this, arguments);
            }
          }
        });

        // Extend 'heading' with tag switcher trait (H1-H6, P) and draggable: true
        editor.DomComponents.addType('heading', {
          extend: 'text',
          isComponent: el => el && el.tagName && /^H[1-6]$/i.test(el.tagName),
          model: {
            defaults: {
              tagName: 'h2',
              editable: true,
              draggable: true,
              droppable: false,
              traits: [
                {
                  type: 'select',
                  name: 'tagName',
                  label: 'Heading Tag',
                  changeProp: true,
                  options: [
                    { id: 'h1', label: 'H1 - Title (Largest)' },
                    { id: 'h2', label: 'H2 - Main Heading' },
                    { id: 'h3', label: 'H3 - Subtitle' },
                    { id: 'h4', label: 'H4 - Card Title' },
                    { id: 'h5', label: 'H5 - Small Heading' },
                    { id: 'h6', label: 'H6 - Micro Heading' },
                    { id: 'p', label: 'P - Paragraph' },
                  ]
                },
                'id',
                'title'
              ]
            },
            init() {
              this.on('change:tagName', this.handleTagChange);
            },
            handleTagChange() {
              const view = this.getView ? this.getView() : this.view;
              if (view && view.el) {
                const newTag = (this.get('tagName') || 'h2').toLowerCase();
                if (view.el.tagName.toLowerCase() !== newTag) {
                  const newEl = view.el.ownerDocument.createElement(newTag);
                  Array.from(view.el.attributes).forEach(attr => {
                    newEl.setAttribute(attr.name, attr.value);
                  });
                  newEl.innerHTML = view.el.innerHTML;
                  view.el.parentNode?.replaceChild(newEl, view.el);
                  view.el = newEl;
                  if (view.render) view.render();
                }
              }
            }
          }
        });

        // Register Custom Code Widget Component Type
        const PLACEHOLDER_CUSTOM_CODE_HTML = `<div class="custom-code-placeholder" style="padding: 24px 20px; border: 2px dashed #6366f1; background: rgba(99, 102, 241, 0.08); border-radius: 8px; text-align: center; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; cursor: pointer; user-select: none;">
          <div style="display: flex; align-items: center; justify-content: center; gap: 8px; color: #818cf8; font-weight: 700; font-size: 0.95rem; margin-bottom: 6px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle;"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>Custom Code Widget</span>
          </div>
          <p style="margin: 0; font-size: 0.82rem; color: #94a3b8; line-height: 1.5;">Double-click or click &lt;/&gt; in toolbar to insert custom HTML, CSS (&lt;style&gt;), or JavaScript (&lt;script&gt;).</p>
        </div>`;

        editor.DomComponents.addType('custom-code', {
          model: {
            defaults: {
              name: 'Custom Code',
              droppable: false,
              draggable: true,
              highlightable: true,
              resizable: true,
              traits: [
                {
                  type: 'button',
                  name: 'edit_code',
                  text: '⚡ Edit Code (HTML/CSS/JS)',
                  command: 'open-custom-code-widget-modal'
                },
                'id',
                'title'
              ]
            }
          },
          view: {
            events: {
              dblclick: 'onDblClick'
            },
            onDblClick(e) {
              if (e) {
                e.preventDefault();
                e.stopPropagation();
              }
              editor.runCommand('open-custom-code-widget-modal', { component: this.model });
            }
          }
        });

        // Command to open the custom code widget modal
        editor.Commands.add('open-custom-code-widget-modal', {
          run(ed, sender, options = {}) {
            const comp = options.component || ed.getSelected();
            if (typeof openCustomCodeWidgetModal === 'function') {
              openCustomCodeWidgetModal(comp);
            }
          }
        });

        // Register custom component type 'accordion-container' in Popup Editor
        editor.DomComponents.addType('accordion-container', {
          isComponent: el => el && el.classList && el.classList.contains('accordion-container'),
          model: {
            defaults: {
              name: 'Accordion (FAQ)',
              droppable: true,
              traits: [
                {
                  type: 'select',
                  name: 'data-initial-state',
                  label: 'Default State',
                  options: [
                    { id: 'first-open', name: 'Expanded for the first one', label: 'Expanded for the first one' },
                    { id: 'first-two-open', name: 'Expanded for the first two', label: 'Expanded for the first two' },
                    { id: 'all-collapsed', name: 'All Collapsed (Closed)', label: 'All Collapsed (Closed)' },
                    { id: 'all-expanded', name: 'All Expanded (Open)', label: 'All Expanded (Open)' },
                    { id: 'custom', name: 'Custom (Per Item)', label: 'Custom (Per Item)' }
                  ],
                  value: 'all-collapsed'
                },
                'id',
                'title'
              ]
            },
            init() {
              this.on('change:attributes:data-initial-state', () => {
                const state = this.getAttributes()['data-initial-state'] || 'all-collapsed';
                if (state === 'custom') return;
                const items = this.find('.accordion-item');
                items.forEach((item, idx) => {
                  const icon = item.find('.accordion-icon svg')[0] || item.find('.accordion-icon')[0];
                  let shouldOpen = false;
                  if (state === 'all-collapsed') {
                    shouldOpen = false;
                  } else if (state === 'all-expanded') {
                    shouldOpen = true;
                  } else if (state === 'first-open' || state === 'first-ones') {
                    shouldOpen = (idx === 0);
                  } else if (state === 'first-two-open') {
                    shouldOpen = (idx < 2);
                  }

                  if (shouldOpen) {
                    item.addAttributes({ 'data-open': 'true' });
                    item.addClass('is-open');
                    if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
                  } else {
                    item.addAttributes({ 'data-open': 'false' });
                    item.removeClass('is-open');
                    if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
                  }
                });
              });
            }
          }
        });

        // Register custom component type 'accordion-item' in Popup Editor
        editor.DomComponents.addType('accordion-item', {
          isComponent: el => el && el.classList && el.classList.contains('accordion-item'),
          model: {
            defaults: {
              name: 'Accordion Item',
              droppable: false,
              draggable: '.accordion-container, [data-gjs-type="wrapper"]',
              traits: [
                {
                  type: 'select',
                  name: 'data-open',
                  label: 'Default State',
                  badge: 'Display',
                  description: 'Set whether this item loads expanded (open) or collapsed (closed).',
                  options: [
                    { id: 'false', name: 'Collapsed (Closed)', label: 'Collapsed (Closed)' },
                    { id: 'true', name: 'Expanded (Open)', label: 'Expanded (Open)' }
                  ],
                  value: 'false'
                },
                {
                  type: 'button',
                  name: 'btn_first_open',
                  text: '⚡ Expand for the first one',
                  command: 'accordion-expand-first-only'
                },
                {
                  type: 'button',
                  name: 'btn_all_collapsed',
                  text: '⚡ Collapse All Items',
                  command: 'accordion-collapse-all'
                }
              ]
            },
            init() {
              this.on('change:attributes:data-open', () => {
                const val = String(this.getAttributes()['data-open']);
                const isOpen = val === 'true';
                const icon = this.find('.accordion-icon svg')[0] || this.find('.accordion-icon')[0];
                if (isOpen) {
                  this.addClass('is-open');
                  if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
                  const cc = this.find('.accordion-content')[0];
                  if (cc) {
                    cc.removeStyle('max-height');
                    cc.removeStyle('padding');
                  }
                } else {
                  this.removeClass('is-open');
                  if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
                }
                const parent = this.closest('.accordion-container');
                if (parent) {
                  const parentState = parent.getAttributes()['data-initial-state'];
                  if (parentState && parentState !== 'custom') {
                    parent.addAttributes({ 'data-initial-state': 'custom' });
                  }
                }
              });
            }
          }
        });

        // Command to toggle accordion item expanded/collapsed state directly
        editor.Commands.add('toggle-accordion-item-state', {
          run(ed) {
            const selected = ed.getSelected();
            if (!selected) return;
            const item = (selected.getClasses && selected.getClasses().includes('accordion-item'))
              ? selected
              : (selected.closest ? selected.closest('.accordion-item') : null);
            if (!item) return;
            const currentVal = item.getAttributes()['data-open'] === 'true' || (item.getClasses && item.getClasses().includes('is-open'));
            const nextVal = !currentVal;
            item.addAttributes({ 'data-open': String(nextVal) });
            const icon = item.find('.accordion-icon svg')[0] || item.find('.accordion-icon')[0];
            if (nextVal) {
              item.addClass('is-open');
              if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
              const cc = item.find('.accordion-content')[0];
              if (cc) {
                cc.removeStyle('max-height');
                cc.removeStyle('padding');
              }
            } else {
              item.removeClass('is-open');
              if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
            }
            const parent = item.closest('.accordion-container');
            if (parent && parent.getAttributes()['data-initial-state'] !== 'custom') {
              parent.addAttributes({ 'data-initial-state': 'custom' });
            }
          }
        });

        // Command to expand only the first item in the accordion
        editor.Commands.add('accordion-expand-first-only', {
          run(ed) {
            const selected = ed.getSelected();
            if (!selected) return;
            const container = (selected.getClasses && selected.getClasses().includes('accordion-container'))
              ? selected
              : (selected.closest ? selected.closest('.accordion-container') : null);
            if (!container) return;
            container.addAttributes({ 'data-initial-state': 'first-open' });
            const items = container.find('.accordion-item');
            items.forEach((item, idx) => {
              const icon = item.find('.accordion-icon svg')[0] || item.find('.accordion-icon')[0];
              if (idx === 0) {
                item.addAttributes({ 'data-open': 'true' });
                item.addClass('is-open');
                if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
              } else {
                item.addAttributes({ 'data-open': 'false' });
                item.removeClass('is-open');
                if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
              }
            });
          }
        });

        // Command to collapse all items in the accordion
        editor.Commands.add('accordion-collapse-all', {
          run(ed) {
            const selected = ed.getSelected();
            if (!selected) return;
            const container = (selected.getClasses && selected.getClasses().includes('accordion-container'))
              ? selected
              : (selected.closest ? selected.closest('.accordion-container') : null);
            if (!container) return;
            container.addAttributes({ 'data-initial-state': 'all-collapsed' });
            const items = container.find('.accordion-item');
            items.forEach((item) => {
              const icon = item.find('.accordion-icon svg')[0] || item.find('.accordion-icon')[0];
              item.addAttributes({ 'data-open': 'false' });
              item.removeClass('is-open');
              if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
            });
          }
        });
        editor.Commands.add('toggle-accordion-item-state', {
          run(ed) {
            const selected = ed.getSelected();
            if (!selected) return;
            const item = (selected.getClasses && selected.getClasses().includes('accordion-item'))
              ? selected
              : (selected.closest ? selected.closest('.accordion-item') : null);
            if (!item) return;
            const currentVal = item.getAttributes()['data-open'] === 'true' || (item.getClasses && item.getClasses().includes('is-open'));
            const nextVal = !currentVal;
            item.addAttributes({ 'data-open': String(nextVal) });
            const icon = item.find('.accordion-icon svg')[0] || item.find('.accordion-icon')[0];
            if (nextVal) {
              item.addClass('is-open');
              if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
              const cc = item.find('.accordion-content')[0];
              if (cc) {
                cc.removeStyle('max-height');
                cc.removeStyle('padding');
              }
            } else {
              item.removeClass('is-open');
              if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
            }
            const parent = item.closest('.accordion-container');
            if (parent && parent.getAttributes()['data-initial-state'] !== 'custom') {
              parent.addAttributes({ 'data-initial-state': 'custom' });
            }
          }
        });

        // Override open-assets so double-clicking any image on canvas opens our Image Chooser Modal
        editor.Commands.add('open-assets', {
          run(ed, sender, opts) {
            const targetComp = (opts && opts.target) ? opts.target : ed.getSelected();
            openImageChooserModal(targetComp);
          }
        });

        // Auto-switch to Style tab and update element info banner when canvas element is clicked
        editor.on('component:selected', (comp) => {
          if (!comp) return;
          // Add custom code toolbar button if selected element is a custom code widget
          if (comp.get('type') === 'custom-code' || (comp.getClasses && comp.getClasses().includes('custom-code-widget'))) {
            const currentToolbar = comp.get('toolbar') || [];
            if (!currentToolbar.some(t => t.command === 'open-custom-code-widget-modal')) {
              comp.set('toolbar', [
                {
                  attributes: { class: 'fa fa-code', title: 'Edit Code (HTML/CSS/JS)' },
                  command: 'open-custom-code-widget-modal'
                },
                ...currentToolbar
              ]);
            }
          }
          if (typeof isDropzoneHelper === 'function' && isDropzoneHelper(comp)) {
            editor.selectRemove(comp);
            return;
          }

          // Auto-switch to tabStyle or tabSettings for immediate configuration
          const activeTabBtn = document.querySelector('.sidebar-tab-btn.active');
          const isCloseBtn = isCloseButtonComponent(comp);
          const isAccordion = comp.get('type') === 'accordion-container' || comp.get('type') === 'accordion-item' || 
            (comp.getClasses && (comp.getClasses().includes('accordion-container') || comp.getClasses().includes('accordion-item')));

          if (isAccordion) {
            document.querySelector('.sidebar-tab-btn[data-tab="tabSettings"]')?.click();
          } else if (activeTabBtn && (activeTabBtn.dataset.tab === 'tabBlocks' || activeTabBtn.dataset.tab === 'tabSettings' || isCloseBtn)) {
            document.querySelector('.sidebar-tab-btn[data-tab="tabStyle"]')?.click();
          }

          // Add toggle button to toolbar for accordion item
          if (comp.get('type') === 'accordion-item' || (comp.getClasses && comp.getClasses().includes('accordion-item'))) {
            const tb = comp.get('toolbar') || [];
            if (!tb.some(item => item.id === 'btn-tlb-toggle-acc')) {
              tb.unshift({
                id: 'btn-tlb-toggle-acc',
                attributes: { class: 'gjs-tlb-item', title: 'Toggle Expanded / Collapsed' },
                label: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg>`,
                command: 'toggle-accordion-item-state'
              });
              comp.set('toolbar', tb);
            }
          }

          updateSelectedElementUI(comp);
          if (typeof updateLayerSelectionUI === 'function') {
            updateLayerSelectionUI(comp);
          }
          setTimeout(enhanceAllColorFields, 50);
        });

        editor.on('component:deselected', () => {
          updateSelectedElementUI(null);
          if (typeof updateLayerSelectionUI === 'function') {
            updateLayerSelectionUI(null);
          }
          if (typeof updateStateButtonsUI === 'function') {
            updateStateButtonsUI('normal');
          }
        });

        // ========================================================
        // NORMAL & HOVER STATE SWITCHER CONTROLLER
        // ========================================================
        function updateStateButtonsUI(state) {
          activeComponentStylingState = state;
          document.querySelectorAll('.gjs-state-btn, .gjs-master-state-btn').forEach(btn => {
            btn.classList.toggle('is-active', btn.dataset.state === state);
          });
          const indicator = document.getElementById('gjsStateIndicator');
          if (indicator) {
            if (state === 'hover') {
              indicator.textContent = ':hover State Active';
              indicator.className = 'gjs-sm-state-badge is-hover';
            } else {
              indicator.textContent = 'Normal State';
              indicator.className = 'gjs-sm-state-badge';
            }
          }
        }

        function refreshAllStyleProperties(edInstance) {
          const ed = edInstance || editor;
          if (!ed || !ed.StyleManager) return;
          const sectors = ed.StyleManager.getSectors();
          function refreshProp(prop) {
            if (!prop) return;
            if (prop.view && typeof prop.view.render === 'function') {
              try { prop.view.render(); } catch (e) {}
            }
            const subProps = prop.getProperties ? prop.getProperties() : (prop.get ? prop.get('properties') : null);
            if (subProps && subProps.forEach) subProps.forEach(refreshProp);
          }
          sectors.forEach(s => {
            const props = s.getProperties ? s.getProperties() : (s.get ? s.get('properties') : []);
            if (props && props.forEach) props.forEach(refreshProp);
          });
        }

        function setComponentStylingState(state) {
          if (!editor) return;
          const sel = editor.getSelected();
          if (!sel) return;
          const id = sel.getId();

          activeComponentStylingState = state;

          if (state === 'hover') {
            snapshotComponentNormalStyle(sel);
            sel.addClass('gjs-hover-preview');
            let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`);
            if (!hoverRule) {
              hoverRule = editor.Css.getRule(`#${id}:hover`);
            }
            if (!hoverRule) {
              hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
            }
            editor.StyleManager.select(hoverRule);
          } else {
            sel.removeClass('gjs-hover-preview');
            if (componentNormalStyles[id]) {
              sel.setStyle(componentNormalStyles[id]);
              const normRule = editor.Css.getRule('#' + id);
              if (normRule) normRule.setStyle(componentNormalStyles[id]);
            }
            editor.StyleManager.select(sel);
          }

          // Clean up stale enhanced flags and elements so the newly selected state target binds cleanly
          const stylesEl = document.getElementById('styles-container');
          if (stylesEl) {
            stylesEl.querySelectorAll('.gjs-quick-swatches').forEach(s => s.remove());
            stylesEl.querySelectorAll('.gjs-native-color-picker').forEach(p => p.remove());
            stylesEl.querySelectorAll('.gjs-field-colorp').forEach(cp => {
              delete cp.dataset.colorEnhanced;
            });
          }

          refreshAllStyleProperties(editor);
          if (typeof enhanceAllColorFields === 'function') {
            enhanceAllColorFields();
          }
          enhanceStateSwitchers();
          updateStateButtonsUI(state);
        }

        function enhanceStateSwitchers() {
          const stylesEl = document.getElementById('styles-container');
          if (!stylesEl) return;

          // 1. Top Master State Toolbar
          if (!stylesEl.querySelector('.gjs-sm-state-toolbar')) {
            const toolbar = document.createElement('div');
            toolbar.className = 'gjs-sm-state-toolbar';
            toolbar.innerHTML = `
              <div class="gjs-sm-state-left">
                <span class="gjs-sm-state-title">State:</span>
                <div class="gjs-sm-state-pills">
                  <button type="button" class="gjs-master-state-btn ${activeComponentStylingState === 'normal' ? 'is-active' : ''}" data-state="normal">Normal</button>
                  <button type="button" class="gjs-master-state-btn ${activeComponentStylingState === 'hover' ? 'is-active' : ''}" data-state="hover">Hover (:hover)</button>
                </div>
              </div>
              <span class="gjs-sm-state-badge ${activeComponentStylingState === 'hover' ? 'is-hover' : ''}" id="gjsStateIndicator">
                ${activeComponentStylingState === 'hover' ? ':hover State Active' : 'Normal State'}
              </span>
            `;
            toolbar.querySelectorAll('.gjs-master-state-btn').forEach(btn => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                setComponentStylingState(btn.dataset.state);
              });
            });
            stylesEl.insertBefore(toolbar, stylesEl.firstChild);
          }

          // 2. Add normal/hover switchers directly to Sector Titles
          const sectors = stylesEl.querySelectorAll('.gjs-sm-sector');
          sectors.forEach(sector => {
            const title = sector.querySelector('.gjs-sm-sector-title');
            const label = sector.querySelector('.gjs-sm-sector-label');
            if (!title || !label || sector.querySelector('.gjs-sector-state-switch')) return;

            const labelText = label.textContent.trim().toLowerCase();
            if (
              labelText.includes('typography') ||
              labelText.includes('background') ||
              labelText.includes('color') ||
              labelText.includes('border') ||
              labelText.includes('decoration') ||
              labelText.includes('effect')
            ) {
              const switchGroup = document.createElement('div');
              switchGroup.className = 'gjs-sector-state-switch';
              switchGroup.innerHTML = `
                <button type="button" class="gjs-state-btn ${activeComponentStylingState === 'normal' ? 'is-active' : ''}" data-state="normal">normal</button>
                <button type="button" class="gjs-state-btn ${activeComponentStylingState === 'hover' ? 'is-active' : ''}" data-state="hover">hover</button>
              `;
              switchGroup.querySelectorAll('.gjs-state-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                  e.preventDefault();
                  e.stopPropagation();
                  setComponentStylingState(btn.dataset.state);
                });
              });
              title.appendChild(switchGroup);
            }
          });
        }

        editor.on('component:selected', (comp) => {
          if (!comp) return;
          if (typeof isDropzoneHelper === 'function' && isDropzoneHelper(comp)) {
            editor.selectRemove(comp);
            return;
          }
          if (comp) {
            comp.removeClass('gjs-hover-preview');
            snapshotComponentNormalStyle(comp);
          }
          updateStateButtonsUI('normal');
          setTimeout(() => {
            enhanceAllColorFields();
            enhanceStateSwitchers();
          }, 50);
        });

        editor.on('component:styleUpdate', (cmp) => {
          if (!cmp) return;
          const id = cmp.getId();

          if (activeComponentStylingState === 'hover') {
            const normalStyle = componentNormalStyles[id];
            if (!normalStyle) return;

            const currentStyle = cmp.getStyle();
            let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`) 
              || editor.Css.getRule(`#${id}:hover`);
            if (!hoverRule) {
              hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
            }

            let hasChanges = false;
            for (const key in currentStyle) {
              if (currentStyle[key] !== normalStyle[key]) {
                hoverRule.addStyle({ [key]: currentStyle[key] });
                hasChanges = true;
              }
            }

            if (hasChanges) {
              cmp.setStyle(normalStyle, { silent: true });
              const normRule = editor.Css.getRule('#' + id);
              if (normRule) normRule.setStyle(normalStyle, { silent: true });
            }
          } else {
            componentNormalStyles[id] = JSON.parse(JSON.stringify(cmp.getStyle()));
          }
        });

        editor.on('styleManager:change', () => {
          setTimeout(() => {
            enhanceAllColorFields();
            enhanceStateSwitchers();
          }, 50);
        });

        // Observer for style container changes to auto-enhance color pickers and state switchers
        const stylesObserverTarget = document.getElementById('styles-container');
        if (stylesObserverTarget) {
          const stylesObserver = new MutationObserver(() => {
            enhanceAllColorFields();
            enhanceStateSwitchers();
          });
          stylesObserver.observe(stylesObserverTarget, { childList: true, subtree: true });
        }

        // Helper predicates and suppressors to ensure dropzone buttons and hint are never detected as layers or selected
        function isDropzoneHelper(comp) {
          if (!comp) return false;
          const cls = comp.getClasses ? comp.getClasses() : [];
          const tag = (comp.get('tagName') || '').toLowerCase();
          const id = comp.getId ? comp.getId() : '';
          return cls.includes('dropzone-buttons-row') ||
                 cls.includes('dropzone-btn') ||
                 cls.includes('dropzone-hint') ||
                 cls.includes('dropzone-text') ||
                 id === 'btnDropzoneAddBlock' ||
                 id === 'btnDropzoneAddTemplate' ||
                 tag === 'svg' || tag === 'path' || tag === 'line';
        }

        function lockDropzoneComponents() {
          try {
            if (!editor || !editor.DomComponents) return;
            const wrapper = editor.DomComponents.getWrapper();
            if (!wrapper) return;
            const comps = wrapper.find('.dropzone-buttons-row, .dropzone-btn, .dropzone-hint, .dropzone-text, #btnDropzoneAddBlock, #btnDropzoneAddTemplate, svg, path, line');
            comps.forEach(c => {
              if (isDropzoneHelper(c)) {
                c.set({
                  layerable: false,
                  selectable: false,
                  hoverable: false,
                  highlightable: false,
                  badgable: false,
                  draggable: false,
                  droppable: false,
                  copyable: false,
                  removable: false
                });
              }
            });
          } catch (e) {}
        }

        function filterDropzoneLayers() {
          try {
            const container = document.getElementById('layers-container');
            if (!container) return;
            const layers = container.querySelectorAll('.gjs-layer');
            layers.forEach(layer => {
              let comp = null;
              for (const k in layer) {
                if (layer[k] && layer[k].model) {
                  comp = layer[k].model;
                  break;
                }
              }
              if (comp && isDropzoneHelper(comp)) {
                layer.style.setProperty('display', 'none', 'important');
              }
            });
          } catch (e) {}
        }

        function attachDropzoneEvents() {
          try {
            const frameDoc = editor.Canvas?.getDocument();
            if (!frameDoc) return;

            // Ensure helper components are non-layerable, non-selectable and hidden from layer tree
            lockDropzoneComponents();
            filterDropzoneLayers();

            const layersContainerEl = document.getElementById('layers-container');
            if (layersContainerEl && !layersContainerEl.__dropzoneObserverAttached) {
              layersContainerEl.__dropzoneObserverAttached = true;
              const dzLayerObserver = new MutationObserver(() => {
                filterDropzoneLayers();
              });
              dzLayerObserver.observe(layersContainerEl, { childList: true, subtree: true });
            }

            // 1. Inject dropzone dynamic CSS rules so placeholder icons & hint vanish as soon as content is inside
            if (!frameDoc.getElementById('gjs-dropzone-styles')) {
              const style = frameDoc.createElement('style');
              style.id = 'gjs-dropzone-styles';
              style.textContent = `
                .empty-workspace-dropzone:has(> :not(.dropzone-buttons-row):not(.dropzone-hint):not(.dropzone-text)) > .dropzone-buttons-row,
                .empty-workspace-dropzone:has(> :not(.dropzone-buttons-row):not(.dropzone-hint):not(.dropzone-text)) > .dropzone-hint,
                .empty-workspace-dropzone:has(> :not(.dropzone-buttons-row):not(.dropzone-hint):not(.dropzone-text)) > .dropzone-text,
                .empty-workspace-dropzone.has-content > .dropzone-buttons-row,
                .empty-workspace-dropzone.has-content > .dropzone-hint,
                .empty-workspace-dropzone.has-content > .dropzone-text {
                  display: none !important;
                }
                .empty-workspace-dropzone:has(> :not(.dropzone-buttons-row):not(.dropzone-hint):not(.dropzone-text)),
                .empty-workspace-dropzone.has-content {
                  user-select: auto !important;
                  min-height: 40px !important;
                  padding: 14px !important;
                  gap: 0 !important;
                  display: block !important;
                }
              `;
              frameDoc.head.appendChild(style);
            }

            // 2. Synchronize dropzone content state in DOM
            const dropzones = frameDoc.querySelectorAll('.empty-workspace-dropzone, #emptyWorkspaceDropzone');
            dropzones.forEach(dz => {
              const nonPlaceholderChildren = Array.from(dz.children).filter(child =>
                !child.classList.contains('dropzone-buttons-row') &&
                !child.classList.contains('dropzone-hint') &&
                !child.classList.contains('dropzone-text') &&
                !child.classList.contains('gjs-cv-canvas')
              );
              const btnRow = dz.querySelector('.dropzone-buttons-row');
              const hint = dz.querySelector('.dropzone-hint, .dropzone-text');

              if (nonPlaceholderChildren.length > 0) {
                dz.classList.add('has-content');
                if (btnRow) btnRow.style.setProperty('display', 'none', 'important');
                if (hint) hint.style.setProperty('display', 'none', 'important');
              } else {
                dz.classList.remove('has-content');
                if (btnRow) btnRow.style.removeProperty('display');
                if (hint) hint.style.removeProperty('display');
              }
            });

            if (!frameDoc.__dropzoneEventsDelegated) {
              frameDoc.__dropzoneEventsDelegated = true;
              frameDoc.addEventListener('click', (e) => {
                const btnAddBlock = e.target.closest('#btnDropzoneAddBlock, .btn-trigger-add-block');
                if (btnAddBlock) {
                  e.preventDefault();
                  e.stopPropagation();
                  const dz = btnAddBlock.closest('.empty-workspace-dropzone, #emptyWorkspaceDropzone');
                  if (typeof window.openDropzoneLayoutPicker === 'function' && dz) {
                    window.openDropzoneLayoutPicker(dz, editor);
                  } else {
                    document.querySelector('.tab-btn[data-tab="blocks"]')?.click();
                  }
                  return;
                }

                const btnAddTemplate = e.target.closest('#btnDropzoneAddTemplate, .btn-trigger-add-template');
                if (btnAddTemplate) {
                  e.preventDefault();
                  e.stopPropagation();
                  document.getElementById('btnOpenTemplatesGallery')?.click();
                  return;
                }
              }, true);
            }
          } catch(e) {
            console.warn('attachDropzoneEvents error:', e);
          }
        }

        editor.on('load', () => {
          if (typeof initLayerClipboardSystem === 'function') {
            initLayerClipboardSystem();
          }
          if (window.initContainerLayoutStyler) {
            window.initContainerLayoutStyler(editor);
