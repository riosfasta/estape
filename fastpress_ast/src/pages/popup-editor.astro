      btnApplyCodeToCanvas?.addEventListener('click', () => {
        if (!editor || !textareaPopupCode) return;

        // Save current tab content into buffer
        if (activeCodeTab === 'html') {
          codeHtmlBuffer = textareaPopupCode.value;
        } else {
          codeCssBuffer = textareaPopupCode.value;
        }

        let htmlToApply = codeHtmlBuffer.trim();
        let cssToApply = codeCssBuffer.trim();

        if (!htmlToApply && !cssToApply) {
          showToast('No code to apply', true);
          return;
        }

        try {
          // 1. Extract any <style> tags from HTML if user pasted them
          const styleRegex = /<style[^>]*>([\s\S]*?)<\/style>/gi;
          let inlineStyles = '';
          let match;
          while ((match = styleRegex.exec(htmlToApply)) !== null) {
            inlineStyles += '\n' + match[1];
          }
          if (inlineStyles.trim()) {
            htmlToApply = htmlToApply.replace(styleRegex, '').trim();
            cssToApply = (cssToApply ? cssToApply + '\n' : '') + inlineStyles.trim();
          }

          // 2. Ensure outer popup container if missing
          if (htmlToApply && !htmlToApply.includes('popup-box')) {
            htmlToApply = `<div class="popup-box" style="position: relative; overflow: hidden; padding: 28px; background: #11141c; color: #ffffff; border-radius: 16px;">${htmlToApply}</div>`;
          }

          // 3. Apply HTML components to GrapesJS
          if (htmlToApply) {
            editor.setComponents(htmlToApply);
          }

          // 4. Apply / restore CSS styles
          if (cssToApply) {
            editor.setStyle(cssToApply);
          }

          // 5. Sync active popup data model
          if (activePopup) {
            if (htmlToApply) activePopup.html = htmlToApply;
            if (cssToApply) activePopup.css = cssToApply;
          }

          // 6. Stabilize canvas layout and popup box geometry
          ensureCloseButtonInEditor();
          applyActivePopupBackgroundToCanvas();
          applyActivePopupBorderRadiusToCanvas();
          applyActivePopupBoxGeometryToCanvas();
          fitFrameHeightToContent();

