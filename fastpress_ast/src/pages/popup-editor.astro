      // Fit popup frame height tightly to content (when height === 'auto')
      function fitFrameHeightToContent() {
        setTimeout(() => {
          try {
            if (activePopup?.height && activePopup.height !== 'auto') {
              return;
            }
            const isSticky = resolvePopupPosition(activePopup?.layout).isSticky;
            const iframe = document.querySelector('#gjs-canvas iframe');
            if (iframe && iframe.contentDocument && iframe.contentDocument.body) {
              const body = iframe.contentDocument.body;
              const box = body.querySelector('.popup-box, .popup-inner') || body.firstElementChild;
              const h = box ? box.offsetHeight : body.scrollHeight;
              if (h > 40) {
                const wrapper = document.querySelector('.gjs-frame-wrapper');
                if (wrapper) {
                  const minH = isSticky ? 56 : 220;
                  const targetH = Math.min(Math.max(h + 4, minH), window.innerHeight * 0.85);
                  wrapper.style.setProperty('height', targetH + 'px', 'important');
                  iframe.style.setProperty('height', targetH + 'px', 'important');
                }
              }
            }
          } catch (e) {}
        }, 220);
      }

      // Backdrop View Switcher (Website View vs Studio Grid)
      const canvasStage = document.getElementById('canvasStage');
      const btnBackdropWeb = document.getElementById('btnBackdropWebsite');
      const btnBackdropGrid = document.getElementById('btnBackdropStudio');

      btnBackdropWeb?.addEventListener('click', () => {
        canvasStage?.classList.remove('studio-grid-mode');
        btnBackdropWeb.classList.add('active');
        btnBackdropGrid?.classList.remove('active');
        showToast('Website Preview Backdrop Enabled');
      });

      btnBackdropGrid?.addEventListener('click', () => {
        canvasStage?.classList.add('studio-grid-mode');
        btnBackdropGrid.classList.add('active');
        btnBackdropWeb?.classList.remove('active');
        showToast('Studio Grid Backdrop Enabled');
      });

      // ==========================================
      // CLOSE BUTTON STYLING HELPERS
      // ==========================================
      function populateCloseButtonControls(comp) {
        if (!comp) return;
        const style = comp.getStyle() || {};

        let computed = null;
        try {
          const frame = editor.Canvas.getFrameEl();
          const doc = frame?.contentDocument;
          const domEl = doc?.getElementById(comp.getId()) || doc?.querySelector('.popup-close-trigger, .fastpress-popup-close-btn');
          if (domEl) computed = window.getComputedStyle(domEl);
        } catch (e) {}

        const bg = style['background-color'] || style['background'] || computed?.backgroundColor || 'rgba(0, 0, 0, 0.45)';
        const color = style['color'] || computed?.color || '#ffffff';
        const borderColor = style['border-color'] || computed?.borderColor || 'rgba(255, 255, 255, 0.25)';
        const borderWidth = style['border-width'] || computed?.borderWidth || '1px';
        const width = style['width'] || computed?.width || '34px';
        const radius = style['border-radius'] || computed?.borderRadius || '50%';

        const inpBg = document.getElementById('inpCloseBgVal');
        if (inpBg) inpBg.value = bg;
        const pickerBg = document.getElementById('pickerCloseBg');
        if (pickerBg && bg.startsWith('#')) pickerBg.value = bg;

        const inpColor = document.getElementById('inpCloseColorVal');
        if (inpColor) inpColor.value = color;
        const pickerColor = document.getElementById('pickerCloseColor');
        if (pickerColor && color.startsWith('#')) pickerColor.value = color;

        const inpBorder = document.getElementById('inpCloseBorderVal');
        if (inpBorder) inpBorder.value = borderColor;
        const pickerBorder = document.getElementById('pickerCloseBorder');
        if (pickerBorder && borderColor.startsWith('#')) pickerBorder.value = borderColor;

        const selBorderWidth = document.getElementById('selCloseBorderWidth');
        if (selBorderWidth) selBorderWidth.value = borderWidth;

        // Sync size pills
        document.querySelectorAll('#closeSizePills .close-choice-pill').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.size === width);
        });

        // Sync radius pills
        document.querySelectorAll('#closeRadiusPills .close-choice-pill').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.radius === radius);
        });

        // Sync position chips
        const activePos = activePopup?.closePosition || 'right';
        document.querySelectorAll('.close-card-pos').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.pos === activePos);
        });

        // Sync symbol
        let content = '';
        try {
          content = comp.getInnerHTML ? comp.getInnerHTML() : (comp.components ? comp.components().models.map(m => m.get('content') || '').join('') : '');
        } catch (e) {}
        const inpSymbol = document.getElementById('inpCloseCustomSymbol');
        if (inpSymbol) inpSymbol.value = content || '×';

        document.querySelectorAll('.close-symbol-chip').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.symbol === content);
        });
      }

