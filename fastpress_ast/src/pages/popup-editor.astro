      // ===============================================
      // POPUP MODAL BACKGROUND & MEDIA CONTROLS
      // ===============================================
      function getModalPopupBoxComp() {
        if (!editor) return null;
        const wrapper = editor.getWrapper();
        return wrapper?.find('.popup-box')[0] || wrapper?.components().at(0) || wrapper;
      }

      function applyModalBackground(type, options = {}) {
        const popupBox = getModalPopupBoxComp();
        if (!popupBox) return;

        popupBox.addStyle({
          'position': 'relative',
          'overflow': 'hidden'
        });

        // If not video, remove any existing video background layer
        if (type !== 'video') {
          const videoWraps = popupBox.find('.popup-video-bg-wrap');
          if (videoWraps && videoWraps.length > 0) {
            videoWraps.forEach(w => w.remove());
          }
        }

        if (!activePopup.background) activePopup.background = {};
        activePopup.background.type = type;

        if (type === 'color') {
          const isGradient = !!options.isGradient;
          const color = options.color || '#11141c';
          const blur = options.blur || '0';

          popupBox.addStyle({
            'background': color,
            'background-image': isGradient ? color : 'none',
            'backdrop-filter': blur !== '0' ? `blur(${blur})` : 'none',
            '-webkit-backdrop-filter': blur !== '0' ? `blur(${blur})` : 'none'
          });

          activePopup.background.color = color;
          activePopup.background.isGradient = isGradient;
          activePopup.background.blur = blur;
        } else if (type === 'image') {
          const imageUrl = options.imageUrl || '';
          const fit = options.size || 'cover';
          const position = options.position || 'center center';
          const opacity = typeof options.overlayOpacity === 'number' ? options.overlayOpacity : 50;
          const overlayAlpha = (opacity / 100).toFixed(2);
          const overlayColor = `rgba(0, 0, 0, ${overlayAlpha})`;

          if (imageUrl) {
            popupBox.addStyle({
              'background-image': `linear-gradient(${overlayColor}, ${overlayColor}), url("${imageUrl}")`,
              'background-size': fit,
              'background-position': position,
              'background-repeat': fit === 'repeat' ? 'repeat' : 'no-repeat'
            });
          }

          activePopup.background.imageUrl = imageUrl;
          activePopup.background.size = fit;
          activePopup.background.position = position;
          activePopup.background.overlayOpacity = opacity;
        } else if (type === 'video') {
          const videoUrl = options.videoUrl || '';
          const opacity = typeof options.overlayOpacity === 'number' ? options.overlayOpacity : 60;
          const overlayAlpha = (opacity / 100).toFixed(2);

          popupBox.addStyle({
            'background-color': '#000000',
            'background-image': 'none'
          });

          let videoWrap = popupBox.find('.popup-video-bg-wrap')[0];
          if (!videoWrap) {
            const videoHtml = `
              <div class="popup-video-bg-wrap" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; z-index: 0;">
                <video autoplay loop muted playsinline style="position: absolute; top: 50%; left: 50%; min-width: 100%; min-height: 100%; width: auto; height: auto; transform: translate(-50%, -50%); object-fit: cover;">
                  <source src="${videoUrl}" type="video/mp4" />
                </video>
                <div class="popup-video-overlay" style="position: absolute; inset: 0; background: rgba(0, 0, 0, ${overlayAlpha});"></div>
              </div>
            `;
            popupBox.append(videoHtml, { at: 0 });
          } else {
            const v = videoWrap.find('video')[0];
            if (v) {
              const srcEl = v.find('source')[0];
              if (srcEl) srcEl.set('attributes', { src: videoUrl, type: 'video/mp4' });
            }
            const overlay = videoWrap.find('.popup-video-overlay')[0];
            if (overlay) {
              overlay.addStyle({ 'background': `rgba(0, 0, 0, ${overlayAlpha})` });
            }
          }

          popupBox.components().forEach(child => {
            if (!child.hasClass('popup-video-bg-wrap')) {
              const cs = child.getStyle() || {};
              if (!cs['z-index'] || cs['z-index'] === '0') {
                child.addStyle({ 'position': 'relative', 'z-index': '1' });
              }
            }
          });

          activePopup.background.videoUrl = videoUrl;
          activePopup.background.overlayOpacity = opacity;
        }

        // Keep frame wrapper and iframe body background synced
        applyActivePopupBackgroundToCanvas();
      }

      function populateModalBackgroundUI() {
        if (!activePopup) return;
        const bg = activePopup.background || {};
        const type = bg.type || 'color';

        document.querySelectorAll('.bg-mode-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.bgmode === type);
        });

        document.querySelectorAll('.bg-subpane').forEach(p => p.style.display = 'none');
        const badge = document.getElementById('badgeBgType');
        if (badge) badge.textContent = type;

        if (type === 'color') {
          const pane = document.getElementById('paneBgColor');
          if (pane) pane.style.display = 'block';

          const isGrad = !!bg.isGradient;
          document.querySelectorAll('.bg-color-type-btn').forEach(btn => {
            btn.classList.toggle('active', (btn.dataset.colortype === 'gradient') === isGrad);
          });
          const solidPane = document.getElementById('subpaneColorSolid');
          const gradPane = document.getElementById('subpaneColorGradient');
          if (solidPane) solidPane.style.display = isGrad ? 'none' : 'block';
          if (gradPane) gradPane.style.display = isGrad ? 'block' : 'none';

          if (isGrad) {
            const inp = document.getElementById('inpModalBgGradient');
            if (inp) inp.value = bg.color || '';
          } else {
            const inp = document.getElementById('inpModalBgColor');
            if (inp) inp.value = bg.color || '#11141c';
            const picker = document.getElementById('pickerModalBgColor');
            if (picker && (bg.color || '').startsWith('#')) picker.value = bg.color;
          }

          const blur = bg.blur || '0';
          document.querySelectorAll('.bg-blur-chip').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.blur === blur);
          });
        } else if (type === 'image') {
          const pane = document.getElementById('paneBgImage');
          if (pane) pane.style.display = 'block';

          const inpUrl = document.getElementById('inpModalBgImageUrl');
          if (inpUrl) inpUrl.value = bg.imageUrl || '';
