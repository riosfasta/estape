      const DEVICE_LABELS = {
        btnDeviceStandard: 'Standard (540px)',
        btnDeviceCompact: 'Compact (440px)',
        btnDeviceWide: 'Wide (680px)',
        btnDeviceMobile: 'Mobile (360px)',
        btnDeviceFull: 'Full Width (100%)',
      };

      function updateDeviceButtonsActive(activeId, customLabel = '') {
        ['btnDeviceStandard', 'btnDeviceCompact', 'btnDeviceWide', 'btnDeviceMobile', 'btnDeviceFull'].forEach(id => {
          const btn = document.getElementById(id);
          if (btn) {
            if (id === activeId) btn.classList.add('active');
            else btn.classList.remove('active');
          }
        });
        const lbl = document.getElementById('deviceActiveLabel');
        if (lbl) lbl.textContent = customLabel || DEVICE_LABELS[activeId] || 'Standard (540px)';
      }

      function normalizeCssLength(raw, fallback = '0px') {
        if (raw === undefined || raw === null) return fallback;
        const val = String(raw).trim();
        if (!val) return fallback;
        if (val.toLowerCase() === 'auto') return 'auto';
        if (/^-?\d+(\.\d+)?$/.test(val)) return `${val}px`;
        return val;
      }

      function getNormalizedMarginObject(marginVal) {
        if (!marginVal) return { top: '0px', right: '0px', bottom: '0px', left: '0px' };
        if (typeof marginVal === 'string') {
          const parts = marginVal.trim().split(/\s+/).filter(Boolean);
          if (parts.length === 0) return { top: '0px', right: '0px', bottom: '0px', left: '0px' };
          if (parts.length === 1) {
            const v = normalizeCssLength(parts[0], '0px');
            return { top: v, right: v, bottom: v, left: v };
          }
          if (parts.length === 2) {
            const v = normalizeCssLength(parts[0], '0px');
            const h = normalizeCssLength(parts[1], '0px');
            return { top: v, right: h, bottom: v, left: h };
          }
          if (parts.length === 3) {
            return {
              top: normalizeCssLength(parts[0], '0px'),
              right: normalizeCssLength(parts[1], '0px'),
              bottom: normalizeCssLength(parts[2], '0px'),
              left: normalizeCssLength(parts[1], '0px'),
            };
          }
          return {
            top: normalizeCssLength(parts[0], '0px'),
            right: normalizeCssLength(parts[1], '0px'),
            bottom: normalizeCssLength(parts[2], '0px'),
            left: normalizeCssLength(parts[3], '0px'),
          };
        }
        return {
          top: normalizeCssLength(marginVal.top, '0px'),
          right: normalizeCssLength(marginVal.right, '0px'),
          bottom: normalizeCssLength(marginVal.bottom, '0px'),
          left: normalizeCssLength(marginVal.left, '0px'),
        };
      }

      function applyPopupWidthToEditor(rawWidth, { skipCanvasSync = false } = {}) {
        const w = normalizeCssLength(rawWidth, '540px');
        if (activePopup) activePopup.width = w;

        if (editor) {
          if (w === '440px' || w === '480px') {
            editor.setDevice('compact');
            updateDeviceButtonsActive('btnDeviceCompact');
          } else if (w === '680px' || w === '720px') {
            editor.setDevice('wide');
            updateDeviceButtonsActive('btnDeviceWide');
          } else if (w === '360px' || w === '375px') {
            editor.setDevice('mobile');
            updateDeviceButtonsActive('btnDeviceMobile');
          } else if (w === '100%' || w === '100vw') {
            editor.setDevice('full');
            updateDeviceButtonsActive('btnDeviceFull');
          } else if (w === '540px') {
            editor.setDevice('standard');
            updateDeviceButtonsActive('btnDeviceStandard');
          } else {
            editor.setDevice(w.endsWith('%') || w.endsWith('vw') ? 'full' : 'standard');
            updateDeviceButtonsActive('', `Custom (${w})`);
          }
        }

        if (!skipCanvasSync) {
          requestAnimationFrame(() => {
            applyActivePopupBoxGeometryToCanvas();
            populateLayoutAndDimensionsUI();
          });
        }
      }

      const POPUP_POSITION_MAP = {
        'center':        { canonical: 'center',        v: 'center', h: 'center', isSticky: false, label: 'Center' },
        'top-left':      { canonical: 'top-left',      v: 'top',    h: 'left',   isSticky: true,  label: 'Top Left' },
        'top-center':    { canonical: 'top-center',    v: 'top',    h: 'center', isSticky: true,  label: 'Top Center' },
        'top-right':     { canonical: 'top-right',     v: 'top',    h: 'right',  isSticky: true,  label: 'Top Right' },
        'bottom-left':   { canonical: 'bottom-left',   v: 'bottom', h: 'left',   isSticky: true,  label: 'Bottom Left' },
        'bottom-center': { canonical: 'bottom-center', v: 'bottom', h: 'center', isSticky: true,  label: 'Bottom Center' },
        'bottom-right':  { canonical: 'bottom-right',  v: 'bottom', h: 'right',  isSticky: true,  label: 'Bottom Right' },
        'sticky-top':    { canonical: 'top-center',    v: 'top',    h: 'center', isSticky: true,  label: 'Top Center' },
        'top-bar':       { canonical: 'top-center',    v: 'top',    h: 'center', isSticky: true,  label: 'Top Center' },
        'sticky-bottom': { canonical: 'bottom-center', v: 'bottom', h: 'center', isSticky: true,  label: 'Bottom Center' },
        'slide-right':   { canonical: 'bottom-right',  v: 'bottom', h: 'right',  isSticky: true,  label: 'Bottom Right' },
      };

      function resolvePopupPosition(rawLayout) {
        return POPUP_POSITION_MAP[rawLayout || 'center'] || POPUP_POSITION_MAP['center'];
      }

      function applyActivePopupBoxGeometryToCanvas() {
        const pos = resolvePopupPosition(activePopup?.layout);
        const isSticky = pos.isSticky;
        const showBackdrop = typeof activePopup?.showBackdrop === 'boolean' ? activePopup.showBackdrop : !isSticky;

        const widthVal = normalizeCssLength(activePopup?.width, '540px');
        const isFullWidth = widthVal === '100%' || widthVal === '100vw';
        const heightVal = normalizeCssLength(activePopup?.height, 'auto');
        const hasCustomHeight = Boolean(heightVal && heightVal !== 'auto');
        const m = getNormalizedMarginObject(activePopup?.margin);
        const canCalcH = m.left !== 'auto' && m.right !== 'auto';
        const canCalcV = m.top !== 'auto' && m.bottom !== 'auto';

        // Simulated page backdrop overlay in canvas stage
        const simOverlay = document.getElementById('simDimOverlay');
        if (simOverlay) simOverlay.style.opacity = showBackdrop ? '1' : '0';

        // Stage floating badge placement & status summary
        const pill = document.getElementById('stageInfoPill');
        const pillText = document.getElementById('stageInfoText');
        if (pill) pill.classList.toggle('pill-bottom', pos.v === 'top');
        if (pillText) {
          const marginLabel = (m.top === m.right && m.right === m.bottom && m.bottom === m.left)
            ? m.top
            : `${m.top} ${m.right} ${m.bottom} ${m.left}`;
          pillText.textContent = `${pos.label} • ${widthVal} × ${heightVal}${marginLabel !== '0px' ? ` • m:${marginLabel}` : ''}`;
        }

        const wrapper = document.querySelector('.gjs-frame-wrapper');
        const iframe = document.querySelector('#gjs-canvas iframe');
        if (!wrapper || !iframe) return;

        // Vertical placement (top, bottom, center) + margins
        if (pos.v === 'top') {
          wrapper.style.setProperty('top', m.top, 'important');
          wrapper.style.setProperty('bottom', 'auto', 'important');
          wrapper.style.setProperty('margin-top', '0px', 'important');
          wrapper.style.setProperty('margin-bottom', '0px', 'important');
        } else if (pos.v === 'bottom') {
          wrapper.style.setProperty('top', 'auto', 'important');
          wrapper.style.setProperty('bottom', m.bottom, 'important');
          wrapper.style.setProperty('margin-top', '0px', 'important');
          wrapper.style.setProperty('margin-bottom', '0px', 'important');
        } else {
          wrapper.style.setProperty('top', m.top !== '0px' ? m.top : (hasCustomHeight && heightVal === '100vh' ? '12px' : '50px'), 'important');
          wrapper.style.setProperty('bottom', m.bottom !== '0px' ? m.bottom : (hasCustomHeight && heightVal === '100vh' ? '12px' : '30px'), 'important');
          wrapper.style.setProperty('margin-top', 'auto', 'important');
          wrapper.style.setProperty('margin-bottom', 'auto', 'important');
        }

        // Horizontal placement (left, center, right) + width + margins
        const maxWExpr = canCalcH ? `calc(100% - (${m.left} + ${m.right}))` : '100%';
        if (isFullWidth) {
          wrapper.style.setProperty('width', maxWExpr, 'important');
          wrapper.style.setProperty('max-width', 'none', 'important');
          wrapper.style.setProperty('left', m.left === 'auto' ? '0px' : m.left, 'important');
          wrapper.style.setProperty('right', m.right === 'auto' ? '0px' : m.right, 'important');
          wrapper.style.setProperty('margin-left', m.left === 'auto' ? 'auto' : '0px', 'important');
          wrapper.style.setProperty('margin-right', m.right === 'auto' ? 'auto' : '0px', 'important');
        } else {
          wrapper.style.setProperty('width', widthVal, 'important');
          wrapper.style.setProperty('max-width', maxWExpr, 'important');
          if (pos.h === 'left') {
            wrapper.style.setProperty('left', m.left === 'auto' ? '0px' : m.left, 'important');
            wrapper.style.setProperty('right', 'auto', 'important');
            wrapper.style.setProperty('margin-left', m.left === 'auto' ? 'auto' : '0px', 'important');
            wrapper.style.setProperty('margin-right', '0px', 'important');
          } else if (pos.h === 'right') {
            wrapper.style.setProperty('left', 'auto', 'important');
            wrapper.style.setProperty('right', m.right === 'auto' ? '0px' : m.right, 'important');
            wrapper.style.setProperty('margin-left', '0px', 'important');
            wrapper.style.setProperty('margin-right', m.right === 'auto' ? 'auto' : '0px', 'important');
          } else {
            wrapper.style.setProperty('left', m.left === 'auto' ? '0px' : m.left, 'important');
            wrapper.style.setProperty('right', m.right === 'auto' ? '0px' : m.right, 'important');
            wrapper.style.setProperty('margin-left', 'auto', 'important');
            wrapper.style.setProperty('margin-right', 'auto', 'important');
          }
        }

        // Custom Height & inner body fill
        const doc = iframe.contentDocument;
        const body = doc?.body;
        const boxEl = body?.querySelector('.popup-box');
        if (hasCustomHeight) {
          const previewH = heightVal === '100vh'
            ? (canCalcV ? `calc(100% - (${m.top} + ${m.bottom}))` : '100%')
            : heightVal;
          const maxStageH = isSticky
            ? (canCalcV ? `calc(100% - (${m.top} + ${m.bottom}))` : '100%')
            : (canCalcV ? `calc(100% - (${m.top !== '0px' ? m.top : '24px'} + ${m.bottom !== '0px' ? m.bottom : '24px'}))` : 'calc(100vh - 120px)');
          wrapper.style.setProperty('max-height', maxStageH, 'important');
          wrapper.style.setProperty('height', previewH, 'important');
          iframe.style.setProperty('height', '100%', 'important');
          if (body) {
            body.style.setProperty('min-height', '100%', 'important');
            body.style.setProperty('overflow-y', 'auto', 'important');
          }
          if (boxEl) boxEl.style.setProperty('min-height', '100%', 'important');
        } else {
          const maxStageH = isSticky
            ? (canCalcV ? `calc(100% - (${m.top} + ${m.bottom}))` : '100%')
            : 'calc(100vh - 190px)';
          wrapper.style.setProperty('max-height', maxStageH, 'important');
          if (body) body.style.removeProperty('min-height');
          if (boxEl) boxEl.style.removeProperty('min-height');
          fitFrameHeightToContent();
        }
      }

      function populateLayoutAndDimensionsUI() {
        if (!activePopup) return;

        // 1. Position / Sticky layout
        const pos = resolvePopupPosition(activePopup.layout);
        const badgeLayout = document.getElementById('badgePopupLayout');
        if (badgeLayout) badgeLayout.textContent = pos.label;

        document.querySelectorAll('.setting-layout-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.layout === pos.canonical);
        });

        const chkBackdrop = document.getElementById('chkShowBackdrop');
        if (chkBackdrop) {
          chkBackdrop.checked = typeof activePopup.showBackdrop === 'boolean' ? activePopup.showBackdrop : !pos.isSticky;
        }

        // 2. Width
        const w = normalizeCssLength(activePopup.width, '540px');
        const badgeWidth = document.getElementById('badgePopupWidth');
        if (badgeWidth) badgeWidth.textContent = w;

        const inpWidth = document.getElementById('inpModalWidth');
        if (inpWidth && document.activeElement !== inpWidth) inpWidth.value = w;

        document.querySelectorAll('.setting-width-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.width === w);
        });
        const btnQuickFull = document.getElementById('btnQuickFullWidth');
        if (btnQuickFull) btnQuickFull.classList.toggle('active', w === '100%' || w === '100vw');

        // 3. Height
        const h = normalizeCssLength(activePopup.height, 'auto');
        const badgeHeight = document.getElementById('badgePopupHeight');
        if (badgeHeight) badgeHeight.textContent = h;

        const inpHeight = document.getElementById('inpModalHeight');
        if (inpHeight && document.activeElement !== inpHeight) inpHeight.value = h;

        document.querySelectorAll('.setting-height-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.height === h);
        });

        const rngHeight = document.getElementById('rngModalHeight');
        const pxH = h.match(/^(\d+(?:\.\d+)?)px$/);
        if (rngHeight && pxH) {
          rngHeight.value = Math.min(900, Math.max(50, Math.round(parseFloat(pxH[1]))));
        }

        // 4. Margin
        const m = getNormalizedMarginObject(activePopup.margin);
        const uniform = (m.top === m.right && m.right === m.bottom && m.bottom === m.left) ? m.top : null;
        const badgeMargin = document.getElementById('badgePopupMargin');
        if (badgeMargin) badgeMargin.textContent = uniform || `${m.top} ${m.right} ${m.bottom} ${m.left}`;

        document.querySelectorAll('.setting-margin-btn').forEach(btn => {
          btn.classList.toggle('active', uniform !== null && btn.dataset.margin === uniform);
        });

        const mTopEl = document.getElementById('inpMarginTop');
        const mRightEl = document.getElementById('inpMarginRight');
        const mBottomEl = document.getElementById('inpMarginBottom');
        const mLeftEl = document.getElementById('inpMarginLeft');
        if (mTopEl && document.activeElement !== mTopEl) mTopEl.value = m.top;
        if (mRightEl && document.activeElement !== mRightEl) mRightEl.value = m.right;
        if (mBottomEl && document.activeElement !== mBottomEl) mBottomEl.value = m.bottom;
        if (mLeftEl && document.activeElement !== mLeftEl) mLeftEl.value = m.left;
      }

      // Ensure close button exists in editor canvas with perfectly centered SVG
      function ensureCloseButtonInEditor() {
        if (!editor || !activePopup) return;
        if (activePopup.showCloseButton === false) return;

        const wrapper = editor.getWrapper();
        let closeBtns = wrapper.find('.popup-close-trigger:not(.popup-dismiss-link), .fastpress-popup-close-btn, [data-role="popup-close-btn"], button[data-close-popup="true"]:not(.popup-dismiss-link)');
        const pos = activePopup.closePosition || 'right';

        const CLOSE_SVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: block; margin: auto; pointer-events: none;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;

        // If multiple close buttons exist, keep only the one inside .popup-box and remove duplicates
        if (closeBtns && closeBtns.length > 1) {
          let chosen = closeBtns.find(b => {
            const p = b.parent ? b.parent() : null;
            return p && (p.getClasses && p.getClasses().includes('popup-box'));
          }) || closeBtns[0];

          closeBtns.forEach(b => {
            if (b !== chosen) {
              b.remove();
            }
          });
          closeBtns = [chosen];
        }

        const btnStyles = {
          position: 'absolute',
          top: '14px',
          left: pos === 'left' ? '14px' : (pos === 'center' ? '50%' : 'auto'),
          right: pos === 'right' ? '14px' : 'auto',
          transform: pos === 'center' ? 'translateX(-50%)' : 'none',
          'z-index': '50',
          width: '34px',
          height: '34px',
          'min-width': '34px',
          'min-height': '34px',
          background: 'rgba(0, 0, 0, 0.45)',
          'backdrop-filter': 'blur(8px)',
          '-webkit-backdrop-filter': 'blur(8px)',
          border: '1px solid rgba(255, 255, 255, 0.25)',
          color: '#ffffff',
          'border-radius': '50%',
          display: 'flex',
          'align-items': 'center',
          'justify-content': 'center',
          padding: '0px',
          margin: '0px',
          'line-height': '0',
          'box-sizing': 'border-box',
          cursor: 'pointer'
        };

        if (!closeBtns || closeBtns.length === 0) {
          const closeBtnHtml = `
            <button type="button" data-close-popup="true" data-role="popup-close-btn" class="popup-close-trigger pos-${pos}" id="fastpress-close-btn" style="position: absolute; top: 14px; ${pos === 'left' ? 'left: 14px; right: auto;' : (pos === 'center' ? 'left: 50%; right: auto; transform: translateX(-50%);' : 'right: 14px; left: auto;')} width: 34px; height: 34px; background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.25); color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; padding: 0; margin: 0; line-height: 0; cursor: pointer; z-index: 50;">
              ${CLOSE_SVG}
            </button>
          `;
          const popupBox = wrapper.find('.popup-box')[0];
          if (popupBox) {
            popupBox.append(closeBtnHtml, { at: 0 });
          } else {
            wrapper.append(closeBtnHtml, { at: 0 });
          }
        } else {
          const b = closeBtns[0];
          b.removeClass(['pos-left', 'pos-center', 'pos-right']);
          b.addClass(`pos-${pos}`);
          b.setStyle(btnStyles);
          const bHtml = b.toHTML ? b.toHTML() : '';
          if (!bHtml.includes('<svg')) {
            b.components(CLOSE_SVG);
          }
        }
      }

      // Synchronize activePopup.background directly with editor canvas shell
      function applyActivePopupBackgroundToCanvas() {
        if (!activePopup) return;
        const bg = activePopup.background || { type: 'color', color: '#11141c' };
        const frameWrapper = document.querySelector('.gjs-frame-wrapper');
        const iframe = document.querySelector('#gjs-canvas iframe');
        const doc = iframe?.contentDocument;
        const body = doc?.body;

        let bgVal = '#11141c';
        let bgImg = 'none';

        if (bg.type === 'color') {
          bgVal = bg.color || '#11141c';
          bgImg = bg.isGradient ? (bg.color || '#11141c') : 'none';
        } else if (bg.type === 'image' && bg.imageUrl) {
          const alpha = (((bg.overlayOpacity ?? 50) / 100)).toFixed(2);
          bgImg = `linear-gradient(rgba(0,0,0,${alpha}), rgba(0,0,0,${alpha})), url("${bg.imageUrl}")`;
          bgVal = '#11141c';
        } else if (bg.type === 'video') {
          bgVal = '#000000';
          bgImg = 'none';
        }

        if (frameWrapper) {
          frameWrapper.style.setProperty('background', bgVal, 'important');
          frameWrapper.style.setProperty('background-color', bgVal, 'important');
          frameWrapper.style.setProperty('background-image', bgImg, 'important');
          if (bg.type === 'image') {
            frameWrapper.style.setProperty('background-size', bg.size || 'cover', 'important');
            frameWrapper.style.setProperty('background-position', bg.position || 'center center', 'important');
            frameWrapper.style.setProperty('background-repeat', bg.size === 'repeat' ? 'repeat' : 'no-repeat', 'important');
          }
        }

        if (body) {
          body.style.setProperty('background', bgVal, 'important');
          body.style.setProperty('background-color', bgVal, 'important');
          body.style.setProperty('background-image', bgImg, 'important');
          if (bg.type === 'image') {
            body.style.setProperty('background-size', bg.size || 'cover', 'important');
            body.style.setProperty('background-position', bg.position || 'center center', 'important');
            body.style.setProperty('background-repeat', bg.size === 'repeat' ? 'repeat' : 'no-repeat', 'important');
          }
        }
      }

      function normalizeBorderRadiusValue(raw) {
        if (raw === undefined || raw === null) return '16px';
        const val = String(raw).trim();
        if (!val) return '16px';
        return val
          .split(/\s+/)
          .filter(Boolean)
          .map(t => (/^\d+(\.\d+)?$/.test(t) ? `${t}px` : t))
          .join(' ');
      }

      function applyActivePopupBorderRadiusToCanvas(customVal) {
        if (!activePopup && customVal === undefined) return;
        const radiusVal = normalizeBorderRadiusValue(
          customVal !== undefined
            ? customVal
            : (activePopup?.borderRadius ?? activePopup?.styles?.borderRadius ?? '16px')
        );

        if (activePopup) {
          activePopup.borderRadius = radiusVal;
          if (!activePopup.styles) activePopup.styles = {};
          activePopup.styles.borderRadius = radiusVal;
        }

        document.documentElement.style.setProperty('--fp-popup-radius', radiusVal);

        const frameWrapper = document.querySelector('.gjs-frame-wrapper');
        const iframe = document.querySelector('#gjs-canvas iframe');
        if (frameWrapper) frameWrapper.style.setProperty('border-radius', radiusVal, 'important');
        if (iframe) iframe.style.setProperty('border-radius', radiusVal, 'important');

        const doc = iframe?.contentDocument;
        const body = doc?.body;
        if (body) {
          body.style.setProperty('border-radius', radiusVal, 'important');
          body.style.setProperty('overflow', 'hidden', 'important');
          const boxEl = body.querySelector('.popup-box');
          if (boxEl) {
            boxEl.style.setProperty('border-radius', radiusVal, 'important');
          }
        }

        if (editor) {
          try {
            const wrapper = editor.getWrapper();
            const popupBox = wrapper?.find('.popup-box')[0];
            if (popupBox) {
              const attrs = { ...(popupBox.getAttributes() || {}) };
              if (attrs.style && /border-radius\s*:/i.test(attrs.style)) {
                attrs.style = attrs.style.replace(/border-radius\s*:[^;]+;?/gi, '').trim();
                popupBox.setAttributes(attrs);
              }
              popupBox.addStyle({ 'border-radius': radiusVal });
            }
          } catch (e) {}
        }
      }

      function populateBorderRadiusUI(preserveIndividualToggle = false) {
        if (!activePopup) return;
        const r = normalizeBorderRadiusValue(activePopup.borderRadius ?? activePopup.styles?.borderRadius ?? '16px');

        const badge = document.getElementById('badgeBorderRadius');
        if (badge) badge.textContent = r;

        const inp = document.getElementById('inpModalBorderRadius');
        if (inp && document.activeElement !== inp) inp.value = r;

        document.querySelectorAll('.setting-radius-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.radius === r);
        });

        const rng = document.getElementById('rngModalBorderRadius');
        const pxMatch = r.match(/^(\d+(?:\.\d+)?)px$/);
        if (rng && pxMatch) {
          rng.value = Math.min(60, Math.max(0, Math.round(parseFloat(pxMatch[1]))));
        }

        const parts = r.split(/\s+/).filter(Boolean);
        const chkIndiv = document.getElementById('chkIndividualCorners');
        const indivWrap = document.getElementById('individualCornersWrap');
        const tl = document.getElementById('inpCornerTL');
        const tr = document.getElementById('inpCornerTR');
        const br = document.getElementById('inpCornerBR');
        const bl = document.getElementById('inpCornerBL');

        if (parts.length > 1) {
          if (chkIndiv) chkIndiv.checked = true;
          if (indivWrap) indivWrap.style.display = 'grid';
          if (tl && document.activeElement !== tl) tl.value = parts[0] || '16px';
          if (tr && document.activeElement !== tr) tr.value = parts[1] || parts[0] || '16px';
          if (br && document.activeElement !== br) br.value = parts[2] || parts[0] || '16px';
          if (bl && document.activeElement !== bl) bl.value = parts[3] || parts[1] || parts[0] || '16px';
        } else {
          if (!preserveIndividualToggle) {
            if (chkIndiv) chkIndiv.checked = false;
            if (indivWrap) indivWrap.style.display = 'none';
          }
          if (tl && document.activeElement !== tl) tl.value = r;
          if (tr && document.activeElement !== tr) tr.value = r;
          if (br && document.activeElement !== br) br.value = r;
          if (bl && document.activeElement !== bl) bl.value = r;
        }
      }

      // Load active popup content into GrapesJS
      function loadActivePopupIntoEditor() {
        if (!editor || !activePopup) return;

        if (activePopup.html) {
          editor.setComponents(activePopup.html);
        } else {
          editor.setComponents(SAMPLE_TEMPLATES[0].html);
        }

        if (activePopup.css) {
          editor.setStyle(activePopup.css);
        }

        // Adjust device width based on popup.width
        applyPopupWidthToEditor(activePopup.width || '540px', { skipCanvasSync: true });

        syncStateToInputs();
        ensureCloseButtonInEditor();
        applyActivePopupBackgroundToCanvas();
        applyActivePopupBorderRadiusToCanvas();
        applyActivePopupBoxGeometryToCanvas();
        populateModalBackgroundUI();
      }

      // Sync state to sidebar & modal inputs
      function syncStateToInputs() {
        if (!activePopup) return;

        // Name & Status
        document.getElementById('inpSidebarPopupName').value = activePopup.name || 'Untitled Popup';
        document.getElementById('selPopupStatus').value = activePopup.status || 'published';
        document.getElementById('activePopupTitleText').textContent = activePopup.name || 'Untitled Popup';
        document.getElementById('activePopupStatusDot').className = `status-dot ${activePopup.status === 'published' ? 'published' : 'draft'}`;

        // Close Button Position & Visibility in Settings Tab
        const closePos = activePopup.closePosition || 'right';
        document.querySelectorAll('.close-pos-btn').forEach(b => {
          if (b.dataset.pos === closePos) b.classList.add('active');
          else b.classList.remove('active');
        });
        const chkShowClose = document.getElementById('chkShowCloseBtn');
        if (chkShowClose) chkShowClose.checked = activePopup.showCloseButton !== false;

        // Triggers in Settings Tab
        const tr = activePopup.triggers || {};
        document.getElementById('chkSidebarTimeEnabled').checked = tr.timeEnabled !== false;
        document.getElementById('inpSidebarTimeDelay').value = tr.timeDelay || 5;
        document.getElementById('chkSidebarScrollEnabled').checked = tr.scrollEnabled !== false;
        document.getElementById('rngSidebarScrollPercent').value = tr.scrollPercent || 50;
        document.getElementById('txtSidebarScrollPercent').textContent = (tr.scrollPercent || 50) + '%';

        // Visitor Frequency in Settings Tab
        const selFreq = document.getElementById('selSidebarFrequency');
        if (selFreq) selFreq.value = activePopup.frequency || 'session';

        // Audience Targeting in Settings Tab
        const tg = activePopup.targeting || {};
        const selPages = document.getElementById('selSidebarTargetPages');
        if (selPages) selPages.value = tg.targetPages || 'all';
        const wrapPages = document.getElementById('wrapSidebarPages');
        if (wrapPages) wrapPages.style.display = tg.targetPages === 'specific' ? 'block' : 'none';

        const selPosts = document.getElementById('selSidebarTargetPosts');
        if (selPosts) selPosts.value = tg.targetPosts || 'all';
        const wrapPosts = document.getElementById('wrapSidebarPosts');
        if (wrapPosts) wrapPosts.style.display = tg.targetPosts === 'specific' ? 'block' : 'none';

        const selCats = document.getElementById('selSidebarTargetCategories');
        if (selCats) selCats.value = tg.targetCategories || 'all';
        const wrapCats = document.getElementById('wrapSidebarCategories');
        if (wrapCats) wrapCats.style.display = tg.targetCategories === 'specific' ? 'block' : 'none';

        populateTargetingLists();
        populateModalBackgroundUI();
        populateBorderRadiusUI();
        populateLayoutAndDimensionsUI();
      }

      function populateTargetingLists() {
        const tg = activePopup?.targeting || {};

        // Pages
        const pBox = document.getElementById('listSidebarPages');
        if (pBox) {
          pBox.innerHTML = '';
          pagesList.forEach(p => {
            const isChecked = tg.specificPages?.includes(p.slug);
            const label = document.createElement('label');
            label.className = 'target-check-item';
            label.innerHTML = `
              <input type="checkbox" class="chk-sidebar-target-page" value="${p.slug}" ${isChecked ? 'checked' : ''} />
              <span>${p.title} (${p.url})</span>
            `;
            pBox.appendChild(label);
          });
        }

        // Posts
        const postBox = document.getElementById('listSidebarPosts');
        if (postBox) {
          postBox.innerHTML = '';
          postsList.forEach(p => {
            const isChecked = tg.specificPosts?.includes(p.slug);
            const label = document.createElement('label');
            label.className = 'target-check-item';
            label.innerHTML = `
              <input type="checkbox" class="chk-sidebar-target-post" value="${p.slug}" ${isChecked ? 'checked' : ''} />
              <span>${p.title}</span>
            `;
            postBox.appendChild(label);
          });
        }

        // Categories
        const catBox = document.getElementById('listSidebarCategories');
        if (catBox) {
          catBox.innerHTML = '';
          categoriesList.forEach(c => {
            const isChecked = tg.specificCategories?.includes(c.slug);
            const label = document.createElement('label');
            label.className = 'target-check-item';
            label.innerHTML = `
              <input type="checkbox" class="chk-sidebar-target-category" value="${c.slug}" ${isChecked ? 'checked' : ''} />
              <span>${c.name}</span>
            `;
            catBox.appendChild(label);
          });
        }
      }

      // Render Popups Dropdown List
      function renderPopupsList() {
        const container = document.getElementById('popupsListContainer');
        if (!container) return;
        container.innerHTML = '';

        allPopups.forEach(p => {
          const row = document.createElement('div');
          row.className = `popup-item-row ${p.id === activePopupId ? 'active' : ''}`;
          row.innerHTML = `
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="status-dot ${p.status === 'published' ? 'published' : 'draft'}"></span>
              <div>
                <div style="font-size: 0.78rem; font-weight: 600; color: #ffffff;">${p.name || 'Untitled Popup'}</div>
                <div style="font-size: 0.68rem; color: #9ca3af;">
                  ${p.triggers?.timeEnabled ? `⏱️ ${p.triggers.timeDelay || 5}s` : ''} 
                  ${p.triggers?.scrollEnabled ? `📜 ${p.triggers.scrollPercent || 50}%` : ''}
                </div>
              </div>
            </div>
            <div style="display: flex; gap: 4px;">
              <button type="button" class="chip-btn btn-dup" data-id="${p.id}" title="Duplicate">📋</button>
              <button type="button" class="chip-btn btn-del" data-id="${p.id}" style="color: #ef4444;" title="Delete">🗑️</button>
            </div>
          `;

          row.addEventListener('click', (e) => {
            if (e.target.classList.contains('btn-del')) {
              e.stopPropagation();
              deletePopup(p.id);
              return;
            }
            if (e.target.classList.contains('btn-dup')) {
              e.stopPropagation();
              duplicatePopup(p.id);
              return;
            }
            selectActivePopup(p.id);
            document.getElementById('popupSelectorMenu')?.classList.remove('show');
          });

          container.appendChild(row);
        });

        document.getElementById('activePopupTitleText').textContent = activePopup?.name || 'Untitled Popup';
        document.getElementById('activePopupStatusDot').className = `status-dot ${activePopup?.status === 'published' ? 'published' : 'draft'}`;
      }

      function selectActivePopup(id) {
        if (activePopup && editor) {
          try {
          if (editor.getWrapper()) {
            editor.getWrapper().find('.gjs-hover-preview').forEach(c => c.removeClass('gjs-hover-preview'));
          }
        } catch (e) {}
        let cleanHtml = editor.getHtml().replace(/\s*\bgjs-hover-preview\b/g, '');
        const closeMatches = cleanHtml.match(/<button[^>]*data-role="popup-close-btn"[^>]*>[\s\S]*?<\/button>/gi);
        if (closeMatches && closeMatches.length > 1) {
          for (let i = 1; i < closeMatches.length; i++) {
            cleanHtml = cleanHtml.replace(closeMatches[i], '');
          }
        }
        activePopup.html = cleanHtml;
          activePopup.css = editor.getCss();
        }

        const found = allPopups.find(p => p.id === id);
        if (!found) return;
        activePopupId = id;
        activePopup = JSON.parse(JSON.stringify(found));
        loadActivePopupIntoEditor();
        renderPopupsList();
      }

      // Create new blank popup
      async function createNewPopup() {
        const newPopup = {
          id: 'popup-' + Math.random().toString(36).substring(2, 9),
          name: 'New Custom Popup',
          status: 'draft',
          layout: 'center',
          showBackdrop: true,
          width: '540px',
          height: 'auto',
          margin: { top: '0px', right: '0px', bottom: '0px', left: '0px' },
          borderRadius: '16px',
          closePosition: 'right',
          showCloseButton: true,
          html: SAMPLE_TEMPLATES[0].html,
