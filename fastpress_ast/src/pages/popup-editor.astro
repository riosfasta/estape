      // ===============================================
      // CLOSE BUTTON POSITION & SETTINGS CONTROLS
      // ===============================================
      function setCloseButtonPosition(pos) {
        if (!activePopup) return;
        activePopup.closePosition = pos;

        document.querySelectorAll('.close-pos-btn').forEach(b => {
          if (b.dataset.pos === pos) b.classList.add('active');
          else b.classList.remove('active');
        });

        if (!editor) return;

        // 1. Update in GrapesJS component tree
        try {
          const wrapper = editor.getWrapper();
          const closeBtns = wrapper.find('.popup-close-trigger:not(.popup-dismiss-link), .fastpress-popup-close-btn, .popup-close-corner-btn');
          if (closeBtns && closeBtns.length > 0) {
            // Keep only one corner close button
            if (closeBtns.length > 1) {
              for (let i = 1; i < closeBtns.length; i++) {
                closeBtns[i].remove();
              }
            }
            const btnComp = closeBtns[0];
            btnComp.removeClass(['pos-left', 'pos-center', 'pos-right']);
            btnComp.addClass(`pos-${pos}`);
            const style = btnComp.getStyle() || {};
            if (pos === 'left') {
              btnComp.setStyle({ ...style, left: '14px', right: 'auto', transform: 'none' });
            } else if (pos === 'center') {
              btnComp.setStyle({ ...style, left: '50%', right: 'auto', transform: 'translateX(-50%)' });
            } else if (pos === 'right') {
              btnComp.setStyle({ ...style, right: '14px', left: 'auto', transform: 'none' });
            }
          }
        } catch (e) {
          console.warn('GJS component find warning', e);
        }

        // 2. Direct DOM update inside iframe to guarantee instantaneous preview
        const iframe = document.querySelector('#gjs-canvas iframe');
        if (iframe && iframe.contentDocument) {
          const doc = iframe.contentDocument;
          const el = doc.querySelector('.popup-close-trigger:not(.popup-dismiss-link), .fastpress-popup-close-btn, .popup-close-corner-btn');
          if (el) {
            el.classList.remove('pos-left', 'pos-center', 'pos-right');
            el.classList.add(`pos-${pos}`);
            if (pos === 'left') {
              el.style.left = '14px';
              el.style.right = 'auto';
              el.style.transform = 'none';
            } else if (pos === 'center') {
              el.style.left = '50%';
              el.style.right = 'auto';
              el.style.transform = 'translateX(-50%)';
            } else if (pos === 'right') {
              el.style.right = '14px';
              el.style.left = 'auto';
              el.style.transform = 'none';
            }
          }
        }

        showToast(`Close button position set to ${pos.toUpperCase()}`);
      }

