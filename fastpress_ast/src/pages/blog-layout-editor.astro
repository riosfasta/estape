    <!-- MODAL: SAVED TEMPLATES LIBRARY (INSERT TEMPLATE INTO CANVAS) -->
    <div class="custom-modal-backdrop" id="modalSavedTemplatesLibrary">
      <div class="custom-modal-box modal-templates-library">
        <!-- Header -->
        <div class="modal-header">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 34px; height: 34px; background: rgba(139, 92, 246, 0.15); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#8b5cf6"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"></path></svg>
            </div>
            <div>
              <div style="font-weight: 700; color: #ffffff; font-size: 1.02rem; display: flex; align-items: center; gap: 8px;">
                <span>Saved Templates Library</span>
                <span class="tpl-type-pill global">Global</span>
                <span class="tpl-type-pill individual">Individual</span>
              </div>
              <div style="font-size: 0.72rem; color: #9ca3af;">Insert pre-built sections, full components or global synchronized templates</div>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <a href="/template-editor" target="_blank" style="padding: 6px 12px; background: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.3); color: #c4b5fd; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 5px;">
              <span>Template Builder</span>
              <span>&rarr;</span>
            </a>
            <button type="button" class="modal-close-btn" id="btnCloseLibraryModal">&times;</button>
          </div>
        </div>

        <!-- Filter Bar -->
        <div style="padding: 12px 20px; background: #121620; border-bottom: 1px solid #242c3b; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
          <input type="text" id="inputSearchLibrary" placeholder="Search templates by name, category or description..." style="flex: 1; min-width: 200px; padding: 7px 12px; font-size: 0.8rem; background: #1c222e; border: 1px solid #2a3344; border-radius: 6px; color: #f3f4f6;" />
          <div style="display: flex; gap: 6px;">
            <button type="button" class="filter-chip active" id="btnLibFilterAll">All (<span id="libCountAll">0</span>)</button>
            <button type="button" class="filter-chip" id="btnLibFilterGlobal">🌐 Global (<span id="libCountGlobal">0</span>)</button>
            <button type="button" class="filter-chip" id="btnLibFilterIndiv">📄 Individual (<span id="libCountIndiv">0</span>)</button>
          </div>
        </div>

        <!-- Body: Grid -->
        <div class="modal-body" style="padding: 18px 20px;">
          <div id="libraryTemplatesGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px;">
            <!-- Rendered dynamically -->
          </div>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast-notification" id="toastNotification">
      <span id="toastMessage">Layout saved successfully!</span>
    </div>

    <!-- Context Menu for Layer Items & Canvas -->
    <div id="layerContextMenu" class="layer-context-menu" style="display: none;">
      <div class="context-menu-header" id="ctxMenuHeader">
        <span class="ctx-layer-icon">🔲</span>
        <span class="ctx-layer-name" id="ctxMenuLayerName">Element</span>
      </div>
      <div class="context-menu-divider"></div>
      <button type="button" class="ctx-menu-item" id="ctxBtnCopy">
        <span class="ctx-item-left">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Copy Layer</span>
        </span>
        <span class="ctx-shortcut">Ctrl+C</span>
      </button>
      <button type="button" class="ctx-menu-item" id="ctxBtnPasteBelow">
        <span class="ctx-item-left">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 10 4 15 9 20"></polyline><path d="M20 4v7a4 4 0 0 1-4 4H4"></path></svg>
          <span>Paste Below</span>
        </span>
        <span class="ctx-shortcut">Ctrl+V</span>
      </button>
      <button type="button" class="ctx-menu-item" id="ctxBtnPasteInside">
        <span class="ctx-item-left">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span>Paste Inside (Child)</span>
        </span>
      </button>
      <div class="context-menu-divider"></div>
      <button type="button" class="ctx-menu-item" id="ctxBtnDuplicate">
        <span class="ctx-item-left">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><rect x="3" y="3" width="13" height="13" rx="2" ry="2"></rect></svg>
          <span>Duplicate</span>
        </span>
        <span class="ctx-shortcut">Ctrl+D</span>
      </button>
      <button type="button" class="ctx-menu-item danger" id="ctxBtnDelete">
        <span class="ctx-item-left">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          <span>Delete</span>
        </span>
        <span class="ctx-shortcut">Del</span>
      </button>
    </div>

    <!-- CLIENT SCRIPT TO INITIALIZE GRAPESJS AND LOGIC -->
    <script is:inline define:vars={{ initialLayout: activeLayout, allPostsData: postsList, allTemplatesData: templatesList }}>
      window.activeLayout = initialLayout;
      window.allPosts = allPostsData;
      window.allTemplates = allTemplatesData || [];

      // Toast notification
      function showToast(msg, isError = false) {
        const toast = document.getElementById('toastNotification');
        const msgEl = document.getElementById('toastMessage');
        if (!toast || !msgEl) return;
        msgEl.textContent = msg;
        toast.className = `toast-notification ${isError ? 'error' : ''} show`;
        setTimeout(() => { toast.classList.remove('show'); }, 3000);
      }

      // Initialize GrapesJS
      document.addEventListener('DOMContentLoaded', () => {
        const editor = grapesjs.init({
          container: '#gjs-canvas-host',
          fromElement: false,
          height: '100%',
          width: 'auto',
          avoidInlineStyle: false,
          panels: { defaults: [] },
          storageManager: false,
          selectorManager: {
            componentFirst: true
          },
          blockManager: { appendTo: '#blocks-container' },
          styleManager: { appendTo: '#styles-container' },
          traitManager: { appendTo: '#traits-container' },
          layerManager: { appendTo: '#layers-container' },
          deviceManager: {
            devices: [
              { id: 'desktop', name: 'Desktop', width: '' },
              { id: 'tablet', name: 'Tablet', width: '768px', widthMedia: '992px' },
              { id: 'mobile', name: 'Mobile', width: '375px', widthMedia: '480px' },
            ]
          },
          canvas: {
            styles: [
              'https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap'
            ]
          }
        });

        window.grapesEditor = editor;
        window.editor = editor;

        // Inject Baseline Styles & CSS Resets into the Canvas Iframe
        function injectIframeStyles() {
          const iframeDoc = editor.Canvas.getDocument();
          if (!iframeDoc) return;

          let styleTag = iframeDoc.getElementById('gjs-blog-layout-baseline-styles');
          if (!styleTag) {
            styleTag = iframeDoc.createElement('style');
            styleTag.id = 'gjs-blog-layout-baseline-styles';
            iframeDoc.head.appendChild(styleTag);
          }

          styleTag.innerHTML = `
            *, *::before, *::after {
              box-sizing: border-box;
            }
            body {
              font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
              color: #1f2937;
              background-color: #ffffff;
              margin: 0;
              padding: 0;
              line-height: 1.65;
              width: 100%;
            }
            h1, h2, h3, h4, h5, h6 {
              font-family: 'Montserrat', sans-serif;
              font-weight: 700;
              line-height: 1.25;
              color: #111827;
            }
            a {
              text-decoration: none;
              color: inherit;
            }
            img {
              max-width: 100%;
              height: auto;
            }

            /* Breadcrumbs Reset & Layout */
            .breadcrumb-nav {
              margin-bottom: 14px;
            }
            .breadcrumb-list {
              display: flex !important;
              align-items: center !important;
              gap: 8px !important;
              list-style: none !important;
              padding: 0 !important;
              margin: 0 !important;
              font-size: 0.85rem !important;
              color: #6b7280 !important;
            }
            .breadcrumb-list li {
              display: inline-flex !important;
              align-items: center !important;
              list-style-type: none !important;
            }
            .breadcrumb-list a {
              color: #4b5563 !important;
              text-decoration: none !important;
              transition: color 0.15s ease;
            }
            .breadcrumb-list a:hover {
              color: #ff5e3a !important;
            }
            .breadcrumb-current {
