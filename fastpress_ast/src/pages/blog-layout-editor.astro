---
import DeviceSwitcher from '../components/admin/DeviceSwitcher.astro';
import WorkspaceSwitcher from '../components/admin/WorkspaceSwitcher.astro';
// src/pages/blog-layout-editor.astro
// Visual Standard Blog Layout Builder - Design reusable layouts for blog posts
import fs from 'node:fs/promises';
import path from 'node:path';
import { getBlogLayouts, getBlogLayoutById, type BlogLayout } from '../data/blog-layouts';
import { getPosts, type Post } from '../data/posts';
import { getCategories } from '../data/categories';
import { getTemplates, type Template } from '../data/templates';
import { getActiveThemeName } from '../core/theme';

export const prerender = false;

const activeTheme = getActiveThemeName();
const layoutsList = getBlogLayouts();
const postsList = getPosts();
const categoriesList = getCategories();
const templatesList = getTemplates();

// Active layout selection by query param or default
const targetId = Astro.url.searchParams.get('id') || (layoutsList.find(l => l.isDefault)?.id ?? layoutsList[0]?.id ?? 'standard-default-layout');
const activeLayout = getBlogLayoutById(targetId);

// Registered Fonts
let fontsData: any[] = [];
try {
  const fontsPath = path.join(process.cwd(), 'src', 'data', 'fonts.json');
  const fontsContent = await fs.readFile(fontsPath, 'utf-8');
  fontsData = JSON.parse(fontsContent);
} catch {
  fontsData = [
    {
      id: 'plus-jakarta-sans',
      name: 'Plus Jakarta Sans',
      family: 'Plus Jakarta Sans',
      type: 'google',
      url: 'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap'
    },
    {
      id: 'montserrat',
      name: 'Montserrat',
      family: 'Montserrat',
      type: 'google',
      url: 'https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap'
    }
  ];
}

// Find first post applied to this layout for quick live link
const firstAppliedSlug = activeLayout.appliedPostSlugs?.[0] || postsList[0]?.slug || 'branding-identity-modern-age';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Blog Layout Builder - {activeLayout.name} | BUGMEGA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Registered Custom & Google Fonts -->
    {fontsData.map(font => {
      if (font.type === 'google' && font.url) {
        return <link rel="stylesheet" href={font.url} />;
      } else if (font.type === 'upload' && font.url) {
        return (
          <style is:inline set:html={`@font-face { font-family: '${font.family}'; src: url('${font.url}') format('${font.format || 'woff2'}'); font-weight: ${font.weight || 'normal'}; font-style: ${font.style || 'normal'}; font-display: swap; }`} />
        );
      }
      return null;
    })}

    <!-- GrapesJS Default CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/grapesjs@0.23.9/dist/css/grapes.min.css" />
    <link rel="stylesheet" href="/editor-container-layout.css" />
    <script is:inline src="https://unpkg.com/grapesjs@0.23.9/dist/grapes.min.js"></script>
    <script is:inline src="/editor-container-layout.js"></script>
    <script is:inline src="/editor-file-manager.js"></script>
    <script is:inline src="/editor-custom-code.js"></script>

    <style is:global>
      :root {
        color-scheme: dark;
        --builder-bg: #0b0e14;
        --toolbar-bg: #131720;
        --border-color: #242b38;
        --accent-color: #10b981;
        --accent-hover: #059669;
        --text-primary: #f3f4f6;
        --text-muted: #9ca3af;
        --card-bg: #161b24;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html {
        height: 100%;
        overflow: hidden;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--builder-bg);
        color: var(--text-primary);
      }

      /* TOP NAVBAR */
      .builder-navbar {
        height: 52px;
        background-color: var(--toolbar-bg);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-inline: 1rem;
        gap: 0.85rem;
        z-index: 1000;
        position: relative;
      }
      .navbar-left, .navbar-center, .navbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .brand-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.05em;
        color: #ffffff;
        text-decoration: none;
        margin-right: 4px;
      }

      /* SWITCHER DROPDOWN */
      .builder-switcher-wrap { position: relative; }
      .builder-switcher-btn {
        background: #1c212b;
        border: 1px solid #2d3342;
        color: #f3f4f6;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .builder-switcher-btn:hover { background: #252b38; border-color: #3b4354; }
      .builder-switcher-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        width: 260px;
        max-height: calc(100vh - 70px);
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: #374151 #141822;
        background: #141822;
        border: 1px solid #2a3242;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        padding: 6px;
        display: none;
        z-index: 1000;
      }
      .builder-switcher-menu::-webkit-scrollbar {
        width: 6px;
      }
      .builder-switcher-menu::-webkit-scrollbar-thumb {
        background: #2f3849;
        border-radius: 4px;
      }
      .builder-switcher-menu.show { display: block; }
      .switcher-menu-header {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
        padding: 6px 10px 4px 10px;
      }
      .switcher-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 6px;
        text-decoration: none;
        color: #d1d5db;
        transition: background 0.15s;
      }
      .switcher-item:hover { background: #1c212b; }
      .switcher-item.active {
        color: var(--accent-color);
        background: rgba(16, 185, 129, 0.12);
        font-weight: 600;
      }
      .switcher-item-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1c212b;
      }
      .switcher-item-title { font-size: 0.8rem; font-weight: 600; }
      .switcher-item-desc { font-size: 0.68rem; color: #9ca3af; }

      /* LAYOUT SELECTOR */
      .layout-selector-wrap { position: relative; }
      .layout-selector-btn {
        background: #181d26;
        border: 1px solid #2d3444;
        color: #e5e7eb;
        padding: 5px 11px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .layout-selector-btn:hover { border-color: #3f4a60; }
      .layout-selector-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        width: 320px;
        background: #141822;
        border: 1px solid #2a3242;
        border-radius: 8px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.6);
        padding: 6px;
        display: none;
        z-index: 1000;
        max-height: 420px;
        overflow-y: auto;
      }
      .layout-selector-menu.show { display: block; }
      .layout-item-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
        color: #d1d5db;
        text-decoration: none;
        transition: background 0.15s;
        margin-bottom: 2px;
      }
      .layout-item-row:hover { background: #1e2430; }
      .layout-item-row.active {
        background: rgba(16, 185, 129, 0.14);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: #ffffff;
      }
      .btn-add-layout {
        width: 100%;
        margin-top: 6px;
        background: #1c222d;
        border: 1px dashed #374151;
        color: #e5e7eb;
        padding: 7px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .btn-add-layout:hover { background: #242c3b; border-color: var(--accent-color); color: #ffffff; }

      /* ACTION BUTTONS */
      .btn-nav-action {
        background: #1c212b;
        border: 1px solid #2d3342;
        color: #d1d5db;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.76rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
      }
      .btn-nav-action:hover { background: #252b38; border-color: #3b4354; color: #ffffff; }
      .btn-nav-action.highlight {
        background: rgba(16, 185, 129, 0.15);
        border-color: rgba(16, 185, 129, 0.4);
        color: #34d399;
      }
      .btn-nav-action.highlight:hover {
        background: rgba(16, 185, 129, 0.25);
        color: #ffffff;
      }
      .badge-counter {
        background: var(--accent-color);
        color: #0b0e14;
        font-size: 0.68rem;
        font-weight: 800;
        padding: 1px 6px;
        border-radius: 999px;
      }

      /* VIEWPORT DEVICES */
      .device-switcher {
        display: flex;
        align-items: center;
        background: #181d26;
        border: 1px solid #282f3d;
        border-radius: 6px;
        padding: 2px;
      }
      .device-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: all 0.15s;
      }
      .device-btn:hover { color: #f3f4f6; }
      .device-btn.active {
        background: #252d3b;
        color: #ffffff;
      }

      /* SAVE BUTTON */
      .btn-save-layout {
        background: var(--accent-color);
        color: #042f24;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-save-layout:hover { background: #34d399; }

      /* MAIN WORKSPACE */
      .layout-workspace {
        display: flex;
        height: calc(100% - 52px);
        position: relative;
        overflow: hidden;
      }

      /* CANVAS AREA */
      .layout-canvas-wrap {
        flex: 1;
        position: relative;
        background: #11141c;
        overflow: hidden;
      }
      #gjs-canvas-host {
        width: 100%;
        height: 100%;
      }

      /* SIDEBAR */
      .editor-sidebar {
        width: 320px;
        background: #161922;
        border-left: 1px solid #252b37;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        z-index: 50;
      }
      .sidebar-tabs {
        display: flex;
        background: #12151c;
        border-bottom: 1px solid #252b37;
      }
      .tab-btn {
        flex: 1;
        padding: 9px 4px;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: #9ca3af;
        font-size: 0.74rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: all 0.15s;
      }
      .tab-btn:hover { color: #f3f4f6; }
      .tab-btn.active {
        color: var(--accent-color);
        border-bottom-color: var(--accent-color);
        background: rgba(16, 185, 129, 0.05);
      }
      .tab-pane {
        flex: 1;
        overflow-y: auto;
        display: none;
        padding: 10px;
      }
      .tab-pane.active { display: block; }

      /* GRAPESJS STYLING OVERRIDES */
      /* Hide default GrapesJS panels (we use our own custom header and right sidebar) */
      .gjs-pn-panel,
      .gjs-pn-views-container,
      .gjs-pn-views,
      .gjs-pn-commands,
      .gjs-pn-options {
        display: none !important;
      }

      .gjs-cv-canvas {
        width: 100% !important;
        height: 100% !important;
        top: 0 !important;
      }
      .gjs-blocks-cs { padding: 4px !important; }
      .gjs-block-category {
        border-bottom: 1px solid #252b37 !important;
        margin-bottom: 8px !important;
      }
      .gjs-block-category.gjs-open .gjs-blocks-c {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 8px !important;
        padding: 8px 4px !important;
      }
      .gjs-block-category.gjs-open:has(.gjs-block-basic) .gjs-blocks-c,
      .gjs-block-category.is-basic-category.gjs-open .gjs-blocks-c {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 8px !important;
        padding: 8px 4px !important;
      }
      .gjs-block-category:not(.gjs-open) .gjs-blocks-c {
        display: none !important;
      }
      .gjs-title {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        color: #9ca3af !important;
        background: #1a1e28 !important;
        padding: 8px 12px !important;
        border-radius: 6px !important;
        cursor: pointer !important;
        user-select: none !important;
        display: flex !important;
        align-items: center !important;
      }
      .gjs-title:hover {
        background: #212632 !important;
        color: #ffffff !important;
      }
      .gjs-block {
        background: #1d222e !important;
        border: 1px solid #2a3242 !important;
        border-radius: 7px !important;
        color: #e5e7eb !important;
        padding: 10px 8px !important;
        margin: 0 !important;
        width: calc(50% - 4px) !important;
        box-shadow: none !important;
        transition: all 0.15s !important;
        box-sizing: border-box !important;
      }
      .gjs-block:hover {
        background: #242b3b !important;
        border-color: var(--accent-color) !important;
        color: #ffffff !important;
      }
      .gjs-block-label {
        font-size: 0.73rem !important;
        font-weight: 600 !important;
        margin-top: 5px !important;
      }
      .gjs-block svg {
        width: 18px !important;
        height: 18px !important;
      }

      /* Tampilan Square Card untuk Basic Elements (Identik dengan Page Builder) */
      .gjs-block.gjs-block-basic {
        width: 100% !important;
        min-height: 84px !important;
        box-sizing: border-box !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        padding: 12px 6px !important;
        background-color: #1a1e27 !important;
        border: 1px solid #282e3b !important;
        border-radius: 8px !important;
        gap: 6px !important;
        cursor: grab !important;
        margin: 0 !important;
      }
      .gjs-block.gjs-block-basic .gjs-block__media {
        width: 36px !important;
        height: 36px !important;
        min-width: 36px !important;
        background-color: transparent !important;
        border: none !important;
        color: #d1d5db !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }
      .gjs-block.gjs-block-basic .gjs-block__media svg {
        width: 26px !important;
        height: 26px !important;
        stroke: currentColor !important;
      }
      .gjs-block.gjs-block-basic .gjs-block-label {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-size: 0.74rem !important;
        font-weight: 600 !important;
        color: #d1d5db !important;
        text-align: center !important;
        line-height: 1.2 !important;
        margin: 0 !important;
      }
      .gjs-block.gjs-block-basic:hover {
        border-color: #ff5e3a !important;
        background-color: #212632 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4) !important;
      }
      .gjs-block.gjs-block-basic:hover .gjs-block__media {
        color: #ff7e5f !important;
      }
      .gjs-block.gjs-block-basic:hover .gjs-block-label {
        color: #ffffff !important;
      }

      /* DYNAMIC BLOCK BADGE */
      .dynamic-pill-badge {
        display: inline-block;
        font-size: 0.6rem;
        font-weight: 700;
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        padding: 1px 5px;
        border-radius: 4px;
        margin-bottom: 2px;
      }

      /* MODALS */
      .custom-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        padding: 16px;
      }
      .custom-modal-backdrop.open { display: flex; }
      .custom-modal-box {
        background: #141822;
        border: 1px solid #2a3242;
        border-radius: 12px;
        width: 100%;
        max-width: 620px;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
        overflow: hidden;
      }
      .modal-templates-library {
        max-width: 840px !important;
        width: 95vw !important;
        max-height: 85vh !important;
      }
      .tpl-type-pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 9999px;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .tpl-type-pill.global {
        background: rgba(16, 185, 129, 0.18);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.35);
      }
      .tpl-type-pill.individual {
        background: rgba(2, 132, 199, 0.18);
        color: #38bdf8;
        border: 1px solid rgba(2, 132, 199, 0.35);
      }
      .filter-chip {
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #1c222e;
        color: #9ca3af;
        border: 1px solid #2a3344;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .filter-chip:hover {
        color: #f3f4f6;
        border-color: #3b4556;
      }
      .filter-chip.active {
        background: rgba(139, 92, 246, 0.2);
        color: #c4b5fd;
        border-color: #8b5cf6;
      }
      .modal-header {
        padding: 14px 18px;
        border-bottom: 1px solid #242b38;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .modal-title { font-size: 0.95rem; font-weight: 700; color: #ffffff; }
      .modal-close-btn {
        background: transparent;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        padding: 4px;
      }
      .modal-close-btn:hover { color: #ffffff; }
      .modal-body {
        padding: 18px;
        overflow-y: auto;
      }
      .modal-footer {
        padding: 12px 18px;
        border-top: 1px solid #242b38;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: #11141c;
      }
      .btn-secondary {
        background: #1f2533;
        border: 1px solid #333d52;
        color: #d1d5db;
        padding: 7px 14px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-secondary:hover { background: #272f42; color: #ffffff; }
      .btn-primary-action {
        background: var(--accent-color);
        border: none;
        color: #042f24;
        padding: 7px 16px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
      }
      .btn-primary-action:hover { background: #34d399; }

      /* POST ASSIGNMENT CHECKLIST ITEMS */
      .post-assign-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        background: #181d28;
        border: 1px solid #262e3d;
        border-radius: 8px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.15s;
      }
      .post-assign-item:hover { background: #1f2535; border-color: #3b4559; }
      .post-assign-item.selected {
        border-color: rgba(16, 185, 129, 0.4);
        background: rgba(16, 185, 129, 0.08);
      }
      .post-thumb-img {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        object-fit: cover;
        flex-shrink: 0;
      }
      .post-assign-info { flex: 1; min-width: 0; }
      .post-assign-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #f3f4f6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .post-assign-meta {
        font-size: 0.72rem;
        color: #9ca3af;
        margin-top: 2px;
        display: flex;
        gap: 8px;
      }
      .post-badge-layout {
        font-size: 0.68rem;
        padding: 2px 7px;
        border-radius: 4px;
        font-weight: 600;
      }
      .post-badge-layout.this-layout {
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
      }
      .post-badge-layout.other-layout {
        background: rgba(99, 102, 241, 0.2);
        color: #818cf8;
      }
      .post-badge-layout.blank {
        background: #28303f;
        color: #9ca3af;
      }

      /* TOAST NOTIFICATION */
      .toast-notification {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: #10b981;
        color: #042f24;
        font-weight: 700;
        font-size: 0.82rem;
        padding: 10px 18px;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        gap: 8px;
        z-index: 9999;
      }
      .toast-notification.error {
        background: #ef4444;
        color: #ffffff;
      }
      .toast-notification.show { display: flex; }

      /* ========================================================
         STYLE MANAGER STATE SWITCHER: NORMAL vs HOVER
         ======================================================== */
      .gjs-sm-state-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        background: #0f131a;
        border-bottom: 1px solid #1e2638;
        margin-bottom: 8px;
        border-radius: 6px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        gap: 8px;
      }
      .gjs-sm-state-left {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .gjs-sm-state-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
      }
      .gjs-sm-state-pills, .gjs-sector-state-switch {
        display: inline-flex;
        background: #0b0e14;
        border: 1px solid #232c3d;
        border-radius: 6px;
        padding: 2px;
        gap: 2px;
        margin-left: auto;
      }
      .gjs-state-btn, .gjs-master-state-btn {
        background: transparent;
        border: none;
        color: #8b9bb4;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: lowercase;
        padding: 2px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
        line-height: 1.2;
      }
      .gjs-master-state-btn {
        text-transform: none;
        padding: 3px 10px;
        font-size: 0.72rem;
      }
      .gjs-state-btn:hover, .gjs-master-state-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
      }
      .gjs-state-btn.is-active, .gjs-master-state-btn.is-active {
        background: #ff5e3a !important;
        color: #ffffff !important;
        box-shadow: 0 2px 6px rgba(255, 94, 58, 0.4);
      }
      .gjs-state-btn[data-state="normal"].is-active,
      .gjs-master-state-btn[data-state="normal"].is-active {
        background: #252e3e !important;
        color: #ffffff !important;
        box-shadow: none;
      }
      .gjs-sm-state-badge {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        background: #18202d;
        color: #94a3b8;
        border: 1px solid #232c3d;
        white-space: nowrap;
      }
      .gjs-sm-state-badge.is-hover {
        background: rgba(255, 94, 58, 0.15);
        color: #ff5e3a;
        border-color: rgba(255, 94, 58, 0.4);
      }
      .gjs-sm-sector-title {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        position: relative;
        padding-right: 8px !important;
      }
      .gjs-sm-sector-label {
        flex: 1;
      }

      /* Layer Actions Toolbar & Context Menu */
      .layer-active-badge {
        font-size: 0.65rem;
        font-weight: 700;
        color: #ff5e3a;
        background: rgba(255, 94, 58, 0.12);
        border: 1px solid rgba(255, 94, 58, 0.3);
        border-radius: 4px;
        padding: 2px 7px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        max-width: 130px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .layer-actions-toolbar {
        display: grid;
        grid-template-columns: repeat(4, 1fr) 34px;
        gap: 5px;
        background: #11141c;
        border: 1px solid #232936;
        border-radius: 8px;
        padding: 5px;
        margin-bottom: 10px;
      }

      .btn-layer-tool {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        padding: 6px 3px;
        background: #181d28;
        border: 1px solid #2b3344;
        border-radius: 6px;
        color: #9ca3af;
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
      }

      .btn-layer-tool:hover:not(:disabled) {
        background: #232a3a;
        color: #f3f4f6;
        border-color: #3f4a60;
        transform: translateY(-1px);
      }

      .btn-layer-tool:active:not(:disabled) {
        transform: translateY(0);
      }

      .btn-layer-tool:disabled {
        opacity: 0.35;
        cursor: not-allowed;
        background: #131720;
        border-color: #1f2532;
        color: #6b7280;
      }

      .btn-layer-tool.primary:hover:not(:disabled) {
        background: rgba(255, 94, 58, 0.12);
        color: #ff7e5f;
        border-color: rgba(255, 94, 58, 0.4);
      }

      .btn-layer-tool.success:hover:not(:disabled) {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.4);
      }

      .btn-layer-tool.inside:hover:not(:disabled) {
        background: rgba(59, 130, 246, 0.12);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.4);
      }

      .btn-layer-tool.duplicate:hover:not(:disabled) {
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border-color: rgba(245, 158, 11, 0.4);
      }

      .btn-layer-tool.danger {
        padding: 6px;
      }

      .btn-layer-tool.danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.4);
      }

      /* Cross-Page Clipboard Banner */
      .layer-clipboard-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.25);
        border-radius: 6px;
        padding: 6px 10px;
        margin-bottom: 10px;
        animation: fadeInClipboard 0.2s ease-out;
      }

      @keyframes fadeInClipboard {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .clipboard-banner-left {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
      }

      .clipboard-banner-icon {
        font-size: 0.95rem;
        flex-shrink: 0;
      }

      .clipboard-banner-info {
        display: flex;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
      }

      .clipboard-banner-title {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        color: #d1fae5;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .clipboard-banner-title strong {
        color: #34d399;
        font-weight: 700;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .clipboard-source-pill {
        font-size: 0.62rem;
        color: #6ee7b7;
        background: rgba(16, 185, 129, 0.2);
        border-radius: 3px;
        padding: 1px 4px;
        font-weight: 500;
      }

      .clipboard-banner-desc {
        font-size: 0.65rem;
        color: #9ca3af;
      }

      .btn-clipboard-clear {
        background: none;
        border: none;
        color: #6ee7b7;
        cursor: pointer;
        padding: 2px 6px;
        font-size: 1rem;
        line-height: 1;
        border-radius: 4px;
        transition: all 0.15s ease;
      }

      .btn-clipboard-clear:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
      }

      /* Context Menu for Layers & Canvas */
      .layer-context-menu {
        position: fixed;
        z-index: 999999;
        min-width: 185px;
        background: #141720;
        border: 1px solid #2b3344;
        border-radius: 8px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05);
        padding: 5px;
        font-family: inherit;
        backdrop-filter: blur(8px);
      }

      .context-menu-header {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px 6px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .ctx-layer-name {
        color: #ff7e5f;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .context-menu-divider {
        height: 1px;
        background: #232936;
        margin: 4px 0;
      }

      .ctx-menu-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 7px 9px;
        border-radius: 5px;
        background: transparent;
        border: none;
        color: #d1d5db;
        font-size: 0.76rem;
        font-weight: 500;
        cursor: pointer;
        text-align: left;
        transition: all 0.12s ease;
      }

      .ctx-menu-item:hover:not(:disabled) {
        background: #232b3b;
        color: #fff;
      }

      .ctx-menu-item:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .ctx-item-left {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .ctx-shortcut {
        font-size: 0.65rem;
        color: #6b7280;
        font-family: monospace;
      }

      .ctx-menu-item.danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
      }
    </style>
  </head>
  <body>

    <!-- TOP NAVBAR -->
    <header class="builder-navbar">
      <!-- Left: Logo, Workspace Apps Switcher, Layout Selector -->
      <div class="navbar-left">
        <a href="/" class="brand-title" title="BUGMEGA Home">BUGMEGA</a>

        <!-- WORKSPACE APPS SWITCHER DROPDOWN -->
        <WorkspaceSwitcher activeApp="blog-layouts" />

        <!-- Active Theme Pill -->
        <div class="active-theme-pill" title={`Active Theme: ${activeTheme}`} style="display: inline-flex; align-items: center; gap: 6px; background: #191f2c; border: 1px solid #313d54; border-radius: 9999px; padding: 4px 10px; font-size: 0.72rem; color: #94a3b8; margin-right: 6px;">
          <span style="width: 7px; height: 7px; border-radius: 50%; background-color: #10b981; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);"></span>
          <span style="text-transform: uppercase; font-weight: 600; font-size: 0.66rem; color: #64748b;">Theme:</span>
          <strong style="color: #f1f5f9; font-weight: 700; text-transform: capitalize;">{activeTheme}</strong>
        </div>

        <!-- LAYOUT SELECTOR -->
        <div class="layout-selector-wrap" id="layoutSelectorWrap">
          <button type="button" class="layout-selector-btn" id="btnLayoutSelector" title="Switch layout">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line></svg>
            <span id="activeLayoutNameDisplay">{activeLayout.name}</span>
            {activeLayout.isDefault && <span style="font-size: 0.65rem; background: #047857; color: #a7f3d0; padding: 1px 5px; border-radius: 4px; font-weight: 700;">DEFAULT</span>}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>

          <div class="layout-selector-menu" id="layoutSelectorMenu">
            <div style="font-size: 0.68rem; font-weight: 700; color: #6b7280; text-transform: uppercase; padding: 4px 6px;">Manage Standard Layouts</div>
            {layoutsList.map(lay => (
              <a href={`/blog-layout-editor?id=${lay.id}`} class={`layout-item-row ${lay.id === activeLayout.id ? 'active' : ''}`}>
                <div>
                  <div style="font-weight: 700; font-size: 0.82rem;">{lay.name}</div>
                  <div style="font-size: 0.68rem; color: #9ca3af;">{lay.appliedPostSlugs?.length || 0} posts applied {lay.isDefault ? '• Default' : ''}</div>
                </div>
                {lay.isDefault && <span style="font-size: 0.65rem; background: #047857; color: #a7f3d0; padding: 1px 5px; border-radius: 4px; font-weight: 700;">DEFAULT</span>}
              </a>
            ))}
            <button type="button" class="btn-add-layout" id="btnOpenNewLayoutModal">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Create New Standard Layout</span>
            </button>
          </div>
        </div>

        <!-- SPECIFY APPLIED POSTS BUTTON -->
        <button type="button" class="btn-nav-action highlight" id="btnOpenAssignPostsModal" title="Specify which blog posts use this layout">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
          <span>Apply to Posts</span>
          <span class="badge-counter" id="appliedPostsCountBadge">{activeLayout.appliedPostSlugs?.length || 0}</span>
        </button>
      </div>

      <!-- Center: Viewport Device Switching (Dropdown) -->
      <div class="navbar-center">
        <DeviceSwitcher />
      </div>

      <!-- Right: Code Editor, Live View, Save -->
      <div class="navbar-right">
        <!-- Media Library & File Manager -->
        <button type="button" class="btn-nav-action" id="btnOpenMediaLibraryNavbar" title="Open Media Library & File Manager">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Media</span>
        </button>

        <!-- Duplicate Layout -->
        <button type="button" class="btn-nav-action" id="btnDuplicateLayout" title="Duplicate this layout">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Clone</span>
        </button>

        <!-- Live Site, Preview & Code Dropdown -->
        <div class="topbar-dropdown-wrap menu-right" id="viewActionsDropdownWrap">
          <button type="button" class="topbar-dropdown-btn" id="btnViewActionsDropdown" title="Live Site, Preview & Code">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span>Preview & Code</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="topbar-dropdown-menu" id="viewActionsDropdownMenu">
            <a href={`/blog/${firstAppliedSlug}`} target="_blank" class="topbar-dropdown-item" id="btnLivePreviewLink">
              <div class="topbar-item-icon" style="color: #60a5fa;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </div>
              <div class="topbar-item-text">
                <span class="topbar-item-title">Live Post</span>
                <span class="topbar-item-desc">View live article with this layout</span>
              </div>
            </a>
            <button type="button" class="topbar-dropdown-item" onclick="if(window.editor){const cmd = window.editor.Commands; if(cmd.isActive('preview')) cmd.stop('preview'); else cmd.run('preview');}">
              <div class="topbar-item-icon" style="color: #34d399;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </div>
              <div class="topbar-item-text">
                <span class="topbar-item-title">Preview Canvas</span>
                <span class="topbar-item-desc">Toggle fullscreen canvas preview</span>
              </div>
            </button>
            <button type="button" class="topbar-dropdown-item" id="btnOpenCodeEditor">
              <div class="topbar-item-icon" style="color: #f59e0b;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              </div>
              <div class="topbar-item-text">
                <span class="topbar-item-title">View Code</span>
                <span class="topbar-item-desc">Inspect HTML & CSS code</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Toggle Sidebar Panel Button -->
        <button type="button" class="btn-toggle-panel" id="btnToggleSidebar" title="Toggle Sidebar Panel">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="15" y1="3" x2="15" y2="21"></line>
          </svg>
          <span>Panel</span>
        </button>

        <!-- Save Layout Button -->
        <button type="button" class="btn-save-layout" id="btnSaveLayout" title="Save Layout Changes (Ctrl+S)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
          <span>Save Layout</span>
        </button>
      </div>
    </header>

    <!-- WORKSPACE: CANVAS + SIDEBAR -->
    <main class="layout-workspace">
      <!-- CENTER CANVAS AREA -->
      <div class="layout-canvas-wrap">
        <div id="gjs-canvas-host"></div>
      </div>

      <!-- RIGHT SIDEBAR (TABS: BLOCKS, STYLES, SETTINGS, LAYERS) -->
      <aside class="editor-sidebar">
        <div class="sidebar-tabs">
          <button type="button" class="tab-btn active" data-tab="blocks">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Blocks</span>
          </button>
          <button type="button" class="tab-btn" data-tab="styles">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            <span>Style</span>
          </button>
          <button type="button" class="tab-btn" data-tab="settings">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Settings</span>
          </button>
          <button type="button" class="tab-btn" data-tab="layers">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            <span>Layers</span>
          </button>
        </div>

        <div id="tab-blocks" class="tab-pane active">
          <div id="blocks-container"></div>
        </div>
        <div id="tab-styles" class="tab-pane">
          <div id="styles-container"></div>
        </div>
        <div id="tab-settings" class="tab-pane">
          <!-- LIVE PREVIEW SELECTOR CARD -->
          <div style="background: #161b24; border: 1px solid #283142; border-radius: 8px; padding: 14px; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <div style="display: flex; align-items: center; gap: 7px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span style="font-size: 0.8rem; font-weight: 700; color: #f3f4f6; text-transform: uppercase; letter-spacing: 0.05em;">Preview with Post</span>
              </div>
              <span style="font-size: 0.65rem; background: rgba(16, 185, 129, 0.15); color: #10b981; font-weight: 700; padding: 2px 6px; border-radius: 4px;">Dynamic</span>
            </div>
            <p style="font-size: 0.74rem; color: #9ca3af; line-height: 1.45; margin-bottom: 10px;">
              Select a blog post to test and preview dynamic elements (title, excerpt, cover image, author, date, categories) in this canvas:
            </p>
            <select id="selectSamplePost" style="width: 100%; background: #1c212b; border: 1px solid #323b4c; color: #f3f4f6; padding: 8px 10px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; cursor: pointer; outline: none;">
              {postsList.map(p => (
                <option value={p.slug}>{p.title}</option>
              ))}
            </select>
          </div>

          <!-- COMPONENT PROPERTIES / TRAITS -->
          <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #9ca3af; margin: 16px 0 8px 0; display: flex; align-items: center; gap: 6px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Selected Element Settings</span>
          </div>
          <div id="traits-container"></div>
        </div>
        <div id="tab-layers" class="tab-pane">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <span class="panel-header-title" style="margin: 0; font-size: 0.75rem; font-weight: 700; color: #9ca3af; text-transform: uppercase;">Element Hierarchy Tree</span>
            <span class="layer-active-badge" id="layerActiveBadge" style="display: none;">Selected</span>
          </div>

          <!-- Layer Toolbar Actions -->
          <div class="layer-actions-toolbar" id="layerActionsToolbar">
            <button type="button" class="btn-layer-tool primary" id="btnLayerCopy" title="Copy Layer to Clipboard (Ctrl+C)" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy</span>
            </button>

            <button type="button" class="btn-layer-tool success" id="btnLayerPasteBelow" title="Paste as Sibling Below (Ctrl+V)" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 10 4 15 9 20"></polyline>
                <path d="M20 4v7a4 4 0 0 1-4 4H4"></path>
              </svg>
              <span>Paste</span>
            </button>

            <button type="button" class="btn-layer-tool inside" id="btnLayerPasteInside" title="Paste as Child Inside Container" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Inside</span>
            </button>

            <button type="button" class="btn-layer-tool duplicate" id="btnLayerDuplicate" title="Duplicate Layer (Ctrl+D)" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <rect x="3" y="3" width="13" height="13" rx="2" ry="2"></rect>
              </svg>
