          const chosenPost = window.allPosts.find(p => p.slug === slug);
          if (!chosenPost) return;

          // Dynamically update the preview link
          const liveLink = document.getElementById('btnLivePreviewLink');
          if (liveLink) liveLink.href = `/blog/${chosenPost.slug}`;

          const frameDoc = editor.Canvas.getDocument();
          if (!frameDoc) return;

          // Update elements in canvas
