            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            const targetId = `tab-${btn.dataset.tab}`;
            document.getElementById(targetId)?.classList.add('active');
          });
        });

        // Builder Switcher dropdown
        const btnBuilderSwitcher = document.getElementById('btnBuilderSwitcher');
        const builderSwitcherMenu = document.getElementById('builderSwitcherMenu');
        btnBuilderSwitcher?.addEventListener('click', (e) => {
          e.stopPropagation();
          builderSwitcherMenu?.classList.toggle('show');
        });

        // Layout Selector dropdown
        const btnLayoutSelector = document.getElementById('btnLayoutSelector');
        const layoutSelectorMenu = document.getElementById('layoutSelectorMenu');
