    <!-- MODAL: CODE EDITOR (HTML & CSS) -->
    <div class="custom-modal-backdrop" id="modalCodeEditor">
      <div class="custom-modal-box" style="max-width: 800px; height: 80vh;">
        <div class="modal-header">
          <div class="modal-title">Layout Template Code (HTML & CSS)</div>
