        <div class="modal-body" style="display: flex; flex-direction: column; gap: 12px; flex: 1;">
          <div style="display: flex; gap: 8px;">
            <button type="button" class="btn-secondary active" id="btnCodeTabHtml">HTML Template</button>
            <button type="button" class="btn-secondary" id="btnCodeTabCss">Custom CSS</button>
          </div>
          <textarea id="textareaLayoutCode" style="flex: 1; width: 100%; min-height: 380px; padding: 12px; font-family: 'Consolas', 'Fira Code', monospace; font-size: 0.82rem; background: #0c0f16; border: 1px solid #262e3d; border-radius: 6px; color: #38bdf8; line-height: 1.5; resize: none;"></textarea>
