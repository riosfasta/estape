            <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #d1d5db; margin-bottom: 4px;">Layout Name</label>
            <input type="text" id="inputNewLayoutName" placeholder="e.g. Modern Minimalist or Hero Magazine" style="width: 100%; padding: 8px 12px; background: #1c222e; border: 1px solid #2a3344; border-radius: 6px; color: #f3f4f6; font-size: 0.82rem;" />
          </div>
          <div style="margin-bottom: 12px;">
            <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #d1d5db; margin-bottom: 4px;">Description</label>
            <textarea id="inputNewLayoutDesc" rows="2" placeholder="Brief notes about where or when to use this layout..." style="width: 100%; padding: 8px 12px; background: #1c222e; border: 1px solid #2a3344; border-radius: 6px; color: #f3f4f6; font-size: 0.82rem; resize: vertical;"></textarea>
