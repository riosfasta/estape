    <!-- MODAL: ASSIGN LAYOUT TO SPECIFIC BLOG POSTS -->
    <div class="custom-modal-backdrop" id="modalAssignPosts">
      <div class="custom-modal-box">
        <div class="modal-header">
          <div>
            <div class="modal-title">Apply Layout to Specific Blog Posts</div>
            <div style="font-size: 0.74rem; color: #9ca3af; margin-top: 2px;">
              Specify which blog posts will inherit this layout design and structure.
            </div>
          </div>
          <button type="button" class="modal-close-btn" id="btnCloseAssignModal">&times;</button>
        </div>
        <div class="modal-body">
          <div style="display: flex; gap: 8px; margin-bottom: 12px;">
            <input type="text" id="inputSearchAssignPosts" placeholder="Search blog posts by title or category..." style="flex: 1; padding: 7px 12px; background: #1c222e; border: 1px solid #2a3344; border-radius: 6px; color: #f3f4f6; font-size: 0.8rem;" />
            <button type="button" class="btn-secondary" id="btnSelectAllPosts" style="font-size: 0.74rem;">Select All</button>
            <button type="button" class="btn-secondary" id="btnDeselectAllPosts" style="font-size: 0.74rem;">Clear All</button>
          </div>

          <!-- List of blog posts -->
          <div id="assignPostsListContainer" style="max-height: 340px; overflow-y: auto;">
            {postsList.map(p => {
              const isAppliedHere = activeLayout.appliedPostSlugs?.includes(p.slug);
              return (
                <label class={`post-assign-item ${isAppliedHere ? 'selected' : ''}`} data-post-slug={p.slug} data-post-title={p.title.toLowerCase()} data-post-cat={p.category.toLowerCase()}>
                  <input type="checkbox" class="post-assign-checkbox" value={p.slug} checked={isAppliedHere} style="cursor: pointer; width: 16px; height: 16px;" />
                  <img src={p.image} alt={p.title} class="post-thumb-img" />
                  <div class="post-assign-info">
                    <div class="post-assign-title">{p.title}</div>
                    <div class="post-assign-meta">
                      <span>📁 {p.category}</span>
                      <span>📅 {p.formattedDate}</span>
                    </div>
                  </div>
                  <div>
                    {isAppliedHere ? (
                      <span class="post-badge-layout this-layout">✓ This Layout</span>
                    ) : p.layoutId ? (
                      <span class="post-badge-layout other-layout">Other Layout</span>
                    ) : (
                      <span class="post-badge-layout blank">Blank Canvas</span>
                    )}
                  </div>
                </label>
              );
            })}
          </div>

          <div style="margin-top: 14px; padding: 12px; background: #181d28; border-radius: 8px; border: 1px solid #262e3d;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.82rem; color: #f3f4f6;">
              <input type="checkbox" id="checkSetAsDefaultLayout" checked={activeLayout.isDefault} style="width: 16px; height: 16px;" />
              <span style="font-weight: 600;">Set this layout as Default for all new standard blog posts</span>
            </label>
            <div style="font-size: 0.72rem; color: #9ca3af; margin-left: 24px; margin-top: 3px;">
              Newly created blog posts with "Standard Layout" mode will automatically use this layout.
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="btnCancelAssign">Cancel</button>
          <button type="button" class="btn-primary-action" id="btnSavePostAssignments">Save Post Assignments</button>
        </div>
      </div>
    </div>

    <!-- MODAL: CREATE NEW LAYOUT -->
    <div class="custom-modal-backdrop" id="modalNewLayout">
      <div class="custom-modal-box" style="max-width: 500px;">
        <div class="modal-header">
