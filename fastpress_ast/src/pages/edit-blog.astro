      }

      .pm-post-meta-bottom {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 3px;
        font-size: 0.72rem;
        color: #6b7280;
        flex-wrap: wrap;
      }

      .pm-author-mini {
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }

      .pm-author-avatar {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        object-fit: cover;
      }

      .pm-author-name {
        color: #d1d5db;
        font-weight: 600;
      }

      .pm-slug-text {
        color: #6b7280;
