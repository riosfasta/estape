        </div>
        <div id="tab-layers" class="tab-pane">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <span class="panel-header-title" style="margin: 0; font-size: 0.78rem; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px;">Element Hierarchy Tree</span>
            <span class="layer-active-badge" id="layerActiveBadge" style="display: none;">Selected</span>
          </div>

          <!-- Layer Toolbar Actions -->
          <div class="layer-actions-toolbar" id="layerActionsToolbar">
            <button type="button" class="btn-layer-tool primary" id="btnLayerCopy" title="Copy Layer to Clipboard (Ctrl+C)" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy</span>
            </button>

            <button type="button" class="btn-layer-tool success" id="btnLayerPasteBelow" title="Paste as Sibling Below (Ctrl+V)" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 10 4 15 9 20"></polyline>
                <path d="M20 4v7a4 4 0 0 1-4 4H4"></path>
              </svg>
              <span>Paste</span>
            </button>

            <button type="button" class="btn-layer-tool inside" id="btnLayerPasteInside" title="Paste as Child Inside Container" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Inside</span>
            </button>

            <button type="button" class="btn-layer-tool duplicate" id="btnLayerDuplicate" title="Duplicate Layer (Ctrl+D)" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <rect x="3" y="3" width="13" height="13" rx="2" ry="2"></rect>
              </svg>
              <span>Duplicate</span>
            </button>

            <button type="button" class="btn-layer-tool danger" id="btnLayerDelete" title="Delete Layer (Del)" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span>Delete</span>
            </button>
          </div>

          <!-- Cross-Page / Cross-Post Clipboard Banner -->
          <div class="layer-clipboard-banner" id="layerClipboardBanner" style="display: none;">
            <div class="clipboard-banner-left">
              <span class="clipboard-banner-icon">📋</span>
              <div class="clipboard-banner-info">
                <div class="clipboard-banner-title">
                  <span>Clipboard:</span>
                  <strong id="clipboardLayerName">Section</strong>
                  <span class="clipboard-source-pill" id="clipboardSourcePill">from Post</span>
                </div>
                <div class="clipboard-banner-desc">Ready to paste here or across pages/posts</div>
              </div>
            </div>
            <button type="button" class="btn-clipboard-clear" id="btnClearLayerClipboard" title="Clear Clipboard">&times;</button>
          </div>

          <div id="layers-container"></div>
        </div>
      </aside>
    </main>

    <!-- Modal: New Post -->
    <div id="modalNewPost" class="modal-backdrop">
      <div class="modal-card">
        <div class="modal-header">
          <h3 class="modal-title">Create New Post</h3>
          <button type="button" class="modal-close" data-close="modalNewPost">&times;</button>
        </div>
        <form id="formNewPost">
          <div class="modal-body">
            <!-- Post Layout Mode Selection -->
            <div class="form-group" style="padding: 12px 14px; background: #1a1e28; border: 1px solid #2d3444; border-radius: 8px; margin-bottom: 14px;">
              <label class="form-label" style="font-weight: 700; color: #10b981; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                Post Layout Mode
              </label>
              <div style="display: flex; flex-direction: column; gap: 8px;">
                <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;">
                  <input type="radio" name="newPostLayoutMode" value="standard" checked style="margin-top: 3px; accent-color: #10b981;" />
                  <div>
                    <div style="font-size: 0.82rem; font-weight: 700; color: #f3f4f6;">Standard Layout (Recommended)</div>
                    <div style="font-size: 0.72rem; color: #9ca3af;">Inherit reusable layout template. Editing the standard layout updates appearance for all posts under it.</div>
                  </div>
                </label>
                <div id="newPostStandardLayoutSelectWrap" style="margin-left: 24px;">
                  <select id="newPostLayoutId" class="form-input" style="font-size: 0.78rem; padding: 6px 10px;">
                    {blogLayoutsList.map(l => (
                      <option value={l.id}>{l.name} {l.isDefault ? '(Default)' : ''}</option>
                    ))}
                  </select>
                </div>
                <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;">
                  <input type="radio" name="newPostLayoutMode" value="blank" style="margin-top: 3px; accent-color: #10b981;" />
                  <div>
                    <div style="font-size: 0.82rem; font-weight: 700; color: #f3f4f6;">Built from scratch (Blank Canvas)</div>
                    <div style="font-size: 0.72rem; color: #9ca3af;">Design this single post independently with a freeform blank canvas.</div>
                  </div>
                </label>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Post Title</label>
              <input type="text" id="newPostTitle" class="form-input" placeholder="e.g. Modern Branding Strategies 2026" required />
            </div>

            <div class="form-group">
              <label class="form-label">URL Slug</label>
              <input type="text" id="newPostSlug" class="form-input" placeholder="modern-branding-strategies-2026" required />
            </div>

            <div class="form-group">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label class="form-label" style="margin-bottom: 0;">Post Categories (Multi-select)</label>
                <span style="font-size: 0.72rem; color: #9ca3af;">Select one or more categories</span>
              </div>
              <div class="category-manager-box">
                <div class="category-list-wrap" id="newPostCategoriesList">
                  <!-- Rendered dynamically by JavaScript -->
                </div>
                <div class="add-category-row">
                  <input type="text" id="inputNewCatNameNew" class="input-new-cat-name" placeholder="Category name (e.g. Strategy)" />
                  <input type="text" id="inputNewCatSlugNew" class="input-new-cat-slug" placeholder="Slug (e.g. strategy)" />
                  <button type="button" class="btn-add-category" id="btnAddCategoryNew">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Add</span>
                  </button>
                </div>
              </div>
              <input type="hidden" id="newPostCategory" value="Branding" />
            </div>

            <div class="form-group">
              <label class="form-label">Featured Image</label>
              <div class="image-upload-wrapper">
                <div class="image-preview-card" id="newPostPreviewCard" title="Drag & drop image file here or click Upload">
                  <img id="newPostImagePreview" src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=80" alt="Image Preview" class="image-preview-img" />
                  <div class="image-upload-overlay">
                    <button type="button" class="btn-upload-file" id="btnTriggerNewUpload">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                      <span>Select Image File</span>
                    </button>
                  </div>
                </div>

                <div class="image-upload-input-row">
                  <input type="text" id="newPostImage" class="form-input" style="flex: 1;" value="https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=80" placeholder="Enter image URL or upload file..." required />
                  <input type="file" id="newPostFileInput" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,image/avif" style="display: none;" />
                  <button type="button" class="btn-upload-file" id="btnUploadNewPostFile" title="Upload image from computer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                    <span>Upload</span>
                  </button>
                  <button type="button" class="btn-upload-file" id="btnOpenMediaNewPost" title="Select from Media Library">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    <span>Media Library</span>
                  </button>
                </div>

                <div id="newPostUploadStatus" class="upload-spinner">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                  <span>Uploading image to project...</span>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Summary / Excerpt</label>
              <textarea id="newPostExcerpt" class="form-textarea" rows="2" placeholder="Brief summary for post card preview and SEO description..." required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Article Tags</label>
                <input type="text" id="newPostTags" class="form-input" placeholder="Branding, Design, Identity (comma-separated)" />
                <span style="font-size: 0.74rem; color: #6b7280; margin-top: 4px; display: block;">Separate tags with commas (,).</span>
              </div>
              <div class="form-group">
                <label class="form-label">Meta Keywords (SEO)</label>
                <input type="text" id="newPostKeywords" class="form-input" placeholder="branding strategy, visual identity, modern logo" />
                <span style="font-size: 0.74rem; color: #6b7280; margin-top: 4px; display: block;">Automatically added to &lt;meta name="keywords"&gt; for SEO.</span>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" data-close="modalNewPost">Cancel</button>
            <button type="submit" class="btn-primary">Create & Open Editor</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal: Post Settings -->
    <div id="modalPostSettings" class="modal-backdrop">
      <div class="modal-card">
        <div class="modal-header">
          <h3 class="modal-title">Post Settings</h3>
          <button type="button" class="modal-close" data-close="modalPostSettings">&times;</button>
        </div>
        <form id="formPostSettings">
          <div class="modal-body">
            <!-- Post Layout Mode Selection -->
            <div class="form-group" style="padding: 12px 14px; background: #1a1e28; border: 1px solid #2d3444; border-radius: 8px; margin-bottom: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label class="form-label" style="font-weight: 700; color: #10b981; margin-bottom: 0; display: flex; align-items: center; gap: 6px;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                  Post Layout Mode
                </label>
                <a href={`/blog-layout-editor?id=${activeLayoutId}`} target="_blank" style="font-size: 0.72rem; color: #34d399; text-decoration: none; font-weight: 600;">Edit Standard Layout ↗</a>
              </div>
              <div style="display: flex; flex-direction: column; gap: 8px;">
                <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;">
                  <input type="radio" name="editPostLayoutMode" value="standard" checked={activePost.layoutMode !== 'blank'} style="margin-top: 3px; accent-color: #10b981;" />
                  <div>
                    <div style="font-size: 0.82rem; font-weight: 700; color: #f3f4f6;">Standard Layout</div>
                    <div style="font-size: 0.72rem; color: #9ca3af;">Inherits template. Modifying the standard layout updates appearance for all assigned posts.</div>
                  </div>
                </label>
                <div id="editPostStandardLayoutSelectWrap" style="margin-left: 24px;">
                  <select id="editPostLayoutId" class="form-input" style="font-size: 0.78rem; padding: 6px 10px;">
                    {blogLayoutsList.map(l => (
                      <option value={l.id} selected={l.id === activeLayoutId}>{l.name} {l.isDefault ? '(Default)' : ''}</option>
                    ))}
                  </select>
                </div>
                <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;">
                  <input type="radio" name="editPostLayoutMode" value="blank" checked={activePost.layoutMode === 'blank'} style="margin-top: 3px; accent-color: #10b981;" />
                  <div>
                    <div style="font-size: 0.82rem; font-weight: 700; color: #f3f4f6;">Built from scratch (Blank Canvas)</div>
                    <div style="font-size: 0.72rem; color: #9ca3af;">Design this single post independently without standard layout constraints.</div>
                  </div>
                </label>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Post Title</label>
              <input type="text" id="editPostTitle" class="form-input" value={activePost.title} required />
            </div>

            <div class="form-group">
              <label class="form-label">URL Slug (/blog/[slug])</label>
              <input type="text" id="editPostSlug" class="form-input" value={activePost.slug} required />
            </div>

            <div class="form-group">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label class="form-label" style="margin-bottom: 0;">Post Categories (Multi-select)</label>
                <span style="font-size: 0.72rem; color: #9ca3af;">Select one or more categories</span>
              </div>
              <div class="category-manager-box">
                <div class="category-list-wrap" id="editPostCategoriesList">
                  <!-- Rendered dynamically by JavaScript -->
                </div>
                <div class="add-category-row">
                  <input type="text" id="inputNewCatNameEdit" class="input-new-cat-name" placeholder="Category name (e.g. Strategy)" />
                  <input type="text" id="inputNewCatSlugEdit" class="input-new-cat-slug" placeholder="Slug (e.g. strategy)" />
                  <button type="button" class="btn-add-category" id="btnAddCategoryEdit">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Add</span>
                  </button>
                </div>
              </div>
              <input type="hidden" id="editPostCategory" value={activePost.category} />
            </div>

            <div class="form-group">
              <label class="form-label">Featured Image</label>
              <div class="image-upload-wrapper">
                <div class="image-preview-card" id="editPostPreviewCard" title="Drag & drop image file here or click Upload">
                  <img id="editPostImagePreview" src={activePost.image} alt="Image Preview" class="image-preview-img" />
                  <div class="image-upload-overlay">
                    <button type="button" class="btn-upload-file" id="btnTriggerEditUpload">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                      <span>Select Image File</span>
                    </button>
                  </div>
                </div>

                <div class="image-upload-input-row">
                  <input type="text" id="editPostImage" class="form-input" style="flex: 1;" value={activePost.image} placeholder="Enter image URL or upload file..." required />
                  <input type="file" id="editPostFileInput" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,image/avif" style="display: none;" />
                  <button type="button" class="btn-upload-file" id="btnUploadEditPostFile" title="Upload image from computer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                    <span>Upload</span>
                  </button>
                  <button type="button" class="btn-upload-file" id="btnOpenMediaEditPost" title="Select from Media Library">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    <span>Media Library</span>
                  </button>
                </div>

                <div id="editPostUploadStatus" class="upload-spinner">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                  <span>Uploading image to project...</span>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Summary / Excerpt</label>
              <textarea id="editPostExcerpt" class="form-textarea" rows="2" required>{activePost.excerpt}</textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Article Tags</label>
                <input type="text" id="editPostTags" class="form-input" value={Array.isArray(activePost.tags) ? activePost.tags.join(', ') : (activePost.tags || '')} placeholder="Branding, Design, Identity (comma-separated)" />
                <span style="font-size: 0.74rem; color: #6b7280; margin-top: 4px; display: block;">Separate tags with commas (,).</span>
              </div>
              <div class="form-group">
                <label class="form-label">Meta Keywords (SEO)</label>
                <input type="text" id="editPostKeywords" class="form-input" value={activePost.keywords || ''} placeholder="branding strategy, visual identity, modern logo" />
                <span style="font-size: 0.74rem; color: #6b7280; margin-top: 4px; display: block;">Automatically added to &lt;meta name="keywords"&gt; on live page.</span>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Read Time</label>
                <input type="text" id="editPostReadTime" class="form-input" value={activePost.readTime} />
              </div>
              <div class="form-group">
                <label class="form-label">Display Date (Formatted)</label>
                <input type="text" id="editPostFormattedDate" class="form-input" value={activePost.formattedDate} />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Author Name</label>
                <input type="text" id="editPostAuthorName" class="form-input" value={activePost.author?.name || 'Better Team'} />
              </div>
              <div class="form-group">
                <label class="form-label">Author Role</label>
                <input type="text" id="editPostAuthorRole" class="form-input" value={activePost.author?.role || 'Head of Content'} />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Author Avatar URL</label>
              <div class="image-upload-input-row">
                <input type="text" id="editPostAuthorAvatar" class="form-input" style="flex: 1;" value={activePost.author?.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=240&h=240&q=80'} />
                <input type="file" id="editAuthorAvatarFileInput" accept="image/*" style="display: none;" />
                <button type="button" class="btn-upload-file" id="btnUploadAuthorAvatarFile" title="Upload author avatar from computer">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                  <span>Upload</span>
                </button>
                <button type="button" class="btn-upload-file" id="btnOpenMediaAuthorAvatar" title="Select from Media Library">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                  <span>Library</span>
                </button>
              </div>
            </div>

            <!-- Related Articles Section Settings -->
            <div class="form-group" style="padding: 14px 16px; background: rgba(255, 94, 58, 0.05); border: 1px solid rgba(255, 94, 58, 0.25); border-radius: 8px; margin-bottom: 18px;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                <label class="form-label" style="margin-bottom: 0; font-weight: 700; color: #ff5e3a; display: flex; align-items: center; gap: 6px; font-size: 0.82rem;">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                  Related Articles Section (Rekomendasi Artikel Terkait)
                </label>
                <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 0.78rem; font-weight: 600; color: #e5e7eb;">
                  <input type="checkbox" id="editPostShowRelated" checked={activePost.showRelated !== false} style="accent-color: #ff5e3a; width: 15px; height: 15px; cursor: pointer;" />
                  <span>Show Section</span>
                </label>
              </div>
              <div class="form-row" style="margin-bottom: 10px;">
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.72rem; color: #9ca3af;">Tagline (e.g. REKOMENDASI)</label>
                  <input type="text" id="editPostRelatedTagline" class="form-input" value={activePost.relatedTagline || 'REKOMENDASI'} placeholder="REKOMENDASI" />
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.72rem; color: #9ca3af;">Section Title (e.g. Artikel Terkait)</label>
                  <input type="text" id="editPostRelatedTitle" class="form-input" value={activePost.relatedTitle || 'Artikel Terkait'} placeholder="Artikel Terkait" />
                </div>
              </div>

              <!-- Filter Dinamis: Kategori, Sorting (Asc/Desc), dan Limit -->
              <div class="form-row" style="margin-bottom: 6px;">
                <div class="form-group" style="flex: 1.4; margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.72rem; color: #9ca3af;">Filter Kategori Artikel</label>
                  <select id="editPostRelatedCategory" class="form-input" style="background-color: #0d1117; cursor: pointer;">
                    <option value="auto" selected={!activePost.relatedCategory || activePost.relatedCategory === 'auto'}>⚡ Otomatis (Kategori Sama dengan Post)</option>
                    <option value="all" selected={activePost.relatedCategory === 'all'}>🌐 Semua Kategori (All Categories)</option>
                    {categoriesList.map(cat => (
                      <option value={cat.name} selected={activePost.relatedCategory === cat.name}>📁 {cat.name}</option>
                    ))}
                  </select>
                </div>
                <div class="form-group" style="flex: 1.3; margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.72rem; color: #9ca3af;">Urutan Artikel (Sort Order)</label>
                  <select id="editPostRelatedOrderBy" class="form-input" style="background-color: #0d1117; cursor: pointer;">
                    <option value="date-desc" selected={!activePost.relatedOrderBy || activePost.relatedOrderBy === 'date-desc'}>📅 Tanggal Terbaru (Desc)</option>
                    <option value="date-asc" selected={activePost.relatedOrderBy === 'date-asc'}>📅 Tanggal Terlama (Asc)</option>
                    <option value="title-asc" selected={activePost.relatedOrderBy === 'title-asc'}>🔤 Judul A - Z (Asc)</option>
                    <option value="title-desc" selected={activePost.relatedOrderBy === 'title-desc'}>🔤 Judul Z - A (Desc)</option>
                    <option value="random" selected={activePost.relatedOrderBy === 'random'}>🎲 Acak (Random)</option>
                  </select>
                </div>
                <div class="form-group" style="flex: 0.8; margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.72rem; color: #9ca3af;">Jumlah Tampil</label>
                  <select id="editPostRelatedLimit" class="form-input" style="background-color: #0d1117; cursor: pointer;">
                    <option value="2" selected={Number(activePost.relatedLimit) === 2 || !activePost.relatedLimit}>2 Artikel</option>
                    <option value="3" selected={Number(activePost.relatedLimit) === 3}>3 Artikel</option>
                    <option value="4" selected={Number(activePost.relatedLimit) === 4}>4 Artikel</option>
                  </select>
                </div>
              </div>
              <span style="font-size: 0.72rem; color: #9ca3af; margin-top: 6px; display: block;">💡 Rekomendasi artikel ter-update otomatis secara dinamis sesuai kategori dan urutan (asc / desc) yang dipilih.</span>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" data-close="modalPostSettings">Cancel</button>
            <button type="submit" class="btn-primary">Apply Settings</button>
          </div>
        </form>
      </div>
    </div>

