        media: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="4 4"></rect><circle cx="10" cy="12" r="2.5"></circle><circle cx="14" cy="12" r="2.5"></circle></svg>`,
