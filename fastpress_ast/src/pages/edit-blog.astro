      // ============================================
      // Category Checkboxes Rendering & Event Management
      // ============================================
      function renderCategoryCheckboxes(containerId, selectedCategories = []) {
        const container = document.getElementById(containerId);
        if (!container) return;

        // Normalisasi kategori yang dipilih ke lowercase
        const selectedNorm = (selectedCategories || []).map(s => String(s).toLowerCase().trim());

        if (!categoriesData || categoriesData.length === 0) {
          container.innerHTML = `
            <div style="padding: 12px; text-align: center; color: #9ca3af; font-size: 0.78rem;">
              No categories available. Add a new one below.
            </div>
          `;
          return;
        }

        let html = '';
        categoriesData.forEach(cat => {
          const isChecked = selectedNorm.includes(cat.name.toLowerCase()) || selectedNorm.includes(cat.slug.toLowerCase());
          const isDefault = cat.slug.toLowerCase() === 'uncategorized' || cat.name.toLowerCase() === 'uncategorized';
          html += `
            <div class="category-checkbox-item ${isChecked ? 'is-checked' : ''}" data-slug="${escapeHtml(cat.slug)}" data-name="${escapeHtml(cat.name)}">
              <input 
                type="checkbox" 
                id="cb_${containerId}_${escapeHtml(cat.slug)}" 
                value="${escapeHtml(cat.name)}" 
                data-slug="${escapeHtml(cat.slug)}" 
                ${isChecked ? 'checked' : ''} 
              />
              <label for="cb_${containerId}_${escapeHtml(cat.slug)}">
                ${escapeHtml(cat.name)}
              </label>
              <span class="cat-slug-badge">/${escapeHtml(cat.slug)}</span>
              ${isDefault ? `
                <span class="cat-default-badge" title="Default fallback category (cannot be deleted)">DEFAULT</span>
              ` : `
                <button type="button" class="btn-del-category" data-slug="${escapeHtml(cat.slug)}" data-name="${escapeHtml(cat.name)}" title="Delete category">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              `}
            </div>
          `;
        });

        container.innerHTML = html;

        // Pasang listener untuk tiap item checkbox
        container.querySelectorAll('.category-checkbox-item').forEach(item => {
          const cb = item.querySelector('input[type="checkbox"]');
          const delBtn = item.querySelector('.btn-del-category');

          cb.addEventListener('change', () => {
            if (cb.checked) {
              item.classList.add('is-checked');
            } else {
              item.classList.remove('is-checked');
            }
          });

          if (delBtn) {
            delBtn.addEventListener('click', async (e) => {
              e.stopPropagation();
              e.preventDefault();
              const slugToDelete = delBtn.dataset.slug;
              const nameToDelete = delBtn.dataset.name;

              if (!confirm(`Delete category "${nameToDelete}"?\n\nPosts using only this category will automatically be moved to "Uncategorized".`)) {
                return;
              }

              try {
                const res = await fetch('/api/categories', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'delete', slug: slugToDelete })
                });
                const data = await res.json();
                if (data.success) {
                  categoriesData = data.categories || categoriesData.filter(c => c.slug !== slugToDelete);
                  showToast(data.message || `Category "${nameToDelete}" deleted!`);

                  // Sinkronkan daftar artikel di memori browser jika ada artikel yang diperbarui
                  if (Array.isArray(data.updatedPosts)) {
                    allPosts.length = 0;
                    allPosts.push(...data.updatedPosts);

                    // Cek apakah activePost ikut terpengaruh oleh penghapusan kategori
                    const currentActive = data.updatedPosts.find(p => p.slug === activePost.slug || p.id === activePost.id);
                    if (currentActive) {
                      activePost.category = currentActive.category;
                      activePost.categories = currentActive.categories;
                      activePost.categorySlugs = currentActive.categorySlugs;

                      // Update badge visual kategori di canvas artikel aktif
                      const frameDoc = editor.Canvas.getDocument();
                      if (frameDoc) {
                        const catContainer = frameDoc.getElementById('canvas-post-categories');
                        if (catContainer) {
                          catContainer.innerHTML = renderCanvasCategories(activePost);
                        }
                        const breadcrumbCat = frameDoc.getElementById('canvas-breadcrumb-category');
                        if (breadcrumbCat) {
                          breadcrumbCat.textContent = getPostCategoriesArray(activePost)[0] || 'Uncategorized';
                        }
                      }
                    }
                  }

                  let currentCheckedEdit = Array.from(document.querySelectorAll('#editPostCategoriesList input:checked')).map(c => c.value);
                  let currentCheckedNew = Array.from(document.querySelectorAll('#newPostCategoriesList input:checked')).map(c => c.value);

                  currentCheckedEdit = currentCheckedEdit.filter(c => c.toLowerCase() !== nameToDelete.toLowerCase());
                  if (currentCheckedEdit.length === 0) currentCheckedEdit = ['Uncategorized'];

                  currentCheckedNew = currentCheckedNew.filter(c => c.toLowerCase() !== nameToDelete.toLowerCase());
                  if (currentCheckedNew.length === 0) currentCheckedNew = ['Uncategorized'];

                  renderCategoryCheckboxes('editPostCategoriesList', currentCheckedEdit);
                  renderCategoryCheckboxes('newPostCategoriesList', currentCheckedNew);
                  initPmCategories();
                  renderPostsManager();
                } else {
                  showToast(data.error || 'Failed to delete category', true);
                }
              } catch (err) {
                showToast('Error deleting category', true);
              }
            });
          }
        });
      }

      // Handler Tambah Kategori Baru
      async function handleAddCategory(nameInputId, slugInputId, targetListId) {
        const nameInput = document.getElementById(nameInputId);
        const slugInput = document.getElementById(slugInputId);
        const name = (nameInput?.value || '').trim();
        let slug = (slugInput?.value || '').trim();

        if (!name) {
          showToast('Please enter a category name.', true);
          nameInput?.focus();
          return;
        }

        if (!slug) {
          slug = name.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
        }

        try {
          const res = await fetch('/api/categories', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'create', name, slug })
          });
          const data = await res.json();
          if (data.success) {
            categoriesData.push(data.category);
            if (nameInput) nameInput.value = '';
            if (slugInput) slugInput.value = '';
            showToast(`Category "${name}" created!`);

            const currentCheckedEdit = Array.from(document.querySelectorAll('#editPostCategoriesList input:checked')).map(c => c.value);
            const currentCheckedNew = Array.from(document.querySelectorAll('#newPostCategoriesList input:checked')).map(c => c.value);

            if (targetListId === 'editPostCategoriesList') {
              currentCheckedEdit.push(name);
            } else {
              currentCheckedNew.push(name);
            }

            renderCategoryCheckboxes('editPostCategoriesList', currentCheckedEdit);
            renderCategoryCheckboxes('newPostCategoriesList', currentCheckedNew);
            initPmCategories();
          } else {
            showToast(data.error || 'Failed to create category', true);
          }
        } catch (err) {
          showToast('Error creating category', true);
        }
      }

