        .catch(() => {});

      // ========================================================
      // 1. EMPTY WORKSPACE DROPZONE TEMPLATE & HEADING TYPE
      // ========================================================
      const EMPTY_WORKSPACE_HTML = `
<div class="empty-workspace-dropzone" id="emptyWorkspaceDropzone" style="border: 2px dashed #cdd5e0; border-radius: 6px; padding: 42px 20px; margin: 30px auto; max-width: 960px; min-height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; background: #ffffff; user-select: none;">
  <div class="dropzone-buttons-row" data-gjs-layerable="false" data-gjs-selectable="false" data-gjs-hoverable="false" data-gjs-highlightable="false" data-gjs-badgable="false" data-gjs-draggable="false" data-gjs-droppable="false" data-gjs-copyable="false" data-gjs-removable="false" style="display: flex; align-items: center; gap: 14px;">
