      function renderPostSchemasUI() {
        renderPostSchemaTabs();
        renderPostSchemaContent();
        updatePostSchemaPreview();
      }

      function renderPostSchemaTabs() {
        if (!postSchemaTabsBar) return;
        postSchemaTabsBar.innerHTML = '';

        postSchemas.forEach((item, idx) => {
          const pill = document.createElement('div');
          pill.className = `schema-tab-pill ${idx === activePostSchemaIdx ? 'active' : ''}`;
          const icon = POST_SCHEMA_TYPE_ICONS[item.type] || '⚡';
          pill.innerHTML = `
            <span>${icon} #${idx + 1} ${item.type}</span>
            <button type="button" class="schema-tab-del-btn" title="Remove schema">&times;</button>
          `;

          pill.addEventListener('click', (e) => {
            if (e.target.classList.contains('schema-tab-del-btn')) {
              e.stopPropagation();
              if (confirm(`Delete Schema #${idx + 1} (${item.type})?`)) {
                postSchemas.splice(idx, 1);
                if (activePostSchemaIdx >= postSchemas.length) {
                  activePostSchemaIdx = postSchemas.length - 1;
                }
                renderPostSchemasUI();
              }
              return;
            }
            activePostSchemaIdx = idx;
            renderPostSchemasUI();
          });

          postSchemaTabsBar.appendChild(pill);
        });

        // Add Schema Button
        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'btn-add-schema-tab';
        addBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add Schema</span>
        `;
        addBtn.addEventListener('click', () => {
          const hasArticle = postSchemas.some(s => s.type === 'Article');
          const newType = hasArticle ? 'FAQPage' : 'Article';
          const defaultObj = createDefaultPostSchemaObject(newType);
          postSchemas.push({
            id: 'bts_' + Math.random().toString(36).substring(2, 9),
            type: newType,
            mode: 'visual',
            code: JSON.stringify(defaultObj, null, 2)
          });
          activePostSchemaIdx = postSchemas.length - 1;
          renderPostSchemasUI();
        });
        postSchemaTabsBar.appendChild(addBtn);
      }

