      // Helper untuk memastikan dan menyinkronkan section Rekomendasi Artikel Terkait di canvas
      function syncRelatedSectionVisibility(refreshCards = false) {
        const wrapper = editor.getWrapper();
        if (!wrapper) return;
        const frameDoc = editor.Canvas.getDocument();

        let existingRelated = wrapper.find('#canvas-related-posts')[0] || wrapper.find('.related-posts-section')[0];

        if (activePost.showRelated !== false) {
          if (!existingRelated) {
            const relHtml = generateRelatedSectionHTML(activePost);
            if (relHtml) {
              const articleComp = wrapper.find('.single-post-article')[0];
              if (articleComp) {
                try {
                  articleComp.append(relHtml);
                } catch (e) {
                  articleComp.components().add(relHtml);
                }
              } else {
                try {
                  wrapper.append(relHtml);
                } catch (e) {
                  editor.addComponents(relHtml);
                }
              }
              existingRelated = wrapper.find('#canvas-related-posts')[0] || wrapper.find('.related-posts-section')[0];
            }
          }

          if (existingRelated) {
            existingRelated.addStyle({ display: 'block' });
            const curTag = existingRelated.find('#canvas-related-tagline')[0] || existingRelated.find('.section-tagline')[0];
            if (curTag) curTag.components(escapeHtml(activePost.relatedTagline || 'REKOMENDASI'));
            const curTitle = existingRelated.find('#canvas-related-title')[0] || existingRelated.find('.section-title')[0];
            if (curTitle) curTitle.components(escapeHtml(activePost.relatedTitle || 'Artikel Terkait'));

            if (refreshCards) {
              const curGrid = existingRelated.find('#canvas-related-grid')[0] || existingRelated.find('.related-grid')[0];
              if (curGrid) {
                const dynamicPosts = getFilteredRelatedPosts(activePost);
                curGrid.components(generateRelatedCardsHTML(dynamicPosts));
              }
            }
          }

          if (frameDoc) {
            const relEl = frameDoc.getElementById('canvas-related-posts') || frameDoc.querySelector('.related-posts-section');
            if (relEl) {
              relEl.style.display = 'block';
              const tagEl = relEl.querySelector('#canvas-related-tagline, .section-tagline');
              if (tagEl) tagEl.innerText = activePost.relatedTagline || 'REKOMENDASI';
              const titleEl = relEl.querySelector('#canvas-related-title, .section-title');
              if (titleEl) titleEl.innerText = activePost.relatedTitle || 'Artikel Terkait';

              if (refreshCards) {
                const gridEl = relEl.querySelector('#canvas-related-grid, .related-grid');
                if (gridEl) {
                  const dynamicPosts = getFilteredRelatedPosts(activePost);
                  gridEl.innerHTML = generateRelatedCardsHTML(dynamicPosts);
                }
              }
            }
          }
        } else {
          if (existingRelated) {
            existingRelated.addStyle({ display: 'none' });
          }
          if (frameDoc) {
            const relEl = frameDoc.getElementById('canvas-related-posts') || frameDoc.querySelector('.related-posts-section');
            if (relEl) relEl.style.display = 'none';
          }
        }
      }

      // Injeksi Google Fonts & Canvas Resets ke dalam iframe canvas GrapesJS
      editor.on('load', () => {
        const frameDoc = editor.Canvas.getDocument();
        if (frameDoc && frameDoc.head) {
          // Reset margin body di canvas agar tidak ada space kosong berlebih
          const resetStyle = frameDoc.createElement('style');
          resetStyle.innerHTML = `
            body {
              margin: 0 !important;
              padding: 0 !important;
            }
          `;
          frameDoc.head.appendChild(resetStyle);

          const fontLink = frameDoc.createElement('link');
          fontLink.rel = 'stylesheet';
          fontLink.href = 'https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Plus+Jakarta Sans:wght@400;500;600;700&display=swap';
          frameDoc.head.appendChild(fontLink);

          fontsList.forEach(font => {
            if (font.type === 'google' && font.url) {
              const l = frameDoc.createElement('link');
              l.rel = 'stylesheet';
              l.href = font.url;
              frameDoc.head.appendChild(l);
            }
          });
        }

        // Inject canvas styles for locked layout elements & content editable boundary
        const layoutStyle = frameDoc.createElement('style');
        layoutStyle.innerHTML = `
          .layout-locked-element,
          [data-layout-locked="true"],
          .post-header-wrap,
          #canvas-featured-wrap,
          .author-bio-card,
          #canvas-related-posts,
          .related-posts-section {
            user-select: none !important;
          }
          .layout-locked-element.gjs-hovered,
          .post-header-wrap.gjs-hovered,
          #canvas-featured-wrap.gjs-hovered,
          .author-bio-card.gjs-hovered {
            outline: 1px dashed rgba(255, 94, 58, 0.45) !important;
            outline-offset: -1px;
          }
          #article-content-body {
            outline: 1px dashed rgba(16, 185, 129, 0.35) !important;
            outline-offset: 4px;
            min-height: 200px;
          }
        `;
        frameDoc.head.appendChild(layoutStyle);

        // Prevent double-click editing on auto-generated elements
        frameDoc.addEventListener('dblclick', (e) => {
          if (activePost.layoutMode !== 'blank') {
            const bodyContainer = frameDoc.getElementById('article-content-body') || frameDoc.querySelector('[data-post-element="content"]');
            if (bodyContainer && !bodyContainer.contains(e.target)) {
              e.preventDefault();
              e.stopPropagation();
              showToast('🔒 This section is auto-generated by the layout. Edit it in Post Settings ⚙️.');
            }
          }
        }, true);

        // Pastikan section Rekomendasi Artikel Terkait tersinkronisasi saat iframe canvas selesai dimuat
        syncRelatedSectionVisibility();

        if (activePost.layoutMode !== 'blank') {
          enforceStandardLayoutLocking(editor);
        }

        // Inisialisasi sistem copy-paste layer & cross-page/post clipboard
        if (typeof initLayerClipboardSystem === 'function') {
          initLayerClipboardSystem();
        }

        // Attach event listener ke button Empty Workspace Dropzone
        attachDropzoneEvents();
      });

      // Muat konten awal artikel
      if (activePost.layoutMode === 'blank') {
        const hasPollutedHeader = activePost.projectData && JSON.stringify(activePost.projectData).includes('post-header-wrap');
        if (activePost.projectData && !hasPollutedHeader) {
          editor.loadProjectData(activePost.projectData);
        } else {
          editor.setComponents(generateBlogCanvasHTML(activePost));
          if (activePost.css) {
            editor.setStyle(activePost.css);
          }
        }
      } else {
        if (activePost.projectData) {
          editor.loadProjectData(activePost.projectData);
          syncRelatedSectionVisibility();
        } else {
          editor.setComponents(generateBlogCanvasHTML(activePost));
          if (activePost.css) {
            editor.setStyle(activePost.css);
          }
        }
        enforceStandardLayoutLocking(editor);
      }

      // Sidebar Tab Switcher
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          const tab = btn.dataset.tab;
          document.getElementById('tab-' + tab).classList.add('active');
          if (tab === 'layers') {
            if (typeof updateLayerClipboardUI === 'function') updateLayerClipboardUI();
            if (typeof updateLayerSelectionUI === 'function') updateLayerSelectionUI(editor.getSelected());
          }
        });
      });

      // Device Switcher
      document.querySelectorAll('.device-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.device-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          editor.setDevice(btn.dataset.device);
        });
      });

      // ============================================
      // Posts Manager (Search, Filter, Pagination)
      // ============================================
      let pmPosts = [...allPosts];
      let pmSearchQuery = '';
      let pmCategory = 'all';
      let pmSort = 'date-desc';
      let pmPerPage = 10;
      let pmCurrentPage = 1;

      // Inisialisasi dropdown kategori dari daftar master kategori & artikel
      function initPmCategories() {
        const catSelect = document.getElementById('pmCategoryFilter');
        if (!catSelect) return;
        const currentVal = catSelect.value || 'all';
        let html = '<option value="all">All Categories</option>';
        const catMap = new Map();

        if (Array.isArray(categoriesData)) {
          categoriesData.forEach(c => {
            if (c.slug && c.name) catMap.set(c.slug, c.name);
          });
        }

        pmPosts.forEach(p => {
          const cats = getPostCategoriesArray(p);
          cats.forEach(c => {
            const slug = c.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
            if (!catMap.has(slug)) {
              catMap.set(slug, c);
            }
          });
        });

        catMap.forEach((name, slug) => {
          html += `<option value="${escapeHtml(slug)}">${escapeHtml(name)}</option>`;
        });

        catSelect.innerHTML = html;
        catSelect.value = currentVal;
      }

      // Render daftar artikel di modal
      function renderPostsManager() {
        const bodyEl = document.getElementById('postsManagerBody');
        const infoEl = document.getElementById('pmPaginationInfo');
        const controlsEl = document.getElementById('pmPaginationControls');
        const totalBadgeEl = document.getElementById('postsTotalHeaderBadge');
        if (!bodyEl) return;

        if (totalBadgeEl) {
          totalBadgeEl.textContent = `${pmPosts.length} Total`;
        }

        // 1. Filter Search
        let filtered = pmPosts.filter(p => {
          if (!pmSearchQuery) return true;
          const q = pmSearchQuery.toLowerCase();
          const title = (p.title || '').toLowerCase();
          const slug = (p.slug || '').toLowerCase();
          const cat = (p.category || '').toLowerCase();
          const excerpt = (p.excerpt || '').toLowerCase();
          const author = (p.author?.name || '').toLowerCase();
          const tags = (Array.isArray(p.tags) ? p.tags.join(' ') : (p.tags || '')).toLowerCase();
          const keywords = (p.keywords || '').toLowerCase();

          return title.includes(q) || slug.includes(q) || cat.includes(q) || excerpt.includes(q) || author.includes(q) || tags.includes(q) || keywords.includes(q);
        });

        // 2. Filter Kategori (Mendukung multi-kategori dan slugs)
        if (pmCategory !== 'all') {
          filtered = filtered.filter(p => {
            const pSlugs = (Array.isArray(p.categorySlugs) && p.categorySlugs.length > 0)
              ? p.categorySlugs
              : getPostCategoriesArray(p).map(c => c.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, ''));
            const pNames = getPostCategoriesArray(p).map(c => c.toLowerCase());
            return pSlugs.includes(pmCategory.toLowerCase()) || pNames.includes(pmCategory.toLowerCase());
          });
        }

        // 3. Sorting
        filtered.sort((a, b) => {
          if (pmSort === 'date-desc') {
            return new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime();
          } else if (pmSort === 'date-asc') {
            return new Date(a.date || 0).getTime() - new Date(b.date || 0).getTime();
          } else if (pmSort === 'title-asc') {
            return (a.title || '').localeCompare(b.title || '');
          } else if (pmSort === 'title-desc') {
            return (b.title || '').localeCompare(a.title || '');
          }
          return 0;
        });

        const totalItems = filtered.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / pmPerPage));
        if (pmCurrentPage > totalPages) pmCurrentPage = totalPages;
        if (pmCurrentPage < 1) pmCurrentPage = 1;

        const startIndex = totalItems === 0 ? 0 : (pmCurrentPage - 1) * pmPerPage;
        const endIndex = Math.min(startIndex + pmPerPage, totalItems);
        const pageItems = filtered.slice(startIndex, endIndex);

        // Render Empty State
        if (totalItems === 0) {
          bodyEl.innerHTML = `
            <div class="pm-empty-state">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: #6b7280; opacity: 0.6;">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <h4 style="margin: 4px 0; color: #f3f4f6; font-size: 0.95rem;">No Matching Posts Found</h4>
              <p style="margin: 0; font-size: 0.8rem; color: #9ca3af; max-width: 320px;">
                ${pmSearchQuery ? `No posts found matching the keyword "<strong>${escapeHtml(pmSearchQuery)}</strong>".` : 'No posts found in the selected category.'}
              </p>
              <button type="button" class="btn-secondary" id="btnResetPmFilter" style="margin-top: 10px; font-size: 0.78rem; padding: 6px 14px;">
                Reset Filters & Search
              </button>
            </div>
          `;
          document.getElementById('btnResetPmFilter')?.addEventListener('click', () => {
            pmSearchQuery = '';
            const searchInput = document.getElementById('pmSearchInput');
            if (searchInput) searchInput.value = '';
            const clearBtn = document.getElementById('pmSearchClear');
            if (clearBtn) clearBtn.style.display = 'none';
            pmCategory = 'all';
            const catSelect = document.getElementById('pmCategoryFilter');
            if (catSelect) catSelect.value = 'all';
            pmCurrentPage = 1;
            renderPostsManager();
          });

          if (infoEl) infoEl.textContent = 'Showing 0 of 0 posts';
          if (controlsEl) controlsEl.innerHTML = '';
          return;
        }

        // Render List of Posts
        let itemsHtml = '';
        pageItems.forEach(post => {
          const isActive = post.slug === activePost.slug;
          const tagsArr = Array.isArray(post.tags)
            ? post.tags
            : (typeof post.tags === 'string' && post.tags.trim() ? post.tags.split(',').map(t => t.trim()).filter(Boolean) : []);
          const tagsPills = tagsArr.slice(0, 3).map(t => 
            `<span class="pm-tag-pill">#${escapeHtml(t)}</span>`
          ).join('');

          const postCats = getPostCategoriesArray(post);
          const catBadgesHtml = postCats.map(c => 
            `<span class="pm-cat-badge">${escapeHtml(c)}</span>`
          ).join(' ');

          itemsHtml += `
            <div class="pm-post-item ${isActive ? 'is-active' : ''}">
              <div class="pm-post-thumb-wrap">
                <img src="${escapeHtml(post.image || 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=600&q=80')}" alt="${escapeHtml(post.title)}" class="pm-post-thumb" loading="lazy" />
              </div>
              <div class="pm-post-main">
                <div class="pm-post-meta-top" style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center;">
                  ${catBadgesHtml}
                  ${isActive ? '<span class="pm-active-badge">⭐ ACTIVE NOW</span>' : ''}
                  <span class="pm-meta-date">📅 ${escapeHtml(post.formattedDate || post.date || '')}</span>
                  <span class="pm-meta-readtime">⏱️ ${escapeHtml(post.readTime || '5 min read')}</span>
                </div>
                <h4 class="pm-post-title" title="${escapeHtml(post.title)}">
                  ${escapeHtml(post.title)}
                </h4>
                <p class="pm-post-excerpt">
                  ${escapeHtml(post.excerpt || 'No summary available.')}
                </p>
                <div class="pm-post-meta-bottom">
                  <div class="pm-author-mini">
                    <img src="${escapeHtml(post.author?.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80')}" class="pm-author-avatar" alt="${escapeHtml(post.author?.name || 'Author')}" />
                    <span class="pm-author-name">${escapeHtml(post.author?.name || 'Better Team')}</span>
                  </div>
                  <span class="pm-slug-text">/blog/${escapeHtml(post.slug)}</span>
                  ${tagsPills}
                </div>
              </div>
              <div class="pm-post-actions">
                ${isActive 
                  ? `<button type="button" class="btn-pm-action active-now" disabled>
                       <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                       <span>Active in Editor</span>
                     </button>`
                  : `<button type="button" class="btn-pm-action btn-pm-edit" data-slug="${escapeHtml(post.slug)}" title="Open this post in visual editor">
                       <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                       <span>Open in Editor</span>
                     </button>`
                }
                <a href="/blog/${escapeHtml(post.slug)}" target="_blank" class="btn-pm-action btn-pm-live" title="View Live Article in New Tab">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  <span>Live ↗</span>
                </a>
              </div>
            </div>
          `;
        });
        bodyEl.innerHTML = itemsHtml;

        // Pasang event listener tombol Buka di Editor
        bodyEl.querySelectorAll('.btn-pm-edit').forEach(btn => {
          btn.addEventListener('click', () => {
            const targetSlug = btn.dataset.slug;
            if (targetSlug && targetSlug !== activePost.slug) {
              window.location.href = `/edit-blog?slug=${encodeURIComponent(targetSlug)}`;
            }
          });
        });

        // Update pagination info text
        if (infoEl) {
          infoEl.innerHTML = `Showing <strong>${startIndex + 1} - ${endIndex}</strong> of <strong>${totalItems}</strong> posts (Page <strong>${pmCurrentPage}</strong> of <strong>${totalPages}</strong>)`;
        }

        // Render Pagination Controls
        if (controlsEl) {
          let controlsHtml = '';
          
          // First & Prev
          controlsHtml += `
            <button type="button" class="pm-page-btn" data-page="1" ${pmCurrentPage === 1 ? 'disabled' : ''} title="First Page">&laquo;</button>
            <button type="button" class="pm-page-btn" data-page="${pmCurrentPage - 1}" ${pmCurrentPage === 1 ? 'disabled' : ''} title="Previous Page">&lsaquo;</button>
          `;

          // Page numbers calculation with ellipsis
          let startPage = Math.max(1, pmCurrentPage - 2);
          let endPage = Math.min(totalPages, pmCurrentPage + 2);
          if (endPage - startPage < 4) {
            if (startPage === 1) endPage = Math.min(totalPages, startPage + 4);
            else if (endPage === totalPages) startPage = Math.max(1, endPage - 4);
          }

          if (startPage > 1) {
            controlsHtml += `<button type="button" class="pm-page-btn" data-page="1">1</button>`;
            if (startPage > 2) controlsHtml += `<span class="pm-page-ellipsis">...</span>`;
          }

          for (let p = startPage; p <= endPage; p++) {
            controlsHtml += `<button type="button" class="pm-page-btn ${p === pmCurrentPage ? 'active' : ''}" data-page="${p}">${p}</button>`;
          }

          if (endPage < totalPages) {
            if (endPage < totalPages - 1) controlsHtml += `<span class="pm-page-ellipsis">...</span>`;
            controlsHtml += `<button type="button" class="pm-page-btn" data-page="${totalPages}">${totalPages}</button>`;
          }

          // Next & Last
          controlsHtml += `
            <button type="button" class="pm-page-btn" data-page="${pmCurrentPage + 1}" ${pmCurrentPage === totalPages ? 'disabled' : ''} title="Next Page">&rsaquo;</button>
            <button type="button" class="pm-page-btn" data-page="${totalPages}" ${pmCurrentPage === totalPages ? 'disabled' : ''} title="Last Page">&raquo;</button>
          `;

          controlsEl.innerHTML = controlsHtml;

          controlsEl.querySelectorAll('.pm-page-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const targetPage = parseInt(btn.dataset.page);
              if (targetPage && targetPage !== pmCurrentPage && targetPage >= 1 && targetPage <= totalPages) {
                pmCurrentPage = targetPage;
                renderPostsManager();
                bodyEl.scrollTop = 0;
              }
            });
          });
        }
      }

      // Open Modal Posts Manager
      function openPostsManagerModal() {
        initPmCategories();
        renderPostsManager();
        document.getElementById('modalPostsManager').classList.add('open');
        setTimeout(() => {
          document.getElementById('pmSearchInput')?.focus();
        }, 50);
      }

      // Event listener button di navbar
      document.getElementById('btnOpenPostsManager')?.addEventListener('click', openPostsManagerModal);

      // Event listener Search
      const pmSearchInput = document.getElementById('pmSearchInput');
      const pmSearchClear = document.getElementById('pmSearchClear');
      if (pmSearchInput) {
        pmSearchInput.addEventListener('input', (e) => {
          pmSearchQuery = e.target.value.trim();
          if (pmSearchClear) {
            pmSearchClear.style.display = pmSearchQuery ? 'block' : 'none';
          }
          pmCurrentPage = 1;
          renderPostsManager();
        });
      }

      if (pmSearchClear) {
        pmSearchClear.addEventListener('click', () => {
          pmSearchQuery = '';
          pmSearchInput.value = '';
          pmSearchClear.style.display = 'none';
          pmCurrentPage = 1;
          renderPostsManager();
          pmSearchInput.focus();
        });
      }

      // Event listener Filter Kategori
      document.getElementById('pmCategoryFilter')?.addEventListener('change', (e) => {
        pmCategory = e.target.value;
        pmCurrentPage = 1;
        renderPostsManager();
      });

      // Event listener Filter Sort
      document.getElementById('pmSortFilter')?.addEventListener('change', (e) => {
        pmSort = e.target.value;
        renderPostsManager();
      });

      // Event listener Limit Per Page
      document.getElementById('pmPerPageSelect')?.addEventListener('change', (e) => {
        pmPerPage = parseInt(e.target.value) || 10;
        pmCurrentPage = 1;
        renderPostsManager();
      });

      // Tombol "+ Tulis Artikel Baru" di dalam Posts Manager Modal
      document.getElementById('btnTriggerNewFromManager')?.addEventListener('click', () => {
        document.getElementById('modalPostsManager').classList.remove('open');
        renderCategoryCheckboxes('newPostCategoriesList', ['Branding']);
        document.getElementById('modalNewPost').classList.add('open');
        document.getElementById('newPostTitle')?.focus();
      });

      // Preview Mode
      let isPreview = false;
      document.getElementById('btnPreview').addEventListener('click', () => {
        isPreview = !isPreview;
        editor.runCommand(isPreview ? 'preview' : 'preview');
        document.getElementById('btnPreview').style.backgroundColor = isPreview ? '#ff5e3a' : '#1e232d';
      });

      // ============================================
      // CODE EDITOR MODAL LOGIC
      // ============================================
      const modalCodeEditor = document.getElementById('modalCodeEditor');
      const btnViewCode = document.getElementById('btnViewCode');
      const ceTextarea = document.getElementById('ceTextarea');
      const ceLineNumbers = document.getElementById('ceLineNumbers');
      const ceScopeSelect = document.getElementById('ceScopeSelect');
      const ceScopeOptionSelected = document.getElementById('ceScopeOptionSelected');
      const ceScopeBadge = document.getElementById('ceScopeBadge');
      const ceScopeSelectorWrap = document.getElementById('ceScopeSelectorWrap');
      const btnCeFormat = document.getElementById('btnCeFormat');
      const btnCeCopy = document.getElementById('btnCeCopy');
      const btnCeApply = document.getElementById('btnCeApply');
      let activeCeTab = 'html'; // 'html' | 'css'

      function formatHTML(html) {
        if (!html) return '';
        let formatted = '';
        let indent = 0;
        const tab = '  ';
        html = html.replace(/>\s*</g, '><').trim();
        const tokens = html.split(/(<\/?[a-zA-Z0-9_-]+(?:\s+[^>]*?)?\/?>|<!--[\s\S]*?-->)/);
        for (let i = 0; i < tokens.length; i++) {
          const token = tokens[i].trim();
          if (!token) continue;
          if (token.startsWith('</')) {
            indent = Math.max(0, indent - 1);
            formatted += (formatted ? '\n' : '') + tab.repeat(indent) + token;
          } else if (token.startsWith('<') && !token.startsWith('<!') && !token.endsWith('/>')) {
            const isVoid = /^<(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)[\s>]/i.test(token);
            formatted += (formatted ? '\n' : '') + tab.repeat(indent) + token;
            if (!isVoid) {
              indent++;
            }
          } else {
            formatted += (formatted ? '\n' : '') + tab.repeat(indent) + token;
          }
        }
        return formatted || html;
      }

      function formatCSS(css) {
        if (!css) return '';
        return css
          .replace(/\s*\{\s*/g, ' {\n  ')
          .replace(/\s*;\s*/g, ';\n  ')
          .replace(/\s*\}\s*/g, '\n}\n\n')
          .replace(/\n\s*\n\s*\n/g, '\n\n')
          .trim();
      }

      function updateCeLineNumbers() {
        if (!ceTextarea || !ceLineNumbers) return;
        const lines = ceTextarea.value.split('\n').length;
        let nums = '';
        for (let i = 1; i <= lines; i++) {
          nums += i + '\n';
        }
        ceLineNumbers.textContent = nums;
        const statsEl = document.getElementById('ceStatsInfo');
        if (statsEl) {
          statsEl.textContent = `Lines: ${lines} | Characters: ${ceTextarea.value.length}`;
        }
      }

      function loadCodeIntoEditor() {
        if (!ceTextarea) return;
        if (activeCeTab === 'html') {
          if (ceScopeSelectorWrap) ceScopeSelectorWrap.style.display = 'flex';
          const scope = ceScopeSelect ? ceScopeSelect.value : 'body';
          if (ceScopeBadge) {
            ceScopeBadge.textContent = scope === 'body' ? 'Article Body' : (scope === 'related' ? 'Related Articles' : (scope === 'selected' ? 'Selected Element' : 'Full Canvas'));
          }

          if (scope === 'selected') {
            const selected = editor.getSelected();
            ceTextarea.value = selected ? formatHTML(selected.toHTML()) : '';
          } else if (scope === 'body') {
            const wrapper = editor.getWrapper();
            const bodyComp = wrapper.find('#article-content-body')[0];
            let bodyHtml = '';
            if (bodyComp) {
              bodyHtml = bodyComp.components().map(c => c.toHTML()).join('\n');
            }
            if (!bodyHtml) {
              const frameDoc = editor.Canvas.getDocument();
              const el = frameDoc?.getElementById('article-content-body');
              bodyHtml = el ? el.innerHTML : editor.getHtml();
            }
            ceTextarea.value = formatHTML(bodyHtml);
          } else if (scope === 'related') {
            const wrapper = editor.getWrapper();
            const relComp = wrapper.find('#canvas-related-posts')[0];
            let relHtml = '';
            if (relComp) {
              relHtml = relComp.toHTML();
            }
            if (!relHtml) {
              const frameDoc = editor.Canvas.getDocument();
              const el = frameDoc?.getElementById('canvas-related-posts') || frameDoc?.querySelector('.related-posts-section');
              relHtml = el ? el.outerHTML : '';
            }
            ceTextarea.value = formatHTML(relHtml);
          } else {
            // Full canvas
            ceTextarea.value = formatHTML(editor.getHtml());
          }
        } else {
          // CSS Tab
          if (ceScopeSelectorWrap) ceScopeSelectorWrap.style.display = 'none';
          if (ceScopeBadge) ceScopeBadge.textContent = 'Custom CSS';
          ceTextarea.value = formatCSS(editor.getCss() || '');
        }
        updateCeLineNumbers();
      }

      function openCodeEditor(targetScope = 'body') {
        const selected = editor.getSelected();
        if (selected) {
          if (ceScopeOptionSelected) {
            ceScopeOptionSelected.disabled = false;
            ceScopeOptionSelected.textContent = `Selected Element (<${selected.get('tagName') || 'div'}>)`;
          }
          if (targetScope === 'selected' && ceScopeSelect) {
            ceScopeSelect.value = 'selected';
          }
        } else {
          if (ceScopeOptionSelected) {
            ceScopeOptionSelected.disabled = true;
            ceScopeOptionSelected.textContent = 'Selected Element (None selected)';
          }
          if (ceScopeSelect && ceScopeSelect.value === 'selected') {
            ceScopeSelect.value = 'body';
          }
        }
        if (targetScope !== 'selected' && ceScopeSelect) {
          ceScopeSelect.value = targetScope;
        }

        activeCeTab = 'html';
        document.querySelectorAll('.ce-tab-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.ceTab === 'html');
        });

        loadCodeIntoEditor();
        if (modalCodeEditor) {
          modalCodeEditor.classList.add('open');
        }
        setTimeout(() => {
          ceTextarea?.focus();
        }, 100);
      }

      btnViewCode?.addEventListener('click', () => {
        openCodeEditor('body');
      });

      // Scope change
      ceScopeSelect?.addEventListener('change', () => {
        loadCodeIntoEditor();
      });

      // Tab button switch
      document.querySelectorAll('.ce-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.ce-tab-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeCeTab = btn.dataset.ceTab;
          loadCodeIntoEditor();
        });
      });

      // Keyboard handling: Tab key indentation (2 spaces)
      ceTextarea?.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          const start = ceTextarea.selectionStart;
          const end = ceTextarea.selectionEnd;
          ceTextarea.value = ceTextarea.value.substring(0, start) + '  ' + ceTextarea.value.substring(end);
          ceTextarea.selectionStart = ceTextarea.selectionEnd = start + 2;
          updateCeLineNumbers();
        }
      });

      ceTextarea?.addEventListener('input', updateCeLineNumbers);
      ceTextarea?.addEventListener('scroll', () => {
        if (ceLineNumbers && ceTextarea) {
          ceLineNumbers.scrollTop = ceTextarea.scrollTop;
        }
      });

      // Format code
      btnCeFormat?.addEventListener('click', () => {
        if (!ceTextarea) return;
        if (activeCeTab === 'html') {
          ceTextarea.value = formatHTML(ceTextarea.value);
        } else {
          ceTextarea.value = formatCSS(ceTextarea.value);
        }
        updateCeLineNumbers();
        showToast('Code formatted!');
      });

      // Copy code
      btnCeCopy?.addEventListener('click', async () => {
        if (!ceTextarea) return;
        try {
          await navigator.clipboard.writeText(ceTextarea.value);
          const txt = document.getElementById('ceCopyText');
          if (txt) {
            txt.textContent = 'Copied!';
            setTimeout(() => { txt.textContent = 'Copy'; }, 1800);
          }
          showToast('Code copied to clipboard!');
        } catch {
          showToast('Failed to copy code', true);
        }
      });

      // Apply changes to canvas
      btnCeApply?.addEventListener('click', () => {
        if (!ceTextarea) return;
        const val = ceTextarea.value;
        try {
          if (activeCeTab === 'html') {
            const scope = ceScopeSelect ? ceScopeSelect.value : 'body';
            if (scope === 'selected') {
              const selected = editor.getSelected();
              if (selected) {
                selected.replaceWith(val);
              } else {
                showToast('No element selected to replace', true);
                return;
              }
            } else if (scope === 'body') {
              const wrapper = editor.getWrapper();
              const bodyComp = wrapper.find('#article-content-body')[0];
              if (bodyComp) {
                bodyComp.components(val);
              } else {
                editor.setComponents(val);
              }
            } else if (scope === 'related') {
              const wrapper = editor.getWrapper();
              const relComp = wrapper.find('#canvas-related-posts')[0];
              if (relComp) {
                relComp.replaceWith(val);
              } else {
                editor.addComponents(val);
              }
            } else {
              // Full canvas
              editor.setComponents(val);
            }
          } else {
            // CSS tab
            editor.setStyle(val);
          }
          if (modalCodeEditor) {
            modalCodeEditor.classList.remove('open');
          }
          showToast('Code changes applied successfully!');
        } catch (err) {
          showToast('Error applying code: ' + err.message, true);
        }
      });

      // Command for GrapesJS: 'open-code-editor'
      editor.Commands.add('open-code-editor', {
        run(ed) {
          openCodeEditor('body');
        }
      });

      // Toolbar Edit Code Icon & Copy Layer when an element is selected
      editor.on('component:selected', (model) => {
        if (!model) return;
        if (typeof isDropzoneHelper === 'function' && isDropzoneHelper(model)) {
          editor.selectRemove(model);
          return;
        }

        // Update layer selection UI di tab Layers & context menu
        if (typeof updateLayerSelectionUI === 'function') {
          updateLayerSelectionUI(model);
        }

        const toolbar = model.get('toolbar') || [];
        let tbChanged = false;

        // Tombol Edit Code (< / >)
        if (!toolbar.some(t => t.id === 'edit-code-btn')) {
          toolbar.unshift({
            id: 'edit-code-btn',
            command: () => openCodeEditor('selected'),
            attributes: { class: 'gjs-toolbar-item', title: 'Edit Code (< / >)' },
            label: '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>'
          });
          tbChanged = true;
        }

        // Tombol Copy Layer ke komponen di canvas
        if (!model.is('wrapper') && typeof copySelectedLayer === 'function') {
          if (!toolbar.some(item => item.id === 'btn-tlb-copy-layer')) {
            toolbar.unshift({
              id: 'btn-tlb-copy-layer',
              attributes: { class: 'gjs-toolbar-item', title: 'Copy Layer (Ctrl+C)' },
              label: `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`,
              command: () => copySelectedLayer(model)
            });
            tbChanged = true;
          }
        }

        if (tbChanged) {
          model.set('toolbar', toolbar);
        }
      });

      // Reset layer selection saat elemen di-deselected
      editor.on('component:deselected', () => {
        if (typeof updateLayerSelectionUI === 'function') {
          updateLayerSelectionUI(null);
        }
        updateStateButtonsUI('normal');
      });

      // ========================================================
      // NORMAL & HOVER STATE SWITCHER CONTROLLER
      // ========================================================
      let activeComponentStylingState = 'normal';
      const componentNormalStyles = {};

      function snapshotComponentNormalStyle(cmp) {
        if (!cmp) return;
        const id = cmp.getId();
        componentNormalStyles[id] = JSON.parse(JSON.stringify(cmp.getStyle()));
      }

      function updateStateButtonsUI(state) {
        activeComponentStylingState = state;
        document.querySelectorAll('.gjs-state-btn, .gjs-master-state-btn').forEach(btn => {
          btn.classList.toggle('is-active', btn.dataset.state === state);
        });
        const indicator = document.getElementById('gjsStateIndicator');
        if (indicator) {
          if (state === 'hover') {
            indicator.textContent = ':hover State Active';
            indicator.className = 'gjs-sm-state-badge is-hover';
          } else {
            indicator.textContent = 'Normal State';
            indicator.className = 'gjs-sm-state-badge';
          }
        }
      }

      function refreshAllStyleProperties(edInstance) {
        const ed = edInstance || editor;
        if (!ed || !ed.StyleManager) return;
        const sectors = ed.StyleManager.getSectors();
        function refreshProp(prop) {
          if (!prop) return;
          if (prop.view && typeof prop.view.render === 'function') {
            try { prop.view.render(); } catch (e) {}
          }
          const subProps = prop.getProperties ? prop.getProperties() : (prop.get ? prop.get('properties') : null);
          if (subProps && subProps.forEach) subProps.forEach(refreshProp);
        }
        sectors.forEach(s => {
          const props = s.getProperties ? s.getProperties() : (s.get ? s.get('properties') : []);
          if (props && props.forEach) props.forEach(refreshProp);
        });
      }

      function setComponentStylingState(state) {
        if (!editor) return;
        const sel = editor.getSelected();
        if (!sel) return;
        const id = sel.getId();

        activeComponentStylingState = state;

        if (state === 'hover') {
          snapshotComponentNormalStyle(sel);
          sel.addClass('gjs-hover-preview');
          let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`);
          if (!hoverRule) {
            hoverRule = editor.Css.getRule(`#${id}:hover`);
          }
          if (!hoverRule) {
            hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
          }
          editor.StyleManager.select(hoverRule);
        } else {
          sel.removeClass('gjs-hover-preview');
          if (componentNormalStyles[id]) {
            sel.setStyle(componentNormalStyles[id]);
            const normRule = editor.Css.getRule('#' + id);
            if (normRule) normRule.setStyle(componentNormalStyles[id]);
          }
          editor.StyleManager.select(sel);
        }

        refreshAllStyleProperties(editor);
        enhanceStateSwitchers();
        updateStateButtonsUI(state);
      }

      function enhanceStateSwitchers() {
        const stylesEl = document.getElementById('styles-container');
        if (!stylesEl) return;

        // 1. Top Master State Toolbar
        if (!stylesEl.querySelector('.gjs-sm-state-toolbar')) {
          const toolbar = document.createElement('div');
          toolbar.className = 'gjs-sm-state-toolbar';
          toolbar.innerHTML = `
            <div class="gjs-sm-state-left">
              <span class="gjs-sm-state-title">State:</span>
              <div class="gjs-sm-state-pills">
                <button type="button" class="gjs-master-state-btn ${activeComponentStylingState === 'normal' ? 'is-active' : ''}" data-state="normal">Normal</button>
                <button type="button" class="gjs-master-state-btn ${activeComponentStylingState === 'hover' ? 'is-active' : ''}" data-state="hover">Hover (:hover)</button>
              </div>
            </div>
            <span class="gjs-sm-state-badge ${activeComponentStylingState === 'hover' ? 'is-hover' : ''}" id="gjsStateIndicator">
              ${activeComponentStylingState === 'hover' ? ':hover State Active' : 'Normal State'}
            </span>
          `;
          toolbar.querySelectorAll('.gjs-master-state-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              setComponentStylingState(btn.dataset.state);
            });
          });
          stylesEl.insertBefore(toolbar, stylesEl.firstChild);
        }

        // 2. Add normal/hover switchers directly to Sector Titles
        const sectors = stylesEl.querySelectorAll('.gjs-sm-sector');
        sectors.forEach(sector => {
          const title = sector.querySelector('.gjs-sm-sector-title');
          const label = sector.querySelector('.gjs-sm-sector-label');
          if (!title || !label || sector.querySelector('.gjs-sector-state-switch')) return;

          const labelText = label.textContent.trim().toLowerCase();
          if (
            labelText.includes('typography') ||
            labelText.includes('background') ||
            labelText.includes('color') ||
            labelText.includes('border') ||
            labelText.includes('decoration') ||
            labelText.includes('effect')
          ) {
            const switchGroup = document.createElement('div');
            switchGroup.className = 'gjs-sector-state-switch';
            switchGroup.innerHTML = `
              <button type="button" class="gjs-state-btn ${activeComponentStylingState === 'normal' ? 'is-active' : ''}" data-state="normal">normal</button>
              <button type="button" class="gjs-state-btn ${activeComponentStylingState === 'hover' ? 'is-active' : ''}" data-state="hover">hover</button>
            `;
            switchGroup.querySelectorAll('.gjs-state-btn').forEach(btn => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                setComponentStylingState(btn.dataset.state);
              });
            });
            title.appendChild(switchGroup);
          }
        });
      }

      editor.on('component:selected', (comp) => {
        if (!comp) return;
        if (typeof isDropzoneHelper === 'function' && isDropzoneHelper(comp)) {
          editor.selectRemove(comp);
          return;
        }
        if (comp) {
          comp.removeClass('gjs-hover-preview');
          snapshotComponentNormalStyle(comp);
        }
        updateStateButtonsUI('normal');

        // Check layout locking
        const lockedBanner = document.getElementById('lockedLayoutBanner');
        if (activePost.layoutMode !== 'blank') {
          const isContent = isComponentInsideContent(comp);
          if (lockedBanner) {
            lockedBanner.style.display = (!isContent && !comp.is('wrapper')) ? 'flex' : 'none';
          }
        } else {
          if (lockedBanner) lockedBanner.style.display = 'none';
        }

        if (typeof updateLayerSelectionUI === 'function') {
          updateLayerSelectionUI(comp);
        }
        setTimeout(enhanceStateSwitchers, 50);
      });

      editor.on('component:add', (comp) => {
        setTimeout(attachDropzoneEvents, 60);
        if (!comp) return;

        if (activePost.layoutMode !== 'blank') {
          const wrapper = editor.getWrapper();
          if (wrapper) {
            const contentContainer = wrapper.find('#article-content-body')[0] || 
                                     wrapper.find('[data-post-element="content"]')[0];
            if (contentContainer && !isComponentInsideContent(comp) && comp !== contentContainer) {
              contentContainer.append(comp);
              showToast('Block placed into Post Content area');
            }
          }

          // Pastikan komponen yang ditambahkan ke area konten berstatus editable & removable
          function unlockRecursive(c) {
            if (isComponentInsideContent(c)) {
              c.set({
                editable: true,
                draggable: true,
                droppable: true,
                removable: true,
                copyable: true,
                badgable: true
              });
            }
            const children = c.components ? c.components() : [];
            if (children && children.forEach) children.forEach(unlockRecursive);
          }
          unlockRecursive(comp);
        }
      });

      ['component:remove', 'block:drag:stop', 'canvas:drop'].forEach(ev => {
        editor.on(ev, () => setTimeout(attachDropzoneEvents, 60));
      });

      editor.on('component:styleUpdate', (cmp) => {
        if (!cmp) return;
        const id = cmp.getId();

        if (activeComponentStylingState === 'hover') {
          const normalStyle = componentNormalStyles[id];
          if (!normalStyle) return;

          const currentStyle = cmp.getStyle();
          let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`) 
            || editor.Css.getRule(`#${id}:hover`);
          if (!hoverRule) {
            hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
          }

          let hasChanges = false;
          for (const key in currentStyle) {
            if (currentStyle[key] !== normalStyle[key]) {
              hoverRule.addStyle({ [key]: currentStyle[key] });
              hasChanges = true;
            }
          }

          if (hasChanges) {
            cmp.setStyle(normalStyle, { silent: true });
            const normRule = editor.Css.getRule('#' + id);
            if (normRule) normRule.setStyle(normalStyle, { silent: true });
          }
        } else {
          componentNormalStyles[id] = JSON.parse(JSON.stringify(cmp.getStyle()));
        }
      });

      editor.on('styleManager:change', () => {
        setTimeout(enhanceStateSwitchers, 50);
      });

      editor.on('load', () => {
        setTimeout(enhanceStateSwitchers, 100);
        if (window.initContainerLayoutStyler) {
          window.initContainerLayoutStyler(editor);
        }
      });

      const editBlogStylesObserverTarget = document.getElementById('styles-container');
      if (editBlogStylesObserverTarget) {
        const obs = new MutationObserver(() => {
          enhanceStateSwitchers();
        });
        obs.observe(editBlogStylesObserverTarget, { childList: true, subtree: true });
      }

      // Helper Fungsi Unggah Gambar ke Proyek (/api/upload)
      async function uploadImageFile(file, statusEl, inputEl, previewEl, callback) {
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          showToast('Selected file must be a valid image format (PNG, JPG, WEBP, GIF, SVG, AVIF).', true);
          return;
        }

        if (file.size > 200 * 1024) {
          showToast(`Image "${file.name}" exceeds the 200 KB limit (${(file.size / 1024).toFixed(1)} KB). Maximum allowed size is 200 KB.`, true);
          return;
        }

        if (statusEl) statusEl.classList.add('active');

        const formData = new FormData();
        formData.append('file', file);

        try {
          const res = await fetch('/api/upload', {
            method: 'POST',
            body: formData,
          });

          const data = await res.json();
          if (data.success && data.url) {
            if (inputEl) {
              inputEl.value = data.url;
            }
            if (previewEl) {
              previewEl.src = data.url;
            }
            showToast('Image uploaded to project successfully!');
            if (callback) callback(data.url);
          } else {
            showToast(data.error || 'Failed to upload image.', true);
          }
        } catch (err) {
          showToast('An error occurred while uploading image: ' + err.message, true);
        } finally {
          if (statusEl) statusEl.classList.remove('active');
        }
      }

      // 1. Setup Unggah Gambar untuk Modal New Post
      const newPostFileInput = document.getElementById('newPostFileInput');
      const newPostImageInput = document.getElementById('newPostImage');
      const newPostImagePreview = document.getElementById('newPostImagePreview');
      const newPostPreviewCard = document.getElementById('newPostPreviewCard');
      const newPostUploadStatus = document.getElementById('newPostUploadStatus');

      document.getElementById('btnUploadNewPostFile').addEventListener('click', () => newPostFileInput.click());
      document.getElementById('btnTriggerNewUpload').addEventListener('click', () => newPostFileInput.click());

      newPostFileInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (file) {
          uploadImageFile(file, newPostUploadStatus, newPostImageInput, newPostImagePreview);
        }
      });

      newPostImageInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        if (val && newPostImagePreview) {
          newPostImagePreview.src = val;
        }
      });

      // Drag & Drop New Post Image
      ['dragenter', 'dragover'].forEach(eventName => {
        newPostPreviewCard.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          newPostPreviewCard.classList.add('dragover');
        });
      });
      ['dragleave', 'drop'].forEach(eventName => {
        newPostPreviewCard.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          newPostPreviewCard.classList.remove('dragover');
        });
      });
      newPostPreviewCard.addEventListener('drop', (e) => {
        const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (file) {
          uploadImageFile(file, newPostUploadStatus, newPostImageInput, newPostImagePreview);
        }
      });

      // 2. Setup Unggah Gambar untuk Modal Post Settings
      const editPostFileInput = document.getElementById('editPostFileInput');
      const editPostImageInput = document.getElementById('editPostImage');
      const editPostImagePreview = document.getElementById('editPostImagePreview');
      const editPostPreviewCard = document.getElementById('editPostPreviewCard');
      const editPostUploadStatus = document.getElementById('editPostUploadStatus');

      document.getElementById('btnUploadEditPostFile').addEventListener('click', () => editPostFileInput.click());
      document.getElementById('btnTriggerEditUpload').addEventListener('click', () => editPostFileInput.click());

      editPostFileInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (file) {
          uploadImageFile(file, editPostUploadStatus, editPostImageInput, editPostImagePreview, (url) => {
            const frameDoc = editor.Canvas.getDocument();
            if (frameDoc) {
              const canvasImg = frameDoc.getElementById('canvas-featured-img');
              if (canvasImg) canvasImg.src = url;
            }
          });
        }
      });

      editPostImageInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        if (val && editPostImagePreview) {
          editPostImagePreview.src = val;
        }
        const frameDoc = editor.Canvas.getDocument();
        if (frameDoc && val) {
          const canvasImg = frameDoc.getElementById('canvas-featured-img');
          if (canvasImg) canvasImg.src = val;
        }
      });

      // Drag & Drop Edit Post Image
      ['dragenter', 'dragover'].forEach(eventName => {
        editPostPreviewCard.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          editPostPreviewCard.classList.add('dragover');
        });
      });
      ['dragleave', 'drop'].forEach(eventName => {
        editPostPreviewCard.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          editPostPreviewCard.classList.remove('dragover');
        });
      });
      editPostPreviewCard.addEventListener('drop', (e) => {
        const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (file) {
          uploadImageFile(file, editPostUploadStatus, editPostImageInput, editPostImagePreview, (url) => {
            const frameDoc = editor.Canvas.getDocument();
            if (frameDoc) {
              const canvasImg = frameDoc.getElementById('canvas-featured-img');
              if (canvasImg) canvasImg.src = url;
            }
          });
        }
      });

      // 3. Setup Unggah Avatar Penulis
      const editAuthorAvatarFileInput = document.getElementById('editAuthorAvatarFileInput');
      const editPostAuthorAvatarInput = document.getElementById('editPostAuthorAvatar');

      document.getElementById('btnUploadAuthorAvatarFile').addEventListener('click', () => editAuthorAvatarFileInput.click());
      editAuthorAvatarFileInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (file) {
          uploadImageFile(file, null, editPostAuthorAvatarInput, null, (url) => {
            const frameDoc = editor.Canvas.getDocument();
            if (frameDoc) {
              const a1 = frameDoc.getElementById('canvas-author-avatar');
              if (a1) a1.src = url;
              const a2 = frameDoc.getElementById('canvas-bio-avatar');
              if (a2) a2.src = url;
            }
          });
        }
      });

      // ==========================================
      // MEDIA LIBRARY & FILE MANAGER LOGIC
      // ==========================================
      let mediaFilesList = [];
      let selectedMediaItem = null;
      let onMediaSelectedCallback = null;

      async function loadMediaLibrary() {
        const container = document.getElementById('mediaGridContainer');
        container.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: #9ca3af;"><div class="upload-spinner active" style="justify-content: center; margin-bottom: 8px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg></div>Loading media from public/uploads...</div>';

        try {
          const res = await fetch('/api/upload');
          const data = await res.json();
          if (Array.isArray(data)) {
            mediaFilesList = data;
            renderMediaGrid(mediaFilesList);
          } else {
            container.innerHTML = '<div class="media-empty-state"><p>Failed to load media: ' + (data.error || 'An error occurred') + '</p></div>';
          }
        } catch (err) {
          container.innerHTML = '<div class="media-empty-state"><p>Failed to connect to server</p></div>';
        }
      }

      function renderMediaGrid(files) {
        const container = document.getElementById('mediaGridContainer');
        const countBadge = document.getElementById('mediaCountBadge');
        countBadge.textContent = `${files.length} images`;

        if (files.length === 0) {
          container.innerHTML = `
            <div class="media-empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity: 0.35;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <p style="font-size: 0.9rem; font-weight: 600; color: #9ca3af; margin: 0;">No images saved in public/uploads yet</p>
              <p style="font-size: 0.78rem; color: #6b7280; margin: 0;">Upload an image file from your computer or drag files into this area.</p>
            </div>
          `;
          clearSelectedMedia();
          return;
        }

        container.innerHTML = '';
        files.forEach(item => {
          const card = document.createElement('div');
          card.className = 'media-item-card' + (selectedMediaItem?.fileName === item.fileName ? ' selected' : '');
          card.innerHTML = `
            <img src="${item.url}" alt="${item.fileName}" class="media-item-thumb" loading="lazy" />
            <div class="media-item-info">
              <span class="media-item-name" title="${item.fileName}">${item.fileName}</span>
              <span class="media-item-meta">${item.size} • ${item.formattedDate}</span>
            </div>
            <div class="media-item-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          `;

          card.addEventListener('click', () => {
            selectMediaItem(item);
          });

          card.addEventListener('dblclick', () => {
            selectMediaItem(item);
            confirmInsertMedia();
          });

          container.appendChild(card);
        });
      }

      function selectMediaItem(item) {
        selectedMediaItem = item;
        document.querySelectorAll('.media-item-card').forEach(el => {
          el.classList.toggle('selected', el.querySelector('.media-item-name')?.textContent === item.fileName);
        });

        document.getElementById('mediaDetailsEmpty').style.display = 'none';
        const content = document.getElementById('mediaDetailsContent');
        content.style.display = 'flex';

        document.getElementById('detailPreviewImg').src = item.url;
        document.getElementById('detailFileName').textContent = item.fileName;
        document.getElementById('detailFileSize').textContent = item.size;
        document.getElementById('detailFileDate').textContent = item.formattedDate;
        document.getElementById('detailFileUrl').value = item.url;

        const btnInsert = document.getElementById('btnInsertSelectedMedia');
        btnInsert.disabled = false;
        btnInsert.style.opacity = '1';
      }

      function clearSelectedMedia() {
        selectedMediaItem = null;
        document.querySelectorAll('.media-item-card').forEach(el => el.classList.remove('selected'));
        document.getElementById('mediaDetailsEmpty').style.display = 'block';
        document.getElementById('mediaDetailsContent').style.display = 'none';

        const btnInsert = document.getElementById('btnInsertSelectedMedia');
        btnInsert.disabled = true;
        btnInsert.style.opacity = '0.5';
      }

      function openMediaLibrary(callback) {
        if (window.FastPressFileManager) {
          window.FastPressFileManager.open({ onSelect: callback });
          return;
        }
        onMediaSelectedCallback = callback || null;
        document.getElementById('modalFileManager').classList.add('open');
        clearSelectedMedia();
        loadMediaLibrary();
      }

      function confirmInsertMedia() {
        if (!selectedMediaItem) return;
        if (onMediaSelectedCallback) {
          onMediaSelectedCallback(selectedMediaItem.url, selectedMediaItem);
        }
        document.getElementById('modalFileManager').classList.remove('open');
      }

      // Triggers Media Library Modal
      document.getElementById('btnOpenMediaLibraryNavbar').addEventListener('click', () => {
        openMediaLibrary();
      });

      document.getElementById('btnOpenMediaNewPost').addEventListener('click', () => {
        openMediaLibrary((url) => {
          newPostImageInput.value = url;
          if (newPostImagePreview) newPostImagePreview.src = url;
        });
      });

      document.getElementById('btnOpenMediaEditPost').addEventListener('click', () => {
        openMediaLibrary((url) => {
          editPostImageInput.value = url;
          if (editPostImagePreview) editPostImagePreview.src = url;
          const frameDoc = editor.Canvas.getDocument();
          if (frameDoc) {
            const canvasImg = frameDoc.getElementById('canvas-featured-img');
            if (canvasImg) canvasImg.src = url;
          }
        });
      });

      document.getElementById('btnOpenMediaAuthorAvatar').addEventListener('click', () => {
        openMediaLibrary((url) => {
          editPostAuthorAvatarInput.value = url;
          const frameDoc = editor.Canvas.getDocument();
          if (frameDoc) {
            const a1 = frameDoc.getElementById('canvas-author-avatar');
            if (a1) a1.src = url;
            const a2 = frameDoc.getElementById('canvas-bio-avatar');
            if (a2) a2.src = url;
          }
        });
      });

      // Media Library Toolbar Actions
      document.getElementById('btnRefreshMedia')?.addEventListener('click', () => loadMediaLibrary());

      const mediaLibraryUploadInput = document.getElementById('mediaLibraryUploadInput');
      document.getElementById('btnTriggerMediaUpload')?.addEventListener('click', () => mediaLibraryUploadInput?.click());
      mediaLibraryUploadInput?.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        if (files.length === 0) return;
