      function parsePostSchemasFromRaw(raw) {
        if (!raw || !raw.trim()) return [];
        const clean = raw.trim().replace(/<\/?script[^>]*>/gi, '').trim();
        if (!clean) return [];

        try {
          const parsed = JSON.parse(clean);
          if (Array.isArray(parsed)) {
            return parsed.map((item) => {
              const rawType = item['@type'] || 'Custom';
              const type = ['Article', 'BlogPosting', 'NewsArticle', 'Review', 'Product', 'LocalBusiness', 'FAQPage'].includes(rawType)
                ? (rawType === 'BlogPosting' ? 'Article' : rawType)
                : 'Custom';
              return {
                id: 'bts_' + Math.random().toString(36).substring(2, 9),
                type: type,
                mode: 'visual',
                code: JSON.stringify(item, null, 2)
              };
            });
          } else if (typeof parsed === 'object' && parsed !== null) {
            if (Array.isArray(parsed['@graph'])) {
              return parsed['@graph'].map((item) => {
                const rawType = item['@type'] || 'Custom';
                const type = ['Article', 'BlogPosting', 'NewsArticle', 'Review', 'Product', 'LocalBusiness', 'FAQPage'].includes(rawType)
                  ? (rawType === 'BlogPosting' ? 'Article' : rawType)
                  : 'Custom';
                return {
                  id: 'bts_' + Math.random().toString(36).substring(2, 9),
                  type: type,
                  mode: 'visual',
                  code: JSON.stringify({ "@context": "https://schema.org", ...item }, null, 2)
                };
              });
            } else {
              const rawType = parsed['@type'] || 'Custom';
              const type = ['Article', 'BlogPosting', 'NewsArticle', 'Review', 'Product', 'LocalBusiness', 'FAQPage'].includes(rawType)
                ? (rawType === 'BlogPosting' ? 'Article' : rawType)
                : 'Custom';
              return [{
                id: 'bts_' + Math.random().toString(36).substring(2, 9),
                type: type,
                mode: 'visual',
                code: JSON.stringify(parsed, null, 2)
              }];
            }
          }
        } catch {
          return [{
            id: 'bts_' + Math.random().toString(36).substring(2, 9),
            type: 'Custom',
            mode: 'code',
            code: clean
          }];
        }
        return [];
      }

