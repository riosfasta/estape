        const raw = activePost.schema || '';
        postSchemas = parsePostSchemasFromRaw(raw);
        activePostSchemaIdx = postSchemas.length > 0 ? 0 : -1;

        modalPostStructuredData.classList.add('open');
        renderPostSchemasUI();
      }

