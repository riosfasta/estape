              "name": "Better Corp"
            }
          };
        } else if (type === 'NewsArticle') {
          return {
            "@context": "https://schema.org",
            "@type": "NewsArticle",
            "headline": postTitle,
            "description": postDesc,
            "image": postImage,
            "datePublished": today,
            "dateModified": today,
            "author": {
              "@type": "Person",
              "name": authorName
            },
            "publisher": {
