        const slug = val.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        document.getElementById('newPostSlug').value = slug;
      });

      // ==========================================
      // SISTEM COPY-PASTE LAYER & LINTAS HALAMAN / POST (CROSS-PAGE/POST)
      // ==========================================
      const LAYER_CLIPBOARD_KEY = 'fastpress_layer_clipboard';

      // Elemen UI Toolbar & Clipboard Banner
      const btnLayerCopy = document.getElementById('btnLayerCopy');
      const btnLayerPasteBelow = document.getElementById('btnLayerPasteBelow');
      const btnLayerPasteInside = document.getElementById('btnLayerPasteInside');
      const btnLayerDuplicate = document.getElementById('btnLayerDuplicate');
      const btnLayerDelete = document.getElementById('btnLayerDelete');
      const btnClearLayerClipboard = document.getElementById('btnClearLayerClipboard');
      const layerClipboardBanner = document.getElementById('layerClipboardBanner');
      const clipboardLayerName = document.getElementById('clipboardLayerName');
      const clipboardSourcePill = document.getElementById('clipboardSourcePill');
      const layerActiveBadge = document.getElementById('layerActiveBadge');

      // Elemen UI Context Menu
      const layerContextMenu = document.getElementById('layerContextMenu');
      const ctxMenuLayerName = document.getElementById('ctxMenuLayerName');
      const ctxBtnCopy = document.getElementById('ctxBtnCopy');
      const ctxBtnPasteBelow = document.getElementById('ctxBtnPasteBelow');
      const ctxBtnPasteInside = document.getElementById('ctxBtnPasteInside');
      const ctxBtnDuplicate = document.getElementById('ctxBtnDuplicate');
      const ctxBtnDelete = document.getElementById('ctxBtnDelete');

      // Ambil data clipboard dari localStorage
      function getLayerClipboard() {
        try {
          const raw = localStorage.getItem(LAYER_CLIPBOARD_KEY);
          if (!raw) return null;
          return JSON.parse(raw);
        } catch (e) {
          console.warn('Failed to parse layer clipboard:', e);
          return null;
        }
      }

      // Format nama manusiawi untuk komponen
      function getComponentHumanName(comp) {
        if (!comp) return 'Element';
        try {
          if (comp.is('wrapper')) return 'Body / Post Canvas';
          const customName = comp.getName ? comp.getName() : null;
          if (customName && customName !== 'Component' && customName !== 'Box') return customName;

          const tag = (comp.get('tagName') || comp.get('type') || 'Element').toUpperCase();
          const compClasses = comp.getClasses ? comp.getClasses() : [];
          if (compClasses.length > 0) {
            const firstCls = typeof compClasses[0] === 'string' ? compClasses[0] : (compClasses[0]?.get ? compClasses[0].get('name') : '');
            if (firstCls && !firstCls.startsWith('gjs-')) {
              return `${tag} (.${firstCls})`;
            }
          }
          return tag;
        } catch (e) {
          return 'Element';
        }
      }

      // Update tampilan status clipboard & tombol paste
      function updateLayerClipboardUI() {
        const payload = getLayerClipboard();
        const hasContent = !!(payload && payload.html);

        if (layerClipboardBanner && clipboardLayerName && clipboardSourcePill) {
          if (hasContent) {
            layerClipboardBanner.style.display = 'flex';
            clipboardLayerName.textContent = payload.name || 'Component';
            const originTitle = payload.sourcePageTitle || payload.sourcePageSlug || 'page/post';
            clipboardSourcePill.textContent = 'from ' + originTitle;
          } else {
            layerClipboardBanner.style.display = 'none';
          }
        }

        if (btnLayerPasteBelow) btnLayerPasteBelow.disabled = !hasContent;
        if (btnLayerPasteInside) btnLayerPasteInside.disabled = !hasContent;
        if (ctxBtnPasteBelow) ctxBtnPasteBelow.disabled = !hasContent;
        if (ctxBtnPasteInside) ctxBtnPasteInside.disabled = !hasContent;
      }

      // Pastikan layer aktif dan parent-parentnya terbuka di panel Layers, serta scroll ke view
      function revealComponentInLayers(comp) {
        if (!comp || comp.is('wrapper')) return;
        try {
          let parent = comp.parent();
          while (parent && !parent.is('wrapper')) {
            if (editor.LayerManager && typeof editor.LayerManager.setOpen === 'function') {
              editor.LayerManager.setOpen(parent, true);
            }
            parent = parent.parent();
          }

          setTimeout(() => {
            const layersContainer = document.getElementById('layers-container');
            if (!layersContainer) return;
            const activeRow = layersContainer.querySelector('.gjs-layer.gjs-selected > .gjs-layer-item') ||
                              layersContainer.querySelector('.gjs-layer.gjs-selected') ||
                              layersContainer.querySelector('.gjs-selected');
            if (activeRow && typeof activeRow.scrollIntoView === 'function') {
              activeRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 60);
        } catch (err) {
          console.warn('revealComponentInLayers error:', err);
        }
      }

      // Update tombol yang bergantung pada pemilihan layer (Copy, Duplicate, Delete)
      function updateLayerSelectionUI(comp) {
        const hasSelection = !!(comp && !comp.is('wrapper'));
        const isLocked = hasSelection && activePost.layoutMode !== 'blank' && !isComponentInsideContent(comp);
        let name = hasSelection ? getComponentHumanName(comp) : '';
        if (isLocked) {
          name = '🔒 ' + name;
        }

        if (layerActiveBadge) {
          if (hasSelection) {
            layerActiveBadge.style.display = 'inline-block';
            layerActiveBadge.textContent = name;
            if (isLocked) {
              layerActiveBadge.style.color = '#f59e0b';
              layerActiveBadge.style.borderColor = 'rgba(245, 158, 11, 0.4)';
              layerActiveBadge.style.background = 'rgba(245, 158, 11, 0.12)';
            } else {
              layerActiveBadge.style.color = '#ff5e3a';
              layerActiveBadge.style.borderColor = 'rgba(255, 94, 58, 0.3)';
              layerActiveBadge.style.background = 'rgba(255, 94, 58, 0.12)';
            }
          } else {
            layerActiveBadge.style.display = 'none';
          }
        }

        // Disable Delete & Duplicate for locked elements!
        const canModify = hasSelection && !isLocked;
        if (btnLayerCopy) btnLayerCopy.disabled = !hasSelection;
        if (btnLayerDuplicate) btnLayerDuplicate.disabled = !canModify;
        if (btnLayerDelete) btnLayerDelete.disabled = !canModify;

        if (ctxBtnCopy) ctxBtnCopy.disabled = !hasSelection;
        if (ctxBtnDuplicate) ctxBtnDuplicate.disabled = !canModify;
        if (ctxBtnDelete) ctxBtnDelete.disabled = !canModify;

        if (ctxMenuLayerName) {
          ctxMenuLayerName.textContent = hasSelection ? name : 'Post Canvas';
        }

        if (hasSelection) {
          revealComponentInLayers(comp);
        }
      }

      // Kumpulkan semua class dan ID dari komponen beserta anak-anaknya
      function collectComponentSelectors(comp) {
        const ids = new Set();
        const classes = new Set();

        function recurse(c) {
          if (!c) return;
          try {
            const id = c.getId ? c.getId() : (c.get ? c.get('id') : null);
            if (id) ids.add(id);

            const clsList = c.getClasses ? c.getClasses() : [];
            if (Array.isArray(clsList)) {
              clsList.forEach(cls => {
                if (typeof cls === 'string') classes.add(cls);
                else if (cls && cls.get) classes.add(cls.get('name'));
              });
            }

            const children = c.components ? c.components() : [];
            if (children && children.forEach) {
              children.forEach(child => recurse(child));
            }
          } catch (err) {}
        }

        recurse(comp);
        return { ids: Array.from(ids), classes: Array.from(classes) };
      }

      // Ekstrak aturan CSS yang cocok dari editor CssComposer
      function extractMatchingCssRules(comp) {
        if (!comp) return '';
        const { ids, classes } = collectComponentSelectors(comp);
        const matchedRules = [];

        try {
          if (editor.CssComposer && editor.CssComposer.getAll) {
            const allRules = editor.CssComposer.getAll();
            allRules.forEach(rule => {
              try {
                const selector = rule.getSelectorsString ? rule.getSelectorsString() : '';
                if (!selector) return;

                const matchesId = ids.some(id => selector.includes('#' + id));
                const matchesClass = classes.some(cls => selector.includes('.' + cls));

                if (matchesId || matchesClass) {
                  const ruleCss = rule.toCSS ? rule.toCSS() : '';
                  if (ruleCss && ruleCss.trim()) {
                    matchedRules.push(ruleCss.trim());
                  }
                }
              } catch (e) {}
            });
          }
        } catch (e) {
          console.warn('Error extracting css rules:', e);
        }

        return matchedRules.join('\n');
      }

      // Salin layer yang dipilih ke clipboard (tersimpan di localStorage untuk lintas halaman / post)
      function copySelectedLayer(targetComp) {
        const comp = targetComp || editor.getSelected();
        if (!comp || comp.is('wrapper')) {
          showToast('Please select a specific element or layer to copy.', true);
          return;
        }

        const name = getComponentHumanName(comp);
        const html = comp.toHTML ? comp.toHTML() : '';
        const cssRules = extractMatchingCssRules(comp);
        const sourcePageSlug = activePost.slug || 'post';
        const sourcePageTitle = activePost.title || activePost.slug || 'Post';

        const payload = {
          name,
          html,
          cssRules,
          sourcePageSlug,
          sourcePageTitle,
          timestamp: Date.now()
        };

        try {
          localStorage.setItem(LAYER_CLIPBOARD_KEY, JSON.stringify(payload));
          updateLayerClipboardUI();
          showToast(`Layer "${name}" copied! Ready to paste here or across pages/posts.`);
        } catch (err) {
          console.error('Failed to copy layer to storage:', err);
          showToast('Failed to save layer to clipboard.', true);
        }
      }

      // Tempelkan layer (asChild = false: tempel di bawahnya, asChild = true: tempel di dalam kontainer)
      function pasteLayer(asChild = false) {
        const payload = getLayerClipboard();
        if (!payload || !payload.html) {
          showToast('Clipboard is empty. Please copy a layer first.', true);
          return;
        }

        // 1. Terapkan CSS kustom jika ada dan halaman belum memilikinya
        if (payload.cssRules && payload.cssRules.trim()) {
          try {
            editor.addStyle(payload.cssRules);
          } catch (e) {
            console.warn('Error applying copied styles:', e);
          }
        }

        // 2. Tentukan target induk (parent) dan indeks penempatan
        const selected = editor.getSelected();
        let targetParent = editor.getWrapper();
        let insertIndex = targetParent.components().length;

        if (selected && !selected.is('wrapper')) {
          if (asChild) {
            targetParent = selected;
            insertIndex = selected.components().length;
          } else {
            const parent = selected.parent();
            if (parent) {
              targetParent = parent;
              insertIndex = selected.index() + 1;
            }
          }
        }

        // 3. Tambahkan komponen baru
        let added = null;
        try {
          if (asChild) {
            added = targetParent.append(payload.html);
          } else {
            const comps = targetParent.components();
            if (comps && typeof comps.add === 'function') {
              added = comps.add(payload.html, { at: insertIndex });
            } else if (typeof targetParent.append === 'function') {
              added = targetParent.append(payload.html);
            }
          }
        } catch (err) {
          console.warn('Primary paste method error, using editor fallback:', err);
          added = editor.addComponents(payload.html);
        }

        // 4. Pilih komponen yang baru ditempel dan gulirkan kanvas
        if (added) {
          const compToSelect = Array.isArray(added) ? added[0] : added;
          if (compToSelect) {
            editor.select(compToSelect);
            try {
              const el = compToSelect.getEl();
              if (el && el.scrollIntoView) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
            } catch (e) {}
          }
          showToast(`Pasted "${payload.name}" successfully!`);
          updateLayerSelectionUI(compToSelect);
        }
      }

      // Duplikat layer aktif
      function duplicateSelectedLayer() {
        const comp = editor.getSelected();
        if (!comp || comp.is('wrapper')) {
          showToast('Please select a layer to duplicate.', true);
          return;
        }
        if (activePost.layoutMode !== 'blank' && !isComponentInsideContent(comp)) {
          showToast('🔒 This section is auto-generated by the layout and cannot be duplicated.', true);
          return;
        }

        const name = getComponentHumanName(comp);
        const parent = comp.parent() || editor.getWrapper();
        const at = comp.parent() ? comp.index() + 1 : parent.components().length;

        try {
          const html = comp.toHTML ? comp.toHTML() : '';
          const added = parent.components().add(html, { at });
          if (added) {
            const compToSelect = Array.isArray(added) ? added[0] : added;
            if (compToSelect) {
              editor.select(compToSelect);
              try {
                const el = compToSelect.getEl();
                if (el && el.scrollIntoView) {
                  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
              } catch (e) {}
            }
          }
          showToast(`Duplicated "${name}" successfully!`);
        } catch (e) {
          console.error('Failed to duplicate component:', e);
          showToast('Failed to duplicate layer.', true);
        }
      }

      // Hapus layer aktif
      function deleteSelectedLayer() {
        const comp = editor.getSelected();
        if (!comp || comp.is('wrapper')) return;
        if (activePost.layoutMode !== 'blank' && !isComponentInsideContent(comp)) {
          showToast('🔒 This section is auto-generated by the layout and cannot be deleted.', true);
          return;
        }

        const name = getComponentHumanName(comp);
        comp.remove();
        editor.select(null);
        updateLayerSelectionUI(null);
        showToast(`Deleted layer "${name}".`);
      }

      // Bersihkan clipboard
      function clearLayerClipboard() {
        localStorage.removeItem(LAYER_CLIPBOARD_KEY);
        updateLayerClipboardUI();
        showToast('Clipboard cleared.');
      }

      // Buka context menu mengambang pada koordinat (x, y)
      function openLayerContextMenu(x, y) {
        if (!layerContextMenu) return;
        updateLayerClipboardUI();
        updateLayerSelectionUI(editor.getSelected());

        layerContextMenu.style.display = 'block';

        const menuWidth = layerContextMenu.offsetWidth || 190;
        const menuHeight = layerContextMenu.offsetHeight || 210;

        let posX = x;
        let posY = y;
        if (posX + menuWidth > window.innerWidth - 10) {
          posX = window.innerWidth - menuWidth - 10;
        }
        if (posY + menuHeight > window.innerHeight - 10) {
          posY = window.innerHeight - menuHeight - 10;
        }
        if (posX < 10) posX = 10;
        if (posY < 10) posY = 10;

        layerContextMenu.style.left = posX + 'px';
        layerContextMenu.style.top = posY + 'px';
      }

      // Tutup context menu
      function closeLayerContextMenu() {
        if (layerContextMenu) {
          layerContextMenu.style.display = 'none';
        }
      }

      // Handler shortcut keyboard global (Ctrl+C, Ctrl+V, Ctrl+D)
      function handleGlobalLayerShortcuts(e) {
        const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
        const target = e.target;
        if (
          target && (
            target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA' ||
            target.tagName === 'SELECT' ||
            target.isContentEditable ||
            target.getAttribute('contenteditable') === 'true' ||
            (target.closest && target.closest('[contenteditable="true"], [contenteditable=""], [contenteditable], input, textarea, select, .gjs-rte-toolbar, .gjs-sm-field, .gjs-fields'))
          )
        ) {
          return;
        }

        const activeEl = document.activeElement;
        if (activeEl && (
          activeEl.tagName === 'INPUT' ||
          activeEl.tagName === 'TEXTAREA' ||
          activeEl.isContentEditable ||
          (activeEl.closest && activeEl.closest('[contenteditable="true"], .gjs-sm-field'))
        )) {
          return;
        }

        try {
          const frameDoc = editor?.Canvas?.getDocument?.();
          if (frameDoc && frameDoc.activeElement) {
            const fActive = frameDoc.activeElement;
            if (
              fActive.tagName === 'INPUT' ||
              fActive.tagName === 'TEXTAREA' ||
              fActive.isContentEditable ||
              (fActive.closest && fActive.closest('[contenteditable="true"], [contenteditable]'))
            ) {
              return;
            }
          }
        } catch (err) {}

        if (editor?.getEditing && editor.getEditing()) return;
        if (editor?.getModel && editor.getModel().isEditing && editor.getModel().isEditing()) return;

        const isCtrlOrCmd = e.ctrlKey || e.metaKey;

        // Ctrl+C / Cmd+C: Copy Layer
        if (isCtrlOrCmd && (e.key === 'c' || e.key === 'C')) {
          const selected = editor.getSelected();
          if (selected && !selected.is('wrapper')) {
            e.preventDefault();
            copySelectedLayer();
          }
        }

        // Ctrl+V / Cmd+V: Paste Layer Below
        if (isCtrlOrCmd && (e.key === 'v' || e.key === 'V')) {
          if (getLayerClipboard()) {
            e.preventDefault();
            pasteLayer(false);
          }
        }

        // Ctrl+D / Cmd+D: Duplicate Layer
        if (isCtrlOrCmd && (e.key === 'd' || e.key === 'D')) {
          const selected = editor.getSelected();
          if (selected && !selected.is('wrapper')) {
            e.preventDefault();
            duplicateSelectedLayer();
          }
        }

        // Delete : Delete Layer (Hanya tombol Delete fisik, atau Backspace di Mac jika BUKAN sedang edit teks)
        const isDeleteKey = e.key === 'Delete' || (isMac && e.key === 'Backspace');
        if (isDeleteKey && !isCtrlOrCmd) {
          const selected = editor.getSelected();
          if (selected && !selected.is('wrapper')) {
            if (activePost.layoutMode !== 'blank' && !isComponentInsideContent(selected)) {
              e.preventDefault();
              showToast('🔒 This section is auto-generated by the layout and cannot be deleted.', true);
              return;
            }
            e.preventDefault();
            deleteSelectedLayer();
          }
        }
      }

      // Inisialisasi event listener sistem layer clipboard
      function initLayerClipboardSystem() {
        updateLayerClipboardUI();
        updateLayerSelectionUI(editor.getSelected());

        // Event Tombol Toolbar
        if (btnLayerCopy) btnLayerCopy.addEventListener('click', () => copySelectedLayer());
        if (btnLayerPasteBelow) btnLayerPasteBelow.addEventListener('click', () => pasteLayer(false));
        if (btnLayerPasteInside) btnLayerPasteInside.addEventListener('click', () => pasteLayer(true));
        if (btnLayerDuplicate) btnLayerDuplicate.addEventListener('click', () => duplicateSelectedLayer());
        if (btnLayerDelete) btnLayerDelete.addEventListener('click', () => deleteSelectedLayer());
        if (btnClearLayerClipboard) btnClearLayerClipboard.addEventListener('click', clearLayerClipboard);

        // Event Context Menu
        if (ctxBtnCopy) ctxBtnCopy.addEventListener('click', () => { copySelectedLayer(); closeLayerContextMenu(); });
        if (ctxBtnPasteBelow) ctxBtnPasteBelow.addEventListener('click', () => { pasteLayer(false); closeLayerContextMenu(); });
        if (ctxBtnPasteInside) ctxBtnPasteInside.addEventListener('click', () => { pasteLayer(true); closeLayerContextMenu(); });
        if (ctxBtnDuplicate) ctxBtnDuplicate.addEventListener('click', () => { duplicateSelectedLayer(); closeLayerContextMenu(); });
        if (ctxBtnDelete) ctxBtnDelete.addEventListener('click', () => { deleteSelectedLayer(); closeLayerContextMenu(); });

        // Klik kanan pada container layers
        const layersContainer = document.getElementById('layers-container');
        if (layersContainer) {
          layersContainer.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const layerRow = e.target.closest('.gjs-layer');
            if (layerRow) {
              if (!layerRow.classList.contains('gjs-selected')) {
                const titleEl = layerRow.querySelector('.gjs-layer-name, .gjs-layer-title') || layerRow;
                titleEl.click();
              }
            }

            setTimeout(() => {
              openLayerContextMenu(e.clientX, e.clientY);
            }, 20);
          });
        }

        // Klik kanan dan shortcut di iframe canvas
        try {
          const frameEl = editor.Canvas.getFrameEl();
          if (frameEl && frameEl.contentDocument) {
            frameEl.contentDocument.addEventListener('contextmenu', (e) => {
              const selected = editor.getSelected();
              if (selected && !selected.is('wrapper')) {
                e.preventDefault();
                e.stopPropagation();
                const rect = frameEl.getBoundingClientRect();
                const mainX = rect.left + e.clientX;
                const mainY = rect.top + e.clientY;
                openLayerContextMenu(mainX, mainY);
              }
            });

            frameEl.contentDocument.addEventListener('click', closeLayerContextMenu);
            frameEl.contentDocument.addEventListener('keydown', handleGlobalLayerShortcuts);
          }
        } catch (err) {
          console.warn('Canvas frame contextmenu attach warning:', err);
        }

        // Global listeners
        document.addEventListener('click', (e) => {
          if (layerContextMenu && !layerContextMenu.contains(e.target)) {
            closeLayerContextMenu();
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeLayerContextMenu();
        });
        document.addEventListener('keydown', handleGlobalLayerShortcuts);
        window.addEventListener('scroll', closeLayerContextMenu, true);

        // Sinkronisasi lintas tab browser
        window.addEventListener('storage', (e) => {
          if (e.key === LAYER_CLIPBOARD_KEY) {
            updateLayerClipboardUI();
          }
        });
      }
    </script>
  </body>
</html>
