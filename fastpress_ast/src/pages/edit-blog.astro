              bm.add(blockId, {
                label: `<div style="display:flex; flex-direction:column; align-items:center; gap:4px; text-align:center; padding: 4px 0;">
                  <span style="font-size:0.62rem; font-weight:800; padding:2px 6px; border-radius:4px; ${isGlobal ? 'background:#10b981; color:#fff;' : 'background:#0284c7; color:#fff;'}">${badge}</span>
                  <span style="font-size:0.78rem; font-weight:600; line-height:1.2; color:#f3f4f6;">${tpl.name}</span>
                </div>`,
                category: CAT_SAVED_TEMPLATES,
                attributes: {
                  title: `${tpl.name} • ${isGlobal ? 'Global Template (Synced everywhere)' : 'Individual Template (Independent copy)'}`,
