      }

      .pm-tag-pill {
        font-size: 0.68rem;
        color: #9ca3af;
        background: #181c26;
        padding: 1px 6px;
        border-radius: 3px;
        border: 1px solid #282e3c;
      }

      .pm-post-actions {
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: flex-end;
        flex-shrink: 0;
      }

      .btn-pm-action {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 0.76rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid transparent;
        transition: all 0.2s ease;
        white-space: nowrap;
      }

      .btn-pm-edit {
        background-color: #ff5e3a;
        color: #fff;
        border-color: #ff5e3a;
      }

      .btn-pm-edit:hover {
        background-color: #e04826;
      }

      .btn-pm-live {
        background-color: #1e232d;
        color: #d1d5db;
        border-color: #2e3544;
      }

      .btn-pm-live:hover {
        background-color: #2b3240;
        color: #fff;
      }

      .btn-pm-action.active-now {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
        border-color: rgba(16, 185, 129, 0.3);
