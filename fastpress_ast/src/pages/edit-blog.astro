      }

      .pm-post-item:hover {
        border-color: #3b4458;
        background: #1e2330;
      }

      .pm-post-item.is-active {
        border-color: rgba(255, 94, 58, 0.45);
        background: rgba(255, 94, 58, 0.05);
      }

      .pm-post-thumb-wrap {
        width: 120px;
        height: 80px;
        border-radius: 6px;
        overflow: hidden;
        flex-shrink: 0;
        background: #000;
        border: 1px solid #2a3140;
      }

      .pm-post-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .pm-post-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .pm-post-meta-top {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 0.72rem;
      }

      .pm-cat-badge {
        font-size: 0.7rem;
        font-weight: 700;
        color: #ff5e3a;
        background: rgba(255, 94, 58, 0.14);
        border: 1px solid rgba(255, 94, 58, 0.3);
        padding: 1px 7px;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .pm-active-badge {
        font-size: 0.68rem;
        font-weight: 700;
        color: #10b981;
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        padding: 1px 7px;
        border-radius: 4px;
      }

      .pm-meta-date, .pm-meta-readtime {
        color: #9ca3af;
      }

      .pm-post-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #f9fafb;
        margin: 0;
        line-height: 1.35;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .pm-post-excerpt {
        font-size: 0.78rem;
        color: #9ca3af;
        margin: 0;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
