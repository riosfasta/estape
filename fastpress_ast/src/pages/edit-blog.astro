        try {
          let articleBodyHtml = '';
          let relatedSectionHtml = '';

          const frameDoc = editor.Canvas.getDocument();
          if (activePost.layoutMode === 'blank') {
            // For Blank Canvas: the content is the entire canvas root!
            const blankRoot = frameDoc ? (frameDoc.getElementById('blank-canvas-root') || frameDoc.querySelector('.blank-canvas-body')) : null;
            if (blankRoot) {
              articleBodyHtml = blankRoot.innerHTML;
            } else {
              articleBodyHtml = editor.getHtml();
            }
          } else {
            // For Standard Layout: extract ONLY the post content (#article-content-body / [data-post-element="content"])
            if (frameDoc) {
              const bodyContainer = frameDoc.getElementById('article-content-body') || 
                                    frameDoc.querySelector('[data-post-element="content"]') ||
                                    frameDoc.querySelector('.dynamic-article-content');
              if (bodyContainer) {
                articleBodyHtml = bodyContainer.innerHTML;
              }

              // Ambil dan sinkronkan section Related Articles (#canvas-related-posts) jika ada
              const relatedEl = frameDoc.getElementById('canvas-related-posts') || frameDoc.querySelector('.related-posts-section');
              if (relatedEl) {
                relatedSectionHtml = relatedEl.outerHTML;
                const curTagline = relatedEl.querySelector('#canvas-related-tagline, .section-tagline');
                if (curTagline && curTagline.innerText.trim()) activePost.relatedTagline = curTagline.innerText.trim();
                const curTitle = relatedEl.querySelector('#canvas-related-title, .section-title');
                if (curTitle && curTitle.innerText.trim()) activePost.relatedTitle = curTitle.innerText.trim();
              } else if (activePost.showRelated !== false) {
                relatedSectionHtml = generateRelatedSectionHTML(activePost);
              }

              // Sinkronkan gambar utama jika ada di canvas
              const canvasImg = frameDoc.getElementById('canvas-featured-img') || frameDoc.querySelector('.featured-post-img');
              if (canvasImg) {
                const src = canvasImg.getAttribute('src');
                if (src) activePost.image = src;
              }
            }

            // Fallback jika tidak menemukan inner container
            if (!articleBodyHtml) {
              const wrapper = editor.getWrapper();
              const bodyComp = wrapper.find('#article-content-body')[0] || wrapper.find('[data-post-element="content"]')[0];
              if (bodyComp) {
                articleBodyHtml = bodyComp.toHTML();
              } else {
                articleBodyHtml = editor.getHtml();
              }
            }
          }

          try {
            if (editor.getWrapper()) {
              editor.getWrapper().find('.gjs-hover-preview').forEach(c => c.removeClass('gjs-hover-preview'));
            }
          } catch (e) {}
          if (articleBodyHtml) {
            articleBodyHtml = articleBodyHtml.replace(/\s*\bgjs-hover-preview\b/g, '');
            // Clean builder-only dropzone placeholder buttons & hint
            articleBodyHtml = articleBodyHtml.replace(/<div[^>]*\bclass=["'][^"']*\bdropzone-buttons-row\b[^"']*["'][^>]*>[\s\S]*?<\/div>/gi, '');
            articleBodyHtml = articleBodyHtml.replace(/<div[^>]*\bclass=["'][^"']*\b(dropzone-hint|dropzone-text)\b[^"']*["'][^>]*>[\s\S]*?<\/div>/gi, '');
            articleBodyHtml = articleBodyHtml.replace(/<button[^>]*\b(?:btn-trigger-add-block|btn-trigger-add-template|btnDropzoneAddBlock|btnDropzoneAddTemplate)\b[^>]*>[\s\S]*?<\/button>/gi, '');
            articleBodyHtml = articleBodyHtml.replace(/<div[^>]*\b(?:class=["'][^"']*\bempty-workspace-dropzone\b[^"']*["']|id=["']emptyWorkspaceDropzone["'])[^>]*>\s*<\/div>/gi, '');
            articleBodyHtml = articleBodyHtml.replace(/(<div[^>]*\b(?:class=["'][^"']*\bempty-workspace-dropzone\b[^"']*["']|id=["']emptyWorkspaceDropzone["'])[^>]*)\bstyle=["'][^"']*["']/gi, '$1style=""');
          }

          const css = editor.getCss();
          const projectData = editor.getProjectData();

          const payload = {
            action: 'save',
            slug: activePost.slug,
            newSlug: activePost.newSlug || activePost.slug,
            title: activePost.title,
            category: activePost.category,
            categories: activePost.categories || getPostCategoriesArray(activePost),
            categorySlugs: activePost.categorySlugs || (activePost.categories || getPostCategoriesArray(activePost)).map(c => c.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '')),
            image: activePost.image,
            excerpt: activePost.excerpt,
            readTime: activePost.readTime,
            date: activePost.date,
            formattedDate: activePost.formattedDate,
            authorName: activePost.author?.name,
            authorRole: activePost.author?.role,
            authorAvatar: activePost.author?.avatar,
            keywords: activePost.keywords !== undefined ? activePost.keywords : '',
            tags: activePost.tags !== undefined ? activePost.tags : '',
            schema: activePost.schema !== undefined ? activePost.schema : '',
            showRelated: activePost.showRelated !== false,
            relatedTagline: activePost.relatedTagline || 'REKOMENDASI',
            relatedTitle: activePost.relatedTitle || 'Artikel Terkait',
            relatedCategory: activePost.relatedCategory || 'auto',
            relatedOrderBy: activePost.relatedOrderBy || 'date-desc',
            relatedLimit: activePost.relatedLimit || 2,
            relatedHtml: relatedSectionHtml || activePost.relatedHtml || '',
            layoutMode: activePost.layoutMode || 'standard',
            layoutId: activePost.layoutId || undefined,
            customCode: activePost.customCode || null,
            content: articleBodyHtml,
            css: css,
            projectData: projectData
          };

          const res = await fetch('/api/posts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await res.json();
          if (data.success) {
            showToast('Post saved successfully!');
            // Update URL jika slug berubah
            if (data.post && data.post.slug !== activePost.slug) {
              activePost.slug = data.post.slug;
              delete activePost.newSlug;
              window.history.replaceState({}, '', `/edit-blog?slug=${encodeURIComponent(data.post.slug)}`);
              document.getElementById('btnLiveArticle').href = `/blog/${data.post.slug}`;
            }
          } else {
            showToast(data.error || 'Failed to save post', true);
          }
        } catch (err) {
          showToast('An error occurred while saving: ' + err.message, true);
        } finally {
          btnSave.disabled = false;
          btnSave.style.opacity = '1';
