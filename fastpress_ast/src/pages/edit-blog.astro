      }

      .btn-apply-code:hover {
        background: #e04825;
      }

      /* ========================================================= */
      /* Layer Manager Overrides & Active Layer Visual Highlights   */
      /* ========================================================= */
      #layers-container {
        font-family: inherit;
        --gjs-primary-color: #ff5e3a;
        --gjs-main-dark-color: #1e2330;
        --gjs-secondary-dark-color: #141720;
      }

      .gjs-layers {
        padding: 2px 0;
      }

      /* Default Layer Item / Row */
      .gjs-layer {
        background-color: transparent !important;
        font-size: 0.78rem !important;
      }

      .gjs-layer-item {
        background-color: #131722 !important;
        color: #9ca3af !important;
        border-bottom: 1px solid #1f2533 !important;
        border-left: 3px solid transparent !important;
        padding: 7px 8px !important;
        cursor: pointer !important;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease !important;
        gap: 6px !important;
      }

      .gjs-layer-name {
        color: #d1d5db !important;
        font-size: 0.78rem !important;
        font-weight: 500 !important;
        transition: color 0.15s ease !important;
      }

      .gjs-layer__icon svg {
        fill: #9ca3af !important;
        transition: fill 0.15s ease !important;
      }

      .gjs-layer-caret {
        color: #6b7280 !important;
        opacity: 0.8 !important;
      }

      .gjs-layer-vis {
        color: #6b7280 !important;
        opacity: 0.7 !important;
        transition: opacity 0.15s ease, color 0.15s ease !important;
      }

      .gjs-layer-vis:hover {
        opacity: 1 !important;
        color: #e5e7eb !important;
      }

      /* Hover State */
      .gjs-layer-item:hover,
      .gjs-layer:hover > .gjs-layer-item,
      .gjs-layer.gjs-hovered > .gjs-layer-item {
        background-color: #1c2230 !important;
        color: #f3f4f6 !important;
        border-left: 3px solid #4b5563 !important;
      }

      .gjs-layer-item:hover .gjs-layer-name,
      .gjs-layer:hover > .gjs-layer-item .gjs-layer-name {
        color: #ffffff !important;
      }

      .gjs-layer-item:hover .gjs-layer__icon svg,
      .gjs-layer:hover > .gjs-layer-item .gjs-layer__icon svg {
        fill: #ff7e5f !important;
      }

      /* ACTIVE / SELECTED LAYER STATE */
      .gjs-layer.gjs-selected > .gjs-layer-item,
      .gjs-layer-item.gjs-selected,
      .gjs-layer.gjs-selected > .gjs-layer-title {
        background: linear-gradient(90deg, rgba(255, 94, 58, 0.28) 0%, rgba(255, 94, 58, 0.12) 100%) !important;
        background-color: #271a1d !important;
        color: #ffffff !important;
        border-left: 3px solid #ff5e3a !important;
        border-bottom: 1px solid rgba(255, 94, 58, 0.35) !important;
        box-shadow: inset 0 0 0 1px rgba(255, 94, 58, 0.35), 0 2px 8px rgba(255, 94, 58, 0.2) !important;
      }

      .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-name,
      .gjs-layer-item.gjs-selected .gjs-layer-name {
        color: #ffffff !important;
        font-weight: 700 !important;
        letter-spacing: 0.2px;
      }

      .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer__icon svg,
      .gjs-layer-item.gjs-selected .gjs-layer__icon svg {
        fill: #ff5e3a !important;
        filter: drop-shadow(0 0 4px rgba(255, 94, 58, 0.6)) !important;
      }

      .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-caret,
      .gjs-layer-item.gjs-selected .gjs-layer-caret {
        color: #ff7e5f !important;
        opacity: 1 !important;
      }

      .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-vis,
      .gjs-layer-item.gjs-selected .gjs-layer-vis {
        color: #ff9e85 !important;
        opacity: 1 !important;
      }

      /* "ACTIVE" Badge Pill inside Active Layer Row */
      .gjs-layer.gjs-selected > .gjs-layer-item .gjs-layer-title-inn::after,
      .gjs-layer-item.gjs-selected .gjs-layer-title-inn::after {
        content: 'ACTIVE';
        display: inline-block;
        font-size: 8px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        color: #ff5e3a;
        background: rgba(255, 94, 58, 0.22);
        border: 1px solid rgba(255, 94, 58, 0.55);
        padding: 2px 5px;
        border-radius: 3px;
        margin-left: 6px;
        vertical-align: middle;
        box-shadow: 0 0 6px rgba(255, 94, 58, 0.25);
      }

      /* Layer Actions & Toolbar */
      .layer-active-badge {
        font-size: 0.68rem;
        font-weight: 700;
        color: #ff5e3a;
        background: rgba(255, 94, 58, 0.16);
        border: 1px solid rgba(255, 94, 58, 0.45);
        border-radius: 4px;
        padding: 2px 7px;
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-shadow: 0 0 8px rgba(255, 94, 58, 0.2);
      }

      .layer-actions-toolbar {
        display: grid;
        grid-template-columns: repeat(4, 1fr) 34px;
        gap: 5px;
        background: #11141c;
        border: 1px solid #232936;
        border-radius: 8px;
        padding: 5px;
        margin-bottom: 10px;
      }

      .btn-layer-tool {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        padding: 6px 3px;
        background: #181d28;
        border: 1px solid #2b3344;
        border-radius: 6px;
        color: #9ca3af;
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
      }

      .btn-layer-tool:hover:not(:disabled) {
        background: #232a3a;
        color: #f3f4f6;
        border-color: #3f4a60;
        transform: translateY(-1px);
      }

      .btn-layer-tool:active:not(:disabled) {
        transform: translateY(0);
      }

      .btn-layer-tool:disabled {
        opacity: 0.35;
        cursor: not-allowed;
        background: #131720;
        border-color: #1f2532;
        color: #6b7280;
      }

      .btn-layer-tool.primary:hover:not(:disabled) {
        background: rgba(255, 94, 58, 0.12);
        color: #ff7e5f;
        border-color: rgba(255, 94, 58, 0.4);
      }

      .btn-layer-tool.success:hover:not(:disabled) {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.4);
      }

      .btn-layer-tool.inside:hover:not(:disabled) {
        background: rgba(59, 130, 246, 0.12);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.4);
      }

      .btn-layer-tool.duplicate:hover:not(:disabled) {
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border-color: rgba(245, 158, 11, 0.4);
      }

      .btn-layer-tool.danger {
        padding: 6px;
      }

      .btn-layer-tool.danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.4);
      }

      /* Cross-Page Clipboard Banner */
      .layer-clipboard-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.25);
        border-radius: 6px;
        padding: 6px 10px;
        margin-bottom: 10px;
        animation: fadeInClipboard 0.2s ease-out;
      }

      @keyframes fadeInClipboard {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .clipboard-banner-left {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
      }

      .clipboard-banner-icon {
        font-size: 0.95rem;
        flex-shrink: 0;
      }

      .clipboard-banner-info {
        display: flex;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
      }

      .clipboard-banner-title {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        color: #d1fae5;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .clipboard-banner-title strong {
        color: #34d399;
        font-weight: 700;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .clipboard-source-pill {
        font-size: 0.62rem;
        color: #6ee7b7;
        background: rgba(16, 185, 129, 0.2);
        border-radius: 3px;
        padding: 1px 4px;
        font-weight: 500;
      }

      .clipboard-banner-desc {
        font-size: 0.65rem;
        color: #9ca3af;
      }

      .btn-clipboard-clear {
        background: none;
        border: none;
        color: #6ee7b7;
        cursor: pointer;
        padding: 2px 6px;
        font-size: 1rem;
        line-height: 1;
        border-radius: 4px;
        transition: all 0.15s ease;
      }

      .btn-clipboard-clear:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
      }

      /* Context Menu for Layers & Canvas */
      .layer-context-menu {
        position: fixed;
        z-index: 999999;
        min-width: 185px;
        background: #141720;
        border: 1px solid #2b3344;
        border-radius: 8px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05);
        padding: 5px;
        font-family: inherit;
        backdrop-filter: blur(8px);
      }

      .context-menu-header {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px 6px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .ctx-layer-name {
        color: #ff7e5f;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .context-menu-divider {
        height: 1px;
        background: #232936;
        margin: 4px 0;
      }

      .ctx-menu-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 7px 9px;
        border-radius: 5px;
        background: transparent;
        border: none;
        color: #d1d5db;
        font-size: 0.76rem;
        font-weight: 500;
        cursor: pointer;
        text-align: left;
        transition: all 0.12s ease;
      }

      .ctx-menu-item:hover:not(:disabled) {
        background: #232b3b;
        color: #fff;
      }

      .ctx-menu-item:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .ctx-item-left {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .ctx-shortcut {
        font-size: 0.65rem;
        color: #6b7280;
        font-family: monospace;
      }

      .ctx-menu-item.danger:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
      }

      /* ========================================================
         STYLE MANAGER STATE SWITCHER: NORMAL vs HOVER
         ======================================================== */
      .gjs-sm-state-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        background: #0f131a;
        border-bottom: 1px solid #1e2638;
        margin-bottom: 8px;
        border-radius: 6px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        gap: 8px;
      }
      .gjs-sm-state-left {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .gjs-sm-state-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
      }
      .gjs-sm-state-pills, .gjs-sector-state-switch {
        display: inline-flex;
        background: #0b0e14;
        border: 1px solid #232c3d;
        border-radius: 6px;
        padding: 2px;
        gap: 2px;
        margin-left: auto;
      }
      .gjs-state-btn, .gjs-master-state-btn {
        background: transparent;
        border: none;
        color: #8b9bb4;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: lowercase;
        padding: 2px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s ease;
        line-height: 1.2;
      }
      .gjs-master-state-btn {
        text-transform: none;
        padding: 3px 10px;
        font-size: 0.72rem;
      }
      .gjs-state-btn:hover, .gjs-master-state-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
      }
      .gjs-state-btn.is-active, .gjs-master-state-btn.is-active {
        background: #ff5e3a !important;
        color: #ffffff !important;
        box-shadow: 0 2px 6px rgba(255, 94, 58, 0.4);
      }
      .gjs-state-btn[data-state="normal"].is-active,
      .gjs-master-state-btn[data-state="normal"].is-active {
        background: #252e3e !important;
        color: #ffffff !important;
        box-shadow: none;
      }
      .gjs-sm-state-badge {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        background: #18202d;
        color: #94a3b8;
        border: 1px solid #232c3d;
        white-space: nowrap;
      }
      .gjs-sm-state-badge.is-hover {
        background: rgba(255, 94, 58, 0.15);
        color: #ff5e3a;
        border-color: rgba(255, 94, 58, 0.4);
      }
      .gjs-sm-sector-title {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        position: relative;
        padding-right: 8px !important;
      }
      .gjs-sm-sector-label {
        flex: 1;
      }
    </style>
  </head>

  <body>
