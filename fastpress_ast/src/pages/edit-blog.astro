      }

      .posts-manager-footer {
        padding: 10px 18px;
        background: #161921;
        border-top: 1px solid #282f3d;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
      }

      .pm-pagination-info {
        font-size: 0.78rem;
        color: #9ca3af;
      }

      .pm-pagination-info strong {
        color: #f3f4f6;
      }

      .pm-pagination-controls {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .pm-page-btn {
        min-width: 28px;
        height: 28px;
        padding: 0 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #1a1e28;
        border: 1px solid #2a3140;
        color: #d1d5db;
        border-radius: 4px;
        font-size: 0.76rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
      }

      .pm-page-btn:hover:not(:disabled) {
        background: #252b38;
        color: #fff;
        border-color: #3f475a;
      }

      .pm-page-btn.active {
        background: #ff5e3a;
        color: #fff;
        border-color: #ff5e3a;
      }

      .pm-page-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .pm-page-ellipsis {
        color: #6b7280;
        font-size: 0.78rem;
        padding: 0 4px;
      }

      .pm-empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6b7280;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }

      @media (max-width: 720px) {
        .pm-post-item {
          flex-direction: column;
          align-items: flex-start;
        }
        .pm-post-thumb-wrap {
          width: 100%;
          height: 140px;
        }
        .pm-post-actions {
          flex-direction: row;
          width: 100%;
          justify-content: flex-end;
          margin-top: 8px;
        }
      }

