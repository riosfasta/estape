            "@type": "Review",
            "itemReviewed": {
              "@type": "Thing",
              "name": postTitle
            },
            "author": {
              "@type": "Person",
              "name": authorName
            },
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5",
              "bestRating": "5"
            },
            "reviewBody": postDesc
          };
        } else if (type === 'Product') {
          return {
