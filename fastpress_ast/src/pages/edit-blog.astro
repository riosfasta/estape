            <div style="display: flex; align-items: center; gap: 8px;">
              <div class="schema-mode-switcher">
                <button type="button" class="btn-schema-mode ${cur.mode === 'visual' ? 'active' : ''}" id="btnPostCurModeVisual">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <span>Visual</span>
                </button>
                <button type="button" class="btn-schema-mode ${cur.mode === 'code' ? 'active' : ''}" id="btnPostCurModeCode">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                  <span>Code</span>
                </button>
              </div>
              <button type="button" class="schema-code-btn" id="btnPostCurDuplicate" title="Duplicate this schema item">+ Duplicate</button>
              <button type="button" class="schema-code-btn" id="btnPostCurDelete" style="color: #ef4444; border-color: rgba(239,68,68,0.3);" title="Delete this schema item">Delete</button>
            </div>
          </div>

          <!-- Dynamic Form (Visual) -->
          <div id="curPostSchemaVisualPane" style="display: ${cur.mode === 'visual' ? 'block' : 'none'};">
            <div id="curPostSchemaDynamicFields"></div>
          </div>

          <!-- Code Editor Pane -->
          <div id="curPostSchemaCodePane" style="display: ${cur.mode === 'code' ? 'block' : 'none'};">
            <div class="schema-code-toolbar">
              <div class="schema-validation-status valid" id="curPostSchemaValStatus">
                <span>✓ Valid JSON-LD</span>
              </div>
              <div style="display: flex; gap: 6px;">
                <button type="button" class="schema-code-btn" id="btnPostCurFormat">Format JSON</button>
                <button type="button" class="schema-code-btn" id="btnPostCurReset">Reset to Default</button>
              </div>
            </div>
            <textarea id="curPostSchemaTextarea" class="schema-code-textarea" rows="8">${cur.code}</textarea>
            <span class="field-hint" style="margin-top: 5px; font-size: 0.72rem; color: #6b7280; display: block;">Pure Schema.org JSON-LD (without &lt;script&gt; tags).</span>
          </div>
        `;

        postSchemaContentContainer.appendChild(editorWrap);

        // Attach listeners for type and mode
        const selType = document.getElementById('selCurPostSchemaType');
        selType?.addEventListener('change', () => {
          const newType = selType.value;
          cur.type = newType;
          if (newType === 'Custom') {
            cur.mode = 'code';
          } else {
            const defaultObj = createDefaultPostSchemaObject(newType);
            cur.code = JSON.stringify(defaultObj, null, 2);
          }
          renderPostSchemasUI();
        });

        document.getElementById('btnPostCurModeVisual')?.addEventListener('click', () => {
          cur.mode = 'visual';
          renderPostSchemasUI();
        });

        document.getElementById('btnPostCurModeCode')?.addEventListener('click', () => {
          cur.mode = 'code';
          renderPostSchemasUI();
        });

        document.getElementById('btnPostCurDuplicate')?.addEventListener('click', () => {
          const clone = {
            id: 'bts_' + Math.random().toString(36).substring(2, 9),
            type: cur.type,
            mode: cur.mode,
            code: cur.code
          };
          postSchemas.push(clone);
          activePostSchemaIdx = postSchemas.length - 1;
          renderPostSchemasUI();
        });

        document.getElementById('btnPostCurDelete')?.addEventListener('click', () => {
          if (confirm(`Delete Schema #${activePostSchemaIdx + 1} (${cur.type})?`)) {
            postSchemas.splice(activePostSchemaIdx, 1);
            if (activePostSchemaIdx >= postSchemas.length) {
              activePostSchemaIdx = postSchemas.length - 1;
            }
            renderPostSchemasUI();
          }
        });

        // Code Editor actions
        const codeTextarea = document.getElementById('curPostSchemaTextarea');
        const valStatus = document.getElementById('curPostSchemaValStatus');

        function validateCurrentPostCode() {
          if (!codeTextarea || !valStatus) return true;
          const val = codeTextarea.value.trim();
          if (!val) {
            valStatus.className = 'schema-validation-status valid';
            valStatus.innerHTML = '<span>○ Empty Schema</span>';
            return true;
          }
          try {
            JSON.parse(val);
            valStatus.className = 'schema-validation-status valid';
            valStatus.innerHTML = '<span>✓ Valid JSON-LD</span>';
            return true;
          } catch (e) {
            valStatus.className = 'schema-validation-status invalid';
            valStatus.innerHTML = `<span>⚠ Invalid JSON: ${e.message}</span>`;
            return false;
          }
        }

        codeTextarea?.addEventListener('input', () => {
          cur.code = codeTextarea.value;
          validateCurrentPostCode();
          updatePostSchemaPreview();
        });

        document.getElementById('btnPostCurFormat')?.addEventListener('click', () => {
          try {
            const p = JSON.parse(codeTextarea.value);
            codeTextarea.value = JSON.stringify(p, null, 2);
            cur.code = codeTextarea.value;
            validateCurrentPostCode();
            updatePostSchemaPreview();
          } catch {
            alert('Cannot format invalid JSON. Please fix syntax errors first.');
          }
        });

        document.getElementById('btnPostCurReset')?.addEventListener('click', () => {
          if (confirm('Reset this schema to default template?')) {
            const def = createDefaultPostSchemaObject(cur.type);
            codeTextarea.value = JSON.stringify(def, null, 2);
            cur.code = codeTextarea.value;
            validateCurrentPostCode();
            renderPostSchemasUI();
          }
        });

        validateCurrentPostCode();

        // Render Dynamic Visual Fields
        if (cur.mode === 'visual') {
          renderPostSchemaVisualSubfields(cur, curParsed);
        }
      }

      function renderPostSchemaVisualSubfields(cur, data = {}) {
        const container = document.getElementById('curPostSchemaDynamicFields');
        if (!container) return;
        container.innerHTML = '';

        const type = cur.type;
        const postTitle = activePost.title || 'Article Title';
        const postDesc = activePost.excerpt || 'Article summary';
        const postImage = activePost.image || '';
        const authorName = activePost.author?.name || 'Better Team';

        if (type === 'Custom') {
          container.innerHTML = `
            <div style="padding: 12px; background: rgba(255,94,58,0.08); border: 1px dashed rgba(255,94,58,0.3); border-radius: 6px; text-align: center;">
              <p style="font-size: 0.76rem; color: #d1d5db; margin: 0 0 8px 0;">Custom Schema.org JSON-LD is managed via the Code Editor.</p>
              <button type="button" class="schema-code-btn" id="btnGoToPostCurCode">Switch to Code Editor</button>
            </div>
          `;
          document.getElementById('btnGoToPostCurCode')?.addEventListener('click', () => {
            cur.mode = 'code';
            renderPostSchemasUI();
          });
          return;
        }

        const subwrap = document.createElement('div');

        if (type === 'Article' || type === 'NewsArticle') {
          const author = data.author || {};
          const publisher = data.publisher || {};
          subwrap.innerHTML = `
            <div style="margin-bottom: 8px;">
              <label class="schema-field-label">Headline / Title</label>
              <input type="text" class="form-input psf-field" data-k="art_title" value="${data.headline || postTitle}" />
            </div>
            <div style="margin-bottom: 8px;">
              <label class="schema-field-label">Summary / Description</label>
              <textarea class="form-input psf-field" data-k="art_desc" rows="2">${data.description || postDesc}</textarea>
            </div>
            <div class="schema-grid-3">
              <div>
                <label class="schema-field-label">Author Name</label>
                <input type="text" class="form-input psf-field" data-k="art_author" value="${author.name || authorName}" />
              </div>
              <div>
                <label class="schema-field-label">Publisher</label>
                <input type="text" class="form-input psf-field" data-k="art_pub" value="${publisher.name || 'Better Corp'}" />
              </div>
              <div>
                <label class="schema-field-label">Publish Date</label>
                <input type="date" class="form-input psf-field" data-k="art_date" value="${data.datePublished || new Date().toISOString().split('T')[0]}" />
              </div>
            </div>
            <div>
              <label class="schema-field-label">Featured Image URL</label>
              <input type="text" class="form-input psf-field" data-k="art_img" value="${data.image || postImage}" placeholder="https://..." />
            </div>
          `;
        } else if (type === 'Review') {
          const item = data.itemReviewed || {};
          const rating = data.reviewRating || {};
          const author = data.author || {};
          subwrap.innerHTML = `
            <div class="schema-grid-2">
              <div>
                <label class="schema-field-label">Item / Topic Reviewed</label>
                <input type="text" class="form-input psf-field" data-k="rev_item" value="${item.name || postTitle}" placeholder="Web Design & Branding" />
              </div>
              <div>
                <label class="schema-field-label">Reviewer Name</label>
                <input type="text" class="form-input psf-field" data-k="rev_author" value="${author.name || authorName}" placeholder="John Doe" />
              </div>
            </div>
            <div class="schema-grid-2">
              <div>
                <label class="schema-field-label">Rating Score (1-5)</label>
                <input type="number" step="0.5" min="1" max="5" class="form-input psf-field" data-k="rev_score" value="${rating.ratingValue || '5'}" />
              </div>
              <div>
                <label class="schema-field-label">Best Rating</label>
                <input type="number" class="form-input psf-field" data-k="rev_best" value="${rating.bestRating || '5'}" />
              </div>
            </div>
            <div>
              <label class="schema-field-label">Review Body</label>
              <textarea class="form-input psf-field" data-k="rev_body" rows="2" placeholder="Exceptional insights and practical case studies...">${data.reviewBody || postDesc}</textarea>
            </div>
          `;
        } else if (type === 'Product') {
          const offers = data.offers || {};
          const agg = data.aggregateRating || {};
          subwrap.innerHTML = `
            <div class="schema-grid-2">
              <div>
                <label class="schema-field-label">Product Name</label>
                <input type="text" class="form-input psf-field" data-k="prod_name" value="${data.name || postTitle}" placeholder="Course / Product" />
              </div>
              <div>
                <label class="schema-field-label">Brand</label>
                <input type="text" class="form-input psf-field" data-k="prod_brand" value="${data.brand?.name || data.brand || 'Better'}" placeholder="Better Agency" />
              </div>
            </div>
            <div style="margin-bottom: 8px;">
              <label class="schema-field-label">Description</label>
              <textarea class="form-input psf-field" data-k="prod_desc" rows="2">${data.description || postDesc}</textarea>
            </div>
            <div class="schema-grid-3">
              <div>
                <label class="schema-field-label">Price</label>
                <input type="text" class="form-input psf-field" data-k="prod_price" value="${offers.price || '99'}" placeholder="99" />
              </div>
              <div>
                <label class="schema-field-label">Currency</label>
                <input type="text" class="form-input psf-field" data-k="prod_curr" value="${offers.priceCurrency || 'USD'}" placeholder="USD, IDR..." />
              </div>
              <div>
                <label class="schema-field-label">Availability</label>
                <select class="form-input psf-field" data-k="prod_avail">
                  <option value="https://schema.org/InStock" ${offers.availability?.includes('InStock') ? 'selected' : ''}>In Stock</option>
                  <option value="https://schema.org/PreOrder" ${offers.availability?.includes('PreOrder') ? 'selected' : ''}>Pre-Order</option>
                  <option value="https://schema.org/OutOfStock" ${offers.availability?.includes('OutOfStock') ? 'selected' : ''}>Out of Stock</option>
                </select>
              </div>
            </div>
            <div class="schema-grid-2">
              <div>
                <label class="schema-field-label">Rating Value (1-5)</label>
                <input type="number" step="0.1" min="1" max="5" class="form-input psf-field" data-k="prod_rating" value="${agg.ratingValue || '4.9'}" />
              </div>
              <div>
                <label class="schema-field-label">Review Count</label>
                <input type="number" class="form-input psf-field" data-k="prod_count" value="${agg.reviewCount || '18'}" />
              </div>
            </div>
          `;
        } else if (type === 'LocalBusiness') {
          const addr = data.address || {};
          subwrap.innerHTML = `
            <div class="schema-grid-2">
              <div>
                <label class="schema-field-label">Business Name</label>
                <input type="text" class="form-input psf-field" data-k="name" value="${data.name || 'Better Digital Agency'}" placeholder="Better Agency Inc." />
              </div>
              <div>
                <label class="schema-field-label">Telephone</label>
                <input type="text" class="form-input psf-field" data-k="telephone" value="${data.telephone || ''}" placeholder="+62 812-3456-7890" />
              </div>
            </div>
            <div class="schema-grid-2">
              <div>
                <label class="schema-field-label">Email</label>
                <input type="email" class="form-input psf-field" data-k="email" value="${data.email || ''}" placeholder="hello@better.com" />
              </div>
              <div>
                <label class="schema-field-label">Price Range</label>
                <input type="text" class="form-input psf-field" data-k="priceRange" value="${data.priceRange || '$$'}" placeholder="$$ or $100 - $500" />
              </div>
            </div>
            <div style="margin-bottom: 8px;">
              <label class="schema-field-label">Street Address</label>
              <input type="text" class="form-input psf-field" data-k="street" value="${addr.streetAddress || ''}" placeholder="123 Business Avenue, Suite 400" />
            </div>
            <div class="schema-grid-3">
              <div>
                <label class="schema-field-label">City / Locality</label>
                <input type="text" class="form-input psf-field" data-k="city" value="${addr.addressLocality || ''}" placeholder="Jakarta Selatan" />
              </div>
              <div>
                <label class="schema-field-label">State / Region</label>
                <input type="text" class="form-input psf-field" data-k="region" value="${addr.addressRegion || ''}" placeholder="DKI Jakarta" />
              </div>
              <div>
                <label class="schema-field-label">Postal Code</label>
                <input type="text" class="form-input psf-field" data-k="postal" value="${addr.postalCode || ''}" placeholder="12190" />
              </div>
            </div>
          `;
        } else if (type === 'FAQPage') {
          const faqs = Array.isArray(data.mainEntity)
            ? data.mainEntity.map(e => ({ q: e.name || '', a: e.acceptedAnswer?.text || '' }))
            : [{ q: 'What is covered in this article?', a: postDesc }];

          subwrap.innerHTML = `
            <div id="btsFaqList"></div>
            <button type="button" class="schema-code-btn" id="btnAddBtsFaq" style="margin-top: 6px;">+ Add Question & Answer</button>
          `;

          container.appendChild(subwrap);

          function renderPostFaqRows() {
            const listEl = document.getElementById('btsFaqList');
            if (!listEl) return;
            listEl.innerHTML = '';
            faqs.forEach((faq, fIdx) => {
              const card = document.createElement('div');
              card.className = 'schema-faq-card';
              card.innerHTML = `
                <button type="button" class="btn-del-faq" data-idx="${fIdx}" title="Remove question">&times;</button>
                <div style="margin-bottom: 6px;">
                  <label class="schema-field-label">Question #${fIdx + 1}</label>
                  <input type="text" class="form-input bts-faq-q" data-idx="${fIdx}" value="${faq.q || ''}" placeholder="e.g. What is the key takeaway?" />
                </div>
                <div>
                  <label class="schema-field-label">Answer</label>
                  <textarea class="form-input bts-faq-a" data-idx="${fIdx}" rows="2" placeholder="e.g. Understanding brand architecture...">${faq.a || ''}</textarea>
                </div>
              `;
              listEl.appendChild(card);
            });

            listEl.querySelectorAll('.btn-del-faq').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const fIdx = parseInt(e.target.dataset.idx, 10);
                faqs.splice(fIdx, 1);
                renderPostFaqRows();
                syncPostFaqToJson();
              });
            });

            listEl.querySelectorAll('.bts-faq-q').forEach(inp => {
              inp.addEventListener('input', (e) => {
                const fIdx = parseInt(e.target.dataset.idx, 10);
                if (faqs[fIdx]) faqs[fIdx].q = e.target.value;
                syncPostFaqToJson();
              });
            });

            listEl.querySelectorAll('.bts-faq-a').forEach(inp => {
              inp.addEventListener('input', (e) => {
                const fIdx = parseInt(e.target.dataset.idx, 10);
                if (faqs[fIdx]) faqs[fIdx].a = e.target.value;
                syncPostFaqToJson();
              });
            });
          }

          function syncPostFaqToJson() {
            const obj = {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": faqs.filter(f => f.q.trim()).map(f => ({
                "@type": "Question",
                "name": f.q.trim(),
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": f.a.trim()
                }
              }))
            };
            cur.code = JSON.stringify(obj, null, 2);
            updatePostSchemaPreview();
          }

          renderPostFaqRows();

          document.getElementById('btnAddBtsFaq')?.addEventListener('click', () => {
            faqs.push({ q: '', a: '' });
            renderPostFaqRows();
            syncPostFaqToJson();
          });

          return;
        }

        container.appendChild(subwrap);

        function syncPostFieldsToJson() {
          let obj = null;
          if (type === 'Article' || type === 'NewsArticle') {
            obj = {
              "@context": "https://schema.org",
              "@type": type === 'Article' ? 'BlogPosting' : 'NewsArticle',
              "headline": container.querySelector('[data-k="art_title"]')?.value || "",
              "description": container.querySelector('[data-k="art_desc"]')?.value || "",
              "image": container.querySelector('[data-k="art_img"]')?.value || "",
              "datePublished": container.querySelector('[data-k="art_date"]')?.value || new Date().toISOString().split('T')[0],
              "author": {
                "@type": "Person",
                "name": container.querySelector('[data-k="art_author"]')?.value || authorName
              },
              "publisher": {
                "@type": "Organization",
                "name": container.querySelector('[data-k="art_pub"]')?.value || "Better Corp"
              }
            };
          } else if (type === 'Review') {
            obj = {
              "@context": "https://schema.org",
              "@type": "Review",
              "itemReviewed": {
                "@type": "Thing",
                "name": container.querySelector('[data-k="rev_item"]')?.value || ""
              },
              "author": {
                "@type": "Person",
                "name": container.querySelector('[data-k="rev_author"]')?.value || authorName
              },
              "reviewRating": {
                "@type": "Rating",
                "ratingValue": container.querySelector('[data-k="rev_score"]')?.value || "5",
                "bestRating": container.querySelector('[data-k="rev_best"]')?.value || "5"
              },
              "reviewBody": container.querySelector('[data-k="rev_body"]')?.value || ""
            };
          } else if (type === 'Product') {
            obj = {
              "@context": "https://schema.org",
              "@type": "Product",
              "name": container.querySelector('[data-k="prod_name"]')?.value || "",
              "description": container.querySelector('[data-k="prod_desc"]')?.value || "",
              "brand": {
                "@type": "Brand",
                "name": container.querySelector('[data-k="prod_brand"]')?.value || ""
              },
              "offers": {
                "@type": "Offer",
                "price": container.querySelector('[data-k="prod_price"]')?.value || "0",
                "priceCurrency": container.querySelector('[data-k="prod_curr"]')?.value || "USD",
                "availability": container.querySelector('[data-k="prod_avail"]')?.value || "https://schema.org/InStock"
              },
              "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": container.querySelector('[data-k="prod_rating"]')?.value || "5",
                "reviewCount": container.querySelector('[data-k="prod_count"]')?.value || "1",
                "bestRating": "5"
              }
            };
          } else if (type === 'LocalBusiness') {
            obj = {
              "@context": "https://schema.org",
              "@type": "LocalBusiness",
              "name": container.querySelector('[data-k="name"]')?.value || "",
              "telephone": container.querySelector('[data-k="telephone"]')?.value || "",
              "email": container.querySelector('[data-k="email"]')?.value || "",
              "priceRange": container.querySelector('[data-k="priceRange"]')?.value || "$$",
              "address": {
                "@type": "PostalAddress",
                "streetAddress": container.querySelector('[data-k="street"]')?.value || "",
                "addressLocality": container.querySelector('[data-k="city"]')?.value || "",
                "addressRegion": container.querySelector('[data-k="region"]')?.value || "",
                "postalCode": container.querySelector('[data-k="postal"]')?.value || "",
                "addressCountry": "ID"
              }
            };
          }

          if (obj) {
            cur.code = JSON.stringify(obj, null, 2);
            updatePostSchemaPreview();
          }
        }

        container.querySelectorAll('.psf-field').forEach(el => {
          el.addEventListener('input', syncPostFieldsToJson);
        });
      }

      function updatePostSchemaPreview() {
        if (!postSchemaPreviewText) return;
        if (postSchemas.length === 0) {
          postSchemaPreviewText.textContent = '<!-- No structured data configured for this article -->';
          return;
        }

        postSchemaPreviewText.textContent = postSchemas
          .map((s, idx) => `<!-- [Schema #${idx + 1}: ${s.type}] -->\n<script type="application/ld+json">\n${s.code}\n<\/script>`)
          .join('\n\n');
      }

      if (btnPostStructuredData) {
        btnPostStructuredData.addEventListener('click', openPostStructuredDataModal);
      }

      if (btnSavePostStructuredData) {
        btnSavePostStructuredData.addEventListener('click', async () => {
          // Validate each schema JSON
          for (let i = 0; i < postSchemas.length; i++) {
            const s = postSchemas[i];
            try {
              JSON.parse(s.code);
            } catch (err) {
              alert(`Schema #${i + 1} (${s.type}) contains invalid JSON:\n${err.message}\n\nPlease fix the syntax before saving.`);
              activePostSchemaIdx = i;
              s.mode = 'code';
              renderPostSchemasUI();
              return;
            }
          }

          const validItems = postSchemas
            .map(s => {
              try { return JSON.parse(s.code); } catch { return null; }
            })
            .filter(Boolean);

          let finalSchemaString = '';
          if (validItems.length === 1) {
            finalSchemaString = JSON.stringify(validItems[0], null, 2);
          } else if (validItems.length > 1) {
            finalSchemaString = JSON.stringify(validItems, null, 2);
          }

          btnSavePostStructuredData.disabled = true;
          btnSavePostStructuredData.textContent = 'Saving...';

          try {
            activePost.schema = finalSchemaString;

            const postIdx = allPosts.findIndex(p => p.slug === activePost.slug || p.id === activePost.id);
            if (postIdx !== -1) {
              allPosts[postIdx].schema = finalSchemaString;
            }

            const res = await fetch('/api/posts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'save',
                slug: activePost.slug,
                schema: finalSchemaString
              })
            });

            const data = await res.json();
            if (data.success) {
              showToast(`✓ Structured data (${validItems.length} schema${validItems.length === 1 ? '' : 's'}) saved successfully!`);
              closePostStructuredDataModal();
            } else {
              showToast('Failed to save structured data: ' + (data.error || 'Server error'), true);
            }
          } catch (err) {
            showToast('Network error while saving structured data: ' + err.message, true);
          } finally {
            btnSavePostStructuredData.disabled = false;
            btnSavePostStructuredData.textContent = 'Save Structured Data';
          }
        });
      }

      
      // Post-Specific Custom Code (<head> & <body>) Modal
      const btnOpenPostCustomCode = document.getElementById('btnOpenPostCustomCode');
      if (btnOpenPostCustomCode) {
        btnOpenPostCustomCode.addEventListener('click', () => {
          if (postActionsDropdown) postActionsDropdown.classList.remove('open');
          if (window.FastPressCustomCode) {
            window.FastPressCustomCode.open({
              scope: 'post',
              slug: activePost.slug,
              title: activePost.title,
              targetType: 'post',
              onSave: (savedCode) => {
                activePost.customCode = savedCode;
                const postIdx = allPosts.findIndex(p => p.slug === activePost.slug || p.id === activePost.id);
                if (postIdx !== -1) {
                  allPosts[postIdx].customCode = savedCode;
