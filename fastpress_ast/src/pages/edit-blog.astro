      // Daftarkan Custom Block Editorial untuk Blog
      const bm = editor.BlockManager;

      // Register Saved Templates (Global and Individual) in Blog Editor Block Manager
      fetch('/api/templates')
        .then(r => r.json())
        .then(res => {
          if (res.success && Array.isArray(res.templates)) {
            window.allTemplates = res.templates;
            const CAT_SAVED_TEMPLATES = { id: 'saved-templates', label: '🧩 Saved Templates (Global & Individual)', open: false };
            res.templates.forEach(tpl => {
              const isGlobal = tpl.type === 'global';
              const badge = isGlobal ? '🌐 GLOBAL' : '📄 INDIV';
              const blockId = `tpl-block-${tpl.id}`;

              let blockContent = tpl.html;
              if (isGlobal && !blockContent.includes(`data-global-template-id="${tpl.id}"`)) {
                blockContent = `<div class="global-template-instance" data-global-template-id="${tpl.id}">${blockContent}</div>`;
