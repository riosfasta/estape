      // Command to toggle accordion item expanded/collapsed state directly
      editor.Commands.add('toggle-accordion-item-state', {
        run(ed) {
          const selected = ed.getSelected();
          if (!selected) return;
          const item = (selected.getClasses && selected.getClasses().includes('accordion-item'))
            ? selected
            : (selected.closest ? selected.closest('.accordion-item') : null);
          if (!item) return;
          const currentVal = item.getAttributes()['data-open'] === 'true' || (item.getClasses && item.getClasses().includes('is-open'));
          const nextVal = !currentVal;
          item.addAttributes({ 'data-open': String(nextVal) });
          const icon = item.find('.accordion-icon svg')[0] || item.find('.accordion-icon')[0];
          if (nextVal) {
            item.addClass('is-open');
            if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
            const cc = item.find('.accordion-content')[0];
            if (cc) {
              cc.removeStyle('max-height');
              cc.removeStyle('padding');
            }
          } else {
            item.removeClass('is-open');
            if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
          }
          const parent = item.closest('.accordion-container');
          if (parent && parent.getAttributes()['data-initial-state'] !== 'custom') {
            parent.addAttributes({ 'data-initial-state': 'custom' });
          }
