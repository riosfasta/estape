      function getProductCategorySelectOptions() {
        const catMap = new Map();
        catMap.set('all', 'All Categories');
        if (window.allProductCategories && Array.isArray(window.allProductCategories)) {
          window.allProductCategories.forEach(c => {
            const name = c.name || c;
            const slug = (c.slug || name).toLowerCase().replace(/[^a-z0-9]+/g, '-');
            catMap.set(slug, name);
          });
        }
        if (window.allProducts && Array.isArray(window.allProducts)) {
          window.allProducts.forEach(p => {
            if (p.category) {
              const slug = p.category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
              if (!catMap.has(slug)) catMap.set(slug, p.category);
            }
            if (Array.isArray(p.categories)) {
              p.categories.forEach(cat => {
                const slug = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
                if (!catMap.has(slug)) catMap.set(slug, cat);
              });
            }
          });
        }
        return Array.from(catMap.entries()).map(([id, name]) => ({ id, name }));
      }

      function generateProductsLoopWidgetHtml(productsList, attrs = {}) {
        const paginationType = attrs['data-pagination-type'] || 'load-more';
        const perPage = parseInt(attrs['data-per-page'] || '6', 10) || 6;
        const columns = parseInt(attrs['data-columns'] || '3', 10) || 3;
        const category = (attrs['data-category'] || 'all').toLowerCase().trim();
        const orderby = attrs['data-orderby'] || 'default';

        const list = (productsList && productsList.length > 0) ? [...productsList] : [
          {
            id: 'sample-1',
            slug: 'elowen-woven-lounge-chair',
            title: 'Elowen Woven Lounge Chair',
            price: 189,
            compareAtPrice: 220,
            category: 'Living Room',
            categories: ['Living Room', 'Chairs'],
            image: '/uploads/1794733764491-copy-of-modify-pillar-page-des.png'
          },
          {
            id: 'sample-2',
            slug: 'nova-wooden-coffee-table',
            title: 'Nova Wooden Coffee Table',
            price: 279,
            compareAtPrice: 320,
            category: 'Living Room',
            categories: ['Living Room', 'Tables'],
            image: 'https://images.unsplash.com/photo-1533090161767-e6ffed986c88?auto=format&fit=crop&w=900&q=80'
          },
          {
            id: 'sample-3',
            slug: 'sagewood-6-drawer-dresser',
            title: 'Sagewood 6-Drawer Dresser',
            price: 395,
            compareAtPrice: 450,
            category: 'Bedroom',
            categories: ['Bedroom', 'Storage'],
            image: 'https://images.unsplash.com/photo-1595428774223-ef52624120d2?auto=format&fit=crop&w=900&q=80'
          },
          {
            id: 'sample-4',
            slug: 'juno-rattan-pendant-lamp',
            title: 'Juno Rattan Pendant Lamp',
            price: 98,
            compareAtPrice: 120,
            category: 'Lighting',
            categories: ['Lighting', 'Living Room'],
            image: 'https://images.unsplash.com/photo-1513506003901-1e6a229e2d15?auto=format&fit=crop&w=900&q=80'
          },
          {
            id: 'sample-5',
            slug: 'vella-tufted-dining-bench',
            title: 'Vella Tufted Dining Bench',
            price: 145,
            compareAtPrice: 180,
            category: 'Dining',
            categories: ['Dining', 'Chairs'],
            image: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=900&q=80'
          },
          {
            id: 'sample-6',
            slug: 'kairo-minimal-bookshelf',
            title: 'Kairo Minimal Bookshelf',
            price: 225,
            compareAtPrice: 280,
            category: 'Storage',
            categories: ['Storage', 'Living Room'],
            image: 'https://images.unsplash.com/photo-1594026112284-02bb6f3352fe?auto=format&fit=crop&w=900&q=80'
          }
        ];

        // Filter by category
        let filtered = list;
        if (category && category !== 'all') {
          filtered = list.filter(p => {
            const pCat = (p.category || '').toLowerCase();
            const pCats = Array.isArray(p.categories) ? p.categories.map(c => c.toLowerCase()) : [];
            const pCatSlugs = Array.isArray(p.categorySlugs) ? p.categorySlugs.map(c => c.toLowerCase()) : [];
            return pCat.includes(category) || pCats.some(c => c.includes(category)) || pCatSlugs.some(s => s.includes(category));
          });
          if (filtered.length === 0) filtered = list;
        }

        // Sort by orderby
        if (orderby === 'price-asc') {
          filtered.sort((a, b) => (Number(a.price) || 0) - (Number(b.price) || 0));
        } else if (orderby === 'price-desc') {
          filtered.sort((a, b) => (Number(b.price) || 0) - (Number(a.price) || 0));
        } else if (orderby === 'newest') {
          filtered.sort((a, b) => new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime());
        }

        const totalItems = filtered.length;
        const totalPages = Math.ceil(totalItems / perPage) || 1;

        // Render product cards
        const cardsHtml = filtered.map((item, idx) => {
          const isSale = item.compareAtPrice && item.compareAtPrice > item.price;
          const isHidden = paginationType !== 'none' && idx >= perPage;
          const catsJson = JSON.stringify(item.categories || [item.category || '']).replace(/"/g, '&quot;');
          const itemCat = item.category || (Array.isArray(item.categories) ? item.categories[0] : 'Living Room');
          const itemPrice = item.price || 0;
          const comparePrice = item.compareAtPrice ? `$${item.compareAtPrice}` : '';

          return `
            <article class="fp-product-card furnisite-product-card"
                     data-idx="${idx}"
                     data-category="${(itemCat || '').toLowerCase()}"
                     data-categories="${catsJson}"
                     data-price="${itemPrice}"
                     ${isHidden ? 'style="display:none;" hidden' : ''}>
              <a href="/products/${item.slug || ''}" class="fp-card-image-link furnisite-card-image-link">
                <div class="fp-card-image-wrap furnisite-card-image-wrap">
                  <img src="${item.image || 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=800&q=80'}"
                       alt="${item.title || 'Product'}"
                       class="fp-card-img furnisite-card-img"
                       loading="lazy" />
                  ${isSale ? '<span class="fp-sale-pill fs-sale-pill">Sale</span>' : ''}
                  <span class="fp-card-arrow furnisite-card-arrow">↗</span>
                </div>
              </a>
              <div class="fp-card-meta furnisite-card-meta">
                <span class="fp-card-category fs-card-category">${itemCat}</span>
                <h3 class="fp-card-title furnisite-card-title">
                  <a href="/products/${item.slug || ''}">${item.title || 'Product Title'}</a>
                </h3>
                <div class="fp-card-price-wrap fs-card-price-wrap">
                  <span class="fp-card-price fs-card-price">$${itemPrice}</span>
                  ${isSale ? `<span class="fp-card-compare fs-card-compare">${comparePrice}</span>` : ''}
                </div>
              </div>
            </article>
          `.trim();
        }).join('\n');

        // Render pagination controls
        let paginationHtml = '';
        if (paginationType === 'load-more') {
          const initialVisible = Math.min(perPage, totalItems);
          const allLoaded = initialVisible >= totalItems;
          paginationHtml = `
            <div class="fp-products-pagination" style="display:flex;">
              <div class="fp-pagination-load-more-wrap" style="display:flex;">
                <button type="button" class="fp-load-more-btn" ${allLoaded ? 'disabled' : ''}>
                  <span class="fp-btn-text">${allLoaded ? 'All Products Loaded' : 'Load More Products'}</span>
                </button>
                <div class="fp-pagination-count">Showing <span class="fp-count-current">${initialVisible}</span> of <span class="fp-count-total">${totalItems}</span> pieces</div>
              </div>
              <div class="fp-pagination-numbers-wrap" style="display:none;"></div>
            </div>
          `.trim();
        } else if (paginationType === 'numbers') {
          let numberBtns = '';
          for (let p = 1; p <= totalPages; p++) {
            numberBtns += `<button type="button" class="fp-page-num ${p === 1 ? 'is-active' : ''}" data-page="${p}">${p}</button>`;
          }
          paginationHtml = `
            <div class="fp-products-pagination" style="display:flex;">
              <div class="fp-pagination-load-more-wrap" style="display:none;"></div>
              <nav class="fp-pagination-numbers-wrap" style="display:inline-flex;" aria-label="Products pagination">
                <button type="button" class="fp-page-nav-btn fp-prev-btn" disabled>&larr; Prev</button>
                <div class="fp-page-numbers">${numberBtns}</div>
                <button type="button" class="fp-page-nav-btn fp-next-btn" ${totalPages <= 1 ? 'disabled' : ''}>Next &rarr;</button>
              </nav>
            </div>
          `.trim();
        } else {
          paginationHtml = `
            <div class="fp-products-pagination" style="display:none;"></div>
          `.trim();
        }

        return `
          <div class="fp-products-grid" style="--fp-grid-cols: ${columns};">
            ${cardsHtml}
          </div>
          ${paginationHtml}
        `.trim();
      }

      // Register custom component type 'products-loop'
      editor.DomComponents.addType('products-loop', {
