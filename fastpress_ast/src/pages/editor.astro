        if (!comp) {
          alert('Please select a Custom Code block');
          return;
        }

        activeCustomCodeComp = comp;
        const attrs = comp.getAttributes ? comp.getAttributes() : {};
        const savedHtml = attrs['data-custom-html'] || '';
        const savedCss = attrs['data-custom-css'] || '';
        const savedJs = attrs['data-custom-js'] || '';
        const hasSaved = attrs['data-has-custom-code'] === 'true';

        if (hasSaved) {
          widgetBuffers.html = savedHtml;
          widgetBuffers.css = savedCss;
          widgetBuffers.js = savedJs;
        } else {
          widgetBuffers.html = WIDGET_STARTER_TEMPLATE.html;
          widgetBuffers.css = WIDGET_STARTER_TEMPLATE.css;
          widgetBuffers.js = WIDGET_STARTER_TEMPLATE.js;
