                  '--nm-sub-font-weight': smTypo.fontWeight || '500',
                  '--nm-sub-text-transform': smTypo.textTransform || 'none',
                  '--nm-sub-letter-spacing': smTypo.letterSpacing || '0px',
                  '--nm-sub-color': sm.color || '#374151',
                  '--nm-sub-color-hover': sm.hoverColor || '#111827',
                  '--nm-sub-color-active': sm.activeColor || '#ff5e3a',
                  '--nm-sub-bg': sm.bgColor || '#ffffff',
                  '--nm-sub-bg-hover': sm.hoverBgColor || '#f9fafb',
                  '--nm-sub-border-color': sm.borderColor || '#e5e7eb',
                  '--nm-sub-border-radius': sm.borderRadius || '8px',
                  '--nm-sub-min-width': sm.minWidth || '200px',
                });
                try {
                  const iframeDoc = editor.Canvas.getDocument();
                  if (window.FastPressNavMenu && typeof window.FastPressNavMenu.init === 'function') {
                    window.FastPressNavMenu.init(iframeDoc);
                  }
                } catch(e) {}
              }
            };

            this.on('change:attributes:data-menu-id', () => {
              const attrs = this.getAttributes() || {};
              const menuId = attrs['data-menu-id'];
              const menu = (window.allMenus || []).find(m => m.id === menuId || m.slug === menuId);
              if (menu) {
                this.addAttributes({
