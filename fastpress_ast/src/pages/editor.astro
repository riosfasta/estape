      function escapeHtml(str) {
        return String(str || '')
          .replace(/&/g, '&amp;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      function switchHfTab(tabName) {
        modalTabBtns.forEach(btn => {
          if (btn.dataset.hftab === tabName) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
        Object.keys(hfTabPanels).forEach(key => {
          if (hfTabPanels[key]) {
            hfTabPanels[key].style.display = key === tabName ? 'block' : 'none';
          }
        });
      }

      modalTabBtns.forEach(btn => {
        btn.addEventListener('click', () => switchHfTab(btn.dataset.hftab));
      });

      function renderNavItemsRows(items) {
        const container = document.getElementById('hfNavItemsList');
        if (!container) return;
        container.innerHTML = '';

        if (!items || items.length === 0) {
          container.innerHTML = '<div style="color: #6b7280; font-size: 0.75rem; padding: 10px; text-align: center; background: #0f1217; border-radius: 6px;">No menu links added yet. Click "+ Add Menu Link" to create one.</div>';
          return;
        }

        items.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = 'nav-item-row';
          row.innerHTML = `
            <input type="text" class="nav-item-input name" placeholder="Label (e.g. About)" value="${escapeHtml(item.name || '')}" />
            <input type="text" class="nav-item-input href" placeholder="URL (e.g. /#about or /blog)" value="${escapeHtml(item.href || '#')}" />
            <button type="button" class="btn-row-action up" title="Move Up" ${index === 0 ? 'disabled style="opacity:0.3;cursor:not-allowed;"' : ''}>↑</button>
            <button type="button" class="btn-row-action down" title="Move Down" ${index === items.length - 1 ? 'disabled style="opacity:0.3;cursor:not-allowed;"' : ''}>↓</button>
            <button type="button" class="btn-row-action delete" title="Delete Link">✕</button>
          `;

          row.querySelector('.up')?.addEventListener('click', () => {
            if (index > 0) {
              const temp = items[index - 1];
              items[index - 1] = items[index];
              items[index] = temp;
              renderNavItemsRows(items);
            }
          });

          row.querySelector('.down')?.addEventListener('click', () => {
            if (index < items.length - 1) {
              const temp = items[index + 1];
              items[index + 1] = items[index];
              items[index] = temp;
              renderNavItemsRows(items);
            }
          });

          row.querySelector('.delete')?.addEventListener('click', () => {
            items.splice(index, 1);
            renderNavItemsRows(items);
          });

          row.querySelector('.name')?.addEventListener('input', (e) => {
            items[index].name = e.target.value;
          });

          row.querySelector('.href')?.addEventListener('input', (e) => {
            items[index].href = e.target.value;
          });

          container.appendChild(row);
        });
      }

      const SOCIAL_PLATFORMS = [
