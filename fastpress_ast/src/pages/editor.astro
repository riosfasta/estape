        background: rgba(2, 132, 199, 0.18);
        color: #38bdf8;
        border: 1px solid rgba(2, 132, 199, 0.35);
      }
      .filter-chip {
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #1c222e;
        color: #9ca3af;
        border: 1px solid #2a3344;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .filter-chip:hover {
        color: #f3f4f6;
        border-color: #3b4556;
      }
      .filter-chip.active {
        background: rgba(139, 92, 246, 0.2);
        color: #c4b5fd;
        border-color: #8b5cf6;
      }

      .active-theme-indicator-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #191f2c;
        border: 1px solid #313d54;
        border-radius: 9999px;
        padding: 4px 10px;
        font-size: 0.72rem;
        color: #94a3b8;
        letter-spacing: 0.02em;
        user-select: none;
        flex-shrink: 0;
      }
      .active-theme-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #10b981;
        box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
      }
      .active-theme-label {
        text-transform: uppercase;
        font-weight: 600;
        font-size: 0.66rem;
        color: #64748b;
      }
      .active-theme-name {
        color: #f1f5f9;
        font-weight: 700;
        text-transform: capitalize;
      }
    </style>
  </head>
  <body>
    <!-- Simpan Data Multi-Pages Awal ke Script JSON agar di-load tanpa query string -->
    <script id="initialPagesData" type="application/json" set:html={JSON.stringify(pagesData).replace(/<\/script/gi, '<\\/script')}></script>
    <script id="initialActiveSlug" type="application/json" set:html={JSON.stringify(targetSlug)}></script>
    <script id="initialActiveTheme" type="application/json" set:html={JSON.stringify(activeTheme)}></script>
    <script id="initialThemeCss" type="application/json" set:html={JSON.stringify(themeGlobalCss)}></script>
    <script id="initialSiteConfig" type="application/json" set:html={JSON.stringify(siteConfigData)}></script>
    <script id="initialFontsData" type="application/json" set:html={JSON.stringify(fontsData)}></script>
    <script id="initialTemplatesData" type="application/json" set:html={JSON.stringify(templatesData).replace(/<\/script/gi, '<\\/script')}></script>
    <script id="initialFormsData" type="application/json" set:html={JSON.stringify(formsData).replace(/<\/script/gi, '<\\/script')}></script>
    <script id="initialMenusData" type="application/json" set:html={JSON.stringify(menusData).replace(/<\/script/gi, '<\\/script')}></script>
    <script id="initialProductsData" type="application/json" set:html={JSON.stringify(productsData).replace(/<\/script/gi, '<\\/script')}></script>
    <script id="initialProductCategoriesData" type="application/json" set:html={JSON.stringify(productCategoriesData).replace(/<\/script/gi, '<\\/script')}></script>

    <!-- 1. Top Navbar -->
    <header class="builder-navbar">
      <!-- Left: Brand Logo & Page Selector -->
      <div class="navbar-left">
        <a href="/editor" class="builder-brand" title="BUGMEGA Editor">
          <span class="brand-title">BUGMEGA</span>
        </a>

        <!-- Workspace Apps Switcher Component -->
        <WorkspaceSwitcher activeApp="page-builder" />
        
