                  '--nm-letter-spacing': mmTypo.letterSpacing || '0px',
                  '--nm-color': mmCol.color || '#374151',
                  '--nm-color-hover': mmCol.hoverColor || '#111827',
                  '--nm-color-active': mmCol.activeColor || '#ff5e3a',
                  '--nm-pointer-color': mmCol.pointerColor || '#111827',
                  '--nm-padding-x': mmSpace.horizontalPadding || '12px',
