        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-size: 0.85rem;
        color: #52525b;
      }
      .ef-newsletter-mock {
        display: flex;
        gap: 6px;
      }
      .ef-newsletter-mock input {
        flex: 1;
        padding: 8px 10px;
        border: 1px solid #e4e4e7;
        border-radius: 4px;
        font-size: 0.8rem;
