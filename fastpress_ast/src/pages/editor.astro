            <script is:inline>
              (function() {
                function refreshLiveSiteUrl() {
                  var btn = document.getElementById('btnViewLiveWeb');
                  if (!btn) return;
                  var params = new URLSearchParams(window.location.search);
                  var tenant = params.get('tenant');
                  var slug = (window.currentSlug) ? window.currentSlug : (params.get('slug') || 'home');
                  var path = (slug === 'home' || !slug) ? '/' : (slug === 'blog' ? '/blog' : '/' + slug);
                  if (tenant) {
                    var host = window.location.hostname.replace(/^(www\.|builder\.)/, '');
                    var proto = window.location.protocol;
                    var port = window.location.port ? ':' + window.location.port : '';
                    btn.href = proto + '//' + tenant + '.' + host + port + path;
                  } else {
                    btn.href = path;
                  }
                }
                refreshLiveSiteUrl();
                document.addEventListener('DOMContentLoaded', refreshLiveSiteUrl);
                document.addEventListener('mouseover', function(e) {
                  if (e.target && e.target.closest('#btnViewLiveWeb, #viewActionsDropdownWrap')) {
                    refreshLiveSiteUrl();
                  }
                });
                window.refreshLiveSiteUrl = refreshLiveSiteUrl;
              })();
