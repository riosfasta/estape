        color: #ff7e5f;
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
        text-transform: uppercase;
      }
      .font-badge-google {
        background: rgba(59, 130, 246, 0.15);
