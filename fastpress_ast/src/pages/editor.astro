      const btnOpenPageStructuredDataModal = document.getElementById('btnOpenPageStructuredDataModal');
      const btnClosePageStructuredDataModal = document.getElementById('btnClosePageStructuredDataModal');
      const btnCancelPageStructuredDataModal = document.getElementById('btnCancelPageStructuredDataModal');
      const btnSavePageStructuredData = document.getElementById('btnSavePageStructuredData');
      const pageSchemaTabsBar = document.getElementById('pageSchemaTabsBar');
      const pageSchemaContentContainer = document.getElementById('pageSchemaContentContainer');
      const pageSchemaPreviewText = document.getElementById('pageSchemaPreviewText');

      let pageSchemas = []; // array of { id, type, mode: 'visual'|'code', code: string }
      let activePageSchemaIdx = 0;

      const SCHEMA_TYPE_ICONS = {
        LocalBusiness: '🏢',
        Product: '🛍️',
        Review: '⭐',
        Article: '📄',
        NewsArticle: '📰',
        FAQPage: '❓',
        Custom: '⚡'
      };

      function createDefaultSchemaObject(type) {
        const pageTitle = allPages[currentSlug]?.title || 'Page Title';
        const pageDesc = allPages[currentSlug]?.description || 'Page description';
        const today = new Date().toISOString().split('T')[0];

        if (type === 'LocalBusiness') {
          return {
            "@context": "https://schema.org",
            "@type": "LocalBusiness",
            "name": pageTitle,
            "telephone": "+62 812-3456-7890",
            "email": "hello@better.com",
            "priceRange": "$$",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Sudirman Central Business District",
              "addressLocality": "Jakarta Selatan",
              "addressRegion": "DKI Jakarta",
              "postalCode": "12190",
              "addressCountry": "ID"
            }
          };
        } else if (type === 'Product') {
          return {
            "@context": "https://schema.org",
            "@type": "Product",
            "name": pageTitle,
            "description": pageDesc,
            "brand": {
              "@type": "Brand",
              "name": "Better"
            },
            "offers": {
              "@type": "Offer",
              "price": "999",
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock"
            },
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": "4.9",
              "reviewCount": "28",
              "bestRating": "5"
            }
          };
        } else if (type === 'Review') {
          return {
            "@context": "https://schema.org",
            "@type": "Review",
            "itemReviewed": {
              "@type": "Thing",
              "name": pageTitle
            },
            "author": {
              "@type": "Person",
              "name": "John Doe"
            },
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5",
              "bestRating": "5"
            },
            "reviewBody": "Exceptional results and great communication throughout the project."
          };
        } else if (type === 'Article' || type === 'NewsArticle') {
          return {
            "@context": "https://schema.org",
            "@type": type,
            "headline": pageTitle,
            "description": pageDesc,
            "image": "https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80",
            "datePublished": today,
            "author": {
              "@type": "Person",
              "name": "Better Team"
            },
            "publisher": {
              "@type": "Organization",
              "name": "Better Corp"
            }
          };
        } else if (type === 'FAQPage') {
          return {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "What services do you provide?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "We provide digital branding, responsive website design, and marketing services."
                }
              }
            ]
          };
        } else {
          return {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": pageTitle,
            "description": pageDesc
          };
        }
      }

      function parseSchemasFromRaw(raw) {
        if (!raw || !raw.trim()) return [];
        const clean = raw.trim().replace(/<\/?script[^>]*>/gi, '').trim();
        if (!clean) return [];

        try {
          const parsed = JSON.parse(clean);
          if (Array.isArray(parsed)) {
            return parsed.map((item) => {
              const rawType = item['@type'] || 'Custom';
              const type = ['LocalBusiness', 'Product', 'Review', 'Article', 'NewsArticle', 'FAQPage'].includes(rawType) ? rawType : (rawType === 'BlogPosting' ? 'Article' : 'Custom');
              return {
                id: 'ps_' + Math.random().toString(36).substring(2, 9),
                type: type,
                mode: 'visual',
                code: JSON.stringify(item, null, 2)
              };
            });
          } else if (typeof parsed === 'object' && parsed !== null) {
            if (Array.isArray(parsed['@graph'])) {
              return parsed['@graph'].map((item) => {
                const rawType = item['@type'] || 'Custom';
                const type = ['LocalBusiness', 'Product', 'Review', 'Article', 'NewsArticle', 'FAQPage'].includes(rawType) ? rawType : (rawType === 'BlogPosting' ? 'Article' : 'Custom');
                return {
                  id: 'ps_' + Math.random().toString(36).substring(2, 9),
                  type: type,
                  mode: 'visual',
                  code: JSON.stringify({ "@context": "https://schema.org", ...item }, null, 2)
                };
              });
            } else {
              const rawType = parsed['@type'] || 'Custom';
              const type = ['LocalBusiness', 'Product', 'Review', 'Article', 'NewsArticle', 'FAQPage'].includes(rawType) ? rawType : (rawType === 'BlogPosting' ? 'Article' : 'Custom');
              return [{
                id: 'ps_' + Math.random().toString(36).substring(2, 9),
                type: type,
                mode: 'visual',
                code: JSON.stringify(parsed, null, 2)
              }];
            }
          }
        } catch {
          return [{
            id: 'ps_' + Math.random().toString(36).substring(2, 9),
            type: 'Custom',
            mode: 'code',
            code: clean
          }];
        }
        return [];
      }

      function openPageStructuredDataModal() {
        closePageActionsDropdown();
        if (!modalPageStructuredData) return;

        const raw = allPages[currentSlug]?.schema || '';
        pageSchemas = parseSchemasFromRaw(raw);
        activePageSchemaIdx = pageSchemas.length > 0 ? 0 : -1;

        modalPageStructuredData.style.display = 'flex';
        renderPageSchemasUI();
      }

      function closePageStructuredDataModal() {
        if (modalPageStructuredData) {
          modalPageStructuredData.style.display = 'none';
        }
      }

      function renderPageSchemasUI() {
        renderPageSchemaTabs();
        renderPageSchemaContent();
        updatePageSchemaPreview();
      }

      function renderPageSchemaTabs() {
        if (!pageSchemaTabsBar) return;
        pageSchemaTabsBar.innerHTML = '';

        pageSchemas.forEach((item, idx) => {
          const pill = document.createElement('div');
          pill.className = `schema-tab-pill ${idx === activePageSchemaIdx ? 'active' : ''}`;
          const icon = SCHEMA_TYPE_ICONS[item.type] || '⚡';
          pill.innerHTML = `
            <span>${icon} #${idx + 1} ${item.type}</span>
            <button type="button" class="schema-tab-del-btn" title="Remove schema">&times;</button>
          `;

          pill.addEventListener('click', (e) => {
            if (e.target.classList.contains('schema-tab-del-btn')) {
              e.stopPropagation();
              if (confirm(`Delete Schema #${idx + 1} (${item.type})?`)) {
                pageSchemas.splice(idx, 1);
                if (activePageSchemaIdx >= pageSchemas.length) {
                  activePageSchemaIdx = pageSchemas.length - 1;
                }
                renderPageSchemasUI();
              }
              return;
            }
            activePageSchemaIdx = idx;
            renderPageSchemasUI();
          });

          pageSchemaTabsBar.appendChild(pill);
        });

        // Add Schema Button
        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'btn-add-schema-tab';
        addBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add Schema</span>
        `;
        addBtn.addEventListener('click', () => {
          const newType = 'LocalBusiness';
          const defaultObj = createDefaultSchemaObject(newType);
          pageSchemas.push({
            id: 'ps_' + Math.random().toString(36).substring(2, 9),
            type: newType,
            mode: 'visual',
            code: JSON.stringify(defaultObj, null, 2)
          });
          activePageSchemaIdx = pageSchemas.length - 1;
          renderPageSchemasUI();
        });
        pageSchemaTabsBar.appendChild(addBtn);
      }

      function renderPageSchemaContent() {
        if (!pageSchemaContentContainer) return;
        pageSchemaContentContainer.innerHTML = '';

        if (pageSchemas.length === 0 || activePageSchemaIdx < 0 || activePageSchemaIdx >= pageSchemas.length) {
          pageSchemaContentContainer.innerHTML = `
            <div class="schema-empty-state">
              <div style="font-size: 2.2rem; margin-bottom: 10px;">🏷️</div>
              <h4 style="margin: 0 0 6px 0; font-size: 1rem; color: #f3f4f6; font-weight: 700;">No Structured Data</h4>
              <p style="margin: 0 auto 16px auto; font-size: 0.8rem; color: #9ca3af; max-width: 440px; line-height: 1.5;">
                No structured data configured for this page yet. Add schemas like LocalBusiness, Article, FAQPage, Product, or Review to trigger Google Search rich snippets.
              </p>
              <button type="button" class="btn-modal-submit" id="btnPageSchemaAddFirst" style="display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Add First Structured Data</span>
              </button>
            </div>
          `;
          document.getElementById('btnPageSchemaAddFirst')?.addEventListener('click', () => {
            const defaultObj = createDefaultSchemaObject('LocalBusiness');
            pageSchemas.push({
              id: 'ps_' + Math.random().toString(36).substring(2, 9),
              type: 'LocalBusiness',
              mode: 'visual',
              code: JSON.stringify(defaultObj, null, 2)
            });
            activePageSchemaIdx = 0;
            renderPageSchemasUI();
          });
          return;
        }

        const cur = pageSchemas[activePageSchemaIdx];
        let curParsed = {};
        try {
          curParsed = JSON.parse(cur.code);
        } catch {}

        const editorWrap = document.createElement('div');
        editorWrap.className = 'schema-manager-wrap';
        editorWrap.style.marginTop = '0';

        // Header Bar: Type Selector + Mode Switcher + Action Buttons
        editorWrap.innerHTML = `
          <div class="schema-active-meta-bar">
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <label style="font-size: 0.76rem; font-weight: 600; color: #9ca3af;">Schema #${activePageSchemaIdx + 1} Type:</label>
              <select id="selCurPageSchemaType" class="form-input" style="font-size: 0.78rem; padding: 4px 10px; width: auto; background: #090c10;">
                <option value="LocalBusiness" ${cur.type === 'LocalBusiness' ? 'selected' : ''}>🏢 LocalBusiness (Business & Location)</option>
                <option value="Product" ${cur.type === 'Product' ? 'selected' : ''}>🛍️ Product (Product, Price & Rating)</option>
                <option value="Review" ${cur.type === 'Review' ? 'selected' : ''}>⭐ Review & Rating (Reviews)</option>
                <option value="Article" ${cur.type === 'Article' ? 'selected' : ''}>📄 Article / WebPage (Content & Page)</option>
                <option value="NewsArticle" ${cur.type === 'NewsArticle' ? 'selected' : ''}>📰 NewsArticle (News)</option>
                <option value="FAQPage" ${cur.type === 'FAQPage' ? 'selected' : ''}>❓ FAQPage (FAQ & Questions)</option>
                <option value="Custom" ${cur.type === 'Custom' ? 'selected' : ''}>⚡ Custom Schema.org (JSON-LD)</option>
              </select>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <div class="schema-mode-switcher">
                <button type="button" class="btn-schema-mode ${cur.mode === 'visual' ? 'active' : ''}" id="btnCurModeVisual">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <span>Visual</span>
                </button>
                <button type="button" class="btn-schema-mode ${cur.mode === 'code' ? 'active' : ''}" id="btnCurModeCode">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                  <span>Code</span>
                </button>
              </div>
              <button type="button" class="schema-code-btn" id="btnCurDuplicate" title="Duplicate this schema item">+ Duplicate</button>
              <button type="button" class="schema-code-btn" id="btnCurDelete" style="color: #ef4444; border-color: rgba(239,68,68,0.3);" title="Delete this schema item">Delete</button>
            </div>
          </div>

          <!-- Dynamic Form (Visual) -->
          <div id="curPageSchemaVisualPane" style="display: ${cur.mode === 'visual' ? 'block' : 'none'};">
            <div id="curPageSchemaDynamicFields"></div>
          </div>

          <!-- Code Editor Pane -->
          <div id="curPageSchemaCodePane" style="display: ${cur.mode === 'code' ? 'block' : 'none'};">
            <div class="schema-code-toolbar">
              <div class="schema-validation-status valid" id="curPageSchemaValStatus">
                <span>✓ Valid JSON-LD</span>
              </div>
              <div style="display: flex; gap: 6px;">
                <button type="button" class="schema-code-btn" id="btnCurFormat">Format JSON</button>
                <button type="button" class="schema-code-btn" id="btnCurReset">Reset to Default</button>
              </div>
            </div>
            <textarea id="curPageSchemaTextarea" class="schema-code-textarea" rows="8">${cur.code}</textarea>
            <span class="field-hint" style="margin-top: 5px;">Pure Schema.org JSON-LD (without &lt;script&gt; tags).</span>
          </div>
        `;

        pageSchemaContentContainer.appendChild(editorWrap);

        // Attach listeners for type and mode
        const selType = document.getElementById('selCurPageSchemaType');
        selType?.addEventListener('change', () => {
          const newType = selType.value;
          cur.type = newType;
          if (newType === 'Custom') {
            cur.mode = 'code';
          } else {
            const defaultObj = createDefaultSchemaObject(newType);
            cur.code = JSON.stringify(defaultObj, null, 2);
          }
          renderPageSchemasUI();
        });

        document.getElementById('btnCurModeVisual')?.addEventListener('click', () => {
          cur.mode = 'visual';
          renderPageSchemasUI();
        });

        document.getElementById('btnCurModeCode')?.addEventListener('click', () => {
          cur.mode = 'code';
          renderPageSchemasUI();
        });

        document.getElementById('btnCurDuplicate')?.addEventListener('click', () => {
          const clone = {
            id: 'ps_' + Math.random().toString(36).substring(2, 9),
            type: cur.type,
            mode: cur.mode,
            code: cur.code
          };
          pageSchemas.push(clone);
          activePageSchemaIdx = pageSchemas.length - 1;
          renderPageSchemasUI();
        });

        document.getElementById('btnCurDelete')?.addEventListener('click', () => {
          if (confirm(`Delete Schema #${activePageSchemaIdx + 1} (${cur.type})?`)) {
            pageSchemas.splice(activePageSchemaIdx, 1);
            if (activePageSchemaIdx >= pageSchemas.length) {
              activePageSchemaIdx = pageSchemas.length - 1;
            }
            renderPageSchemasUI();
          }
        });

        // Code Editor actions
        const codeTextarea = document.getElementById('curPageSchemaTextarea');
        const valStatus = document.getElementById('curPageSchemaValStatus');

        function validateCurrentCode() {
          if (!codeTextarea || !valStatus) return true;
          const val = codeTextarea.value.trim();
          if (!val) {
            valStatus.className = 'schema-validation-status valid';
            valStatus.innerHTML = '<span>○ Empty Schema</span>';
            return true;
          }
          try {
            JSON.parse(val);
            valStatus.className = 'schema-validation-status valid';
            valStatus.innerHTML = '<span>✓ Valid JSON-LD</span>';
            return true;
          } catch (e) {
            valStatus.className = 'schema-validation-status invalid';
            valStatus.innerHTML = `<span>⚠ Invalid JSON: ${e.message}</span>`;
            return false;
          }
        }

        codeTextarea?.addEventListener('input', () => {
          cur.code = codeTextarea.value;
          validateCurrentCode();
          updatePageSchemaPreview();
        });

        document.getElementById('btnCurFormat')?.addEventListener('click', () => {
          try {
            const p = JSON.parse(codeTextarea.value);
            codeTextarea.value = JSON.stringify(p, null, 2);
            cur.code = codeTextarea.value;
            validateCurrentCode();
            updatePageSchemaPreview();
          } catch {
            alert('Cannot format invalid JSON. Please fix syntax errors first.');
          }
        });

        document.getElementById('btnCurReset')?.addEventListener('click', () => {
          if (confirm('Reset this schema to default template?')) {
            const def = createDefaultSchemaObject(cur.type);
            codeTextarea.value = JSON.stringify(def, null, 2);
            cur.code = codeTextarea.value;
            validateCurrentCode();
            renderPageSchemasUI();
          }
        });

        validateCurrentCode();

        // Render Dynamic Visual Fields
        if (cur.mode === 'visual') {
          renderPageSchemaVisualSubfields(cur, curParsed);
        }
      }

