      // Otomatis buat slug saat judul diketik
      inputPageTitle.addEventListener('input', () => {
        const title = inputPageTitle.value;
        const slug = title
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9-]/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
        inputPageSlug.value = slug;
      });

      // Pilihan template radio
      [optTplStandard, optTplBlank].forEach(opt => {
        opt.addEventListener('click', () => {
          [optTplStandard, optTplBlank].forEach(o => o.classList.remove('active'));
          opt.classList.add('active');
          const radio = opt.querySelector('input[type="radio"]');
          if (radio) radio.checked = true;
        });
      });

      // Submit buat halaman baru
      btnSubmitCreatePage.addEventListener('click', async () => {
        const title = inputPageTitle.value.trim();
        const slug = inputPageSlug.value.trim();
        const choice = document.querySelector('input[name="newTplChoice"]:checked')?.value || 'default';

        if (!title) {
          alert('Please enter a page title.');
          inputPageTitle.focus();
          return;
        }

        if (!slug) {
          alert('Please enter a page URL slug.');
          inputPageSlug.focus();
          return;
        }

        btnSubmitCreatePage.disabled = true;
        btnSubmitCreatePage.textContent = 'Creating...';

        try {
          const initialHtml = choice === 'blank'
            ? EMPTY_WORKSPACE_HTML
            : DEFAULT_TEMPLATE_HTML;

          const res = await fetch('/api/pages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'create',
              title: title,
              slug: slug,
              html: initialHtml,
              css: '',
              theme: activeThemeName
            })
          });

          const data = await res.json();
          if (data.success && data.page) {
            allPages[data.page.slug] = data.page;
            closeModal();
            showToast(`✓ Page "${title}" created successfully!`, true);
            switchToPage(data.page.slug);
          } else {
            alert('Failed: ' + (data.error || 'An error occurred'));
          }
        } catch (err) {
          alert('Failed to connect to the server while creating page.');
        } finally {
          btnSubmitCreatePage.disabled = false;
          btnSubmitCreatePage.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Create Page`;
        }
      });

      // ==========================================
      // HAPUS HALAMAN KUSTOM
      // ==========================================
      async function deletePageBySlug(slug, title) {
        if (!slug || slug === 'home' || slug === 'blog') {
          alert('System pages (Home and Blog) cannot be deleted.');
          return;
        }
        const pageName = title || allPages[slug]?.title || slug;
        if (confirm(`Are you sure you want to delete page "${pageName}" (/${slug})? This action cannot be undone.`)) {
          try {
            const res = await fetch(`/api/pages?slug=${encodeURIComponent(slug)}&theme=${encodeURIComponent(activeThemeName)}`, {
              method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
              delete allPages[slug];
              showToast(`✓ Page "${pageName}" has been deleted.`, true);
              if (currentSlug === slug) {
                switchToPage('home');
              } else {
                updatePageDropdownUI();
              }
            } else {
              alert('Failed to delete: ' + (data.error || 'An error occurred'));
            }
          } catch {
            alert('Failed to contact server.');
          }
        }
      }

      btnDeleteCurrentPage.addEventListener('click', () => {
