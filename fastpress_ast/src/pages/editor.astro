      // Sinkronkan atribut src ke model video agar live preview & export HTML selalu memuat src
      function syncVideoModelSrc(model) {
        if (!model || model.get('type') !== 'video') return;
        const provider = model.get('provider') || 'yt';
        let vSrc = '';
        if (provider === 'yt') {
          vSrc = (model.get('nocookie') && model.getYoutubeNoCookieSrc) ? model.getYoutubeNoCookieSrc() : (model.getYoutubeSrc ? model.getYoutubeSrc() : `https://www.youtube.com/embed/${model.get('videoId')}?`);
        } else if (provider === 'vi') {
          vSrc = model.getVimeoSrc ? model.getVimeoSrc() : `https://player.vimeo.com/video/${model.get('videoId')}?`;
        } else if (provider === 'so') {
          vSrc = model.get('src') || '';
        }
        if (vSrc) {
          model.addAttributes({ src: vSrc });
        }
      }

      // Auto-clean videoId jika user paste URL penuh di Trait Manager
      editor.on('component:update:videoId', (model) => {
        if (model.get('type') !== 'video') return;
        const raw = model.get('videoId');
        const parsed = parseVideoInput(raw);
        if (parsed && parsed.videoId && parsed.videoId !== raw) {
          model.set('videoId', parsed.videoId);
          if (parsed.provider && model.get('provider') !== parsed.provider) {
            model.set('provider', parsed.provider);
          }
        }
        syncVideoModelSrc(model);
      });

      // Update src saat provider diubah di Trait Manager
      editor.on('component:update:provider', (model) => {
        if (model.get('type') !== 'video') return;
        syncVideoModelSrc(model);
      });

