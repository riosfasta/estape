      @media (max-width: 900px) {
        .ef-footer-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      .ef-footer-col {
        display: flex;
        flex-direction: column;
      }
      .ef-footer-brand {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        color: #18181b;
        margin-bottom: 12px;
      }
      .ef-footer-desc {
        font-size: 0.85rem;
        color: #71717a;
        line-height: 1.6;
        margin: 0 0 16px 0;
      }
      .ef-footer-socials {
        display: flex;
        gap: 12px;
