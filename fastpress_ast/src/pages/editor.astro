      // Helper untuk mengekstrak URL / ID / Provider video
      function parseVideoInput(raw) {
        if (!raw || typeof raw !== 'string') return null;
        const str = raw.trim();
        if (!str) return null;

        // YouTube regex (watch?v=, embed/, youtu.be/, shorts/, dll)
        const ytMatch = str.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|shorts\/|watch\?v=|watch\?.+&v=))([\w-]{11})/i);
        if (ytMatch && ytMatch[1]) {
          return { provider: 'yt', videoId: ytMatch[1] };
        }

        // Vimeo regex
        const viMatch = str.match(/vimeo\.com\/(?:channels\/(?:\w+\/)?|groups\/([^\/]*)\/videos\/|album\/(\d+)\/video\/|)(\d+)/i);
        if (viMatch && viMatch[3]) {
          return { provider: 'vi', videoId: viMatch[3] };
        }

        // Direct HTML5 video file
        if (/\.(mp4|webm|ogg)($|\?)/i.test(str)) {
          return { provider: 'so', src: str, videoId: '' };
        }

        // 11 karakter YouTube ID
        if (/^[\w-]{11}$/.test(str)) {
          return { provider: 'yt', videoId: str };
        }

        // 6-12 digit angka Vimeo ID
        if (/^\d{6,12}$/.test(str)) {
          return { provider: 'vi', videoId: str };
        }

        return { provider: 'yt', videoId: str };
      }

      // Helper untuk mendeteksi target komponen video (GrapesJS video atau iframe fallback)
      function resolveVideoTarget(comp) {
        if (!comp) return null;
        if (comp.get('type') === 'video') {
          return { comp, isGjsVideo: true };
        }
        const tag = comp.get('tagName')?.toLowerCase();
        if (tag === 'iframe') {
          const src = comp.getAttributes()?.src || '';
          if (/youtube|youtu\.be|vimeo/i.test(src)) {
            return { comp, isIframe: true, src };
          }
        }
        const iframeChild = comp.find('iframe')[0];
        if (iframeChild) {
          const src = iframeChild.getAttributes()?.src || '';
          if (/youtube|youtu\.be|vimeo/i.test(src)) {
            return { comp: iframeChild, isIframe: true, src };
          }
        }
        return null;
      }

      // Otomatis pindah tab & sematkan aksi toolbar saat elemen di kanvas dipilih
      editor.on('component:selected', (comp) => {
        if (!comp) return;
        // Add custom code toolbar button if selected element is a custom code widget
        if (comp.get('type') === 'custom-code' || (comp.getClasses && comp.getClasses().includes('custom-code-widget'))) {
          const currentToolbar = comp.get('toolbar') || [];
          if (!currentToolbar.some(t => t.command === 'open-custom-code-widget-modal')) {
            comp.set('toolbar', [
              {
                attributes: { class: 'fa fa-code', title: 'Edit Code (HTML/CSS/JS)' },
                command: 'open-custom-code-widget-modal'
              },
              ...currentToolbar
            ]);
          }
        }
        if (typeof isDropzoneHelper === 'function' && isDropzoneHelper(comp)) {
          editor.selectRemove(comp);
          return;
        }
        const compType = comp.get('type');
        const vTarget = resolveVideoTarget(comp);

        // Jika video, map, atau accordion dipilih, buka langsung Tab "Settings" (Traits)
        const isAccordion = compType === 'accordion-container' || compType === 'accordion-item' || 
          (comp.getClasses && (comp.getClasses().includes('accordion-container') || comp.getClasses().includes('accordion-item')));
        if (compType === 'video' || compType === 'map' || vTarget || isAccordion) {
          const traitsTabBtn = document.querySelector('.tab-btn[data-tab="traits"]');
          if (traitsTabBtn && !traitsTabBtn.classList.contains('active')) {
            traitsTabBtn.click();
          }
        } else {
          // Untuk elemen biasa, jika sebelumnya di tab Blocks, pindah ke Style
          const activeTab = document.querySelector('.tab-btn.active')?.dataset?.tab;
          if (activeTab === 'blocks') {
            const styleTabBtn = document.querySelector('.tab-btn[data-tab="styles"]');
            if (styleTabBtn) styleTabBtn.click();
          }
        }

        // Tambahkan tombol toolbar 'Toggle Expanded/Collapsed' jika accordion item dipilih
        if (compType === 'accordion-item' || (comp.getClasses && comp.getClasses().includes('accordion-item'))) {
          const tb = comp.get('toolbar') || [];
          if (!tb.some(item => item.id === 'btn-tlb-toggle-acc')) {
            tb.unshift({
              id: 'btn-tlb-toggle-acc',
              attributes: { class: 'gjs-tlb-item', title: 'Toggle Expanded / Collapsed' },
              label: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 13 12 18 17 13"></polyline><polyline points="7 6 12 11 17 6"></polyline></svg>`,
              command: 'toggle-accordion-item-state'
            });
            comp.set('toolbar', tb);
          }
        }

        // Tambahkan tombol toolbar 'Configure Video URL' jika video dipilih
        if (vTarget) {
          const targetComp = vTarget.comp;
          const tb = targetComp.get('toolbar') || [];
          if (!tb.some(item => item.id === 'btn-tlb-edit-video')) {
            tb.unshift({
              id: 'btn-tlb-edit-video',
              attributes: { class: 'gjs-tlb-item', title: 'Configure Video URL' },
              label: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="4"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>`,
              command: () => openVideoModal(vTarget)
            });
            targetComp.set('toolbar', tb);
          }
        }

        // Update status pemilihan layer
        if (typeof updateLayerSelectionUI === 'function') {
          updateLayerSelectionUI(comp);
        }

        // Tambahkan tombol toolbar 'Copy Layer' ke komponen di canvas
        if (comp && !comp.is('wrapper') && typeof copySelectedLayer === 'function') {
          const tb = comp.get('toolbar') || [];
          if (!tb.some(item => item.id === 'btn-tlb-copy-layer')) {
            tb.unshift({
              id: 'btn-tlb-copy-layer',
              attributes: { class: 'gjs-tlb-item', title: 'Copy Layer (Ctrl+C)' },
              label: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`,
              command: () => copySelectedLayer(comp)
            });
            comp.set('toolbar', tb);
          }
        }

        // Buka / expand Accordion jika elemen di dalam accordion-item dipilih di canvas
        let currAcc = comp;
        let accItemModel = null;
        while (currAcc) {
          const classes = currAcc.getClasses ? currAcc.getClasses() : [];
          if (classes.includes('accordion-item')) {
            accItemModel = currAcc;
            break;
          }
          currAcc = currAcc.parent ? currAcc.parent() : null;
        }
        if (accItemModel) {
          accItemModel.addClass('is-open');
          const contentComp = accItemModel.find('.accordion-content')[0];
          if (contentComp) {
            contentComp.removeStyle('max-height');
            contentComp.removeStyle('padding');
          }
          // Tambahkan tombol toolbar 'Toggle Expand / Collapse'
          const tb = comp.get('toolbar') || [];
          if (!tb.some(item => item.id === 'btn-tlb-toggle-acc')) {
            tb.unshift({
              id: 'btn-tlb-toggle-acc',
              attributes: { class: 'gjs-tlb-item', title: 'Toggle Expand / Collapse Accordion' },
              label: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>`,
              command: () => {
                const isOpen = accItemModel.getClasses().includes('is-open');
                if (isOpen) {
                  accItemModel.removeClass('is-open');
                  accItemModel.addAttributes({ 'data-open': 'false' });
                } else {
                  accItemModel.addClass('is-open');
                  accItemModel.addAttributes({ 'data-open': 'true' });
                  const cc = accItemModel.find('.accordion-content')[0];
                  if (cc) {
                    cc.removeStyle('max-height');
                    cc.removeStyle('padding');
                  }
                }
                editor.select(accItemModel);
              }
            });
            comp.set('toolbar', tb);
          }
        }
      });

      // Saat blok baru di-drag & drop ke dalam accordion (gambar, kolom, dropzone, teks, dll)
      editor.on('component:add', (comp) => {
        if (!comp) return;
        let curr = comp;
        while (curr) {
          const classes = curr.getClasses ? curr.getClasses() : [];
          if (classes.includes('accordion-item')) {
            curr.addClass('is-open');
            const cc = curr.find('.accordion-content')[0];
            if (cc) {
              cc.removeStyle('max-height');
              cc.removeStyle('padding');
            }
            break;
          }
          curr = curr.parent ? curr.parent() : null;
        }
      });

