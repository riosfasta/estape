        });

        fontPanelUpload.style.display = tabName === 'upload' ? 'block' : 'none';
        fontPanelGoogle.style.display = tabName === 'google' ? 'block' : 'none';
        fontPanelInstalled.style.display = tabName === 'installed' ? 'block' : 'none';

        if (tabName === 'upload') {
          btnSubmitAddFont.style.display = 'flex';
          submitAddFontLabel.textContent = 'Upload & Use Font';
        } else if (tabName === 'google') {
          btnSubmitAddFont.style.display = 'flex';
          submitAddFontLabel.textContent = '+ Add Google Font';
        } else {
          btnSubmitAddFont.style.display = 'none';
        }

        if (tabName === 'installed') {
          renderInstalledFontsList();
        }
      }

      fontTabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          switchFontTab(btn.getAttribute('data-fonttab'));
        });
      });

      // 1. File Upload Dropzone & Selection
      function cleanFontFamilyName(rawFileName) {
        let base = rawFileName.replace(/\.[^/.]+$/, '');
        base = base.replace(/[-_](regular|italic|bold|semibold|extrabold|light|thin|medium|black|variable|webfont)/gi, ' ');
        base = base.replace(/([a-z])([A-Z])/g, '$1 $2');
        base = base.replace(/[-_]+/g, ' ').trim();
        return base.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }

      function handleFontFile(file) {
        if (!file) return;
        const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
        const allowed = ['.woff2', '.woff', '.ttf', '.otf'];
        if (!allowed.includes(ext)) {
          showToast('Please select a .woff2, .woff, .ttf, or .otf font file.', false);
          return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
          const result = e.target.result;
          currentFontFileData = {
            file,
            fileName: file.name,
            base64: result
          };

          const detectedName = cleanFontFamilyName(file.name);
          inputFontFamilyName.value = detectedName;

          // Temporary preview font face
          const tempFamily = `temp_font_${Date.now()}`;
          const fontFace = new FontFace(tempFamily, `url(${result})`);
          fontFace.load().then(loadedFace => {
            document.fonts.add(loadedFace);
            fontUploadPreviewText.style.fontFamily = `"${tempFamily}", sans-serif`;
          }).catch(err => {
            console.warn('Font preview load warning:', err);
            fontUploadPreviewText.style.fontFamily = 'inherit';
          });

          fontDropzoneText.textContent = `✓ Selected: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
          fontUploadFileNameMeta.textContent = `${file.name} · ${(file.size / 1024).toFixed(1)} KB`;
          fontUploadDetails.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }

      fontDropzone?.addEventListener('click', () => {
        fontFileInput?.click();
      });

      fontFileInput?.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          handleFontFile(e.target.files[0]);
        }
      });

      fontDropzone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        fontDropzone.classList.add('dragover');
      });

      fontDropzone?.addEventListener('dragleave', () => {
        fontDropzone.classList.remove('dragover');
      });

      fontDropzone?.addEventListener('drop', (e) => {
        e.preventDefault();
        fontDropzone.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          handleFontFile(e.dataTransfer.files[0]);
        }
      });

      function resetFontUploadForm() {
        currentFontFileData = null;
        if (fontFileInput) fontFileInput.value = '';
        if (fontDropzoneText) fontDropzoneText.textContent = 'Click or Drag & Drop your font file here';
        if (fontUploadDetails) fontUploadDetails.style.display = 'none';
        if (inputFontFamilyName) inputFontFamilyName.value = '';
      }

      // 2. Google Fonts Preview & Chips
      function previewGoogleFont(fontName) {
        if (!fontName) return;
        const safeName = fontName.trim();
        const enc = encodeURIComponent(safeName).replace(/%20/g, '+');
        const url = `https://fonts.googleapis.com/css2?family=${enc}:wght@400;600;700&display=swap`;

        let link = document.getElementById('temp-google-font-preview');
        if (!link) {
          link = document.createElement('link');
          link.id = 'temp-google-font-preview';
          link.rel = 'stylesheet';
          document.head.appendChild(link);
        }
        link.href = url;

        googleFontPreviewText.style.fontFamily = `"${safeName}", sans-serif`;
        googleFontPreviewBox.style.display = 'block';
        googleFontLoadedMeta.textContent = `Font loaded: ${safeName}`;
      }

      btnPreviewGoogleFont?.addEventListener('click', () => {
        previewGoogleFont(inputGoogleFontName.value.trim());
      });

      googleFontChips?.addEventListener('click', (e) => {
        const chip = e.target.closest('.font-chip');
        if (chip) {
          const fontName = chip.getAttribute('data-name');
          inputGoogleFontName.value = fontName;
          previewGoogleFont(fontName);
        }
      });

      // 3. Submit Handler (Upload or Google Font)
      btnSubmitAddFont?.addEventListener('click', async () => {
        if (activeFontTab === 'upload') {
          if (!currentFontFileData || !currentFontFileData.base64) {
            showToast('Please select or drag-and-drop a font file first.', false);
            return;
          }
          const familyName = inputFontFamilyName.value.trim();
          if (!familyName) {
            showToast('Font Family Name cannot be empty.', false);
            inputFontFamilyName.focus();
            return;
          }

          btnSubmitAddFont.disabled = true;
          submitAddFontLabel.textContent = 'Uploading...';

          try {
            const res = await fetch('/api/fonts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'upload',
                name: familyName,
                fileName: currentFontFileData.fileName,
                fileData: currentFontFileData.base64,
                weight: selectFontWeight.value
              })
            });
            const data = await res.json();
            if (data.success && data.fonts) {
              installedFonts = data.fonts;
              syncFontsToCanvas();
              syncFontsToDocument();
              updateStyleManagerFontOptions();
              resetFontUploadForm();
              switchFontTab('installed');
              showToast(`✓ Font "${familyName}" uploaded and added successfully!`, true);
            } else {
              showToast('Upload failed: ' + (data.error || 'Unknown error'), false);
            }
          } catch (err) {
            showToast('Error uploading font: ' + err.message, false);
          } finally {
            btnSubmitAddFont.disabled = false;
            submitAddFontLabel.textContent = 'Upload & Use Font';
          }
        } else if (activeFontTab === 'google') {
          const familyName = inputGoogleFontName.value.trim();
          if (!familyName) {
            showToast('Please enter a Google Font name.', false);
            inputGoogleFontName.focus();
            return;
          }

          btnSubmitAddFont.disabled = true;
          submitAddFontLabel.textContent = 'Adding Font...';

          try {
            const res = await fetch('/api/fonts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'google',
                name: familyName
              })
            });
            const data = await res.json();
            if (data.success && data.fonts) {
              installedFonts = data.fonts;
              syncFontsToCanvas();
              syncFontsToDocument();
              updateStyleManagerFontOptions();
              inputGoogleFontName.value = '';
              googleFontPreviewBox.style.display = 'none';
              switchFontTab('installed');
              showToast(`✓ Google Font "${familyName}" added to project!`, true);
            } else {
              showToast('Failed to add Google Font: ' + (data.error || 'Unknown error'), false);
            }
          } catch (err) {
            showToast('Error adding Google Font: ' + err.message, false);
          } finally {
            btnSubmitAddFont.disabled = false;
            submitAddFontLabel.textContent = '+ Add Google Font';
          }
        }
      });

      // 4. Render Installed Fonts List & Delete Action
      function renderInstalledFontsList() {
        if (!installedFontsContainer) return;
        installedFontsContainer.innerHTML = '';
        if (installedFontsCount) installedFontsCount.textContent = installedFonts.length;

        if (!installedFonts || installedFonts.length === 0) {
          installedFontsContainer.innerHTML = '<p class="field-hint" style="text-align: center; padding: 20px;">No fonts installed yet.</p>';
          return;
        }

        installedFonts.forEach(font => {
          const item = document.createElement('div');
          item.className = 'installed-font-item';

          const isBuiltIn = font.id === 'plus-jakarta-sans' || font.id === 'montserrat';
          const typeBadge = font.type === 'upload' 
            ? `<span class="font-badge-custom">Custom File (${font.format || 'woff2'})</span>`
            : `<span class="font-badge-google">Google Font</span>`;

          item.innerHTML = `
            <div class="installed-font-info">
              <div class="installed-font-header">
                <span class="installed-font-name">${font.name || font.family}</span>
                ${typeBadge}
              </div>
              <div class="installed-font-specimen" style="font-family: '${font.family}', sans-serif;">
                The quick brown fox jumps over the lazy dog 1234567890
              </div>
            </div>
            ${!isBuiltIn ? `
              <button type="button" class="btn-delete-font" data-fontid="${font.id}" title="Delete font '${font.name}'">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Delete
              </button>
            ` : `<span style="font-size: 0.72rem; color: #6b7280; font-weight: 500;">Default</span>`}
          `;

          const deleteBtn = item.querySelector('.btn-delete-font');
          if (deleteBtn) {
            deleteBtn.addEventListener('click', async () => {
              if (!confirm(`Are you sure you want to remove font "${font.name}"?`)) return;
              try {
                const res = await fetch('/api/fonts', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'delete', id: font.id })
                });
                const data = await res.json();
                if (data.success && data.fonts) {
                  installedFonts = data.fonts;
                  syncFontsToCanvas();
                  syncFontsToDocument();
                  updateStyleManagerFontOptions();
                  renderInstalledFontsList();
                  showToast(`✓ Font "${font.name}" deleted.`, true);
                } else {
                  showToast('Failed to delete font: ' + (data.error || 'Unknown error'), false);
                }
              } catch (err) {
                showToast('Error deleting font: ' + err.message, false);
              }
            });
          }

          installedFontsContainer.appendChild(item);
        });
      }

      // ==========================================
      // COLOR PICKER & QUICK SWATCHES UNTUK STYLE MANAGER
      // ==========================================
      const QUICK_SWATCHES = [
        { color: 'transparent', title: 'Transparent / Clear' },
        { color: '#ffffff', title: 'White (#ffffff)' },
        { color: '#111827', title: 'Dark Slate (#111827)' },
        { color: '#ff5e3a', title: 'Brand Accent (#ff5e3a)' },
        { color: '#4b5563', title: 'Muted Gray (#4b5563)' },
        { color: '#f3f4f6', title: 'Light Gray (#f3f4f6)' },
        { color: '#3b82f6', title: 'Blue (#3b82f6)' },
        { color: '#10b981', title: 'Green (#10b981)' },
        { color: '#ef4444', title: 'Red (#ef4444)' },
        { color: '#000000', title: 'Black (#000000)' }
      ];

      function colorToHex(colorStr) {
        if (!colorStr || colorStr === 'transparent' || colorStr === 'none') return '#000000';
        const trimmed = colorStr.trim();
        if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) return trimmed;
        if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
          return '#' + trimmed[1] + trimmed[1] + trimmed[2] + trimmed[2] + trimmed[3] + trimmed[3];
        }
        try {
          const ctx = document.createElement('canvas').getContext('2d');
          ctx.fillStyle = trimmed;
          const computed = ctx.fillStyle;
          if (computed.startsWith('#') && computed.length === 7) return computed;
          const match = computed.match(/\d+/g);
          if (match && match.length >= 3) {
            const r = parseInt(match[0], 10).toString(16).padStart(2, '0');
            const g = parseInt(match[1], 10).toString(16).padStart(2, '0');
            const b = parseInt(match[2], 10).toString(16).padStart(2, '0');
            return `#${r}${g}${b}`;
          }
        } catch (e) {}
        return '#000000';
      }

      function applyColorToField(triggerEl, newColor) {
        if (!triggerEl) return;
        const propRow = triggerEl.closest ? triggerEl.closest('.gjs-sm-property') : null;
        if (!propRow) return;

        const liveInput = propRow.querySelector('.gjs-field-color input:not([type="color"])') 
          || propRow.querySelector('input:not([type="color"])');
        if (liveInput && liveInput !== triggerEl) {
          liveInput.__isUpdatingFromApply = true;
          liveInput.value = newColor;
          setTimeout(() => { delete liveInput.__isUpdatingFromApply; }, 0);
        }

        const colorpEl = propRow.querySelector('.gjs-field-colorp');
        const previewEl = colorpEl?.querySelector('.gjs-field-color-picker') || colorpEl?.querySelector('.gjs-field-colorp-c');
        if (previewEl) {
          previewEl.style.backgroundColor = newColor;
        }

        const nativePicker = colorpEl?.querySelector('.gjs-native-color-picker');
        if (nativePicker && newColor !== 'transparent' && newColor !== 'none') {
          nativePicker.value = colorToHex(newColor);
        }

        // Direct target synchronization to guarantee normal vs hover separation
        if (editor) {
          const sel = editor.getSelected();
          if (sel) {
            const id = sel.getId();
            const propClass = Array.from(propRow.classList).find(c => c.startsWith('gjs-sm-property__'));
            const propName = propClass ? propClass.replace('gjs-sm-property__', '') : null;

            if (activeComponentStylingState === 'hover') {
              let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`) 
                || editor.Css.getRule(`#${id}:hover`);
              if (!hoverRule) {
                hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
              }
              if (propName) {
                hoverRule.addStyle({ [propName]: newColor });
              }
            } else {
              if (propName) {
                sel.addStyle({ [propName]: newColor });
                const normRule = editor.Css.getRule(`#${id}`);
                if (normRule) normRule.addStyle({ [propName]: newColor });
              }
            }
          }
        }

        if (liveInput && liveInput !== triggerEl) {
          liveInput.dispatchEvent(new Event('input', { bubbles: true }));
          liveInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      function enhanceAllColorFields() {
        const stylesEl = document.getElementById('styles-container');
        if (!stylesEl) return;

        const colorpList = stylesEl.querySelectorAll('.gjs-field-colorp');
        colorpList.forEach(colorp => {
          if (colorp.dataset.colorEnhanced === 'true') return;
          colorp.dataset.colorEnhanced = 'true';

          const fieldColor = colorp.closest('.gjs-field-color') || colorp.parentElement;
          const propRow = fieldColor?.closest('.gjs-sm-property') || fieldColor?.parentElement;
          if (!propRow) return;

          // Remove any previous stale pickers or swatches in this property row
          propRow.querySelectorAll('.gjs-quick-swatches').forEach(s => s.remove());
          colorp.querySelectorAll('.gjs-native-color-picker').forEach(p => p.remove());

          // 1. Native Color Picker
          const nativePicker = document.createElement('input');
          nativePicker.type = 'color';
          nativePicker.className = 'gjs-native-color-picker';
          nativePicker.title = 'Click to open Color Picker';
          
          const textInput = fieldColor.querySelector('input:not([type="color"])');
          nativePicker.value = colorToHex(textInput?.value || '#000000');

          nativePicker.addEventListener('input', (e) => {
            applyColorToField(nativePicker, e.target.value);
          });
          nativePicker.addEventListener('change', (e) => {
            applyColorToField(nativePicker, e.target.value);
          });

          if (textInput) {
            let debounceTimer = null;
            const handleTextInput = () => {
              if (textInput.__isUpdatingFromApply) return;
              const val = textInput.value.trim();
              if (val) {
                applyColorToField(textInput, val);
              }
            };
            textInput.addEventListener('input', () => {
              clearTimeout(debounceTimer);
              debounceTimer = setTimeout(handleTextInput, 40);
            });
            textInput.addEventListener('change', handleTextInput);
            textInput.addEventListener('blur', handleTextInput);
          }

          colorp.appendChild(nativePicker);

          // 2. Quick Color Swatches (Palette) & Eyedropper
          const swatchesRow = document.createElement('div');
          swatchesRow.className = 'gjs-quick-swatches';

          QUICK_SWATCHES.forEach(swatch => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `gjs-swatch-btn ${swatch.color === 'transparent' ? 'transparent-swatch' : ''}`;
            btn.title = swatch.title;
            if (swatch.color === 'transparent') {
              btn.textContent = '⊘';
            } else {
              btn.style.backgroundColor = swatch.color;
            }

            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              applyColorToField(btn, swatch.color);
            });

            swatchesRow.appendChild(btn);
          });

          // Eyedropper Pipette (if browser supports it)
          if (window.EyeDropper) {
            const eyeBtn = document.createElement('button');
            eyeBtn.type = 'button';
            eyeBtn.className = 'gjs-swatch-eyedropper';
            eyeBtn.title = 'Pick color from screen (Eyedropper)';
            eyeBtn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m2 22 1-1h3l9-9"/><path d="M14 6l4 4"/><path d="M19.5 2.5a2.12 2.12 0 0 1 3 3L16 12l-4-4 6.5-6.5a2.12 2.12 0 0 1 1-.5z"/></svg>`;
            eyeBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              e.stopPropagation();
              try {
                const dropper = new EyeDropper();
                const result = await dropper.open();
                if (result && result.sRGBHex) {
                  applyColorToField(eyeBtn, result.sRGBHex);
                }
              } catch (err) {}
            });
            swatchesRow.appendChild(eyeBtn);
          }

          fieldColor.insertAdjacentElement('afterend', swatchesRow);
        });
      }

      // ========================================================
      // NORMAL & HOVER STATE SWITCHER CONTROLLER
      // ========================================================
      let activeComponentStylingState = 'normal';
      const componentNormalStyles = {};

      function snapshotComponentNormalStyle(cmp) {
        if (!cmp) return;
        const id = cmp.getId();
        componentNormalStyles[id] = JSON.parse(JSON.stringify(cmp.getStyle()));
      }

      function updateStateButtonsUI(state) {
        activeComponentStylingState = state;
        document.querySelectorAll('.gjs-state-btn, .gjs-master-state-btn').forEach(btn => {
          btn.classList.toggle('is-active', btn.dataset.state === state);
        });
        const indicator = document.getElementById('gjsStateIndicator');
        if (indicator) {
          if (state === 'hover') {
            indicator.textContent = ':hover State Active';
            indicator.className = 'gjs-sm-state-badge is-hover';
          } else {
            indicator.textContent = 'Normal State';
            indicator.className = 'gjs-sm-state-badge';
          }
        }
      }

      function refreshAllStyleProperties(edInstance) {
        const ed = edInstance || editor;
        if (!ed || !ed.StyleManager) return;
        const sectors = ed.StyleManager.getSectors();
        function refreshProp(prop) {
          if (!prop) return;
          if (prop.view && typeof prop.view.render === 'function') {
            try { prop.view.render(); } catch (e) {}
          }
          const subProps = prop.getProperties ? prop.getProperties() : (prop.get ? prop.get('properties') : null);
          if (subProps && subProps.forEach) subProps.forEach(refreshProp);
        }
        sectors.forEach(s => {
          const props = s.getProperties ? s.getProperties() : (s.get ? s.get('properties') : []);
          if (props && props.forEach) props.forEach(refreshProp);
        });
      }

      function setComponentStylingState(state) {
        if (!editor) return;
        const sel = editor.getSelected();
        if (!sel) return;
        const id = sel.getId();

        activeComponentStylingState = state;

        if (state === 'hover') {
          snapshotComponentNormalStyle(sel);
          sel.addClass('gjs-hover-preview');
          let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`);
          if (!hoverRule) {
            hoverRule = editor.Css.getRule(`#${id}:hover`);
          }
          if (!hoverRule) {
            hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
          }
          editor.StyleManager.select(hoverRule);
        } else {
          sel.removeClass('gjs-hover-preview');
          if (componentNormalStyles[id]) {
            sel.setStyle(componentNormalStyles[id]);
            const normRule = editor.Css.getRule('#' + id);
            if (normRule) normRule.setStyle(componentNormalStyles[id]);
          }
          editor.StyleManager.select(sel);
        }

        // Clean up stale enhanced flags and elements so the newly selected state target binds cleanly
        const stylesEl = document.getElementById('styles-container');
        if (stylesEl) {
          stylesEl.querySelectorAll('.gjs-quick-swatches').forEach(s => s.remove());
          stylesEl.querySelectorAll('.gjs-native-color-picker').forEach(p => p.remove());
          stylesEl.querySelectorAll('.gjs-field-colorp').forEach(cp => {
            delete cp.dataset.colorEnhanced;
          });
        }

        refreshAllStyleProperties(editor);
        enhanceAllColorFields();
        enhanceStateSwitchers();
        updateStateButtonsUI(state);
      }

      function enhanceStateSwitchers() {
        const stylesEl = document.getElementById('styles-container');
        if (!stylesEl) return;

        // 1. Top Master State Toolbar
        if (!stylesEl.querySelector('.gjs-sm-state-toolbar')) {
          const toolbar = document.createElement('div');
          toolbar.className = 'gjs-sm-state-toolbar';
          toolbar.innerHTML = `
            <div class="gjs-sm-state-left">
              <span class="gjs-sm-state-title">State:</span>
              <div class="gjs-sm-state-pills">
                <button type="button" class="gjs-master-state-btn ${activeComponentStylingState === 'normal' ? 'is-active' : ''}" data-state="normal">Normal</button>
                <button type="button" class="gjs-master-state-btn ${activeComponentStylingState === 'hover' ? 'is-active' : ''}" data-state="hover">Hover (:hover)</button>
              </div>
            </div>
            <span class="gjs-sm-state-badge ${activeComponentStylingState === 'hover' ? 'is-hover' : ''}" id="gjsStateIndicator">
              ${activeComponentStylingState === 'hover' ? ':hover State Active' : 'Normal State'}
            </span>
          `;
          toolbar.querySelectorAll('.gjs-master-state-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              setComponentStylingState(btn.dataset.state);
            });
          });
          stylesEl.insertBefore(toolbar, stylesEl.firstChild);
        }

        // 2. Add normal/hover switchers directly to Sector Titles (Typography, Background, Border/Decorations)
        const sectors = stylesEl.querySelectorAll('.gjs-sm-sector');
        sectors.forEach(sector => {
          const title = sector.querySelector('.gjs-sm-sector-title');
          const label = sector.querySelector('.gjs-sm-sector-label');
          if (!title || !label || sector.querySelector('.gjs-sector-state-switch')) return;

          const labelText = label.textContent.trim().toLowerCase();
          if (
            labelText.includes('typography') ||
            labelText.includes('background') ||
            labelText.includes('color') ||
            labelText.includes('border') ||
            labelText.includes('decoration') ||
            labelText.includes('effect')
          ) {
            const switchGroup = document.createElement('div');
            switchGroup.className = 'gjs-sector-state-switch';
            switchGroup.innerHTML = `
              <button type="button" class="gjs-state-btn ${activeComponentStylingState === 'normal' ? 'is-active' : ''}" data-state="normal">normal</button>
              <button type="button" class="gjs-state-btn ${activeComponentStylingState === 'hover' ? 'is-active' : ''}" data-state="hover">hover</button>
            `;
            switchGroup.querySelectorAll('.gjs-state-btn').forEach(btn => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                setComponentStylingState(btn.dataset.state);
              });
            });
            title.appendChild(switchGroup);
          }
        });
      }

      // Initial synchronization on editor load & reactive events
      editor.on('load', () => {
        syncFontsToCanvas();
        syncFontsToDocument();
        updateStyleManagerFontOptions();
        enhanceAllColorFields();
        enhanceStateSwitchers();
        initLayerClipboardSystem();
        if (window.initContainerLayoutStyler) {
          window.initContainerLayoutStyler(editor);
        }
      });

      editor.on('component:selected', (comp) => {
        if (!comp) return;
        if (typeof isDropzoneHelper === 'function' && isDropzoneHelper(comp)) {
          editor.selectRemove(comp);
          return;
        }
        if (comp) {
          comp.removeClass('gjs-hover-preview');
          snapshotComponentNormalStyle(comp);

          // Pop Drawer helper: if an element inside the drawer is selected, expand drawer so user can edit it
          const drawerOverlay = (comp.getClasses && comp.getClasses().includes('pop-drawer-overlay')) ? comp : (comp.closest ? comp.closest('.pop-drawer-overlay') : null);
          if (drawerOverlay) {
            drawerOverlay.addClass('is-editor-open');
          } else {
            editor.getWrapper().find('.pop-drawer-overlay.is-editor-open').forEach(o => o.removeClass('is-editor-open'));
          }
        }
        updateStateButtonsUI('normal');
        setTimeout(() => {
          enhanceAllColorFields();
          enhanceStateSwitchers();
        }, 50);
      });

      editor.on('component:styleUpdate', (cmp) => {
        if (!cmp) return;
        const id = cmp.getId();

        if (activeComponentStylingState === 'hover') {
          const normalStyle = componentNormalStyles[id];
          if (!normalStyle) return;

          const currentStyle = cmp.getStyle();
          let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`) 
            || editor.Css.getRule(`#${id}:hover`);
          if (!hoverRule) {
            hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
          }

          let hasChanges = false;
          for (const key in currentStyle) {
            if (currentStyle[key] !== normalStyle[key]) {
              hoverRule.addStyle({ [key]: currentStyle[key] });
              hasChanges = true;
            }
          }

          if (hasChanges) {
            cmp.setStyle(normalStyle, { silent: true });
            const normRule = editor.Css.getRule('#' + id);
            if (normRule) normRule.setStyle(normalStyle, { silent: true });
          }
        } else {
          componentNormalStyles[id] = JSON.parse(JSON.stringify(cmp.getStyle()));
        }
      });

      editor.on('component:deselected', (comp) => {
        if (comp) {
          comp.removeClass('gjs-hover-preview');
        }
        updateStateButtonsUI('normal');
      });

      editor.on('styleManager:change', () => {
        setTimeout(() => {
          enhanceAllColorFields();
          enhanceStateSwitchers();
        }, 50);
      });

      // Observer untuk mendeteksi perubahan sektor/properti di Style Manager
      const stylesObserverTarget = document.getElementById('styles-container');
      if (stylesObserverTarget) {
        const stylesObserver = new MutationObserver(() => {
          enhanceAllColorFields();
          enhanceStateSwitchers();
        });
        stylesObserver.observe(stylesObserverTarget, { childList: true, subtree: true });
      }

      // ==========================================
      // SISTEM COPY-PASTE LAYER & LINTAS HALAMAN (CROSS-PAGE)
      // ==========================================
      const LAYER_CLIPBOARD_KEY = 'fastpress_layer_clipboard';

      // Elemen UI Toolbar & Clipboard Banner
      const btnLayerCopy = document.getElementById('btnLayerCopy');
      const btnLayerPasteBelow = document.getElementById('btnLayerPasteBelow');
      const btnLayerPasteInside = document.getElementById('btnLayerPasteInside');
      const btnLayerDuplicate = document.getElementById('btnLayerDuplicate');
      const btnLayerDelete = document.getElementById('btnLayerDelete');
      const btnClearLayerClipboard = document.getElementById('btnClearLayerClipboard');
      const layerClipboardBanner = document.getElementById('layerClipboardBanner');
      const clipboardLayerName = document.getElementById('clipboardLayerName');
      const clipboardSourcePill = document.getElementById('clipboardSourcePill');
      const layerActiveBadge = document.getElementById('layerActiveBadge');

      // Elemen UI Context Menu
      const layerContextMenu = document.getElementById('layerContextMenu');
      const ctxMenuLayerName = document.getElementById('ctxMenuLayerName');
      const ctxBtnCopy = document.getElementById('ctxBtnCopy');
      const ctxBtnPasteBelow = document.getElementById('ctxBtnPasteBelow');
      const ctxBtnPasteInside = document.getElementById('ctxBtnPasteInside');
      const ctxBtnDuplicate = document.getElementById('ctxBtnDuplicate');
      const ctxBtnDelete = document.getElementById('ctxBtnDelete');

      // Ambil data clipboard dari localStorage
      function getLayerClipboard() {
        try {
          const raw = localStorage.getItem(LAYER_CLIPBOARD_KEY);
          if (!raw) return null;
          return JSON.parse(raw);
        } catch (e) {
          console.warn('Failed to parse layer clipboard:', e);
          return null;
        }
      }

      // Format nama manusiawi untuk komponen
      function getComponentHumanName(comp) {
        if (!comp) return 'Element';
        try {
          if (comp.is('wrapper')) return 'Body / Page';
          const customName = comp.getName ? comp.getName() : null;
          if (customName && customName !== 'Component' && customName !== 'Box') return customName;

          const tag = (comp.get('tagName') || comp.get('type') || 'Element').toUpperCase();
          const compClasses = comp.getClasses ? comp.getClasses() : [];
          if (compClasses.length > 0) {
            const firstCls = typeof compClasses[0] === 'string' ? compClasses[0] : (compClasses[0]?.get ? compClasses[0].get('name') : '');
            if (firstCls && !firstCls.startsWith('gjs-')) {
              return `${tag} (.${firstCls})`;
            }
          }
          return tag;
        } catch (e) {
          return 'Element';
        }
      }

      // Update tampilan status clipboard & tombol paste
      function updateLayerClipboardUI() {
        const payload = getLayerClipboard();
        const hasContent = !!(payload && payload.html);

        if (layerClipboardBanner && clipboardLayerName && clipboardSourcePill) {
          if (hasContent) {
            layerClipboardBanner.style.display = 'flex';
            clipboardLayerName.textContent = payload.name || 'Component';
            const originTitle = payload.sourcePageTitle || payload.sourcePageSlug || 'page';
            clipboardSourcePill.textContent = 'from ' + originTitle;
          } else {
            layerClipboardBanner.style.display = 'none';
          }
        }

        if (btnLayerPasteBelow) btnLayerPasteBelow.disabled = !hasContent;
        if (btnLayerPasteInside) btnLayerPasteInside.disabled = !hasContent;
        if (ctxBtnPasteBelow) ctxBtnPasteBelow.disabled = !hasContent;
        if (ctxBtnPasteInside) ctxBtnPasteInside.disabled = !hasContent;
      }

      // Pastikan layer aktif dan parent-parentnya terbuka di panel Layers, serta scroll ke view
      function revealComponentInLayers(comp) {
        if (!comp || comp.is('wrapper')) return;
        try {
          let parent = comp.parent();
          while (parent && !parent.is('wrapper')) {
            if (editor.LayerManager && typeof editor.LayerManager.setOpen === 'function') {
              editor.LayerManager.setOpen(parent, true);
            }
            parent = parent.parent();
          }

          setTimeout(() => {
            const layersContainer = document.getElementById('layers-container');
            if (!layersContainer) return;
            const activeRow = layersContainer.querySelector('.gjs-layer.gjs-selected > .gjs-layer-item') ||
                              layersContainer.querySelector('.gjs-layer.gjs-selected') ||
                              layersContainer.querySelector('.gjs-selected');
            if (activeRow && typeof activeRow.scrollIntoView === 'function') {
              activeRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 60);
        } catch (err) {
          console.warn('revealComponentInLayers error:', err);
        }
      }

      // Update tombol yang bergantung pada pemilihan layer (Copy, Duplicate, Delete)
      function updateLayerSelectionUI(comp) {
        const hasSelection = !!(comp && !comp.is('wrapper'));
        const name = hasSelection ? getComponentHumanName(comp) : '';

        if (layerActiveBadge) {
          if (hasSelection) {
            layerActiveBadge.style.display = 'inline-block';
            layerActiveBadge.textContent = name;
          } else {
            layerActiveBadge.style.display = 'none';
          }
        }

        if (btnLayerCopy) btnLayerCopy.disabled = !hasSelection;
        if (btnLayerDuplicate) btnLayerDuplicate.disabled = !hasSelection;
        if (btnLayerDelete) btnLayerDelete.disabled = !hasSelection;

        if (ctxBtnCopy) ctxBtnCopy.disabled = !hasSelection;
        if (ctxBtnDuplicate) ctxBtnDuplicate.disabled = !hasSelection;
        if (ctxBtnDelete) ctxBtnDelete.disabled = !hasSelection;

        if (ctxMenuLayerName) {
          ctxMenuLayerName.textContent = hasSelection ? name : 'Page Canvas';
        }

        if (hasSelection) {
          revealComponentInLayers(comp);
        }
      }

      // Kumpulkan semua class dan ID dari komponen beserta anak-anaknya
      function collectComponentSelectors(comp) {
        const ids = new Set();
        const classes = new Set();

        function recurse(c) {
          if (!c) return;
          try {
            const id = c.getId ? c.getId() : (c.get ? c.get('id') : null);
            if (id) ids.add(id);

            const clsList = c.getClasses ? c.getClasses() : [];
            if (Array.isArray(clsList)) {
              clsList.forEach(cls => {
                if (typeof cls === 'string') classes.add(cls);
                else if (cls && cls.get) classes.add(cls.get('name'));
              });
            }

            const children = c.components ? c.components() : [];
            if (children && children.forEach) {
              children.forEach(child => recurse(child));
            }
          } catch (err) {}
        }

        recurse(comp);
        return { ids: Array.from(ids), classes: Array.from(classes) };
      }

      // Ekstrak aturan CSS yang cocok dari editor CssComposer
      function extractMatchingCssRules(comp) {
        if (!comp) return '';
        const { ids, classes } = collectComponentSelectors(comp);
        const matchedRules = [];

        try {
          if (editor.CssComposer && editor.CssComposer.getAll) {
            const allRules = editor.CssComposer.getAll();
            allRules.forEach(rule => {
              try {
                const selector = rule.getSelectorsString ? rule.getSelectorsString() : '';
                if (!selector) return;

                const matchesId = ids.some(id => selector.includes('#' + id));
                const matchesClass = classes.some(cls => selector.includes('.' + cls));

                if (matchesId || matchesClass) {
                  const ruleCss = rule.toCSS ? rule.toCSS() : '';
                  if (ruleCss && ruleCss.trim()) {
                    matchedRules.push(ruleCss.trim());
                  }
                }
              } catch (e) {}
            });
          }
        } catch (e) {
          console.warn('Error extracting css rules:', e);
        }

        return matchedRules.join('\n');
      }

      // Salin layer yang dipilih ke clipboard (tersimpan di localStorage untuk lintas halaman)
      function copySelectedLayer(targetComp) {
        const comp = targetComp || editor.getSelected();
        if (!comp || comp.is('wrapper')) {
          showToast('Please select a specific element or layer to copy.', false);
          return;
        }

        const name = getComponentHumanName(comp);
        const html = comp.toHTML ? comp.toHTML() : '';
        const cssRules = extractMatchingCssRules(comp);
        const sourcePageSlug = currentSlug;
        const sourcePageTitle = allPages[currentSlug]?.title || currentSlug;

        const payload = {
          name,
          html,
          cssRules,
          sourcePageSlug,
          sourcePageTitle,
          timestamp: Date.now()
        };

        try {
          localStorage.setItem(LAYER_CLIPBOARD_KEY, JSON.stringify(payload));
          updateLayerClipboardUI();
          showToast(`Layer "${name}" copied! Ready to paste here or across pages.`);
        } catch (err) {
          console.error('Failed to copy layer to storage:', err);
          showToast('Failed to save layer to clipboard.', false);
        }
      }

      // Tempelkan layer (asChild = false: tempel di bawahnya, asChild = true: tempel di dalam kontainer)
      function pasteLayer(asChild = false) {
        const payload = getLayerClipboard();
        if (!payload || !payload.html) {
          showToast('Clipboard is empty. Please copy a layer first.', false);
          return;
        }

        // 1. Terapkan CSS kustom jika ada dan halaman belum memilikinya
        if (payload.cssRules && payload.cssRules.trim()) {
          try {
            editor.addStyle(payload.cssRules);
          } catch (e) {
            console.warn('Error applying copied styles:', e);
          }
        }

        // 2. Tentukan target induk (parent) dan indeks penempatan
        const selected = editor.getSelected();
        let targetParent = editor.getWrapper();
        let insertIndex = targetParent.components().length;

        if (selected && !selected.is('wrapper')) {
          if (asChild) {
            targetParent = selected;
            insertIndex = selected.components().length;
          } else {
            const parent = selected.parent();
            if (parent) {
              targetParent = parent;
              insertIndex = selected.index() + 1;
            }
          }
        }

        // 3. Tambahkan komponen baru
        let added = null;
        try {
          if (asChild) {
            added = targetParent.append(payload.html);
          } else {
            const comps = targetParent.components();
            if (comps && typeof comps.add === 'function') {
              added = comps.add(payload.html, { at: insertIndex });
            } else if (typeof targetParent.append === 'function') {
              added = targetParent.append(payload.html);
            }
          }
        } catch (err) {
          console.warn('Primary paste method error, using editor fallback:', err);
          added = editor.addComponents(payload.html);
        }

        // 4. Pilih komponen yang baru ditempel dan gulirkan kanvas
        if (added) {
          const compToSelect = Array.isArray(added) ? added[0] : added;
          if (compToSelect) {
            editor.select(compToSelect);
            try {
              const el = compToSelect.getEl();
              if (el && el.scrollIntoView) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
            } catch (e) {}
          }
          showToast(`Pasted "${payload.name}" successfully!`);
          updateLayerSelectionUI(compToSelect);
        }
      }

      // Duplikat layer aktif
      function duplicateSelectedLayer() {
        const comp = editor.getSelected();
        if (!comp || comp.is('wrapper')) {
          showToast('Please select a layer to duplicate.', false);
          return;
        }

        const name = getComponentHumanName(comp);
        const parent = comp.parent() || editor.getWrapper();
        const at = comp.parent() ? comp.index() + 1 : parent.components().length;

        try {
          const html = comp.toHTML ? comp.toHTML() : '';
          const added = parent.components().add(html, { at });
          if (added) {
            const compToSelect = Array.isArray(added) ? added[0] : added;
            if (compToSelect) {
              editor.select(compToSelect);
              try {
                const el = compToSelect.getEl();
                if (el && el.scrollIntoView) {
                  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
              } catch (e) {}
            }
          }
          showToast(`Duplicated "${name}" successfully!`);
        } catch (e) {
          console.error('Failed to duplicate component:', e);
          showToast('Failed to duplicate layer.', false);
        }
      }

      // Hapus layer aktif
      function deleteSelectedLayer() {
        const comp = editor.getSelected();
        if (!comp || comp.is('wrapper')) return;

        const name = getComponentHumanName(comp);
        comp.remove();
        editor.select(null);
        updateLayerSelectionUI(null);
        showToast(`Deleted layer "${name}".`);
      }

      // Bersihkan clipboard
      function clearLayerClipboard() {
        localStorage.removeItem(LAYER_CLIPBOARD_KEY);
        updateLayerClipboardUI();
        showToast('Clipboard cleared.');
      }

      // Buka context menu mengambang pada koordinat (x, y)
      function openLayerContextMenu(x, y) {
        if (!layerContextMenu) return;
        updateLayerClipboardUI();
        updateLayerSelectionUI(editor.getSelected());

        layerContextMenu.style.display = 'block';

        const menuWidth = layerContextMenu.offsetWidth || 190;
        const menuHeight = layerContextMenu.offsetHeight || 210;

        let posX = x;
        let posY = y;
        if (posX + menuWidth > window.innerWidth - 10) {
          posX = window.innerWidth - menuWidth - 10;
        }
        if (posY + menuHeight > window.innerHeight - 10) {
          posY = window.innerHeight - menuHeight - 10;
        }
        if (posX < 10) posX = 10;
        if (posY < 10) posY = 10;

        layerContextMenu.style.left = posX + 'px';
        layerContextMenu.style.top = posY + 'px';
      }

      // Tutup context menu
      function closeLayerContextMenu() {
        if (layerContextMenu) {
          layerContextMenu.style.display = 'none';
        }
      }

      // Handler shortcut keyboard global (Ctrl+C, Ctrl+V, Ctrl+D)
      function handleGlobalLayerShortcuts(e) {
        const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
        const target = e.target;
        if (
          target && (
            target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA' ||
            target.tagName === 'SELECT' ||
            target.isContentEditable ||
            target.getAttribute('contenteditable') === 'true' ||
            (target.closest && target.closest('[contenteditable="true"], [contenteditable=""], [contenteditable], input, textarea, select, .gjs-rte-toolbar, .gjs-sm-field, .gjs-fields'))
          )
        ) {
          return;
        }

        const activeEl = document.activeElement;
        if (activeEl && (
          activeEl.tagName === 'INPUT' ||
          activeEl.tagName === 'TEXTAREA' ||
          activeEl.isContentEditable ||
          (activeEl.closest && activeEl.closest('[contenteditable="true"], .gjs-sm-field'))
        )) {
          return;
        }

        try {
          const frameDoc = editor?.Canvas?.getDocument?.();
          if (frameDoc && frameDoc.activeElement) {
            const fActive = frameDoc.activeElement;
            if (
              fActive.tagName === 'INPUT' ||
              fActive.tagName === 'TEXTAREA' ||
              fActive.isContentEditable ||
              (fActive.closest && fActive.closest('[contenteditable="true"], [contenteditable]'))
            ) {
              return;
            }
          }
        } catch (err) {}

        if (editor?.getEditing && editor.getEditing()) return;
        if (editor?.getModel && editor.getModel().isEditing && editor.getModel().isEditing()) return;

        const isCtrlOrCmd = e.ctrlKey || e.metaKey;

        // Ctrl+C / Cmd+C: Copy Layer
        if (isCtrlOrCmd && (e.key === 'c' || e.key === 'C')) {
          const selected = editor.getSelected();
          if (selected && !selected.is('wrapper')) {
            e.preventDefault();
            copySelectedLayer();
          }
        }

        // Ctrl+V / Cmd+V: Paste Layer Below
        if (isCtrlOrCmd && (e.key === 'v' || e.key === 'V')) {
          if (getLayerClipboard()) {
            e.preventDefault();
            pasteLayer(false);
          }
        }

        // Ctrl+D / Cmd+D: Duplicate Layer
        if (isCtrlOrCmd && (e.key === 'd' || e.key === 'D')) {
          const selected = editor.getSelected();
          if (selected && !selected.is('wrapper')) {
            e.preventDefault();
            duplicateSelectedLayer();
          }
        }

        // Delete : Delete Layer (Hanya tombol Delete fisik, atau Backspace di Mac jika BUKAN sedang edit teks)
        const isDeleteKey = e.key === 'Delete' || (isMac && e.key === 'Backspace');
        if (isDeleteKey && !isCtrlOrCmd) {
          const selected = editor.getSelected();
          if (selected && !selected.is('wrapper')) {
            e.preventDefault();
            deleteSelectedLayer();
          }
        }
      }

      // Inisialisasi event listener sistem layer clipboard
      function initLayerClipboardSystem() {
        updateLayerClipboardUI();
        updateLayerSelectionUI(editor.getSelected());

        // Event Tombol Toolbar
        if (btnLayerCopy) btnLayerCopy.addEventListener('click', () => copySelectedLayer());
        if (btnLayerPasteBelow) btnLayerPasteBelow.addEventListener('click', () => pasteLayer(false));
        if (btnLayerPasteInside) btnLayerPasteInside.addEventListener('click', () => pasteLayer(true));
        if (btnLayerDuplicate) btnLayerDuplicate.addEventListener('click', () => duplicateSelectedLayer());
        if (btnLayerDelete) btnLayerDelete.addEventListener('click', () => deleteSelectedLayer());
        if (btnClearLayerClipboard) btnClearLayerClipboard.addEventListener('click', clearLayerClipboard);

        // Event Context Menu
        if (ctxBtnCopy) ctxBtnCopy.addEventListener('click', () => { copySelectedLayer(); closeLayerContextMenu(); });
        if (ctxBtnPasteBelow) ctxBtnPasteBelow.addEventListener('click', () => { pasteLayer(false); closeLayerContextMenu(); });
        if (ctxBtnPasteInside) ctxBtnPasteInside.addEventListener('click', () => { pasteLayer(true); closeLayerContextMenu(); });
        if (ctxBtnDuplicate) ctxBtnDuplicate.addEventListener('click', () => { duplicateSelectedLayer(); closeLayerContextMenu(); });
        if (ctxBtnDelete) ctxBtnDelete.addEventListener('click', () => { deleteSelectedLayer(); closeLayerContextMenu(); });

        // Klik kanan pada container layers
        const layersContainer = document.getElementById('layers-container');
        if (layersContainer) {
          layersContainer.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const layerRow = e.target.closest('.gjs-layer');
            if (layerRow) {
              if (!layerRow.classList.contains('gjs-selected')) {
                const titleEl = layerRow.querySelector('.gjs-layer-name, .gjs-layer-title') || layerRow;
                titleEl.click();
              }
            }

            setTimeout(() => {
              openLayerContextMenu(e.clientX, e.clientY);
            }, 20);
          });
        }

        // Klik kanan dan shortcut di iframe canvas
        try {
          const frameEl = editor.Canvas.getFrameEl();
          if (frameEl && frameEl.contentDocument) {
            frameEl.contentDocument.addEventListener('contextmenu', (e) => {
              const selected = editor.getSelected();
              if (selected && !selected.is('wrapper')) {
                e.preventDefault();
                e.stopPropagation();
                const rect = frameEl.getBoundingClientRect();
                const mainX = rect.left + e.clientX;
                const mainY = rect.top + e.clientY;
                openLayerContextMenu(mainX, mainY);
              }
            });

            frameEl.contentDocument.addEventListener('click', closeLayerContextMenu);
            frameEl.contentDocument.addEventListener('keydown', handleGlobalLayerShortcuts);
          }
        } catch (err) {
          console.warn('Canvas frame contextmenu attach warning:', err);
        }

        // Global listeners
        document.addEventListener('click', (e) => {
          if (layerContextMenu && !layerContextMenu.contains(e.target)) {
            closeLayerContextMenu();
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeLayerContextMenu();
        });
        document.addEventListener('keydown', handleGlobalLayerShortcuts);
        window.addEventListener('scroll', closeLayerContextMenu, true);

        // Sinkronisasi lintas tab browser
        window.addEventListener('storage', (e) => {
          if (e.key === LAYER_CLIPBOARD_KEY) {
            updateLayerClipboardUI();
          }
        });
      }
    </script>
  </body>
</html>
