      editor.on('component:update:src', (model) => {
        if (model.get('type') !== 'video') return;
        const raw = model.get('src');
        const parsed = parseVideoInput(raw);
        if (parsed && (parsed.provider === 'yt' || parsed.provider === 'vi')) {
          model.set('provider', parsed.provider);
          model.set('videoId', parsed.videoId);
          model.set('src', '');
        }
        syncVideoModelSrc(model);
      });

