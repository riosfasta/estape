      // Sinkronisasi Fonts ke Canvas Iframe
      function syncFontsToCanvas() {
        try {
          const iframeDoc = editor.Canvas.getDocument();
          if (!iframeDoc) return;
          let container = iframeDoc.getElementById('gjs-custom-fonts-container');
          if (!container) {
            container = iframeDoc.createElement('div');
            container.id = 'gjs-custom-fonts-container';
            iframeDoc.head.appendChild(container);
          }
          container.innerHTML = '';
          (installedFonts || []).forEach(font => {
            if (font.type === 'google' && font.url) {
              const link = iframeDoc.createElement('link');
              link.rel = 'stylesheet';
              link.href = font.url;
              container.appendChild(link);
            } else if (font.type === 'upload' && font.url) {
              const style = iframeDoc.createElement('style');
              style.innerHTML = `@font-face { font-family: '${font.family}'; src: url('${font.url}') format('${font.format || 'woff2'}'); font-weight: ${font.weight || 'normal'}; font-style: ${font.style || 'normal'}; font-display: swap; }`;
              container.appendChild(style);
            }
          });
        } catch (e) {
          console.warn('syncFontsToCanvas error:', e);
        }
      }

      // Sinkronisasi Fonts ke Dokumen Editor Utama
      function syncFontsToDocument() {
        try {
          let container = document.getElementById('main-custom-fonts-container');
          if (!container) {
            container = document.createElement('div');
            container.id = 'main-custom-fonts-container';
            document.head.appendChild(container);
          }
          container.innerHTML = '';
          (installedFonts || []).forEach(font => {
            if (font.type === 'google' && font.url) {
              const link = document.createElement('link');
              link.rel = 'stylesheet';
              link.href = font.url;
              container.appendChild(link);
            } else if (font.type === 'upload' && font.url) {
              const style = document.createElement('style');
              style.innerHTML = `@font-face { font-family: '${font.family}'; src: url('${font.url}') format('${font.format || 'woff2'}'); font-weight: ${font.weight || 'normal'}; font-style: ${font.style || 'normal'}; font-display: swap; }`;
              container.appendChild(style);
            }
          });
        } catch (e) {
          console.warn('syncFontsToDocument error:', e);
        }
      }

      // Update Opsi Font-Family di GrapesJS Style Manager
      function updateStyleManagerFontOptions() {
        try {
          const prop = editor.StyleManager.getProperty('typography', 'font-family')
                    || editor.StyleManager.getProperty('Typography', 'font-family')
                    || (editor.StyleManager.getProperty && editor.StyleManager.getProperty('font-family'));
          if (prop) {
            prop.set('options', buildFontOptions(installedFonts));
          }
        } catch (e) {
          console.warn('updateStyleManagerFontOptions error:', e);
        }
      }

