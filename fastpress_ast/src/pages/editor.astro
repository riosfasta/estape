      }

      function syncActiveWidgetBuffer() {
        if (!textareaWidgetCode) return;
        const currentVal = textareaWidgetCode.value;

        if (activeWidgetTab === 'unified') {
          let text = currentVal;
          let parsedCss = '';
          let parsedJs = '';

          text = text.replace(/<style\b[^>]*>([\s\S]*?)<\/style>/gi, (m, p1) => {
            parsedCss += (parsedCss ? '\n' : '') + p1.trim();
            return '';
          });
          text = text.replace(/<script\b[^>]*>([\s\S]*?)<\/script>/gi, (m, p1) => {
            parsedJs += (parsedJs ? '\n' : '') + p1.trim();
            return '';
          });

          widgetBuffers.html = text.trim();
          if (parsedCss) widgetBuffers.css = parsedCss;
          if (parsedJs) widgetBuffers.js = parsedJs;
        } else if (activeWidgetTab === 'html') {
          widgetBuffers.html = currentVal;
        } else if (activeWidgetTab === 'css') {
          widgetBuffers.css = currentVal;
        } else if (activeWidgetTab === 'js') {
          widgetBuffers.js = currentVal;
        }
      }

      function updateWidgetTabUI() {
        if (!textareaWidgetCode) return;

        btnWidgetTabHtml?.classList.remove('active');
        btnWidgetTabCss?.classList.remove('active', 'tab-css');
        btnWidgetTabJs?.classList.remove('active', 'tab-js');
        btnWidgetTabUnified?.classList.remove('active', 'tab-unified');

        if (activeWidgetTab === 'html') {
          btnWidgetTabHtml?.classList.add('active');
          textareaWidgetCode.value = widgetBuffers.html || '';
          textareaWidgetCode.style.color = '#38bdf8';
          if (widgetTabHintText) widgetTabHintText.textContent = 'HTML Markup: write elements, forms, SVG, or embed containers';
        } else if (activeWidgetTab === 'css') {
          btnWidgetTabCss?.classList.add('active', 'tab-css');
          textareaWidgetCode.value = widgetBuffers.css || '';
          textareaWidgetCode.style.color = '#c084fc';
          if (widgetTabHintText) widgetTabHintText.textContent = 'CSS Styling (<style>): write CSS classes and styles scoped to this widget';
        } else if (activeWidgetTab === 'js') {
          btnWidgetTabJs?.classList.add('active', 'tab-js');
          textareaWidgetCode.value = widgetBuffers.js || '';
          textareaWidgetCode.style.color = '#fbbf24';
          if (widgetTabHintText) widgetTabHintText.textContent = 'JavaScript (<script>): write interactive logic, event listeners, or API handlers';
        } else if (activeWidgetTab === 'unified') {
          btnWidgetTabUnified?.classList.add('active', 'tab-unified');
          let combined = (widgetBuffers.html || '').trim();
          if (widgetBuffers.css && widgetBuffers.css.trim()) {
            combined += (combined ? '\n\n' : '') + `<style>\n${widgetBuffers.css.trim()}\n</style>`;
          }
          if (widgetBuffers.js && widgetBuffers.js.trim()) {
            combined += (combined ? '\n\n' : '') + '<' + 'script>\n' + widgetBuffers.js.trim() + '\n<' + '/script>';
          }
          textareaWidgetCode.value = combined;
          textareaWidgetCode.style.color = '#34d399';
          if (widgetTabHintText) widgetTabHintText.textContent = 'Unified Code: view and edit HTML, <style>, and <script> in a single editor';
        }
      }

      function switchWidgetTab(newTab) {
        if (newTab === activeWidgetTab) return;
        syncActiveWidgetBuffer();
        activeWidgetTab = newTab;
