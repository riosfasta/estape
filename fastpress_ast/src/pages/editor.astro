      /* Deskripsi di bawah judul checkbox */
      .gjs-trt-trait.gjs-trt-trait--checkbox:has(.gjs-label[title*="FAQ"]) .gjs-label-wrp::after,
      .gjs-trt-trait.gjs-trt-trait--checkbox:has(.gjs-label[title*="faq"]) .gjs-label-wrp::after,
      .gjs-trt-trait.gjs-trt-trait--checkbox:has(.gjs-label[title*="Schema"]) .gjs-label-wrp::after {
        content: "Generate schema.org/FAQPage JSON-LD structured data for Google Rich Snippets in search results.";
