      .editor-visual-navbar-wrap.is-collapsed .esc-collapsed-pill,
      .editor-visual-footer-wrap.is-collapsed .esc-collapsed-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .esc-btn-collapse {
        background: #1e2430;
        border-color: #333d4e;
        color: #cbd5e1;
      }
      .esc-btn-collapse:hover {
        background: #2a3344;
        color: #ffffff;
        border-color: #4b5563;
      }
      .esc-chevron-icon {
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .editor-visual-navbar-wrap.is-collapsed .esc-chevron-icon,
      .editor-visual-footer-wrap.is-collapsed .esc-chevron-icon {
        transform: rotate(180deg);
      }

      /* Furnisite Navbar UI in Editor */
      .editor-furnisite-navbar {
        background: #ffffff;
        padding: 12px 24px;
        box-sizing: border-box;
      }
      .ef-nav-container {
        max-width: 1240px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }
      .ef-brand-group {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .ef-hamburger-btn {
        background: none;
        border: 1px solid #e4e4e7;
        color: #18181b;
        cursor: pointer;
        padding: 5px 8px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s ease;
      }
      .ef-hamburger-btn:hover {
        background: #f4f4f5;
        border-color: #18181b;
      }
      .ef-drawer-hint-pill {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: #18181b;
        color: #ffffff;
        padding: 2px 5px;
        border-radius: 3px;
      }
      .ef-logo {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: #18181b;
        cursor: pointer;
      }
      .ef-nav-center {
        display: flex;
        align-items: center;
      }
      .ef-nav-list {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 28px;
      }
      .ef-nav-link {
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
        font-size: 0.92rem;
        font-weight: 500;
        color: #52525b;
        text-decoration: none;
        position: relative;
        padding: 6px 2px;
        display: inline-block;
        transition: color 0.18s ease;
      }
      .ef-nav-link:hover, .ef-nav-link.is-active {
        color: #18181b;
        font-weight: 600;
      }
      .ef-nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #18181b;
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease;
        border-radius: 1px;
      }
      .ef-nav-link:hover::after {
        transform: scaleX(0.5);
        background-color: #9ca3af;
      }
      .ef-nav-link.is-active::after {
        transform: scaleX(1);
        background-color: #18181b;
      }
      /* 1. Underline Mode (default) */
      [data-nav-indicator="underline"] .ef-nav-link::after,
      .nav-indicator-underline .ef-nav-link::after {
        top: auto;
        bottom: 0;
        display: block;
      }
      /* 2. Overline Mode */
      [data-nav-indicator="overline"] .ef-nav-link::after,
      .nav-indicator-overline .ef-nav-link::after {
        bottom: auto;
        top: 0;
        display: block;
      }
      /* 3. None Mode (no line) */
      [data-nav-indicator="none"] .ef-nav-link::after,
      .nav-indicator-none .ef-nav-link::after {
        display: none !important;
      }
      .ef-actions-group {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .ef-icon-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #18181b;
        cursor: pointer;
      }
      .ef-cart-btn {
        position: relative;
      }
      .ef-cart-badge {
        position: absolute;
        top: 2px;
        right: 0px;
        background: #18181b;
        color: #ffffff;
        font-size: 0.6rem;
        font-weight: 700;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .ef-quick-edit-pill {
        background: #18181b;
        color: #ffffff;
        border: none;
        border-radius: 4px;
        padding: 5px 10px;
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: opacity 0.15s ease;
      }
      .ef-quick-edit-pill:hover {
        opacity: 0.85;
      }

      /* Visual Footer in Editor */
      .editor-visual-footer-wrap {
        background: #ffffff;
        border-top: 1px solid #e4e4e7;
        flex-shrink: 0;
        z-index: 10;
        position: relative;
        transition: opacity 0.2s ease, filter 0.2s ease;
      }
      .editor-visual-footer-wrap.is-hidden {
