      }
      .emd-close-btn:hover {
        color: #18181b;
      }
      .emd-banner {
        background: #faf9f6;
        border: 1px dashed #e4e4e7;
        border-radius: 6px;
        padding: 10px 12px;
        margin-bottom: 20px;
      }
      .emd-badge {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ff5e3a;
        margin-bottom: 4px;
      }
      .emd-hint {
        font-size: 0.72rem;
        color: #71717a;
        line-height: 1.4;
        margin: 0;
      }
      .emd-links-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
        overflow-y: auto;
      }
      .emd-drawer-link {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: #27272a;
        text-decoration: none;
