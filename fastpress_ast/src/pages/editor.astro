              document.addEventListener('click', function(e) {
                var header = e.target.closest('.accordion-header');
                if (header) {
                  var item = header.closest('.accordion-item');
                  if (item) {
                    var content = item.querySelector('.accordion-content');
                    var icon = item.querySelector('.accordion-icon svg') || item.querySelector('.accordion-icon');
                    var isOpen = item.classList.contains('is-open');
                    var newState = !isOpen;
                    if (newState) {
                      item.classList.add('is-open');
                      item.setAttribute('data-open', 'true');
                      if (icon) icon.style.transform = 'rotate(180deg)';
                    } else {
                      item.classList.remove('is-open');
                      item.setAttribute('data-open', 'false');
                      if (icon) icon.style.transform = 'rotate(0deg)';
                    }
                    if (content) {
                      content.style.removeProperty('max-height');
                      content.style.removeProperty('padding');
                    }
                    try {
                      if (window.parent && window.parent.editor) {
                        var pEd = window.parent.editor;
                        var sel = pEd.getSelected();
                        if (sel) {
                          var itemComp = (sel.getClasses && sel.getClasses().includes('accordion-item')) ? sel : (sel.closest ? sel.closest('.accordion-item') : null);
                          if (itemComp) {
                            itemComp.addAttributes({ 'data-open': String(newState) });
                            if (newState) {
                              itemComp.addClass('is-open');
                            } else {
                              itemComp.removeClass('is-open');
                            }
                            var parentComp = itemComp.closest ? itemComp.closest('.accordion-container') : null;
                            if (parentComp && parentComp.getAttributes()['data-initial-state'] !== 'custom') {
                              parentComp.addAttributes({ 'data-initial-state': 'custom' });
                            }
                          }
                        }
                      }
                    } catch(err) {}
                  }
                }
              }, true);

              // Auto-expand accordion when dragging blocks over it in canvas
              document.addEventListener('dragover', function(e) {
                var item = e.target.closest('.accordion-item');
                if (item && !item.classList.contains('is-open')) {
                  item.classList.add('is-open');
                  var icon = item.querySelector('.accordion-icon svg') || item.querySelector('.accordion-icon');
                  if (icon) icon.style.transform = 'rotate(180deg)';
                }
              }, true);
            `;
