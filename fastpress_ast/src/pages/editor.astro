                type: 'select',
                name: 'data-initial-state',
                label: 'Default State',
                options: [
                  { id: 'first-open', name: 'Expanded for the first one', label: 'Expanded for the first one' },
                  { id: 'first-two-open', name: 'Expanded for the first two', label: 'Expanded for the first two' },
                  { id: 'all-collapsed', name: 'All Collapsed (Closed)', label: 'All Collapsed (Closed)' },
                  { id: 'all-expanded', name: 'All Expanded (Open)', label: 'All Expanded (Open)' },
                  { id: 'custom', name: 'Custom (Per Item)', label: 'Custom (Per Item)' }
                ],
                value: 'first-open'
