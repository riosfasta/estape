      function setNavbarCollapsed(isCollapsed, persist) {
        if (persist === undefined) persist = true;
        if (!canvasHeaderBar) return;
        if (isCollapsed) {
          canvasHeaderBar.classList.add('is-collapsed');
          if (labelCollapseNavbar) labelCollapseNavbar.textContent = 'Expand';
          if (btnToggleCollapseNavbar) btnToggleCollapseNavbar.setAttribute('title', 'Expand Header Preview');
        } else {
          canvasHeaderBar.classList.remove('is-collapsed');
          if (labelCollapseNavbar) labelCollapseNavbar.textContent = 'Collapse';
          if (btnToggleCollapseNavbar) btnToggleCollapseNavbar.setAttribute('title', 'Collapse Header Preview to free up canvas space');
        }
        if (persist) {
          localStorage.setItem('fastpress_editor_navbar_collapsed', isCollapsed ? '1' : '0');
        }
        window.dispatchEvent(new Event('resize'));
        if (typeof editor !== 'undefined' && editor && typeof editor.refresh === 'function') {
          try { editor.refresh(); } catch (err) {}
        }
      }

      function setFooterCollapsed(isCollapsed, persist) {
        if (persist === undefined) persist = true;
        if (!canvasFooterBar) return;
        if (isCollapsed) {
          canvasFooterBar.classList.add('is-collapsed');
          if (labelCollapseFooter) labelCollapseFooter.textContent = 'Expand';
