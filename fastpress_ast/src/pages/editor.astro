            if (provider === 'yt') {
              attr.src = (this.get('nocookie') && this.getYoutubeNoCookieSrc) ? this.getYoutubeNoCookieSrc() : this.getYoutubeSrc();
            } else if (provider === 'vi') {
              attr.src = this.getVimeoSrc();
