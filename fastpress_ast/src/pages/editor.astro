                name: 'btn_menu_builder',
                text: '⚙ Open Menu Builder',
                command: 'open-menu-builder'
              }
            ]
          },
          init() {
            const reRender = () => {
              const attrs = this.getAttributes() || {};
              const menuId = attrs['data-menu-id'];
              const menu = (window.allMenus || []).find(m => m.id === menuId || m.slug === menuId) || window.allMenus[0];
              if (menu) {
                const innerHtml = generateNavMenuWidgetHtml(menu, attrs);
                this.components(innerHtml);
                const st = menu.styles || {};
                const mm = st.mainMenu || {};
                const mmTypo = mm.typography || {};
                const mmCol = mm.colors || {};
                const mmSpace = mm.spacing || {};
                const sm = st.subMenu || {};
                const smTypo = sm.typography || {};
                this.addStyle({
