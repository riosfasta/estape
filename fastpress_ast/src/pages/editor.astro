      }
      .emd-brand {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: #18181b;
      }
      .emd-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .emd-edit-btn {
        background: #f4f4f5;
        border: 1px solid #e4e4e7;
        color: #18181b;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .emd-edit-btn:hover {
        background: #18181b;
        color: #ffffff;
      }
      .emd-close-btn {
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: #71717a;
        padding: 4px;
