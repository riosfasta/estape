      .ef-newsletter-mock button {
        background: #18181b;
        color: #ffffff;
        border: none;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
      }
      .ef-footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 16px;
        font-size: 0.78rem;
        color: #a1a1aa;
        flex-wrap: wrap;
        gap: 12px;
      }
      .ef-copyright {
        margin: 0;
      }
      .ef-legal-links {
        display: flex;
        gap: 8px;
      }

      /* POPPED MOBILE DRAWER OVERLAY */
      .editor-mobile-drawer-wrap {
        position: fixed;
        inset: 0;
        z-index: 9999999;
        display: none;
        overflow: hidden;
      }
      .editor-mobile-drawer-wrap.is-open {
        display: flex;
      }
      .editor-mobile-drawer-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 18, 24, 0.65);
        backdrop-filter: blur(3px);
        animation: emdFadeIn 0.2s ease-out;
      }
      .editor-mobile-drawer {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        width: 320px;
        max-width: 85vw;
        background: #ffffff;
        z-index: 2;
        padding: 24px;
        display: flex;
        flex-direction: column;
        box-shadow: 6px 0 30px rgba(0, 0, 0, 0.25);
        animation: emdSlideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes emdSlideIn {
        from { transform: translateX(-100%); }
        to { transform: translateX(0); }
      }
      @keyframes emdFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      .emd-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 14px;
        border-bottom: 1px solid #f4f4f5;
