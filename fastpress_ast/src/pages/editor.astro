          const publisher = data.publisher || {};
          subwrap.innerHTML = `
            <div style="margin-bottom: 8px;">
              <label class="schema-field-label">Headline</label>
              <input type="text" class="form-input psf-field" data-k="art_title" value="${data.headline || pageTitle}" />
            </div>
            <div style="margin-bottom: 8px;">
              <label class="schema-field-label">Summary / Description</label>
              <textarea class="form-input psf-field" data-k="art_desc" rows="2">${data.description || pageDesc}</textarea>
            </div>
            <div class="schema-grid-3">
              <div>
                <label class="schema-field-label">Author Name</label>
                <input type="text" class="form-input psf-field" data-k="art_author" value="${author.name || 'Better Team'}" />
              </div>
              <div>
                <label class="schema-field-label">Publisher</label>
                <input type="text" class="form-input psf-field" data-k="art_pub" value="${publisher.name || 'Better Corp'}" />
              </div>
              <div>
                <label class="schema-field-label">Publish Date</label>
                <input type="date" class="form-input psf-field" data-k="art_date" value="${data.datePublished || new Date().toISOString().split('T')[0]}" />
              </div>
            </div>
            <div>
              <label class="schema-field-label">Image URL</label>
              <input type="text" class="form-input psf-field" data-k="art_img" value="${data.image || ''}" placeholder="https://..." />
            </div>
          `;
        } else if (type === 'FAQPage') {
          const faqs = Array.isArray(data.mainEntity)
            ? data.mainEntity.map(e => ({ q: e.name || '', a: e.acceptedAnswer?.text || '' }))
            : [{ q: 'What services do you provide?', a: 'We provide branding, web design, and digital marketing.' }];

          subwrap.innerHTML = `
            <div id="psfFaqList"></div>
            <button type="button" class="schema-code-btn" id="btnAddPsfFaq" style="margin-top: 6px;">+ Add Question & Answer</button>
          `;

          container.appendChild(subwrap);

          function renderFaqRows() {
            const listEl = document.getElementById('psfFaqList');
            if (!listEl) return;
            listEl.innerHTML = '';
            faqs.forEach((faq, fIdx) => {
              const card = document.createElement('div');
              card.className = 'schema-faq-card';
              card.innerHTML = `
                <button type="button" class="btn-del-faq" data-idx="${fIdx}" title="Remove question">&times;</button>
                <div style="margin-bottom: 6px;">
                  <label class="schema-field-label">Question #${fIdx + 1}</label>
                  <input type="text" class="form-input psf-faq-q" data-idx="${fIdx}" value="${faq.q || ''}" placeholder="e.g. What services do you offer?" />
                </div>
                <div>
                  <label class="schema-field-label">Answer</label>
                  <textarea class="form-input psf-faq-a" data-idx="${fIdx}" rows="2" placeholder="e.g. We provide branding and web design.">${faq.a || ''}</textarea>
                </div>
              `;
              listEl.appendChild(card);
            });

            listEl.querySelectorAll('.btn-del-faq').forEach(btn => {
              btn.addEventListener('click', (e) => {
                const fIdx = parseInt(e.target.dataset.idx, 10);
                faqs.splice(fIdx, 1);
                renderFaqRows();
                syncFaqToJson();
              });
            });

            listEl.querySelectorAll('.psf-faq-q').forEach(inp => {
              inp.addEventListener('input', (e) => {
                const fIdx = parseInt(e.target.dataset.idx, 10);
                if (faqs[fIdx]) faqs[fIdx].q = e.target.value;
                syncFaqToJson();
              });
            });

            listEl.querySelectorAll('.psf-faq-a').forEach(inp => {
              inp.addEventListener('input', (e) => {
                const fIdx = parseInt(e.target.dataset.idx, 10);
                if (faqs[fIdx]) faqs[fIdx].a = e.target.value;
                syncFaqToJson();
              });
            });
          }

          function syncFaqToJson() {
            const obj = {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": faqs.filter(f => f.q.trim()).map(f => ({
                "@type": "Question",
                "name": f.q.trim(),
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": f.a.trim()
                }
              }))
            };
            cur.code = JSON.stringify(obj, null, 2);
            updatePageSchemaPreview();
          }

          renderFaqRows();

          document.getElementById('btnAddPsfFaq')?.addEventListener('click', () => {
            faqs.push({ q: '', a: '' });
            renderFaqRows();
            syncFaqToJson();
          });

          return;
        }

        container.appendChild(subwrap);

        function syncFieldsToJson() {
          let obj = null;
          if (type === 'LocalBusiness') {
            obj = {
              "@context": "https://schema.org",
              "@type": "LocalBusiness",
              "name": container.querySelector('[data-k="name"]')?.value || "",
              "telephone": container.querySelector('[data-k="telephone"]')?.value || "",
              "email": container.querySelector('[data-k="email"]')?.value || "",
              "priceRange": container.querySelector('[data-k="priceRange"]')?.value || "$$",
              "address": {
                "@type": "PostalAddress",
                "streetAddress": container.querySelector('[data-k="street"]')?.value || "",
                "addressLocality": container.querySelector('[data-k="city"]')?.value || "",
                "addressRegion": container.querySelector('[data-k="region"]')?.value || "",
                "postalCode": container.querySelector('[data-k="postal"]')?.value || "",
                "addressCountry": "ID"
              }
            };
          } else if (type === 'Product') {
            obj = {
              "@context": "https://schema.org",
              "@type": "Product",
              "name": container.querySelector('[data-k="prod_name"]')?.value || "",
              "description": container.querySelector('[data-k="prod_desc"]')?.value || "",
              "brand": {
                "@type": "Brand",
                "name": container.querySelector('[data-k="prod_brand"]')?.value || ""
              },
              "offers": {
                "@type": "Offer",
                "price": container.querySelector('[data-k="prod_price"]')?.value || "0",
                "priceCurrency": container.querySelector('[data-k="prod_curr"]')?.value || "USD",
                "availability": container.querySelector('[data-k="prod_avail"]')?.value || "https://schema.org/InStock"
              },
              "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": container.querySelector('[data-k="prod_rating"]')?.value || "5",
                "reviewCount": container.querySelector('[data-k="prod_count"]')?.value || "1",
                "bestRating": "5"
              }
            };
          } else if (type === 'Review') {
            obj = {
              "@context": "https://schema.org",
              "@type": "Review",
              "itemReviewed": {
                "@type": "Thing",
                "name": container.querySelector('[data-k="rev_item"]')?.value || ""
              },
              "author": {
                "@type": "Person",
                "name": container.querySelector('[data-k="rev_author"]')?.value || ""
              },
              "reviewRating": {
                "@type": "Rating",
                "ratingValue": container.querySelector('[data-k="rev_score"]')?.value || "5",
                "bestRating": container.querySelector('[data-k="rev_best"]')?.value || "5"
              },
              "reviewBody": container.querySelector('[data-k="rev_body"]')?.value || ""
            };
          } else if (type === 'Article' || type === 'NewsArticle') {
            obj = {
              "@context": "https://schema.org",
              "@type": type,
              "headline": container.querySelector('[data-k="art_title"]')?.value || "",
              "description": container.querySelector('[data-k="art_desc"]')?.value || "",
              "image": container.querySelector('[data-k="art_img"]')?.value || "",
              "datePublished": container.querySelector('[data-k="art_date"]')?.value || new Date().toISOString().split('T')[0],
              "author": {
                "@type": "Person",
                "name": container.querySelector('[data-k="art_author"]')?.value || ""
              },
              "publisher": {
                "@type": "Organization",
                "name": container.querySelector('[data-k="art_pub"]')?.value || "Better Corp"
              }
            };
          }

          if (obj) {
            cur.code = JSON.stringify(obj, null, 2);
            updatePageSchemaPreview();
          }
        }

        container.querySelectorAll('.psf-field').forEach(el => {
          el.addEventListener('input', syncFieldsToJson);
        });
      }

      function updatePageSchemaPreview() {
        if (!pageSchemaPreviewText) return;
        if (pageSchemas.length === 0) {
          pageSchemaPreviewText.textContent = '<!-- No structured data configured for this page -->';
          return;
        }

        pageSchemaPreviewText.textContent = pageSchemas
          .map((s, idx) => `<!-- [Schema #${idx + 1}: ${s.type}] -->\n<script type="application/ld+json">\n${s.code}\n<\/script>`)
          .join('\n\n');
      }

      if (btnOpenPageStructuredDataModal) {
        btnOpenPageStructuredDataModal.addEventListener('click', openPageStructuredDataModal);
      }

      // Page-Specific Custom Code (<head> & <body>) Modal
      const btnOpenPageCustomCode = document.getElementById('btnOpenPageCustomCode');
      if (btnOpenPageCustomCode) {
        btnOpenPageCustomCode.addEventListener('click', () => {
          closePageActionsDropdown();
          const p = allPages[currentSlug] || {};
          let titleVal = p.title || '';
          if (!titleVal) {
            if (currentSlug === 'home') titleVal = 'Home';
            else if (currentSlug === 'blog') titleVal = 'Blog';
            else titleVal = currentSlug;
          }
          if (window.FastPressCustomCode) {
            window.FastPressCustomCode.open({
              scope: 'page',
              slug: currentSlug,
              title: titleVal,
              targetType: 'page',
              onSave: (savedCode) => {
                if (!allPages[currentSlug]) allPages[currentSlug] = {};
                allPages[currentSlug].customCode = savedCode;
              }
            });
          }
        });
      }
      if (btnClosePageStructuredDataModal) {
        btnClosePageStructuredDataModal.addEventListener('click', closePageStructuredDataModal);
      }
      if (btnCancelPageStructuredDataModal) {
        btnCancelPageStructuredDataModal.addEventListener('click', closePageStructuredDataModal);
      }

      if (btnSavePageStructuredData) {
        btnSavePageStructuredData.addEventListener('click', async () => {
          // Validate each schema JSON
          for (let i = 0; i < pageSchemas.length; i++) {
            const s = pageSchemas[i];
            try {
              JSON.parse(s.code);
            } catch (err) {
              alert(`Schema #${i + 1} (${s.type}) contains invalid JSON:\n${err.message}\n\nPlease fix the syntax before saving.`);
              activePageSchemaIdx = i;
              s.mode = 'code';
              renderPageSchemasUI();
              return;
            }
          }

          const validItems = pageSchemas
            .map(s => {
              try { return JSON.parse(s.code); } catch { return null; }
            })
            .filter(Boolean);

          let finalSchemaString = '';
          if (validItems.length === 1) {
            finalSchemaString = JSON.stringify(validItems[0], null, 2);
          } else if (validItems.length > 1) {
            finalSchemaString = JSON.stringify(validItems, null, 2);
          }

          btnSavePageStructuredData.disabled = true;
          btnSavePageStructuredData.textContent = 'Saving...';

          try {
            const res = await fetch('/api/pages', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'save',
                slug: currentSlug,
                schema: finalSchemaString,
                theme: activeThemeName
              })
            });

            const data = await res.json();
            if (data.success) {
              if (allPages[currentSlug]) {
                allPages[currentSlug].schema = finalSchemaString;
              }
              showToast(`✓ Structured data (${validItems.length} schema${validItems.length === 1 ? '' : 's'}) saved successfully!`, true);
              closePageStructuredDataModal();
            } else {
              alert('Failed to save structured data: ' + (data.error || 'Server error'));
            }
          } catch (err) {
            alert('Network error while saving structured data: ' + err.message);
          } finally {
            btnSavePageStructuredData.disabled = false;
            btnSavePageStructuredData.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Save Structured Data`;
          }
        });
      }

      function openPageSettingsModal(targetSlug) {
        closePageActionsDropdown();
        if (targetSlug && targetSlug !== currentSlug) {
          switchToPage(targetSlug);
        }
        if (!modalPageSettings) return;

        const p = allPages[currentSlug] || {};
        
        let titleVal = p.title || '';
        if (!titleVal) {
          if (currentSlug === 'home') titleVal = 'Home';
          else if (currentSlug === 'blog') titleVal = 'Blog';
          else titleVal = currentSlug;
        }
        if (pageSettingTitle) pageSettingTitle.value = titleVal;

        if (pageSettingSlug && pageSettingSlugHint) {
          if (currentSlug === 'home') {
            pageSettingSlug.value = '';
            pageSettingSlug.disabled = true;
            pageSettingSlug.placeholder = '(Root page /)';
            pageSettingSlugHint.textContent = 'Homepage route is fixed to the root URL (/) and cannot be renamed.';
            pageSettingSlugHint.style.color = '#9ca3af';
          } else if (currentSlug === 'blog') {
            pageSettingSlug.value = 'blog';
            pageSettingSlug.disabled = true;
            pageSettingSlug.placeholder = 'blog';
            pageSettingSlugHint.textContent = 'Blog index route is fixed to /blog and cannot be renamed.';
            pageSettingSlugHint.style.color = '#9ca3af';
          } else {
            pageSettingSlug.value = p.slug || currentSlug;
            pageSettingSlug.disabled = false;
            pageSettingSlug.placeholder = 'custom-page';
            pageSettingSlugHint.textContent = 'Public URL route for this page. Must be unique and alphanumeric.';
            pageSettingSlugHint.style.color = '#6b7280';
          }
        }

        if (pageSettingDescription) {
          pageSettingDescription.value = p.description || '';
          updateDescCharCount();
        }

        if (pageSettingKeywords) {
          pageSettingKeywords.value = p.keywords || '';
        }

        if (pageSettingShowHeader) {
          pageSettingShowHeader.checked = p.showHeader !== false;
        }

        if (pageSettingShowFooter) {
          pageSettingShowFooter.checked = p.showFooter !== false;
        }

        modalPageSettings.style.display = 'flex';
        pageSettingTitle?.focus();
      }

      function closePageSettingsModal() {
        if (modalPageSettings) {
          modalPageSettings.style.display = 'none';
        }
      }

      if (btnOpenPageSettingsModal) {
        btnOpenPageSettingsModal.addEventListener('click', openPageSettingsModal);
      }
      if (btnClosePageSettingsModal) {
        btnClosePageSettingsModal.addEventListener('click', closePageSettingsModal);
      }
      if (btnCancelPageSettingsModal) {
        btnCancelPageSettingsModal.addEventListener('click', closePageSettingsModal);
      }
      if (pageSettingDescription) {
        pageSettingDescription.addEventListener('input', updateDescCharCount);
      }

      if (btnSubmitPageSettings) {
        btnSubmitPageSettings.addEventListener('click', async () => {
          const title = pageSettingTitle ? pageSettingTitle.value.trim() : '';
          let newSlug = pageSettingSlug ? pageSettingSlug.value.trim().toLowerCase() : '';
          const description = pageSettingDescription ? pageSettingDescription.value.trim() : '';
          const keywords = pageSettingKeywords ? pageSettingKeywords.value.trim() : '';
          const showHeader = pageSettingShowHeader ? pageSettingShowHeader.checked : true;
          const showFooter = pageSettingShowFooter ? pageSettingShowFooter.checked : true;
          const schema = allPages[currentSlug]?.schema || '';

          if (!title) {
            alert('Please enter a page title.');
            pageSettingTitle?.focus();
            return;
          }

          if (currentSlug !== 'home' && currentSlug !== 'blog') {
            newSlug = newSlug
              .replace(/[^a-z0-9-]/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-|-$/g, '');
            if (!newSlug) {
              alert('Please enter a valid page URL slug.');
              pageSettingSlug?.focus();
              return;
            }
          } else {
            newSlug = currentSlug;
          }

          btnSubmitPageSettings.disabled = true;
          btnSubmitPageSettings.textContent = 'Saving...';

          try {
            const res = await fetch('/api/pages', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'save',
                slug: currentSlug,
                newSlug: newSlug,
                title: title,
                description: description,
                keywords: keywords,
                showHeader: showHeader,
                showFooter: showFooter,
                schema: schema,
                theme: activeThemeName
              })
            });

            const data = await res.json();
            if (data.success && data.page) {
              const oldSlug = currentSlug;
              const savedSlug = data.page.slug || (currentSlug === 'home' ? 'home' : (currentSlug === 'blog' ? 'blog' : newSlug));
              
              if (oldSlug !== savedSlug) {
                delete allPages[oldSlug];
                currentSlug = savedSlug;
                const newUrl = new URL(window.location.href);
                newUrl.searchParams.set('page', savedSlug);
                window.history.replaceState({}, '', newUrl.toString());
              }
              allPages[currentSlug] = data.page;

              closePageSettingsModal();
              updatePageDropdownUI();
              showToast(`✓ Page settings saved successfully!`, true);
            } else {
              alert('Failed to save settings: ' + (data.error || 'An error occurred'));
            }
          } catch (err) {
            alert('Failed to connect to the server while saving page settings.');
          } finally {
            btnSubmitPageSettings.disabled = false;
            btnSubmitPageSettings.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Save Settings`;
          }
        });
      }

      // ==========================================
      // MODAL: EDIT VIDEO
      // ==========================================
      const modalEditVideo = document.getElementById('modalEditVideo');
      const btnCloseVideoModal = document.getElementById('btnCloseVideoModal');
      const btnCancelVideoModal = document.getElementById('btnCancelVideoModal');
      const btnSubmitVideoModal = document.getElementById('btnSubmitVideoModal');
      const inputVideoUrlModal = document.getElementById('inputVideoUrlModal');
      const selectVideoProviderModal = document.getElementById('selectVideoProviderModal');
      const checkVideoControlsModal = document.getElementById('checkVideoControlsModal');
      const checkVideoAutoplayModal = document.getElementById('checkVideoAutoplayModal');
      const checkVideoLoopModal = document.getElementById('checkVideoLoopModal');

      let activeVideoTarget = null;

      function openVideoModal(target) {
        activeVideoTarget = target;
        if (!target) return;

        if (target.isGjsVideo) {
          const comp = target.comp;
          const provider = comp.get('provider') || 'yt';
          selectVideoProviderModal.value = provider;
          
          if (provider === 'yt') {
            const vid = comp.get('videoId') || '';
            inputVideoUrlModal.value = vid ? `https://www.youtube.com/watch?v=${vid}` : '';
          } else if (provider === 'vi') {
            const vid = comp.get('videoId') || '';
            inputVideoUrlModal.value = vid ? `https://vimeo.com/${vid}` : '';
          } else {
            inputVideoUrlModal.value = comp.get('src') || '';
          }

          checkVideoControlsModal.checked = comp.get('controls') !== false;
          checkVideoAutoplayModal.checked = !!comp.get('autoplay');
          checkVideoLoopModal.checked = !!comp.get('loop');
        } else if (target.isIframe) {
          const src = target.src || target.comp.getAttributes()?.src || '';
          inputVideoUrlModal.value = src;
          if (/vimeo/i.test(src)) {
            selectVideoProviderModal.value = 'vi';
          } else {
            selectVideoProviderModal.value = 'yt';
          }
          checkVideoControlsModal.checked = true;
          checkVideoAutoplayModal.checked = false;
          checkVideoLoopModal.checked = false;
        }

        modalEditVideo.style.display = 'flex';
        inputVideoUrlModal.focus();
        inputVideoUrlModal.select();
      }

      function closeVideoModal() {
        modalEditVideo.style.display = 'none';
        activeVideoTarget = null;
      }

      btnCloseVideoModal.addEventListener('click', closeVideoModal);
      btnCancelVideoModal.addEventListener('click', closeVideoModal);
      modalEditVideo.addEventListener('click', (e) => {
        if (e.target === modalEditVideo) closeVideoModal();
      });

      // Ganti placeholder saat provider diubah
      selectVideoProviderModal.addEventListener('change', () => {
        const val = selectVideoProviderModal.value;
        if (val === 'yt') {
          inputVideoUrlModal.placeholder = 'e.g. https://www.youtube.com/watch?v=dQw4w9WgXcQ';
        } else if (val === 'vi') {
          inputVideoUrlModal.placeholder = 'e.g. https://vimeo.com/148751763';
        } else {
          inputVideoUrlModal.placeholder = 'e.g. https://example.com/video.mp4';
        }
      });

      // Submit konfigurasi video
      btnSubmitVideoModal.addEventListener('click', () => {
        if (!activeVideoTarget) return;

        const rawInput = inputVideoUrlModal.value.trim();
        if (!rawInput) {
          alert('Please enter a video URL or ID.');
          inputVideoUrlModal.focus();
          return;
        }

        const parsed = parseVideoInput(rawInput);
        const selectedProvider = selectVideoProviderModal.value;
        const provider = parsed?.provider || selectedProvider;
        const controls = checkVideoControlsModal.checked;
        const autoplay = checkVideoAutoplayModal.checked;
        const loop = checkVideoLoopModal.checked;

        if (activeVideoTarget.isGjsVideo) {
          const comp = activeVideoTarget.comp;
          comp.set('provider', provider);
          comp.set('controls', controls);
          comp.set('autoplay', autoplay);
          comp.set('loop', loop);

          let embedSrc = '';
          if (provider === 'so') {
            embedSrc = parsed?.src || rawInput;
            comp.set('src', embedSrc);
            comp.set('videoId', '');
          } else {
            const vId = parsed?.videoId || rawInput;
            comp.set('videoId', vId);
            comp.set('src', '');
            if (provider === 'yt') {
              embedSrc = comp.getYoutubeSrc ? comp.getYoutubeSrc() : `https://www.youtube.com/embed/${vId}?autoplay=${autoplay ? 1 : 0}&controls=${controls ? 1 : 0}&loop=${loop ? 1 : 0}`;
            } else if (provider === 'vi') {
              embedSrc = comp.getVimeoSrc ? comp.getVimeoSrc() : `https://player.vimeo.com/video/${vId}?autoplay=${autoplay ? 1 : 0}&loop=${loop ? 1 : 0}`;
            }
          }
          if (embedSrc) {
            comp.addAttributes({ src: embedSrc });
          }
        } else if (activeVideoTarget.isIframe) {
          const comp = activeVideoTarget.comp;
          let embedSrc = rawInput;
          if (provider === 'yt' && parsed?.videoId) {
            embedSrc = `https://www.youtube.com/embed/${parsed.videoId}?autoplay=${autoplay ? 1 : 0}&controls=${controls ? 1 : 0}&loop=${loop ? 1 : 0}`;
          } else if (provider === 'vi' && parsed?.videoId) {
            embedSrc = `https://player.vimeo.com/video/${parsed.videoId}?autoplay=${autoplay ? 1 : 0}&loop=${loop ? 1 : 0}`;
          }
          comp.addAttributes({ src: embedSrc });
        }

        showToast('✓ Video updated successfully!', true);
        closeVideoModal();
      });

      // ==========================================
      // SIMPAN HALAMAN AKTIF
      // ==========================================
      const toast = document.getElementById('builderToast');

      function showToast(msg, isSuccess = true) {
        toast.textContent = msg;
        toast.style.background = isSuccess ? '#10b981' : '#ef4444';
        toast.style.display = 'block';
        setTimeout(() => {
          toast.style.display = 'none';
        }, 4000);
      }

      const btnSave = document.getElementById('btnSave');
      btnSave.addEventListener('click', async () => {
        btnSave.disabled = true;
        btnSave.style.opacity = '0.7';

        try {
          // Sinkronisasi atribut src untuk semua komponen video sebelum diexport ke HTML
          const wrapper = editor.getWrapper();
          if (wrapper) {
            wrapper.findType('video').forEach(vComp => {
              const provider = vComp.get('provider') || 'yt';
              let vSrc = '';
              if (provider === 'yt') {
                vSrc = (vComp.get('nocookie') && vComp.getYoutubeNoCookieSrc) ? vComp.getYoutubeNoCookieSrc() : (vComp.getYoutubeSrc ? vComp.getYoutubeSrc() : `https://www.youtube.com/embed/${vComp.get('videoId')}?`);
              } else if (provider === 'vi') {
                vSrc = vComp.getVimeoSrc ? vComp.getVimeoSrc() : `https://player.vimeo.com/video/${vComp.get('videoId')}?`;
              } else if (provider === 'so') {
                vSrc = vComp.get('src') || '';
              }
              if (vSrc) {
                vComp.addAttributes({ src: vSrc });
              }
            });
          }

          // Ambil projectData (representasi internal GrapesJS yang lengkap)
          const projectData = editor.getProjectData();
          if (projectData && Array.isArray(projectData.styles)) {
            projectData.styles.forEach(s => {
              if (s && s.style) {
                if (s.style['border-top-color'] === 'rgba(156, 163, 175, 0.4)' || s.style['border-color'] === 'rgba(156, 163, 175, 0.4)') {
                  Object.keys(s.style).forEach(k => {
                    if (k.startsWith('border')) delete s.style[k];
                  });
                }
              }
            });
          }
          
          // Bersihkan class preview hover dari komponen sebelum simpan
          try {
            if (editor.getWrapper()) {
              editor.getWrapper().find('.gjs-hover-preview').forEach(c => c.removeClass('gjs-hover-preview'));
            }
          } catch (e) {}

          // Ambil HTML bersih tanpa tag <body>
          let html = editor.getHtml();
          html = html.replace(/\s*\bgjs-hover-preview\b/g, '').replace(/^<body[^>]*>/i, '').replace(/<\/body>$/i, '').trim();
          // Clean builder-only dropzone placeholder buttons & hint
          html = html.replace(/<div[^>]*\bclass=["'][^"']*\bdropzone-buttons-row\b[^"']*["'][^>]*>[\s\S]*?<\/div>/gi, '');
          html = html.replace(/<div[^>]*\bclass=["'][^"']*\b(dropzone-hint|dropzone-text)\b[^"']*["'][^>]*>[\s\S]*?<\/div>/gi, '');
          html = html.replace(/<button[^>]*\b(?:btn-trigger-add-block|btn-trigger-add-template|btnDropzoneAddBlock|btnDropzoneAddTemplate)\b[^>]*>[\s\S]*?<\/button>/gi, '');
          html = html.replace(/<div[^>]*\b(?:class=["'][^"']*\bempty-workspace-dropzone\b[^"']*["']|id=["']emptyWorkspaceDropzone["'])[^>]*>\s*<\/div>/gi, '');
          html = html.replace(/(<div[^>]*\b(?:class=["'][^"']*\bempty-workspace-dropzone\b[^"']*["']|id=["']emptyWorkspaceDropzone["'])[^>]*)\bstyle=["'][^"']*["']/gi, '$1style=""');
          
          // Ambil CSS yang dihasilkan GrapesJS dan bersihkan sisa-sisa helper border dashed lama jika ada
          let css = editor.getCss();
          if (css) {
            css = css
              .replace(/@media\s*\(\s*max-width:\s*100%\s*\)\s*\{([^}]*)\}/gi, '$1')
              .replace(/border-(top|right|bottom|left)-(width|style|color):\s*(1px|dashed|rgba\(156,\s*163,\s*175,\s*0\.4\));?/gi, '')
              .replace(/border:\s*1px\s+dashed\s+rgba\(156,\s*163,\s*175,\s*0\.4\);?/gi, '')
              .replace(/border-image-[^:]+:[^;]+;?/gi, '');
          }

          const pageTitle = allPages[currentSlug]?.title || currentSlug;

          const res = await fetch('/api/pages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save',
              slug: currentSlug,
              title: pageTitle,
              isCustom: true,
              showHeader: allPages[currentSlug]?.showHeader !== false,
              showFooter: allPages[currentSlug]?.showFooter !== false,
              schema: allPages[currentSlug]?.schema || '',
              customCode: allPages[currentSlug]?.customCode || null,
              html: html,
              css: css,
              projectData: projectData,
              theme: activeThemeName
            })
          });

          const data = await res.json();
          if (data.success) {
            allPages[currentSlug] = data.page;
            showToast(`✓ Page saved successfully!`, true);
          } else {
            showToast('Failed to save: ' + (data.error || 'Unknown error'), false);
          }
        } catch (err) {
          showToast('Connection error while saving to server.', false);
        } finally {
          btnSave.disabled = false;
          btnSave.style.opacity = '1';
        }
      });

      // Tombol Reset ke Template Awal
