        transition: all 0.2s ease;
      }
      .font-upload-dropzone:hover, .font-upload-dropzone.dragover {
        border-color: #ff5e3a;
        background: rgba(255, 94, 58, 0.06);
      }
      .font-upload-dropzone svg {
        margin-bottom: 8px;
        color: #9ca3af;
        transition: color 0.2s ease;
      }
      .font-upload-dropzone:hover svg {
        color: #ff5e3a;
      }
      .font-upload-dropzone p {
        margin: 0;
        font-size: 0.82rem;
        color: #d1d5db;
        font-weight: 500;
      }
      .font-upload-dropzone span {
        display: block;
        font-size: 0.72rem;
        color: #6b7280;
        margin-top: 4px;
      }
      .font-preview-box {
        background: #0d1015;
        border: 1px solid #252b37;
        border-radius: 8px;
        padding: 14px 16px;
        margin-top: 14px;
