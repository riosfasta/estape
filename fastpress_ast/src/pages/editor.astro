                  { id: 'h5', label: 'H5 - Heading 5 (Small Heading)' },
                  { id: 'h6', label: 'H6 - Heading 6 (Micro Heading)' },
                  { id: 'p', label: 'P - Paragraph' },
                ]
              },
              'id',
              'title'
            ]
          },
          init() {
            this.on('change:tagName', this.handleTagChange);
          },
          handleTagChange() {
            const view = this.getView ? this.getView() : this.view;
            if (view && view.el) {
              const newTag = (this.get('tagName') || 'h2').toLowerCase();
              if (view.el.tagName.toLowerCase() !== newTag) {
                const newEl = view.el.ownerDocument.createElement(newTag);
                Array.from(view.el.attributes).forEach(attr => {
                  newEl.setAttribute(attr.name, attr.value);
                });
                newEl.innerHTML = view.el.innerHTML;
                view.el.parentNode?.replaceChild(newEl, view.el);
                view.el = newEl;
                if (view.render) view.render();
              }
            }
          }
        }
      });

