        editor.on('component:styleUpdate', (cmp) => {
          if (!cmp) return;
          const id = cmp.getId();

          if (activeComponentStylingState === 'hover') {
            const normalStyle = componentNormalStyles[id];
            if (!normalStyle) return;

            const currentStyle = cmp.getStyle();
            let hoverRule = editor.Css.getRule(`#${id}:hover, #${id}.gjs-hover-preview`) 
              || editor.Css.getRule(`#${id}:hover`);
            if (!hoverRule) {
              hoverRule = editor.Css.setRule(`#${id}:hover, #${id}.gjs-hover-preview`, {});
            }

            let hasChanges = false;
            for (const key in currentStyle) {
              if (currentStyle[key] !== normalStyle[key]) {
                hoverRule.addStyle({ [key]: currentStyle[key] });
                hasChanges = true;
              }
            }

            if (hasChanges) {
              cmp.setStyle(normalStyle, { silent: true });
              const normRule = editor.Css.getRule('#' + id);
              if (normRule) normRule.setStyle(normalStyle, { silent: true });
            }
          } else {
            componentNormalStyles[id] = JSON.parse(JSON.stringify(cmp.getStyle()));
          }
        });

