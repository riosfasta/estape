              this.on('change:attributes:data-layout', reRender);
              this.on('change:attributes:data-align', reRender);
              this.on('change:attributes:data-pointer', reRender);
              this.on('change:attributes:data-animation', reRender);
              this.on('change:attributes:data-indicator', reRender);
