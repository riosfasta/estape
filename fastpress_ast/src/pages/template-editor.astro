            pill.className = `tpl-type-pill ${window.activeTemplate.type}`;
            pill.textContent = window.activeTemplate.type === 'global' ? '🌐 GLOBAL' : '📄 INDIVIDUAL';
          }
          showToast(`Template type changed to: ${window.activeTemplate.type.toUpperCase()}`);
        });

        // ========================================================
        // SAVE TEMPLATE LOGIC
        // ========================================================
        const btnSaveTemplate = document.getElementById('btnSaveTemplate');
        async function saveCurrentTemplate() {
          if (!btnSaveTemplate) return;
          btnSaveTemplate.disabled = true;
          btnSaveTemplate.style.opacity = '0.7';

          try {
            try {
              if (editor.getWrapper()) {
                editor.getWrapper().find('.gjs-hover-preview').forEach(c => c.removeClass('gjs-hover-preview'));
              }
            } catch (e) {}

            let html = editor.getHtml();
            if (html) html = html.replace(/\s*\bgjs-hover-preview\b/g, '');
            const css = editor.getCss();
            const projectData = editor.getProjectData();

            const updated = {
              ...window.activeTemplate,
              html,
              css,
              projectData
            };

            const res = await fetch('/api/templates', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'save',
                template: updated
              })
            });

            const data = await res.json();
            if (data.success) {
              window.activeTemplate = data.template;
              showToast(`✓ Template "${data.template.name}" saved successfully!`);
            } else {
              showToast(data.error || 'Failed to save template', true);
            }
          } catch (err) {
            showToast('Network error while saving: ' + err.message, true);
          } finally {
            btnSaveTemplate.disabled = false;
            btnSaveTemplate.style.opacity = '1';
          }
        }

        btnSaveTemplate?.addEventListener('click', saveCurrentTemplate);
        window.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            saveCurrentTemplate();
          }
        });

        // ========================================================
        // TEMPLATES MANAGER POPUP MODAL (SEARCH, FILTER, SORT, CARDS)
        // ========================================================
        const modalTemplatesManager = document.getElementById('modalTemplatesManager');
        const btnOpenTemplatesManager = document.getElementById('btnOpenTemplatesManager');
        const btnCloseTemplatesManager = document.getElementById('btnCloseTemplatesManager');
        const inputSearchTemplates = document.getElementById('inputSearchTemplates');
        const selectFilterTemplateType = document.getElementById('selectFilterTemplateType');
        const selectSortTemplates = document.getElementById('selectSortTemplates');
        const templatesListContainer = document.getElementById('templatesListContainer');

        function renderTemplatesManagerList() {
          if (!templatesListContainer) return;
          const query = inputSearchTemplates?.value.toLowerCase().trim() || '';
          const filterType = selectFilterTemplateType?.value || 'all';
          const sortVal = selectSortTemplates?.value || 'newest';

          let list = [...window.allTemplates];

          if (query) {
            list = list.filter(t => t.name.toLowerCase().includes(query) || (t.category && t.category.toLowerCase().includes(query)));
          }

          if (filterType !== 'all') {
            list = list.filter(t => t.type === filterType);
          }

          if (sortVal === 'name') {
            list.sort((a, b) => a.name.localeCompare(b.name));
          } else if (sortVal === 'oldest') {
            list.sort((a, b) => new Date(a.createdAt || 0).getTime() - new Date(b.createdAt || 0).getTime());
          } else {
            list.sort((a, b) => new Date(b.updatedAt || b.createdAt || 0).getTime() - new Date(a.updatedAt || a.createdAt || 0).getTime());
          }

          if (list.length === 0) {
            templatesListContainer.innerHTML = `
              <div style="text-align: center; padding: 40px 20px; color: #9ca3af;">
                <p style="font-size: 0.95rem; font-weight: 600;">No templates found matching your search.</p>
              </div>`;
            return;
          }

          templatesListContainer.innerHTML = list.map(t => {
            const isActive = t.id === window.activeTemplate.id;
            const isGlobal = t.type === 'global';
            return `
              <div class="tm-item-row ${isActive ? 'active' : ''}">
                <div class="tm-icon-box">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="${isGlobal ? '#10b981' : '#8b5cf6'}"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"></path></svg>
                </div>
                <div class="tm-info">
                  <div class="tm-title-line">
                    <span class="tm-title">${t.name}</span>
                    <span class="tpl-type-pill ${t.type}">${isGlobal ? '🌐 GLOBAL' : '📄 INDIVIDUAL'}</span>
                    ${isActive ? '<span style="font-size: 0.65rem; background: rgba(139, 92, 246, 0.2); color: #c4b5fd; padding: 1px 6px; border-radius: 4px; font-weight: 700;">ACTIVE</span>' : ''}
                  </div>
                  <div class="tm-desc">Category: <strong>${t.category || 'General'}</strong> • ${isGlobal ? 'Synced everywhere' : 'Independent copy'}</div>
                </div>
                <div class="tm-actions">
                  <a href="/template-editor?id=${t.id}" class="btn-secondary" style="font-size: 0.74rem; text-decoration: none; padding: 5px 10px;">Open</a>
                  <button type="button" class="btn-secondary btn-duplicate-tm" data-id="${t.id}" style="font-size: 0.74rem; padding: 5px 8px;" title="Clone template">Clone</button>
                  <button type="button" class="btn-secondary btn-delete-tm" data-id="${t.id}" data-name="${t.name}" style="font-size: 0.74rem; padding: 5px 8px; color: #ef4444;" title="Delete template">&times;</button>
                </div>
              </div>`;
          }).join('');

          // Bind clone and delete buttons
          templatesListContainer.querySelectorAll('.btn-duplicate-tm').forEach(b => {
            b.addEventListener('click', async (e) => {
              const id = e.currentTarget.dataset.id;
              await duplicateTemplate(id);
            });
          });

          templatesListContainer.querySelectorAll('.btn-delete-tm').forEach(b => {
            b.addEventListener('click', async (e) => {
              const id = e.currentTarget.dataset.id;
              const name = e.currentTarget.dataset.name;
              await deleteTemplate(id, name);
            });
          });
        }

        btnOpenTemplatesManager?.addEventListener('click', () => {
          renderTemplatesManagerList();
          modalTemplatesManager?.classList.add('open');
        });
        const closeTemplatesManager = () => modalTemplatesManager?.classList.remove('open');
        btnCloseTemplatesManager?.addEventListener('click', closeTemplatesManager);

        inputSearchTemplates?.addEventListener('input', renderTemplatesManagerList);
        selectFilterTemplateType?.addEventListener('change', renderTemplatesManagerList);
        selectSortTemplates?.addEventListener('change', renderTemplatesManagerList);

        // ========================================================
        // CREATE NEW TEMPLATE MODAL
        // ========================================================
        const modalNewTemplate = document.getElementById('modalNewTemplate');
        const btnNavbarNewTemplate = document.getElementById('btnNavbarNewTemplate');
        const btnModalTriggerNewTemplate = document.getElementById('btnModalTriggerNewTemplate');
        const btnCloseNewTemplateModal = document.getElementById('btnCloseNewTemplateModal');
        const btnCancelNewTemplate = document.getElementById('btnCancelNewTemplate');
        const btnConfirmCreateTemplate = document.getElementById('btnConfirmCreateTemplate');

        function openNewTemplateModal() {
          closeTemplatesManager();
          modalNewTemplate?.classList.add('open');
        }

        btnNavbarNewTemplate?.addEventListener('click', openNewTemplateModal);
        btnModalTriggerNewTemplate?.addEventListener('click', openNewTemplateModal);
        const closeNewTemplateModal = () => modalNewTemplate?.classList.remove('open');
        btnCloseNewTemplateModal?.addEventListener('click', closeNewTemplateModal);
        btnCancelNewTemplate?.addEventListener('click', closeNewTemplateModal);

        btnConfirmCreateTemplate?.addEventListener('click', async () => {
          const name = document.getElementById('inputNewTemplateName').value.trim();
          const type = document.querySelector('input[name="radioNewTemplateType"]:checked')?.value || 'global';
          const category = document.getElementById('selectNewTemplateCategory')?.value || 'General';
          const starter = document.getElementById('selectNewTemplateStarter')?.value || 'empty';

          if (!name) {
            alert('Please enter a name for the template.');
            return;
          }

          let initialHtml = '';
          let initialCss = '';
          if (starter === 'empty') {
            initialHtml = EMPTY_WORKSPACE_HTML;
          } else {
            const chosen = window.allTemplates.find(t => t.id === starter);
            if (chosen) {
              initialHtml = chosen.html;
              initialCss = chosen.css;
            }
          }

          btnConfirmCreateTemplate.disabled = true;
          btnConfirmCreateTemplate.textContent = 'Creating...';

          try {
            const res = await fetch('/api/templates', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'create',
                name,
                type,
                category,
                html: initialHtml,
                css: initialCss
              })
            });

            const data = await res.json();
            if (data.success && data.template) {
              showToast(`✓ Template "${data.template.name}" created! Opening...`);
              window.location.href = `/template-editor?id=${data.template.id}`;
            } else {
              showToast(data.error || 'Failed to create template', true);
            }
          } catch (err) {
            showToast('Network error: ' + err.message, true);
          } finally {
            btnConfirmCreateTemplate.disabled = false;
            btnConfirmCreateTemplate.textContent = 'Create Template';
          }
        });

        // ========================================================
        // DUPLICATE & DELETE HELPERS
        // ========================================================
        async function duplicateTemplate(id) {
          try {
            const res = await fetch('/api/templates', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'duplicate', id })
            });
            const data = await res.json();
            if (data.success && data.template) {
              showToast(`✓ Duplicated template! Opening...`);
              window.location.href = `/template-editor?id=${data.template.id}`;
            }
          } catch (err) {
            showToast('Failed to duplicate: ' + err.message, true);
          }
        }

        async function deleteTemplate(id, name) {
          if (window.allTemplates.length <= 1) {
            alert('Cannot delete the only remaining template.');
            return;
          }
          const ok = confirm(`Are you sure you want to delete template "${name}"?`);
          if (!ok) return;

          try {
            const res = await fetch('/api/templates', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', id })
            });
            const data = await res.json();
            if (data.success) {
              showToast(`Template "${name}" deleted.`);
              const remaining = window.allTemplates.filter(t => t.id !== id);
              window.location.href = `/template-editor?id=${remaining[0].id}`;
            }
          } catch (err) {
            showToast('Failed to delete: ' + err.message, true);
          }
        }

        document.getElementById('btnNavbarDuplicateTemplate')?.addEventListener('click', () => {
          duplicateTemplate(window.activeTemplate.id);
        });

        // ========================================================
        // SAVED TEMPLATES LIBRARY MODAL (FOLDER BUTTON ACTION)
        // ========================================================
        const modalSavedTemplatesLibrary = document.getElementById('modalSavedTemplatesLibrary');
        const btnOpenSavedTemplatesModal = document.getElementById('btnOpenSavedTemplatesModal');
        const btnCloseLibraryModal = document.getElementById('btnCloseLibraryModal');
        const inputSearchLibrary = document.getElementById('inputSearchLibrary');
        const libraryTemplatesGrid = document.getElementById('libraryTemplatesGrid');
        const btnLibFilterAll = document.getElementById('btnLibFilterAll');
        const btnLibFilterGlobal = document.getElementById('btnLibFilterGlobal');
        const btnLibFilterIndiv = document.getElementById('btnLibFilterIndiv');

        let libActiveFilter = 'all';

        function renderLibraryGrid() {
          if (!libraryTemplatesGrid) return;
          const query = inputSearchLibrary?.value.toLowerCase().trim() || '';
          let list = [...window.allTemplates];

          if (libActiveFilter !== 'all') {
            list = list.filter(t => t.type === libActiveFilter);
          }

          if (query) {
            list = list.filter(t => t.name.toLowerCase().includes(query) || (t.category && t.category.toLowerCase().includes(query)));
          }

          libraryTemplatesGrid.innerHTML = list.map(t => {
            const isGlobal = t.type === 'global';
            return `
              <div style="background: #181d28; border: 1px solid #2a3344; border-radius: 10px; padding: 16px; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.15s;">
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                    <span class="tpl-type-pill ${t.type}">${isGlobal ? '🌐 GLOBAL' : '📄 INDIVIDUAL'}</span>
                    <span style="font-size: 0.7rem; color: #9ca3af;">${t.category || 'General'}</span>
                  </div>
                  <h4 style="font-size: 0.95rem; font-weight: 700; color: #f3f4f6; margin-bottom: 6px;">${t.name}</h4>
                  <p style="font-size: 0.78rem; color: #9ca3af; line-height: 1.5; margin-bottom: 14px;">${t.description || ''}</p>
                </div>
                <button type="button" class="btn-primary-action btn-insert-lib-template" data-id="${t.id}" style="width: 100%; padding: 8px 12px; font-size: 0.78rem; display: flex; align-items: center; justify-content: center; gap: 6px;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  <span>Insert into Canvas</span>
                </button>
              </div>`;
          }).join('');

          libraryTemplatesGrid.querySelectorAll('.btn-insert-lib-template').forEach(b => {
            b.addEventListener('click', (e) => {
              const id = e.currentTarget.dataset.id;
              const targetTpl = window.allTemplates.find(t => t.id === id);
              if (!targetTpl) return;

              // If empty dropzone is present, replace it; otherwise add components
              const wrapper = editor.getWrapper();
              const dropzoneComp = wrapper.find('#emptyWorkspaceDropzone')[0];
              if (dropzoneComp) {
                dropzoneComp.remove();
              }

              let insertHtml = targetTpl.html;
              if (targetTpl.type === 'global' && !insertHtml.includes(`data-global-template-id="${targetTpl.id}"`)) {
                insertHtml = `<div class="global-template-instance" data-global-template-id="${targetTpl.id}">${insertHtml}</div>`;
              }

              editor.addComponents(insertHtml);
              if (targetTpl.css) {
                editor.setStyle(editor.getCss() + '\n' + targetTpl.css);
              }

              showToast(`Inserted "${targetTpl.name}" (${targetTpl.type.toUpperCase()})!`);
              closeLibraryModal();
            });
          });
        }

        function openLibraryModal() {
          libActiveFilter = 'all';
          updateLibFilterButtons();
          renderLibraryGrid();
          modalSavedTemplatesLibrary?.classList.add('open');
        }

        function updateLibFilterButtons() {
          btnLibFilterAll?.classList.toggle('active', libActiveFilter === 'all');
          btnLibFilterGlobal?.classList.toggle('active', libActiveFilter === 'global');
          btnLibFilterIndiv?.classList.toggle('active', libActiveFilter === 'individual');
        }

        btnOpenSavedTemplatesModal?.addEventListener('click', openLibraryModal);
        const closeLibraryModal = () => modalSavedTemplatesLibrary?.classList.remove('open');
        btnCloseLibraryModal?.addEventListener('click', closeLibraryModal);

        btnLibFilterAll?.addEventListener('click', () => { libActiveFilter = 'all'; updateLibFilterButtons(); renderLibraryGrid(); });
        btnLibFilterGlobal?.addEventListener('click', () => { libActiveFilter = 'global'; updateLibFilterButtons(); renderLibraryGrid(); });
        btnLibFilterIndiv?.addEventListener('click', () => { libActiveFilter = 'individual'; updateLibFilterButtons(); renderLibraryGrid(); });
        inputSearchLibrary?.addEventListener('input', renderLibraryGrid);

        // ========================================================
        // CODE EDITOR (HTML & CSS)
        // ========================================================
        const modalCodeEditor = document.getElementById('modalCodeEditor');
        const btnOpenCodeEditor = document.getElementById('btnOpenCodeEditor');
        const btnCloseCodeModal = document.getElementById('btnCloseCodeModal');
        const btnCancelCode = document.getElementById('btnCancelCode');
        const btnApplyCodeToCanvas = document.getElementById('btnApplyCodeToCanvas');
        const btnCodeTabHtml = document.getElementById('btnCodeTabHtml');
        const btnCodeTabCss = document.getElementById('btnCodeTabCss');
        const textareaTemplateCode = document.getElementById('textareaTemplateCode');

        let activeCodeTab = 'html';

        function syncCodeEditorTab() {
          if (activeCodeTab === 'html') {
            btnCodeTabHtml.classList.add('active');
            btnCodeTabCss.classList.remove('active');
            textareaTemplateCode.value = editor.getHtml();
          } else {
            btnCodeTabCss.classList.add('active');
            btnCodeTabHtml.classList.remove('active');
            textareaTemplateCode.value = editor.getCss();
          }
        }

        btnOpenCodeEditor?.addEventListener('click', () => {
          activeCodeTab = 'html';
          syncCodeEditorTab();
          modalCodeEditor?.classList.add('open');
        });
        const closeCodeModal = () => modalCodeEditor?.classList.remove('open');
        btnCloseCodeModal?.addEventListener('click', closeCodeModal);
        btnCancelCode?.addEventListener('click', closeCodeModal);

        btnCodeTabHtml?.addEventListener('click', () => { activeCodeTab = 'html'; syncCodeEditorTab(); });
        btnCodeTabCss?.addEventListener('click', () => { activeCodeTab = 'css'; syncCodeEditorTab(); });

        btnApplyCodeToCanvas?.addEventListener('click', () => {
          const val = textareaTemplateCode.value;
          if (activeCodeTab === 'html') {
            editor.setComponents(val);
          } else {
            editor.setStyle(val);
          }
          showToast('Updated canvas from code editor!');
          closeCodeModal();
        });

        // ==========================================
        // LAYER ACTIONS & CROSS-BUILDER CLIPBOARD SYSTEM
        // ==========================================
        const LAYER_CLIPBOARD_KEY = 'fastpress_layer_clipboard';

        // Elemen UI Toolbar & Clipboard Banner
        const btnLayerCopy = document.getElementById('btnLayerCopy');
        const btnLayerPasteBelow = document.getElementById('btnLayerPasteBelow');
        const btnLayerPasteInside = document.getElementById('btnLayerPasteInside');
        const btnLayerDuplicate = document.getElementById('btnLayerDuplicate');
        const btnLayerDelete = document.getElementById('btnLayerDelete');
        const btnClearLayerClipboard = document.getElementById('btnClearLayerClipboard');
        const layerClipboardBanner = document.getElementById('layerClipboardBanner');
        const clipboardLayerName = document.getElementById('clipboardLayerName');
        const clipboardSourcePill = document.getElementById('clipboardSourcePill');
        const layerActiveBadge = document.getElementById('layerActiveBadge');

        // Elemen UI Context Menu
        const layerContextMenu = document.getElementById('layerContextMenu');
        const ctxMenuLayerName = document.getElementById('ctxMenuLayerName');
        const ctxBtnCopy = document.getElementById('ctxBtnCopy');
        const ctxBtnPasteBelow = document.getElementById('ctxBtnPasteBelow');
        const ctxBtnPasteInside = document.getElementById('ctxBtnPasteInside');
        const ctxBtnDuplicate = document.getElementById('ctxBtnDuplicate');
        const ctxBtnDelete = document.getElementById('ctxBtnDelete');

        // Ambil data clipboard dari localStorage
        function getLayerClipboard() {
          try {
            const raw = localStorage.getItem(LAYER_CLIPBOARD_KEY);
            if (!raw) return null;
            return JSON.parse(raw);
          } catch (e) {
            console.warn('Failed to parse layer clipboard:', e);
            return null;
          }
        }

        // Format nama manusiawi untuk komponen
        function getComponentHumanName(comp) {
          if (!comp) return 'Element';
          try {
            if (comp.is('wrapper')) return 'Body / Root Wrapper';
            const customName = comp.getName ? comp.getName() : null;
            if (customName && customName !== 'Component' && customName !== 'Box') return customName;

            const tag = (comp.get('tagName') || comp.get('type') || 'Element').toUpperCase();
            const compClasses = comp.getClasses ? comp.getClasses() : [];
            if (compClasses.length > 0) {
              const firstCls = typeof compClasses[0] === 'string' ? compClasses[0] : (compClasses[0]?.get ? compClasses[0].get('name') : '');
              if (firstCls && !firstCls.startsWith('gjs-')) {
                return `${tag} (.${firstCls})`;
              }
            }
            return tag;
          } catch (e) {
            return 'Element';
          }
        }

        // Update tampilan status clipboard & tombol paste
        function updateLayerClipboardUI() {
          const payload = getLayerClipboard();
          const hasContent = !!(payload && payload.html);

          if (layerClipboardBanner && clipboardLayerName && clipboardSourcePill) {
            if (hasContent) {
              layerClipboardBanner.style.display = 'flex';
              clipboardLayerName.textContent = payload.name || 'Component';
              const originTitle = payload.sourcePageTitle || payload.sourcePageSlug || 'Template';
              clipboardSourcePill.textContent = 'from ' + originTitle;
            } else {
              layerClipboardBanner.style.display = 'none';
            }
          }

          if (btnLayerPasteBelow) btnLayerPasteBelow.disabled = !hasContent;
          if (btnLayerPasteInside) btnLayerPasteInside.disabled = !hasContent;
          if (ctxBtnPasteBelow) ctxBtnPasteBelow.disabled = !hasContent;
          if (ctxBtnPasteInside) ctxBtnPasteInside.disabled = !hasContent;
        }

        // Pastikan layer aktif dan parent-parentnya terbuka di panel Layers, serta scroll ke view
        function revealComponentInLayers(comp) {
          if (!comp || comp.is('wrapper')) return;
          try {
            let parent = comp.parent();
            while (parent && !parent.is('wrapper')) {
              if (editor && editor.LayerManager && typeof editor.LayerManager.setOpen === 'function') {
                editor.LayerManager.setOpen(parent, true);
              }
              parent = parent.parent();
            }

            setTimeout(() => {
              const layersContainer = document.getElementById('layers-container');
              if (!layersContainer) return;
              const activeRow = layersContainer.querySelector('.gjs-layer.gjs-selected > .gjs-layer-item') ||
                                layersContainer.querySelector('.gjs-layer.gjs-selected') ||
                                layersContainer.querySelector('.gjs-selected');
              if (activeRow && typeof activeRow.scrollIntoView === 'function') {
                activeRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }
            }, 60);
          } catch (err) {
            console.warn('revealComponentInLayers error:', err);
          }
        }

        // Update tombol yang bergantung pada pemilihan layer (Copy, Duplicate, Delete)
        function updateLayerSelectionUI(comp) {
          const hasSelection = !!(comp && !comp.is('wrapper'));
          const name = hasSelection ? getComponentHumanName(comp) : '';

          if (layerActiveBadge) {
            if (hasSelection) {
              layerActiveBadge.style.display = 'inline-block';
              layerActiveBadge.textContent = name;
            } else {
              layerActiveBadge.style.display = 'none';
            }
          }

          if (btnLayerCopy) btnLayerCopy.disabled = !hasSelection;
          if (btnLayerDuplicate) btnLayerDuplicate.disabled = !hasSelection;
          if (btnLayerDelete) btnLayerDelete.disabled = !hasSelection;

          if (ctxBtnCopy) ctxBtnCopy.disabled = !hasSelection;
          if (ctxBtnDuplicate) ctxBtnDuplicate.disabled = !hasSelection;
          if (ctxBtnDelete) ctxBtnDelete.disabled = !hasSelection;

          if (ctxMenuLayerName) {
            ctxMenuLayerName.textContent = hasSelection ? name : 'Template Root';
          }

          if (hasSelection) {
            revealComponentInLayers(comp);
          }
        }

        // Ekstrak CSS rules yang relevan dengan komponen dan anak-anaknya
        function extractMatchingCssRules(comp) {
          if (!comp || !editor) return '';
          const matchedRules = [];

          try {
            const ids = [];
            const classes = [];

            function collectSelectors(c) {
              const id = c.getId ? c.getId() : null;
              if (id) ids.push(id);
              const clsList = c.getClasses ? c.getClasses() : [];
              clsList.forEach(cls => {
                const name = typeof cls === 'string' ? cls : (cls?.get ? cls.get('name') : '');
                if (name) classes.push(name);
              });
              const children = c.components ? c.components() : [];
              if (children && children.forEach) {
                children.forEach(collectSelectors);
              }
            }
            collectSelectors(comp);

            const allRules = editor.CssComposer ? editor.CssComposer.getAll() : null;
            if (allRules && allRules.forEach) {
              allRules.forEach(rule => {
                try {
                  const selector = rule.getSelectorsString ? rule.getSelectorsString() : '';
                  if (!selector) return;

                  const matchesId = ids.some(id => selector.includes('#' + id));
                  const matchesClass = classes.some(cls => selector.includes('.' + cls));

                  if (matchesId || matchesClass) {
                    const ruleCss = rule.toCSS ? rule.toCSS() : '';
                    if (ruleCss && ruleCss.trim()) {
                      matchedRules.push(ruleCss.trim());
                    }
                  }
                } catch (e) {}
              });
            }
          } catch (e) {
            console.warn('Error extracting css rules:', e);
          }

          return matchedRules.join('\n');
        }

        // Salin layer yang dipilih ke clipboard (tersimpan di localStorage untuk lintas halaman)
        function copySelectedLayer(targetComp) {
          if (!editor) return;
          const comp = targetComp || editor.getSelected();
          if (!comp || comp.is('wrapper')) {
            showToast('Please select a specific element or layer to copy.');
            return;
          }

          const name = getComponentHumanName(comp);
          const html = comp.toHTML ? comp.toHTML() : '';
          const cssRules = extractMatchingCssRules(comp);
          const sourcePageSlug = window.activeTemplate?.id || 'template';
          const sourcePageTitle = window.activeTemplate?.name || 'Template';

          const payload = {
            name,
            html,
            cssRules,
            sourcePageSlug,
            sourcePageTitle,
            timestamp: Date.now()
          };

          try {
            localStorage.setItem(LAYER_CLIPBOARD_KEY, JSON.stringify(payload));
            updateLayerClipboardUI();
            showToast(`Layer "${name}" copied! Ready to paste here or across builders.`);
          } catch (err) {
            console.error('Failed to copy layer to storage:', err);
            showToast('Failed to save layer to clipboard.');
          }
        }

        // Tempelkan layer (asChild = false: tempel di bawahnya, asChild = true: tempel di dalam kontainer)
        function pasteLayer(asChild = false) {
          if (!editor) return;
          const payload = getLayerClipboard();
          if (!payload || !payload.html) {
            showToast('Clipboard is empty. Please copy a layer first.');
            return;
          }

          // 1. Terapkan CSS kustom jika ada
          if (payload.cssRules && payload.cssRules.trim()) {
            try {
              editor.addStyle(payload.cssRules);
            } catch (e) {
              console.warn('Error applying copied styles:', e);
            }
          }

          // 2. Tentukan target induk (parent) dan indeks penempatan
          const selected = editor.getSelected();
          let targetParent = editor.getWrapper();
          let insertIndex = targetParent.components().length;

          if (selected && !selected.is('wrapper')) {
            if (asChild) {
              targetParent = selected;
              insertIndex = selected.components().length;
            } else {
              const parent = selected.parent();
              if (parent) {
                targetParent = parent;
                insertIndex = selected.index() + 1;
              }
            }
          }

          // 3. Tambahkan komponen baru
          let added = null;
          try {
            if (asChild) {
              added = targetParent.append(payload.html);
            } else {
              const comps = targetParent.components();
              if (comps && typeof comps.add === 'function') {
                added = comps.add(payload.html, { at: insertIndex });
              } else if (typeof targetParent.append === 'function') {
                added = targetParent.append(payload.html);
              }
            }
          } catch (err) {
            console.warn('Primary paste method error, using editor fallback:', err);
            added = editor.addComponents(payload.html);
          }

          // 4. Pilih komponen yang baru ditempel dan gulirkan kanvas
          if (added) {
            const compToSelect = Array.isArray(added) ? added[0] : added;
            if (compToSelect) {
              editor.select(compToSelect);
              try {
                const el = compToSelect.getEl();
                if (el && el.scrollIntoView) {
                  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
              } catch (e) {}
            }
            showToast(`Pasted "${payload.name}" successfully!`);
            updateLayerSelectionUI(compToSelect);
          }
        }

        // Duplikat layer aktif
        function duplicateSelectedLayer() {
          if (!editor) return;
          const comp = editor.getSelected();
          if (!comp || comp.is('wrapper')) {
            showToast('Please select a layer to duplicate.');
            return;
          }

          const name = getComponentHumanName(comp);
          const parent = comp.parent() || editor.getWrapper();
          const index = comp.index();
          const html = comp.toHTML ? comp.toHTML() : '';
          const cssRules = extractMatchingCssRules(comp);

          if (cssRules && cssRules.trim()) {
            try {
              editor.addStyle(cssRules);
            } catch (e) {}
          }

          try {
            let duplicated = null;
            const comps = parent.components();
            if (comps && typeof comps.add === 'function') {
              duplicated = comps.add(html, { at: index + 1 });
            } else {
              duplicated = parent.append(html);
            }

            if (duplicated) {
              const compToSelect = Array.isArray(duplicated) ? duplicated[0] : duplicated;
              if (compToSelect) {
                editor.select(compToSelect);
                try {
                  const el = compToSelect.getEl();
                  if (el && el.scrollIntoView) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  }
                } catch (e) {}
              }
              showToast(`Duplicated "${name}" successfully!`);
              updateLayerSelectionUI(compToSelect);
            }
          } catch (err) {
            console.error('Failed to duplicate component:', err);
            showToast('Failed to duplicate layer.');
          }
        }

        // Hapus layer aktif
        function deleteSelectedLayer() {
          if (!editor) return;
          const comp = editor.getSelected();
          if (!comp || comp.is('wrapper')) {
            showToast('Cannot delete wrapper. Select an inner layer.');
            return;
          }

          const name = getComponentHumanName(comp);
          try {
            comp.remove();
            showToast(`Deleted "${name}".`);
            updateLayerSelectionUI(null);
          } catch (err) {
            console.error('Failed to delete layer:', err);
            showToast('Failed to delete layer.');
          }
        }

        // Buka Context Menu di koordinat (x, y)
        function openLayerContextMenu(x, y) {
          if (!layerContextMenu) return;
          const selected = editor.getSelected();
          const hasSelection = !!(selected && !selected.is('wrapper'));

          updateLayerClipboardUI();
          updateLayerSelectionUI(selected);

          const menuWidth = 195;
          const menuHeight = 175;
          const maxX = window.innerWidth - menuWidth - 10;
          const maxY = window.innerHeight - menuHeight - 10;

          const posX = Math.max(10, Math.min(x, maxX));
          const posY = Math.max(10, Math.min(y, maxY));

          layerContextMenu.style.left = `${posX}px`;
          layerContextMenu.style.top = `${posY}px`;
          layerContextMenu.style.display = 'block';
        }

        // Tutup Context Menu
        function closeLayerContextMenu() {
          if (layerContextMenu) {
            layerContextMenu.style.display = 'none';
          }
        }

        // Global Keyboard Shortcut handler untuk operasi layer
        function handleGlobalLayerShortcuts(e) {
          const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
          const modKey = isMac ? e.metaKey : e.ctrlKey;

          // Cek apakah target atau activeElement sedang dalam mode pengetikan atau editing teks
          const target = e.target;
          if (
            target && (
              target.tagName === 'INPUT' ||
              target.tagName === 'TEXTAREA' ||
              target.tagName === 'SELECT' ||
              target.isContentEditable ||
              target.getAttribute('contenteditable') === 'true' ||
              (target.closest && target.closest('[contenteditable="true"], [contenteditable=""], [contenteditable], input, textarea, select, .gjs-rte-toolbar, .gjs-sm-field, .gjs-fields'))
            )
          ) {
            return;
          }

          const activeEl = document.activeElement;
          if (activeEl && (
            activeEl.tagName === 'INPUT' ||
            activeEl.tagName === 'TEXTAREA' ||
            activeEl.isContentEditable ||
            (activeEl.closest && activeEl.closest('[contenteditable="true"], .gjs-sm-field'))
          )) {
            return;
          }

          try {
            const frameDoc = editor?.Canvas?.getDocument?.();
            if (frameDoc && frameDoc.activeElement) {
              const fActive = frameDoc.activeElement;
              if (
                fActive.tagName === 'INPUT' ||
                fActive.tagName === 'TEXTAREA' ||
                fActive.isContentEditable ||
                (fActive.closest && fActive.closest('[contenteditable="true"], [contenteditable]'))
              ) {
                return;
              }
            }
          } catch (err) {}

          if (editor?.getEditing && editor.getEditing()) return;
          if (editor?.getModel && editor.getModel().isEditing && editor.getModel().isEditing()) return;

          const selected = editor ? editor.getSelected() : null;

          // Ctrl/Cmd + C : Copy Layer
          if (modKey && (e.key === 'c' || e.key === 'C')) {
            if (selected && !selected.is('wrapper')) {
              e.preventDefault();
              copySelectedLayer();
            }
          }

          // Ctrl/Cmd + V : Paste Layer Below
          if (modKey && (e.key === 'v' || e.key === 'V')) {
            const clip = getLayerClipboard();
            if (clip && clip.html) {
              e.preventDefault();
              pasteLayer(false);
            }
          }

          // Ctrl/Cmd + D : Duplicate Layer
          if (modKey && (e.key === 'd' || e.key === 'D')) {
            if (selected && !selected.is('wrapper')) {
              e.preventDefault();
              duplicateSelectedLayer();
            }
          }

          // Delete : Delete Layer (Hanya tombol Delete fisik, atau Backspace di Mac jika BUKAN sedang edit teks)
          const isDeleteKey = e.key === 'Delete' || (isMac && e.key === 'Backspace');
          if (isDeleteKey && !modKey) {
            if (selected && !selected.is('wrapper')) {
              e.preventDefault();
              deleteSelectedLayer();
            }
          }
        }

        // Inisialisasi event listener sistem layer clipboard
        function initLayerClipboardSystem() {
          if (!editor) return;
          window.fastpressLayerClipboard = {
            copySelectedLayer,
            pasteLayer,
            duplicateSelectedLayer,
            deleteSelectedLayer,
            openLayerContextMenu,
            closeLayerContextMenu
          };
          updateLayerClipboardUI();
          updateLayerSelectionUI(editor.getSelected());

          // Event Tombol Toolbar
          if (btnLayerCopy) btnLayerCopy.addEventListener('click', () => copySelectedLayer());
          if (btnLayerPasteBelow) btnLayerPasteBelow.addEventListener('click', () => pasteLayer(false));
          if (btnLayerPasteInside) btnLayerPasteInside.addEventListener('click', () => pasteLayer(true));
          if (btnLayerDuplicate) btnLayerDuplicate.addEventListener('click', () => duplicateSelectedLayer());
          if (btnLayerDelete) btnLayerDelete.addEventListener('click', () => deleteSelectedLayer());

          if (btnClearLayerClipboard) {
            btnClearLayerClipboard.addEventListener('click', (e) => {
              e.stopPropagation();
              localStorage.removeItem(LAYER_CLIPBOARD_KEY);
              updateLayerClipboardUI();
              showToast('Layer clipboard cleared.');
            });
          }

          // Event Context Menu Buttons
          if (ctxBtnCopy) ctxBtnCopy.addEventListener('click', () => { copySelectedLayer(); closeLayerContextMenu(); });
          if (ctxBtnPasteBelow) ctxBtnPasteBelow.addEventListener('click', () => { pasteLayer(false); closeLayerContextMenu(); });
          if (ctxBtnPasteInside) ctxBtnPasteInside.addEventListener('click', () => { pasteLayer(true); closeLayerContextMenu(); });
          if (ctxBtnDuplicate) ctxBtnDuplicate.addEventListener('click', () => { duplicateSelectedLayer(); closeLayerContextMenu(); });
          if (ctxBtnDelete) ctxBtnDelete.addEventListener('click', () => { deleteSelectedLayer(); closeLayerContextMenu(); });

          // Klik kanan pada container layers
          const layersContainer = document.getElementById('layers-container');
          if (layersContainer) {
            layersContainer.addEventListener('contextmenu', (e) => {
              e.preventDefault();
              e.stopPropagation();

              const layerRow = e.target.closest('.gjs-layer');
              if (layerRow) {
                if (!layerRow.classList.contains('gjs-selected')) {
                  const titleEl = layerRow.querySelector('.gjs-layer-name, .gjs-layer-title') || layerRow;
                  titleEl.click();
                }
              }

              setTimeout(() => {
                openLayerContextMenu(e.clientX, e.clientY);
              }, 20);
            });
          }

          // Klik kanan dan shortcut di iframe canvas
          try {
            const frameEl = editor.Canvas.getFrameEl();
            if (frameEl && frameEl.contentDocument) {
              frameEl.contentDocument.addEventListener('contextmenu', (e) => {
                const targetEl = e.target;
                if (targetEl && targetEl !== frameEl.contentDocument.body) {
                  try {
                    const comp = editor.Components.getWrapper().find(targetEl)[0] || editor.getSelected();
                    if (comp && !comp.is('wrapper')) {
                      editor.select(comp);
                    }
                  } catch (err) {}
                }

                const selected = editor.getSelected();
                if (selected && !selected.is('wrapper')) {
                  e.preventDefault();
                  e.stopPropagation();
                  const rect = frameEl.getBoundingClientRect();
                  const mainX = rect.left + e.clientX;
                  const mainY = rect.top + e.clientY;
                  openLayerContextMenu(mainX, mainY);
                }
              });

              frameEl.contentDocument.addEventListener('click', closeLayerContextMenu);
              frameEl.contentDocument.addEventListener('keydown', handleGlobalLayerShortcuts);
            }
          } catch (err) {
            console.warn('Canvas frame contextmenu attach warning:', err);
          }

          // Double click on layer item in Layers list to rename
          const layersBox = document.getElementById('layers-container');
          if (layersBox && !layersBox.dataset.dblclickBound) {
            layersBox.dataset.dblclickBound = 'true';
            layersBox.addEventListener('dblclick', (e) => {
              const item = e.target.closest('.gjs-layer-item');
              if (!item || !editor) return;
              const sel = editor.getSelected();
              if (sel && !sel.is('wrapper')) {
                const current = sel.get('custom-name') || (sel.getName ? sel.getName() : 'Section');
                const newName = prompt('Rename layer:', current);
                if (newName && newName.trim()) {
                  sel.set('custom-name', newName.trim());
                  showToast(`Renamed to "${newName.trim()}"`);
                }
              }
            });

            // Auto-expand collapsed layers when dragging over them
            layersBox.addEventListener('dragover', (e) => {
              const layerItem = e.target.closest('.gjs-layer-item');
              if (layerItem) {
                const caret = layerItem.querySelector('.gjs-layer-caret');
                if (caret && !caret.classList.contains('gjs-open')) {
                  caret.click();
                }
              }
            });
          }

          // Global listeners
          document.addEventListener('click', (e) => {
            if (layerContextMenu && !layerContextMenu.contains(e.target)) {
              closeLayerContextMenu();
            }
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLayerContextMenu();
          });
          document.addEventListener('keydown', handleGlobalLayerShortcuts);
          window.addEventListener('scroll', closeLayerContextMenu, true);

          // Sinkronisasi lintas tab browser
          window.addEventListener('storage', (e) => {
            if (e.key === LAYER_CLIPBOARD_KEY) {
              updateLayerClipboardUI();
            }
          });
        }

        if (typeof initLayerClipboardSystem === 'function') {
          initLayerClipboardSystem();
        }

        // ========================================================
        // TOPBAR DROPDOWNS INITIALIZATION (Actions & Preview/Code)
        // ========================================================
        function initTopbarDropdowns() {
          const wraps = document.querySelectorAll('.topbar-dropdown-wrap');
          wraps.forEach((wrap) => {
            const btn = wrap.querySelector('.topbar-dropdown-btn');
            const menu = wrap.querySelector('.topbar-dropdown-menu');
            if (!btn) return;

            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const isOpen = wrap.classList.contains('open');
              wraps.forEach((w) => {
                w.classList.remove('open');
                w.querySelector('.topbar-dropdown-btn')?.setAttribute('aria-expanded', 'false');
              });
              if (!isOpen) {
                wrap.classList.add('open');
                btn.setAttribute('aria-expanded', 'true');
              }
            });

            if (menu) {
              menu.addEventListener('click', (e) => {
                if (e.target.closest('.topbar-dropdown-item')) {
                  wrap.classList.remove('open');
                  btn.setAttribute('aria-expanded', 'false');
                }
              });
            }
          });

          document.addEventListener('click', (e) => {
            if (!e.target.closest('.topbar-dropdown-wrap')) {
              wraps.forEach((w) => {
                w.classList.remove('open');
                w.querySelector('.topbar-dropdown-btn')?.setAttribute('aria-expanded', 'false');
              });
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              wraps.forEach((w) => {
                w.classList.remove('open');
                w.querySelector('.topbar-dropdown-btn')?.setAttribute('aria-expanded', 'false');
              });
            }
          });
        }

        initTopbarDropdowns();

      });
    </script>
  </body>
</html>
