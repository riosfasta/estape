            init() {
              this.on('change:attributes:data-initial-state', () => {
                const state = this.getAttributes()['data-initial-state'] || 'first-open';
                if (state === 'custom') return;
                const items = this.find('.accordion-item');
                items.forEach((item, idx) => {
                  const icon = item.find('.accordion-icon svg')[0] || item.find('.accordion-icon')[0];
                  let shouldOpen = false;
                  if (state === 'all-collapsed') {
                    shouldOpen = false;
                  } else if (state === 'all-expanded') {
                    shouldOpen = true;
                  } else if (state === 'first-open' || state === 'first-ones') {
                    shouldOpen = (idx === 0);
                  } else if (state === 'first-two-open') {
                    shouldOpen = (idx < 2);
                  }

                  if (shouldOpen) {
                    item.addAttributes({ 'data-open': 'true' });
                    item.addClass('is-open');
                    if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
                  } else {
                    item.addAttributes({ 'data-open': 'false' });
                    item.removeClass('is-open');
