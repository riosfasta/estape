        // ==========================================
        // NAV MENU COMPONENT & WIDGET GENERATOR
        // ==========================================
        function generateNavMenuWidgetHtml(menu, traits = {}) {
          if (!menu) return '';
          const layout = traits['data-layout'] || menu.layout || 'horizontal';
          const alignment = traits['data-align'] || menu.alignment || 'left';
          const pointer = traits['data-pointer'] || menu.pointer || 'underline';
          const animation = traits['data-animation'] || menu.animation || 'fade';
          const indicator = traits['data-indicator'] || menu.submenuIndicator || 'angle';
          const mb = menu.mobileDropdown || {};
          const toggleBtn = traits['data-toggle-button'] || mb.toggleButton || 'hamburger';

          const indicatorSvg = (() => {
            switch (indicator) {
              case 'angle':
                return '<svg class="nm-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>';
              case 'chevron':
                return '<svg class="nm-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>';
              case 'classic':
                return '<span class="nm-arrow-classic">▼</span>';
              case 'plus':
                return '<span class="nm-arrow-plus">+</span>';
              default:
                return '';
            }
          })();

          const renderItems = (items, depth = 0) => {
            return (items || []).map(item => {
              const hasChildren = Array.isArray(item.children) && item.children.length > 0;
              const isExternal = item.target === '_blank';
              return `
                <li class="nm-item ${hasChildren ? 'nm-has-children' : ''}">
                  <a href="${item.url || '#'}" target="${isExternal ? '_blank' : '_self'}" class="nm-link">
                    <span class="nm-link-title">${item.label || ''}</span>
                    ${item.badge ? `<span class="nm-badge">${item.badge}</span>` : ''}
                    ${hasChildren && indicator !== 'none' ? indicatorSvg : ''}
                  </a>
                  ${hasChildren ? `
                    <ul class="nm-submenu nm-sub-depth-${depth + 1}">
                      ${renderItems(item.children, depth + 1)}
                    </ul>
                  ` : ''}
                </li>
              `;
            }).join('');
          };

          const toggleHtml = toggleBtn === 'hamburger' ? `
            <button type="button" class="nm-mobile-toggle" aria-label="Toggle Menu">
              <span class="nm-hamburger-icon"><span></span><span></span><span></span></span>
              <span class="nm-toggle-label">Menu</span>
            </button>
          ` : '';

          return `
            ${toggleHtml}
            <nav class="nm-nav-wrapper">
              <ul class="nm-menu-list">
                ${renderItems(menu.items || [])}
              </ul>
            </nav>
          `.trim();
        }

        function getNavMenuSelectOptions() {
