        // --------------------------------------------------------
        // 2. SAVED TEMPLATES (GLOBAL & INDIVIDUAL)
        // --------------------------------------------------------
        function registerSavedTemplateBlocks() {
          window.allTemplates.forEach(tpl => {
            const isGlobal = tpl.type === 'global';
            const blockId = `block-${tpl.id}`;
            const badgeClass = isGlobal ? 'global' : 'individual';
            const badgeText = isGlobal ? 'GLOBAL' : 'INDIVIDUAL';
            const blockLabel = `<div class="tpl-block-badge ${badgeClass}">${badgeText}</div><div>${tpl.name}</div>`;

            // If global, ensure wrapper carries data-global-template-id
            let blockContent = tpl.html;
            if (isGlobal && !blockContent.includes(`data-global-template-id="${tpl.id}"`)) {
              blockContent = `<div class="global-template-instance" data-global-template-id="${tpl.id}">${blockContent}</div>`;
            }

            bm.add(blockId, {
              label: blockLabel,
              category: CAT_SAVED,
              attributes: { title: `${tpl.name} (${badgeText})` },
              media: `<svg viewBox="0 0 24 24" fill="${isGlobal ? '#10b981' : '#6366f1'}"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"></path></svg>`,
              content: blockContent
            });
          });
        }
        registerSavedTemplateBlocks();

        // ========================================================
