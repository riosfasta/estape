            init() {
              this.on('change:attributes:data-open', () => {
                const val = String(this.getAttributes()['data-open']);
                const isOpen = val === 'true';
                const icon = this.find('.accordion-icon svg')[0] || this.find('.accordion-icon')[0];
                if (isOpen) {
                  this.addClass('is-open');
                  if (icon) icon.addStyle({ transform: 'rotate(180deg)' });
                  const cc = this.find('.accordion-content')[0];
                  if (cc) {
                    cc.removeStyle('max-height');
                    cc.removeStyle('padding');
