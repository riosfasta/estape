                } else {
                  this.removeClass('is-open');
                  if (icon) icon.addStyle({ transform: 'rotate(0deg)' });
                }
                const parent = this.closest('.accordion-container');
                if (parent) {
                  const parentState = parent.getAttributes()['data-initial-state'];
                  if (parentState && parentState !== 'custom') {
                    parent.addAttributes({ 'data-initial-state': 'custom' });
