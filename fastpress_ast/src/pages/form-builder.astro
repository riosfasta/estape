          renderCanvas();
        });
        document.getElementById('settingStyleLabelColor').addEventListener('input', (e) => {
          activeForm.settings.styling.labelColor = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingStyleTextColor').addEventListener('input', (e) => {
          activeForm.settings.styling.inputTextColor = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingStyleInputBg').addEventListener('input', (e) => {
          activeForm.settings.styling.inputBg = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingStyleInputBorder').addEventListener('input', (e) => {
          activeForm.settings.styling.inputBorder = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingStyleRadius').addEventListener('change', (e) => {
          activeForm.settings.styling.borderRadius = e.target.value;
          renderCanvas();
        });

        // Background Color Listeners
        const bgPickerEl = document.getElementById('settingFormBgColorPicker');
        const bgTextEl = document.getElementById('settingFormBgColorText');
        bgPickerEl?.addEventListener('input', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBgColor = e.target.value;
          if (bgTextEl) bgTextEl.value = e.target.value;
          renderCanvas();
        });
        bgTextEl?.addEventListener('input', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          const val = e.target.value.trim();
          activeForm.settings.styling.formBgColor = val;
          if (val.startsWith('#') && val.length === 7 && bgPickerEl) {
            bgPickerEl.value = val;
          }
          renderCanvas();
        });

        // Quick Swatches for Background & Border
        document.querySelectorAll('.btn-color-swatch').forEach(btn => {
          btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-target');
            const color = btn.getAttribute('data-color');
            if (!activeForm.settings.styling) activeForm.settings.styling = {};
            if (target === 'bg') {
              activeForm.settings.styling.formBgColor = color;
              if (bgTextEl) bgTextEl.value = color;
              if (color.startsWith('#') && color.length === 7 && bgPickerEl) bgPickerEl.value = color;
              renderCanvas();
              showToast(`Background set to ${color}`);
            } else if (target === 'border') {
              activeForm.settings.styling.formBorderColor = color;
              const bText = document.getElementById('settingFormBorderColorText');
              const bPicker = document.getElementById('settingFormBorderColorPicker');
              if (bText) bText.value = color;
              if (color.startsWith('#') && color.length === 7 && bPicker) bPicker.value = color;
              renderCanvas();
              showToast(`Border color set to ${color}`);
            }
          });
        });

        // Background Image Listeners
        const bgImgInputEl = document.getElementById('settingFormBgImage');
        const bgWrapEl = document.getElementById('bgImageControlsWrap');
        bgImgInputEl?.addEventListener('input', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          const url = e.target.value.trim();
          activeForm.settings.styling.formBgImage = url;
          if (bgWrapEl) bgWrapEl.style.display = url ? 'block' : 'none';
          renderCanvas();
        });

        document.getElementById('btnClearFormBgImage')?.addEventListener('click', () => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBgImage = '';
          if (bgImgInputEl) bgImgInputEl.value = '';
          if (bgWrapEl) bgWrapEl.style.display = 'none';
          renderCanvas();
          showToast('Background image removed');
        });

        // Upload Image directly
        const btnUploadBg = document.getElementById('btnUploadFormBg');
        const fileInputBg = document.getElementById('fileInputFormBg');
        btnUploadBg?.addEventListener('click', () => fileInputBg?.click());
        fileInputBg?.addEventListener('change', async (e) => {
          const file = e.target.files?.[0];
          if (!file) return;
          const formData = new FormData();
          formData.append('file', file);
          try {
            showToast('Uploading background image...', '⏳');
            const res = await fetch('/api/upload', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.url) {
              if (!activeForm.settings.styling) activeForm.settings.styling = {};
              activeForm.settings.styling.formBgImage = data.url;
              if (bgImgInputEl) bgImgInputEl.value = data.url;
              if (bgWrapEl) bgWrapEl.style.display = 'block';
              renderCanvas();
              showToast('Background image uploaded & applied!');
            } else {
              showToast(data.error || 'Upload failed', '❌');
            }
          } catch (err) {
            console.error(err);
            showToast('Error uploading image', '❌');
          } finally {
            e.target.value = '';
          }
        });

        // Media Library Picker Modal
        const mediaModal = document.getElementById('mediaLibraryModal');
        const mediaGrid = document.getElementById('mediaLibraryGrid');
        const mediaDropzone = document.getElementById('mediaDropzone');
        const mediaModalFileInput = document.getElementById('mediaModalFileInput');
        let selectedMediaUrl = null;

        function openMediaModal() {
          selectedMediaUrl = activeForm.settings?.styling?.formBgImage || null;
          mediaModal?.classList.add('active');
          loadMediaList();
        }
        function closeMediaModal() {
          mediaModal?.classList.remove('active');
        }

        document.getElementById('btnOpenMediaPicker')?.addEventListener('click', openMediaModal);
        document.getElementById('btnCloseMediaModal')?.addEventListener('click', closeMediaModal);
        document.getElementById('btnCancelMediaModal')?.addEventListener('click', closeMediaModal);
        mediaModal?.addEventListener('click', (e) => {
          if (e.target === mediaModal) closeMediaModal();
        });

        mediaDropzone?.addEventListener('click', () => mediaModalFileInput?.click());
        mediaModalFileInput?.addEventListener('change', async (e) => {
          const file = e.target.files?.[0];
          if (!file) return;
          const formData = new FormData();
          formData.append('file', file);
          try {
            showToast('Uploading image...', '⏳');
            const res = await fetch('/api/upload', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.url) {
              selectedMediaUrl = data.url;
              await loadMediaList();
              showToast('Image uploaded! Click "Use Selected Image" to apply.');
            } else {
              showToast(data.error || 'Upload failed', '❌');
            }
          } catch {
            showToast('Error uploading image', '❌');
          } finally {
            e.target.value = '';
          }
        });

        async function loadMediaList() {
          if (!mediaGrid) return;
          mediaGrid.innerHTML = '<div style="grid-column: 1/-1; padding: 20px; text-align: center; color: #64748b;">Loading images...</div>';
          try {
            const res = await fetch('/api/upload');
            const data = await res.json();
            if (Array.isArray(data) && data.length > 0) {
              mediaGrid.innerHTML = data.map(item => `
                <div class="media-thumb-item" data-url="${item.url}" style="height: 80px; background: #0c0f17; border: ${selectedMediaUrl === item.url ? '2px solid #3b82f6' : '1px solid #1c2433'}; border-radius: 6px; overflow: hidden; cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative;">
                  <img src="${item.url}" alt="${item.fileName || 'Media'}" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                </div>
              `).join('');

              mediaGrid.querySelectorAll('.media-thumb-item').forEach(thumb => {
                thumb.addEventListener('click', () => {
                  mediaGrid.querySelectorAll('.media-thumb-item').forEach(t => t.style.border = '1px solid #1c2433');
                  thumb.style.border = '2px solid #3b82f6';
                  selectedMediaUrl = thumb.dataset.url;
                });
              });
            } else {
              mediaGrid.innerHTML = '<div style="grid-column: 1/-1; padding: 20px; text-align: center; color: #64748b;">No uploaded images found. Click above to upload one!</div>';
            }
          } catch {
            mediaGrid.innerHTML = '<div style="grid-column: 1/-1; padding: 20px; text-align: center; color: #ef4444;">Failed to load media.</div>';
          }
        }

        document.getElementById('btnApplySelectedMedia')?.addEventListener('click', () => {
          if (selectedMediaUrl) {
            if (!activeForm.settings.styling) activeForm.settings.styling = {};
            activeForm.settings.styling.formBgImage = selectedMediaUrl;
            if (bgImgInputEl) bgImgInputEl.value = selectedMediaUrl;
            if (bgWrapEl) bgWrapEl.style.display = 'block';
            renderCanvas();
            closeMediaModal();
            showToast('Background image applied!');
          } else {
            showToast('Please select or upload an image first', '⚠️');
          }
        });

        // Background Size, Position, Repeat, Overlay
        document.getElementById('settingFormBgSize')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBgSize = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingFormBgPosition')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBgPosition = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingFormBgRepeat')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBgRepeat = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingFormBgOverlay')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBgOverlay = e.target.value;
          renderCanvas();
        });

        // Border Width, Style, Color, Radius, Padding, Shadow
        document.getElementById('settingFormBorderWidth')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBorderWidth = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingFormBorderStyle')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBorderStyle = e.target.value;
          renderCanvas();
        });

        const borderPickerEl = document.getElementById('settingFormBorderColorPicker');
        const borderTextEl = document.getElementById('settingFormBorderColorText');
        borderPickerEl?.addEventListener('input', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBorderColor = e.target.value;
          if (borderTextEl) borderTextEl.value = e.target.value;
          renderCanvas();
        });
        borderTextEl?.addEventListener('input', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          const val = e.target.value.trim();
          activeForm.settings.styling.formBorderColor = val;
          if (val.startsWith('#') && val.length === 7 && borderPickerEl) {
            borderPickerEl.value = val;
          }
          renderCanvas();
        });

        document.getElementById('settingFormBorderRadius')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBorderRadius = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingFormPadding')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formPadding = e.target.value;
          renderCanvas();
        });
        document.getElementById('settingFormBoxShadow')?.addEventListener('change', (e) => {
          if (!activeForm.settings.styling) activeForm.settings.styling = {};
          activeForm.settings.styling.formBoxShadow = e.target.value;
          renderCanvas();
        });

        // Save Form Action
        btnSaveForm.addEventListener('click', async () => {
          try {
            btnSaveForm.disabled = true;
            btnSaveForm.innerHTML = '<span>Saving...</span>';

            const resp = await fetch('/api/forms', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(activeForm)
            });

            if (!resp.ok) throw new Error('Save failed');
            const data = await resp.json();

            // Update in local list
            const idx = formsList.findIndex(f => f.id === activeForm.id);
            if (idx >= 0) formsList[idx] = activeForm;
            else formsList.push(activeForm);

            renderFormSelector();
            showToast('Form successfully saved! Available in Page Builder.');
          } catch (err) {
            console.error(err);
            showToast('Error saving form', '❌');
          } finally {
            btnSaveForm.disabled = false;
            btnSaveForm.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg><span>Save Form</span>`;
          }
        });

        // New Form Action
        btnNewForm.addEventListener('click', () => {
          const title = prompt('Enter a name for the new form:', 'New Inquiry Form');
          if (!title) return;

          const newId = `form-${Date.now()}`;
          const newForm = {
            id: newId,
            name: title,
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            fields: [
              {
                id: `field_name_${Date.now()}`,
                type: 'text',
                label: 'Your Name',
                placeholder: 'Jane Doe',
                required: true,
                width: '100%'
              },
              {
                id: `field_email_${Date.now()}`,
                type: 'email',
                label: 'Email Address',
                placeholder: 'jane@example.com',
                required: true,
                width: '100%'
              },
              {
                id: `field_message_${Date.now()}`,
                type: 'textarea',
                label: 'Message',
                placeholder: 'Your message here...',
                required: true,
                width: '100%'
              }
            ],
            settings: {
              title: title,
              showTitle: true,
              titleColor: '#f3f4f6',
              titleSize: '1.45rem',
              titleAlign: 'left',
              description: 'Please fill out this form.',
              showDescription: true,
              descriptionColor: '#9ca3af',
              descriptionSize: '0.9rem',
              submitButton: {
                text: 'Submit Form',
                align: 'left',
                bgColor: '#2563eb',
                textColor: '#ffffff',
                borderRadius: '8px',
                size: 'md'
              },
              googleSheets: {
                enabled: true,
                sheetUrl: '',
                tabName: 'Sheet1',
                webhookUrl: ''
              },
              spamProtection: {
                method: 'method2',
                honeypotEnabled: true,
                minSubmissionSeconds: 2
              },
              confirmation: {
                type: 'message',
                message: 'Thank you! Your submission has been received.'
              },
              styling: {
                theme: 'modern-dark',
                formBgColor: '#0f131d',
                formBgImage: '',
                formBgSize: 'cover',
                formBgPosition: 'center',
                formBgRepeat: 'no-repeat',
                formBgOverlay: '',
                formBorderWidth: '1px',
                formBorderStyle: 'solid',
                formBorderColor: '#28334a',
                formBorderRadius: '14px',
                formPadding: '32px',
                formBoxShadow: '0 10px 25px -5px rgba(0, 0, 0, 0.3)',
                labelColor: '#f3f4f6',
                inputBg: '#111827',
                inputBorder: '#374151',
                inputTextColor: '#ffffff',
                borderRadius: '8px'
              }
            }
          };

          formsList.push(newForm);
          activeForm = newForm;
          selectedFieldId = null;
          renderFormSelector();
          renderCanvas();
          syncFormSettingsUI();
          updateFieldInspector();
          showToast(`Created "${title}"`);
        });

        // Duplicate Form Action
        btnDuplicateForm.addEventListener('click', async () => {
          if (!confirm(`Duplicate "${activeForm.name}"?`)) return;
          try {
            const resp = await fetch('/api/forms', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'duplicate', id: activeForm.id })
            });
            const data = await resp.json();
            if (data.newForm) {
              formsList.push(data.newForm);
              activeForm = data.newForm;
              selectedFieldId = null;
              renderFormSelector();
              renderCanvas();
              syncFormSettingsUI();
              updateFieldInspector();
              showToast('Form duplicated successfully!');
            }
          } catch (e) {
            console.error(e);
          }
        });

        // Delete Form Action
        btnDeleteForm.addEventListener('click', async () => {
          if (formsList.length <= 1) {
            alert('Cannot delete the only existing form.');
            return;
          }
          if (!confirm(`Are you sure you want to delete "${activeForm.name}"?`)) return;

          try {
            const resp = await fetch(`/api/forms?id=${activeForm.id}`, { method: 'DELETE' });
            if (resp.ok) {
              formsList = formsList.filter(f => f.id !== activeForm.id);
              activeForm = formsList[0];
              selectedFieldId = null;
              renderFormSelector();
              renderCanvas();
              syncFormSettingsUI();
              updateFieldInspector();
              showToast('Form deleted');
            }
          } catch (e) {
            console.error(e);
          }
        });

        // Google Sheets Guide Modal
        const modal = document.getElementById('googleSheetsDocsModal');
        const openModal = () => modal.classList.add('active');
        const closeModal = () => modal.classList.remove('active');

        document.getElementById('btnOpenDocsModal')?.addEventListener('click', openModal);
        document.getElementById('btnOpenDocsModal2')?.addEventListener('click', openModal);
        document.getElementById('btnCloseDocsModal')?.addEventListener('click', closeModal);
        document.getElementById('btnCloseDocsModal2')?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        document.getElementById('btnCopyScriptCode')?.addEventListener('click', () => {
          const code = document.getElementById('scriptSnippetCode').innerText;
          navigator.clipboard.writeText(code).then(() => {
            showToast('Apps Script code copied to clipboard!');
          });
        });

        // Submissions & Google Sheets Status Modal
        const subModal = document.getElementById('submissionsModal');
        const subContainer = document.getElementById('submissionsListContainer');
        const subSubtitle = document.getElementById('submissionsModalSubtitle');

        function renderSubmissionCard(sub) {
          const card = document.createElement('div');
          card.style.cssText = 'background:#0b0f19;border:1px solid #232a3b;border-radius:8px;padding:12px;';

          const header = document.createElement('div');
          header.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px;';

          const timeEl = document.createElement('span');
          timeEl.style.cssText = 'font-size:0.75rem;color:#9ca3af;font-family:monospace;';
          timeEl.textContent = new Date(sub.submittedAt).toLocaleString();
          header.appendChild(timeEl);

          const statusWrap = document.createElement('div');
          statusWrap.style.cssText = 'display:flex;align-items:center;gap:8px;flex-wrap:wrap;';

          const badge = document.createElement('span');
          const ok = sub.forwardedToGoogleSheets === true;
          badge.style.cssText = ok
            ? 'font-size:0.72rem;font-weight:600;padding:2px 8px;border-radius:999px;background:#064e3b;color:#6ee7b7;border:1px solid #059669;'
            : 'font-size:0.72rem;font-weight:600;padding:2px 8px;border-radius:999px;background:#451a1a;color:#fca5a5;border:1px solid #b91c1c;';
          badge.textContent = (ok ? '✅ Sheets: ' : '⚠️ Sheets: ') + (sub.googleSheetsStatus || 'Unknown');
          statusWrap.appendChild(badge);

          if (typeof sub.googleSheetTargetUrl === 'string' && sub.googleSheetTargetUrl.startsWith('https://')) {
            const link = document.createElement('a');
            link.href = sub.googleSheetTargetUrl;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.style.cssText = 'font-size:0.72rem;color:#60a5fa;text-decoration:underline;';
            link.textContent = 'Open Sheet ↗';
            statusWrap.appendChild(link);
          }

          header.appendChild(statusWrap);
          card.appendChild(header);

          const grid = document.createElement('div');
          grid.style.cssText = 'display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px 12px;border-top:1px solid #1a2133;padding-top:8px;';
          Object.entries(sub.fields || {}).forEach(([k, v]) => {
            const row = document.createElement('div');
            row.style.cssText = 'font-size:0.78rem;line-height:1.4;word-break:break-word;';
            const lbl = document.createElement('span');
            lbl.style.cssText = 'color:#9ca3af;margin-right:4px;';
            lbl.textContent = k + ':';
            const val = document.createElement('span');
            val.style.cssText = 'color:#f3f4f6;font-weight:500;';
            val.textContent = String(v ?? '');
            row.appendChild(lbl);
            row.appendChild(val);
            grid.appendChild(row);
          });
          card.appendChild(grid);
          return card;
        }

        async function loadSubmissionsList() {
          if (!activeForm || !subContainer) return;
          subSubtitle.textContent = `Form: ${activeForm.name} (${activeForm.id}) • Saved locally in src/data/form-submissions.json`;
          subContainer.innerHTML = '<div style="text-align:center;color:#9ca3af;font-size:0.82rem;padding:24px;">Loading submissions...</div>';
          try {
            const resp = await fetch(`/api/forms/submit?formId=${encodeURIComponent(activeForm.id)}`);
            const data = await resp.json();
            const list = Array.isArray(data.submissions) ? data.submissions : [];
            subContainer.innerHTML = '';
            if (list.length === 0) {
              const empty = document.createElement('div');
              empty.style.cssText = 'text-align:center;color:#9ca3af;font-size:0.82rem;padding:24px;';
              empty.textContent = 'No submissions recorded yet for this form.';
              subContainer.appendChild(empty);
              return;
            }
            list.forEach((sub) => subContainer.appendChild(renderSubmissionCard(sub)));
          } catch (err) {
            subContainer.innerHTML = '';
            const errEl = document.createElement('div');
            errEl.style.cssText = 'text-align:center;color:#f87171;font-size:0.82rem;padding:24px;';
            errEl.textContent = 'Failed to load submissions: ' + (err.message || err);
            subContainer.appendChild(errEl);
          }
        }

        document.getElementById('btnOpenSubmissionsModal')?.addEventListener('click', () => {
          subModal.classList.add('active');
          loadSubmissionsList();
        });
        document.getElementById('btnRefreshSubmissions')?.addEventListener('click', loadSubmissionsList);
        document.getElementById('btnCloseSubmissionsModal')?.addEventListener('click', () => subModal.classList.remove('active'));
        subModal?.addEventListener('click', (e) => {
          if (e.target === subModal) subModal.classList.remove('active');
        });

        // Initialize UI
        renderFormSelector();
        renderCanvas();
        syncFormSettingsUI();
        updateFieldInspector();
      })();
    </script>
  </body>
</html>
