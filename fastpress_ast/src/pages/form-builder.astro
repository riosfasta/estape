    <script is:inline>
      (function() {
        // State variables
        let formsList = [];
        try {
          formsList = JSON.parse(document.getElementById('initialFormsData').textContent || '[]');
        } catch (e) {
          formsList = [];
        }

        let activeFormId = 'form-contact-default';
        try {
          activeFormId = JSON.parse(document.getElementById('activeFormIdData').textContent || '"form-contact-default"');
        } catch (e) {}

        let activeForm = formsList.find(f => f.id === activeFormId) || formsList[0];
        let selectedFieldId = null;

        // DOM elements
        const formSelectDropdown = document.getElementById('formSelectDropdown');
        const btnNewForm = document.getElementById('btnNewForm');
        const btnDuplicateForm = document.getElementById('btnDuplicateForm');
        const btnDeleteForm = document.getElementById('btnDeleteForm');
        const btnSaveForm = document.getElementById('btnSaveForm');
        const canvasFieldsGrid = document.getElementById('canvasFieldsGrid');
        const deviceFrame = document.getElementById('deviceFrame');
        const toastNotice = document.getElementById('toastNotice');
        const toastMessage = document.getElementById('toastMessage');

        // Studio Menu Toggle
        const btnStudioSwitcher = document.getElementById('btnStudioSwitcher');
        const studioMenuFlyout = document.getElementById('studioMenuFlyout');
        btnStudioSwitcher?.addEventListener('click', (e) => {
          e.stopPropagation();
          studioMenuFlyout.classList.toggle('active');
        });
        document.addEventListener('click', () => {
          studioMenuFlyout?.classList.remove('active');
        });

        // Toast Helper
        function showToast(msg, icon = '✅') {
          toastMessage.textContent = msg;
          document.getElementById('toastIcon').textContent = icon;
          toastNotice.classList.add('show');
          setTimeout(() => {
            toastNotice.classList.remove('show');
          }, 3000);
        }

        // Viewport Switcher
        document.querySelectorAll('.viewport-btn[data-vp]').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.viewport-btn[data-vp]').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const vp = btn.getAttribute('data-vp');
            deviceFrame.className = 'canvas-device-frame ' + (vp !== 'desktop' ? vp : '');
            renderCanvas();
          });
        });

        // Mode Switcher (Edit vs Test Mode)
        let canvasMode = 'edit';
        const btnModeEdit = document.getElementById('btnModeEdit');
        const btnModeTest = document.getElementById('btnModeTest');

        btnModeEdit?.addEventListener('click', () => {
          canvasMode = 'edit';
          btnModeEdit.classList.add('active');
          btnModeTest.classList.remove('active');
          document.getElementById('btnCanvasDropzone').style.display = 'block';
          renderCanvas();
        });

        btnModeTest?.addEventListener('click', () => {
          canvasMode = 'test';
          btnModeTest.classList.add('active');
          btnModeEdit.classList.remove('active');
          selectedFieldId = null;
          document.getElementById('btnCanvasDropzone').style.display = 'none';
          renderCanvas();
          evaluateCanvasConditionalLogic();
          showToast('Interactive Test Mode: Try changing inputs to test conditional logic!', '👁️');
        });

        // Tab Navigation
        document.querySelectorAll('.sidebar-tab-btn').forEach(tabBtn => {
          tabBtn.addEventListener('click', () => {
            document.querySelectorAll('.sidebar-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.sidebar-tab-content').forEach(c => c.classList.remove('active'));
            tabBtn.classList.add('active');
            const targetId = tabBtn.getAttribute('data-tab');
            document.getElementById(targetId)?.classList.add('active');
          });
        });

        function switchSidebarTab(tabId) {
          const btn = document.querySelector(`.sidebar-tab-btn[data-tab="${tabId}"]`);
          if (btn) btn.click();
        }

        // Populate Forms Selector
        function renderFormSelector() {
          formSelectDropdown.innerHTML = '';
          formsList.forEach(f => {
            const opt = document.createElement('option');
            opt.value = f.id;
            opt.textContent = f.name;
            if (f.id === activeForm.id) opt.selected = true;
            formSelectDropdown.appendChild(opt);
          });
        }

        formSelectDropdown.addEventListener('change', () => {
          const selected = formsList.find(f => f.id === formSelectDropdown.value);
          if (selected) {
            activeForm = selected;
            selectedFieldId = null;
            renderCanvas();
            syncFormSettingsUI();
            updateFieldInspector();
          }
        });

        // Canvas Rendering
        function renderCanvas() {
          if (!activeForm) return;

          // Apply Form Container Background & Border styling to deviceFrame
          const st = activeForm.settings.styling || {};
          const isDark = st.theme !== 'clean-light';

          const formBgColor = st.formBgColor || (isDark ? '#0f131d' : '#ffffff');
          const formBgImage = st.formBgImage?.trim() || '';
          const formBgSize = st.formBgSize || 'cover';
          const formBgPos = st.formBgPosition || 'center';
          const formBgRepeat = st.formBgRepeat || 'no-repeat';
          const formBgOverlay = st.formBgOverlay || '';

          const formBorderWidth = st.formBorderWidth !== undefined ? st.formBorderWidth : '1px';
          const formBorderStyle = st.formBorderStyle || 'solid';
          const formBorderColor = st.formBorderColor || (isDark ? '#28334a' : '#d1d5db');
          const formBorderRadius = st.formBorderRadius || '14px';
          const formBoxShadow = st.formBoxShadow !== undefined ? st.formBoxShadow : '0 10px 25px -5px rgba(0, 0, 0, 0.3)';
          const formPadding = st.formPadding || '32px';

          deviceFrame.style.backgroundColor = formBgColor;
          if (formBgImage) {
            if (formBgOverlay) {
              deviceFrame.style.backgroundImage = `linear-gradient(${formBgOverlay}, ${formBgOverlay}), url("${formBgImage}")`;
            } else {
              deviceFrame.style.backgroundImage = `url("${formBgImage}")`;
            }
            deviceFrame.style.backgroundSize = formBgSize;
            deviceFrame.style.backgroundPosition = formBgPos;
            deviceFrame.style.backgroundRepeat = formBgRepeat;
          } else {
            deviceFrame.style.backgroundImage = 'none';
          }

          deviceFrame.style.border = `${formBorderWidth} ${formBorderStyle} ${formBorderColor}`;
          deviceFrame.style.borderRadius = formBorderRadius;
          deviceFrame.style.boxShadow = formBoxShadow;
          if (!deviceFrame.classList.contains('mobile')) {
            deviceFrame.style.padding = formPadding;
          } else {
            deviceFrame.style.padding = '20px 16px';
          }

          // Header (Title & Subtitle / Description)
          const headerContainer = document.getElementById('canvasFormHeader');
          const titleEl = document.getElementById('canvasFormTitle');
          const descEl = document.getElementById('canvasFormDesc');

          const showTitle = activeForm.settings.showTitle !== false;
          const showDesc = activeForm.settings.showDescription !== false;
          const titleColor = activeForm.settings.titleColor || (isDark ? '#f3f4f6' : '#111827');
          const titleSize = activeForm.settings.titleSize || '1.45rem';
          const descColor = activeForm.settings.descriptionColor || (isDark ? '#9ca3af' : '#4b5563');
          const descSize = activeForm.settings.descriptionSize || '0.9rem';
          const titleAlign = activeForm.settings.titleAlign || 'left';

          if (headerContainer) {
            headerContainer.style.textAlign = titleAlign;
            if ((!showTitle || !activeForm.settings.title) && (!showDesc || !activeForm.settings.description)) {
              headerContainer.style.display = 'none';
            } else {
              headerContainer.style.display = 'block';
              headerContainer.style.marginBottom = '20px';
            }
          }

          if (showTitle && (activeForm.settings.title || activeForm.name)) {
            titleEl.textContent = activeForm.settings.title || activeForm.name;
            titleEl.style.color = titleColor;
            titleEl.style.fontSize = titleSize;
            titleEl.style.display = 'block';
          } else {
            titleEl.style.display = 'none';
          }

          if (showDesc && activeForm.settings.description) {
            descEl.textContent = activeForm.settings.description;
            descEl.style.color = descColor;
            descEl.style.fontSize = descSize;
            descEl.style.display = 'block';
          } else {
            descEl.style.display = 'none';
          }

          // Submit button
          const submitBtn = document.getElementById('canvasSubmitBtn');
          submitBtn.textContent = activeForm.settings.submitButton.text || 'Submit Form';
          submitBtn.style.background = activeForm.settings.submitButton.bgColor || '#ff5e3a';
          submitBtn.style.color = activeForm.settings.submitButton.textColor || '#ffffff';
          submitBtn.style.borderRadius = activeForm.settings.submitButton.borderRadius || '8px';
          const align = activeForm.settings.submitButton.align || 'left';
          const actionRow = document.getElementById('canvasSubmitActionRow');
          if (align === 'center') actionRow.style.justifyContent = 'center';
          else if (align === 'right') actionRow.style.justifyContent = 'flex-end';
          else actionRow.style.justifyContent = 'flex-start';
          if (align === 'full') submitBtn.style.width = '100%';
          else submitBtn.style.width = 'auto';

          // Fields
          canvasFieldsGrid.innerHTML = '';
          const labelColor = activeForm.settings.styling?.labelColor || (isDark ? '#e5e7eb' : '#1f2937');
          const inputBg = activeForm.settings.styling?.inputBg || (isDark ? '#111827' : '#ffffff');
          const inputBorder = activeForm.settings.styling?.inputBorder || (isDark ? '#374151' : '#d1d5db');
          const inputTextColor = activeForm.settings.styling?.inputTextColor || (isDark ? '#f9fafb' : '#111827');
          const radius = activeForm.settings.styling?.borderRadius || '8px';
          const baseInputStyle = `width: 100%; box-sizing: border-box; background: ${inputBg}; border: 1px solid ${inputBorder}; color: ${inputTextColor}; border-radius: ${radius}; padding: 9px 12px; font-size: 0.9rem; outline: none;`;

          activeForm.fields.forEach((field, index) => {
            const currentWidth = field.width || '100%';
            const row = document.createElement('div');
            row.className = `canvas-field-row ${field.id === selectedFieldId ? 'active' : ''}`;
            row.style.width = currentWidth;
            row.setAttribute('data-field-id', field.id);
            row.setAttribute('data-width', currentWidth);

            // Floating action bar
            const actionBar = document.createElement('div');
            actionBar.className = 'field-actions-bar';

            let widthBadgeText = '100% Full';
            if (currentWidth === '50%') widthBadgeText = '50% Half';
            else if (currentWidth === '33.33%') widthBadgeText = '33% 1/3';
            else if (currentWidth === '25%') widthBadgeText = '25% 1/4';
            else if (currentWidth === '66.66%') widthBadgeText = '66% 2/3';
            else if (currentWidth === '75%') widthBadgeText = '75% 3/4';

            actionBar.innerHTML = `
              <button type="button" class="field-act-btn width-btn" data-act="toggle-width" title="Click to cycle width: 100% Full ⮂ 50% Side-by-side ⮂ 33% 1/3">
                ↔️ ${widthBadgeText}
              </button>
              <button type="button" class="field-act-btn" data-act="up" title="Move Up">▲</button>
              <button type="button" class="field-act-btn" data-act="down" title="Move Down">▼</button>
              <button type="button" class="field-act-btn" data-act="duplicate" title="Duplicate Field">📋</button>
              <button type="button" class="field-act-btn del" data-act="delete" title="Delete Field">🗑️</button>
            `;
            row.appendChild(actionBar);

            // Interactive Drag-to-Resize Handle on the right edge
            if (canvasMode !== 'test') {
              const resizeHandle = document.createElement('div');
              resizeHandle.className = 'field-resize-handle';
              resizeHandle.title = 'Drag to resize width (or click to toggle 100% Full / 50% Side-by-Side)';
              resizeHandle.innerHTML = '<div class="resize-handle-bar"></div>';
              setupResizeHandle(resizeHandle, row, field);
              row.appendChild(resizeHandle);
            }

            const inner = document.createElement('div');
            inner.className = 'canvas-field-inner';

            // Conditional Logic indicator badge
            const condBadge = field.conditionalLogic?.enabled
              ? `<span style="font-size:0.62rem; font-weight:800; background:#3b82f6; color:#fff; padding:1px 5px; border-radius:3px; margin-left:6px;">CONDITIONAL</span>`
              : '';

            const reqMark = field.required ? '<span style="color:#ef4444; margin-left:3px;">*</span>' : '';
            const desc = field.description ? `<div style="font-size:0.75rem; color:#9ca3af; margin-top:4px;">${field.description}</div>` : '';

            const escHtml = (s) => String(s ?? '')
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
            let controlHtml = '';
            switch (field.type) {
              case 'textarea':
                controlHtml = `<textarea placeholder="${escHtml(field.placeholder || '')}" rows="3" style="${baseInputStyle} resize:vertical;">${escHtml(field.defaultValue || '')}</textarea>`;
                break;
              case 'select':
                const opts = (field.options || []).map(o => `<option value="${escHtml(o.value || o.label)}">${escHtml(o.label)}</option>`).join('');
                controlHtml = `<select style="${baseInputStyle}"><option value="">${escHtml(field.placeholder || '-- Select --')}</option>${opts}</select>`;
                break;
              case 'radio':
                controlHtml = `<div style="display:flex; flex-direction:column; gap:6px; margin-top:4px;">` +
                  (field.options || []).map(o => `<label style="display:flex; align-items:center; gap:8px; font-size:0.88rem; color:${labelColor};"><input type="radio" name="${field.id}" value="${escHtml(o.value || o.label)}"> ${escHtml(o.label)}</label>`).join('') +
                  `</div>`;
                break;
              case 'checkbox':
                controlHtml = `<div style="display:flex; flex-direction:column; gap:6px; margin-top:4px;">` +
                  (field.options || []).map(o => `<label style="display:flex; align-items:center; gap:8px; font-size:0.88rem; color:${labelColor};"><input type="checkbox" value="${escHtml(o.value || o.label)}"> ${escHtml(o.label)}</label>`).join('') +
                  `</div>`;
                break;
              case 'section':
                controlHtml = `<div style="border-bottom:1px solid ${inputBorder}; padding-bottom:6px;"><h4 style="margin:0; font-size:1.05rem; font-weight:700; color:${labelColor};">${field.label}</h4>${desc}</div>`;
                break;
              case 'html':
                controlHtml = `<div>${field.content || '<div style="font-size:0.85rem; color:#9ca3af;">Custom HTML Content Block</div>'}</div>`;
                break;
              default:
                controlHtml = `<input type="${field.type === 'phone' ? 'tel' : field.type}" placeholder="${field.placeholder || ''}" value="${field.defaultValue || ''}" style="${baseInputStyle}" />`;
                break;
            }

            if (field.type !== 'section') {
              inner.innerHTML = `
                <label style="display:block; font-size:0.85rem; font-weight:700; color:${labelColor}; margin-bottom:5px;">
                  ${field.label}${reqMark}${condBadge}
                </label>
                ${controlHtml}
                ${desc}
              `;
            } else {
              inner.innerHTML = controlHtml;
            }

            if (canvasMode === 'test') {
              actionBar.style.display = 'none';
              inner.querySelectorAll('input, select, textarea').forEach(inp => {
                inp.addEventListener('input', evaluateCanvasConditionalLogic);
                inp.addEventListener('change', evaluateCanvasConditionalLogic);
              });
            } else {
              // Click row to inspect in Edit Mode
              inner.addEventListener('click', (e) => {
                e.stopPropagation();
                selectedFieldId = field.id;
                renderCanvas();
                updateFieldInspector();
                switchSidebarTab('tab-field-settings');
              });

              // Action bar clicks
              actionBar.addEventListener('click', (e) => {
                e.stopPropagation();
                const btn = e.target.closest('.field-act-btn');
                if (!btn) return;
                const act = btn.getAttribute('data-act');
                if (act === 'toggle-width') {
                  const w = field.width || '100%';
                  let nextW = '50%';
                  if (w === '100%') nextW = '50%';
                  else if (w === '50%') nextW = '33.33%';
                  else if (w === '33.33%') nextW = '25%';
                  else nextW = '100%';
                  field.width = nextW;
                  renderCanvas();
                  updateFieldInspector();
                  showToast(`Field width: ${nextW === '50%' ? '50% (Side-by-side)' : nextW}`);
                  return;
                } else if (act === 'up' && index > 0) {
                  const temp = activeForm.fields[index];
                  activeForm.fields[index] = activeForm.fields[index - 1];
                  activeForm.fields[index - 1] = temp;
                  renderCanvas();
                } else if (act === 'down' && index < activeForm.fields.length - 1) {
                  const temp = activeForm.fields[index];
                  activeForm.fields[index] = activeForm.fields[index + 1];
                  activeForm.fields[index + 1] = temp;
                  renderCanvas();
                } else if (act === 'duplicate') {
                  const dup = JSON.parse(JSON.stringify(field));
                  dup.id = `field_${Date.now()}`;
                  dup.label = `${field.label} (Copy)`;
                  activeForm.fields.splice(index + 1, 0, dup);
                  selectedFieldId = dup.id;
                  renderCanvas();
                  updateFieldInspector();
                } else if (act === 'delete') {
                  if (confirm(`Delete "${field.label}"?`)) {
                    activeForm.fields.splice(index, 1);
                    if (selectedFieldId === field.id) selectedFieldId = null;
                    renderCanvas();
                    updateFieldInspector();
                  }
                }
              });
            }

            row.appendChild(inner);
            canvasFieldsGrid.appendChild(row);
          });
        }

        // Interactive Drag-to-Resize Handle Handler
        function setupResizeHandle(handle, rowEl, field) {
          let isDragging = false;
          let startX = 0;
          let initialWidthPx = 0;
          let containerWidthPx = 0;
          let snappedWidth = field.width || '100%';
          const tooltip = document.getElementById('resizeTooltip');

          handle.addEventListener('click', (e) => {
            e.stopPropagation();
            if (isDragging) return;
            // Quick toggle between 100% and 50%
            field.width = (field.width === '50%') ? '100%' : '50%';
            renderCanvas();
            updateFieldInspector();
            showToast(`Field width: ${field.width === '50%' ? '50% (Side by side)' : '100% (Full width)'}`);
          });

          handle.addEventListener('mousedown', (e) => {
            e.preventDefault();
            e.stopPropagation();
            isDragging = true;
            handle.classList.add('resizing');
            startX = e.clientX;
            initialWidthPx = rowEl.getBoundingClientRect().width;
            containerWidthPx = canvasFieldsGrid.getBoundingClientRect().width;

            if (tooltip) {
              tooltip.style.display = 'block';
              tooltip.textContent = `↔️ ${field.width || '100%'}`;
              tooltip.style.left = (e.clientX + 15) + 'px';
              tooltip.style.top = (e.clientY - 30) + 'px';
            }

            function onMouseMove(moveEvent) {
              if (!isDragging) return;
              const deltaX = moveEvent.clientX - startX;
              const newWidthPx = Math.max(80, Math.min(containerWidthPx, initialWidthPx + deltaX));
              const pct = (newWidthPx / containerWidthPx) * 100;

              let label = '100% Full Width';
              if (pct < 29) {
                snappedWidth = '25%';
                label = '25% (4 Columns)';
              } else if (pct < 41) {
                snappedWidth = '33.33%';
                label = '33% (3 Columns)';
              } else if (pct < 58) {
                snappedWidth = '50%';
                label = '50% (Side by Side)';
              } else if (pct < 71) {
                snappedWidth = '66.66%';
                label = '66% (2/3 Width)';
              } else if (pct < 87) {
                snappedWidth = '75%';
                label = '75% (3/4 Width)';
              } else {
                snappedWidth = '100%';
                label = '100% (Full Width)';
              }

              rowEl.style.width = snappedWidth;
              if (tooltip) {
                tooltip.textContent = `↔️ ${label}`;
                tooltip.style.left = (moveEvent.clientX + 15) + 'px';
                tooltip.style.top = (moveEvent.clientY - 30) + 'px';
              }
            }

            function onMouseUp() {
              if (!isDragging) return;
              isDragging = false;
              handle.classList.remove('resizing');
              if (tooltip) tooltip.style.display = 'none';
              document.removeEventListener('mousemove', onMouseMove);
              document.removeEventListener('mouseup', onMouseUp);

              field.width = snappedWidth;
              renderCanvas();
              updateFieldInspector();
              showToast(`Field resized to ${snappedWidth}`);
            }

            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
          });
        }

        // Live conditional logic evaluator for Interactive Test Mode
        function evaluateCanvasConditionalLogic() {
          if (canvasMode !== 'test') return;
          activeForm.fields.forEach(field => {
            const row = canvasFieldsGrid.querySelector(`[data-field-id="${field.id}"]`);
            if (!row) return;

            if (!field.conditionalLogic || !field.conditionalLogic.enabled || !field.conditionalLogic.rules.length) {
              row.style.display = 'block';
              return;
            }

            const action = field.conditionalLogic.action || 'show';
            const logicType = field.conditionalLogic.logicType || 'all';
            let passedCount = 0;

            field.conditionalLogic.rules.forEach(rule => {
              const targetInput = canvasFieldsGrid.querySelector(`[name="${rule.fieldId}"], [name="${rule.fieldId}[]"]`);
              let currentVal = '';
              if (targetInput) {
                if (targetInput.type === 'radio') {
                  const checked = canvasFieldsGrid.querySelector(`[name="${rule.fieldId}"]:checked`);
                  currentVal = checked ? checked.value : '';
                } else if (targetInput.type === 'checkbox') {
                  const checkedBoxes = Array.from(canvasFieldsGrid.querySelectorAll(`[name="${rule.fieldId}[]"]:checked`)).map(cb => cb.value);
                  currentVal = checkedBoxes.join(',');
                } else {
                  currentVal = targetInput.value || '';
                }
              }

              const targetVal = (rule.value || '').trim().toLowerCase();
              const val = (currentVal || '').trim().toLowerCase();
              let ruleMet = false;
              switch (rule.operator) {
                case 'is': ruleMet = val === targetVal; break;
                case 'is_not': ruleMet = val !== targetVal; break;
                case 'contains': ruleMet = val.includes(targetVal); break;
                case 'not_contains': ruleMet = !val.includes(targetVal); break;
                case 'greater_than': ruleMet = parseFloat(val) > parseFloat(targetVal); break;
                case 'less_than': ruleMet = parseFloat(val) < parseFloat(targetVal); break;
                case 'is_empty': ruleMet = val === ''; break;
                case 'is_not_empty': ruleMet = val !== ''; break;
                default: ruleMet = val === targetVal;
              }
              if (ruleMet) passedCount++;
            });

            const rulesMatch = logicType === 'all'
              ? (passedCount === field.conditionalLogic.rules.length)
              : (passedCount > 0);

            const shouldShow = action === 'show' ? rulesMatch : !rulesMatch;
            row.style.display = shouldShow ? 'block' : 'none';
          });
        }

        document.getElementById('canvasSubmitBtn')?.addEventListener('click', () => {
          if (canvasMode === 'test') {
            showToast(activeForm.settings.confirmation.message || 'Form submitted successfully! (Test Mode)', '🎉');
          } else {
            switchSidebarTab('tab-form-settings');
          }
        });

        // Add Field Click Handlers
        document.querySelectorAll('.palette-field-card').forEach(card => {
          card.addEventListener('click', () => {
            const type = card.getAttribute('data-add-type');
            addNewField(type);
          });
        });

        document.getElementById('btnCanvasDropzone')?.addEventListener('click', () => {
          switchSidebarTab('tab-add-fields');
        });

        function addNewField(type) {
          if (!activeForm) return;
          const timestamp = Date.now();

          let newField = {
            id: `field_${timestamp}`,
            type: type,
            label: 'Untitled Field',
            placeholder: '',
            required: false,
            width: '100%',
            description: ''
          };

          if (type === 'name') {
            // Add First & Last Name side-by-side
            const f1 = {
              id: `field_fn_${timestamp}`,
              type: 'text',
              label: 'First Name',
              placeholder: 'Jane',
              required: true,
              width: '50%'
            };
            const f2 = {
              id: `field_ln_${timestamp}`,
              type: 'text',
              label: 'Last Name',
              placeholder: 'Smith',
              required: true,
              width: '50%'
            };
            activeForm.fields.push(f1, f2);
            selectedFieldId = f1.id;
            renderCanvas();
            updateFieldInspector();
            switchSidebarTab('tab-field-settings');
            showToast('Added First & Last Name fields');
            return;
          } else if (type === 'email') {
            newField.label = 'Email Address';
            newField.placeholder = 'you@example.com';
            newField.required = true;
          } else if (type === 'phone') {
            newField.label = 'Phone Number';
            newField.placeholder = '+1 (555) 000-0000';
          } else if (type === 'textarea') {
            newField.label = 'Message / Description';
            newField.placeholder = 'Enter details here...';
          } else if (type === 'select') {
            newField.label = 'Choose an Option';
            newField.options = [
              { label: 'Option 1', value: 'Option 1', isDefault: true },
              { label: 'Option 2', value: 'Option 2' },
              { label: 'Option 3', value: 'Option 3' }
            ];
          } else if (type === 'radio') {
            newField.label = 'Select One';
            newField.options = [
              { label: 'Choice A', value: 'Choice A', isDefault: true },
              { label: 'Choice B', value: 'Choice B' }
            ];
          } else if (type === 'checkbox') {
            newField.label = 'Select Options';
            newField.options = [
              { label: 'Option A', value: 'Option A' },
              { label: 'Option B', value: 'Option B' }
            ];
          } else if (type === 'date') {
            newField.label = 'Preferred Date';
          } else if (type === 'time') {
            newField.label = 'Preferred Time';
          } else if (type === 'url') {
            newField.label = 'Website';
            newField.placeholder = 'https://example.com';
          } else if (type === 'section') {
            newField.label = 'Section Title';
            newField.description = 'Provide a brief explanation of this group of fields.';
          } else if (type === 'html') {
            newField.label = 'Custom HTML Block';
            newField.content = '<p style="color:#9ca3af; font-size:0.85rem;">Custom notice or disclaimer text goes here.</p>';
          } else {
            newField.label = 'Single Line Text';
            newField.placeholder = 'Enter text...';
          }

          activeForm.fields.push(newField);
          selectedFieldId = newField.id;
          renderCanvas();
          updateFieldInspector();
          switchSidebarTab('tab-field-settings');
          showToast(`Added ${newField.label}`);
        }

        // Field Inspector UI Sync
        function updateFieldInspector() {
          const noField = document.getElementById('noFieldSelectedNotice');
          const inspector = document.getElementById('fieldInspectorForm');

          if (!selectedFieldId) {
            noField.style.display = 'block';
            inspector.style.display = 'none';
            return;
          }

          const field = activeForm.fields.find(f => f.id === selectedFieldId);
          if (!field) {
            noField.style.display = 'block';
            inspector.style.display = 'none';
            return;
          }

          noField.style.display = 'none';
          inspector.style.display = 'block';

          document.getElementById('inspectorFieldTypeBadge').textContent = field.type;
          document.getElementById('inspectorFieldId').textContent = field.id;
          document.getElementById('settingFieldLabel').value = field.label || '';
          document.getElementById('settingFieldPlaceholder').value = field.placeholder || '';
          document.getElementById('settingFieldDesc').value = field.description || '';
          const curWidth = field.width || '100%';
          document.getElementById('settingFieldWidth').value = curWidth;
          const widthLabels = {
            '100%': '100% Full Width',
            '50%': '50% Half (Side by Side)',
            '33.33%': '33% 1/3 (3 Columns)',
            '25%': '25% 1/4 (4 Columns)',
            '66.66%': '66% 2/3 Width',
            '75%': '75% 3/4 Width'
          };
          const curLabelEl = document.getElementById('currentWidthLabel');
          if (curLabelEl) {
            curLabelEl.textContent = widthLabels[curWidth] || `${curWidth} Width`;
          }
          document.querySelectorAll('.width-seg-btn').forEach(btn => {
            const btnW = btn.getAttribute('data-width');
            btn.classList.toggle('active', btnW === curWidth);
          });
          document.getElementById('settingFieldRequired').checked = !!field.required;

          // Placeholder visibility
          const phGroup = document.getElementById('settingPlaceholderGroup');
          phGroup.style.display = (field.type === 'section' || field.type === 'radio' || field.type === 'checkbox' || field.type === 'html') ? 'none' : 'block';

          // Options Manager
          const optSec = document.getElementById('optionsManagerSection');
          if (field.type === 'select' || field.type === 'radio' || field.type === 'checkbox') {
            optSec.style.display = 'block';
            renderOptionsList(field);
          } else {
            optSec.style.display = 'none';
          }

          // HTML / Content
          const contentSec = document.getElementById('contentEditorSection');
          if (field.type === 'html') {
            contentSec.style.display = 'block';
            document.getElementById('settingFieldContent').value = field.content || '';
          } else {
            contentSec.style.display = 'none';
          }

          // Conditional Logic
          const condEnabled = document.getElementById('settingCondEnabled');
          const condWrap = document.getElementById('conditionalConfigWrap');
          const hasCond = field.conditionalLogic && field.conditionalLogic.enabled;
          condEnabled.checked = !!hasCond;
          condWrap.style.display = hasCond ? 'block' : 'none';

          if (hasCond) {
            document.getElementById('settingCondAction').value = field.conditionalLogic.action || 'show';
            document.getElementById('settingCondLogicType').value = field.conditionalLogic.logicType || 'all';
            renderConditionalRules(field);
          }
        }

