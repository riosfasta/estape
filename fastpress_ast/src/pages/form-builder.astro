        // Options List Rendering
        function renderOptionsList(field) {
          const list = document.getElementById('optionsListContainer');
          const customChk = document.getElementById('settingOptionCustomValues');
          const hasDistinctValues = (field.options || []).some(o => o.value && o.value !== o.label);
          const showCustomValues = field.showValues !== undefined ? Boolean(field.showValues) : hasDistinctValues;
          if (customChk) customChk.checked = showCustomValues;

          list.innerHTML = '';
          (field.options || []).forEach((opt, idx) => {
            const row = document.createElement('div');
            row.style.cssText = 'display:flex; align-items:center; gap:6px;';

            const lblInput = document.createElement('input');
            lblInput.type = 'text';
            lblInput.className = 'control-input opt-lbl';
            lblInput.value = opt.label || '';
            lblInput.placeholder = showCustomValues ? 'Label' : 'Option value';
            lblInput.style.cssText = 'flex:1; padding:6px 8px; font-size:0.8rem;';

            let valInput = null;
            if (showCustomValues) {
              valInput = document.createElement('input');
              valInput.type = 'text';
              valInput.className = 'control-input opt-val';
              valInput.value = opt.value || opt.label || '';
              valInput.placeholder = 'Submit Value';
              valInput.style.cssText = 'width:105px; padding:6px 8px; font-size:0.8rem;';
              valInput.addEventListener('input', (e) => {
                opt.value = e.target.value;
                renderCanvas();
              });
            }

            lblInput.addEventListener('input', (e) => {
              const prevLabel = opt.label;
              const nextVal = e.target.value;
              opt.label = nextVal;
              if (!showCustomValues || !opt.value || opt.value === prevLabel) {
                opt.value = nextVal;
                if (valInput) valInput.value = nextVal;
              }
              renderCanvas();
            });

            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'field-act-btn del';
            delBtn.style.cssText = 'padding:4px 6px; font-size:0.8rem;';
            delBtn.title = 'Remove Option';
            delBtn.innerHTML = '&times;';
            delBtn.addEventListener('click', () => {
              field.options.splice(idx, 1);
              renderOptionsList(field);
              renderCanvas();
            });

            row.appendChild(lblInput);
            if (valInput) row.appendChild(valInput);
            row.appendChild(delBtn);
            list.appendChild(row);
          });
        }

        document.getElementById('settingOptionCustomValues')?.addEventListener('change', (e) => {
          const field = activeForm.fields.find(f => f.id === selectedFieldId);
          if (!field) return;
          field.showValues = e.target.checked;
          if (!e.target.checked) {
            (field.options || []).forEach(opt => {
              opt.value = opt.label || '';
            });
          }
          renderOptionsList(field);
          renderCanvas();
        });

        document.getElementById('btnAddOption').addEventListener('click', () => {
          const field = activeForm.fields.find(f => f.id === selectedFieldId);
          if (!field) return;
          if (!field.options) field.options = [];
          const count = field.options.length + 1;
          const label = `Option ${count}`;
          field.options.push({ label, value: label });
          renderOptionsList(field);
          renderCanvas();
        });

        // Conditional Logic Listeners
        document.getElementById('settingCondEnabled').addEventListener('change', (e) => {
          const field = activeForm.fields.find(f => f.id === selectedFieldId);
          if (!field) return;
          if (!field.conditionalLogic) {
            field.conditionalLogic = { enabled: false, action: 'show', logicType: 'all', rules: [] };
          }
          field.conditionalLogic.enabled = e.target.checked;
          document.getElementById('conditionalConfigWrap').style.display = e.target.checked ? 'block' : 'none';

          if (e.target.checked && field.conditionalLogic.rules.length === 0) {
            // Add default rule
            const otherFields = activeForm.fields.filter(f => f.id !== field.id);
            if (otherFields.length > 0) {
              field.conditionalLogic.rules.push({
                fieldId: otherFields[0].id,
                operator: 'is',
                value: ''
              });
            }
          }
          renderConditionalRules(field);
          renderCanvas();
        });

        document.getElementById('settingCondAction').addEventListener('change', (e) => {
          const field = activeForm.fields.find(f => f.id === selectedFieldId);
          if (field?.conditionalLogic) { field.conditionalLogic.action = e.target.value; renderCanvas(); }
        });

        document.getElementById('settingCondLogicType').addEventListener('change', (e) => {
          const field = activeForm.fields.find(f => f.id === selectedFieldId);
          if (field?.conditionalLogic) { field.conditionalLogic.logicType = e.target.value; renderCanvas(); }
        });

        function renderConditionalRules(field) {
          const container = document.getElementById('conditionalRulesList');
          container.innerHTML = '';
          const otherFields = activeForm.fields.filter(f => f.id !== field.id);

          (field.conditionalLogic.rules || []).forEach((rule, rIdx) => {
            const row = document.createElement('div');
            row.className = 'rule-row';

            let fieldOpts = otherFields.map(of => `<option value="${of.id}" ${of.id === rule.fieldId ? 'selected' : ''}>${of.label || of.id}</option>`).join('');

            row.innerHTML = `
              <button type="button" class="btn-del-rule" title="Delete Rule">&times;</button>
              <div style="display:flex; gap:6px;">
                <select class="control-select rule-fld" style="flex:1; padding:4px 6px; font-size:0.75rem;">${fieldOpts}</select>
                <select class="control-select rule-op" style="width:110px; padding:4px 6px; font-size:0.75rem;">
                  <option value="is" ${rule.operator === 'is' ? 'selected' : ''}>is</option>
                  <option value="is_not" ${rule.operator === 'is_not' ? 'selected' : ''}>is not</option>
                  <option value="contains" ${rule.operator === 'contains' ? 'selected' : ''}>contains</option>
                  <option value="greater_than" ${rule.operator === 'greater_than' ? 'selected' : ''}>greater than</option>
                  <option value="less_than" ${rule.operator === 'less_than' ? 'selected' : ''}>less than</option>
                </select>
              </div>
              <input type="text" class="control-input rule-val" value="${rule.value || ''}" placeholder="Value..." style="padding:4px 8px; font-size:0.75rem; margin-top:2px;" />
            `;

            row.querySelector('.rule-fld').addEventListener('change', (e) => { rule.fieldId = e.target.value; });
            row.querySelector('.rule-op').addEventListener('change', (e) => { rule.operator = e.target.value; });
            row.querySelector('.rule-val').addEventListener('input', (e) => { rule.value = e.target.value; });
            row.querySelector('.btn-del-rule').addEventListener('click', () => {
              field.conditionalLogic.rules.splice(rIdx, 1);
              renderConditionalRules(field);
            });

            container.appendChild(row);
          });
        }

        document.getElementById('btnAddRule').addEventListener('click', () => {
          const field = activeForm.fields.find(f => f.id === selectedFieldId);
          if (!field?.conditionalLogic) return;
          const otherFields = activeForm.fields.filter(f => f.id !== field.id);
          if (otherFields.length === 0) {
            alert('Add at least one more field to create conditional rules.');
            return;
          }
          field.conditionalLogic.rules.push({
            fieldId: otherFields[0].id,
            operator: 'is',
            value: ''
          });
          renderConditionalRules(field);
        });

