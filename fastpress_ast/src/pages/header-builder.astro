          const sliderEl = document.getElementById(cfg.sliderId);

          if (pickerEl) {
            pickerEl.addEventListener('input', (e) => {
              const hex = e.target.value;
              const alpha = (sliderEl ? parseInt(sliderEl.value, 10) : 100) / 100;
              const finalColor = alpha < 1 ? formatRgba(hex, alpha) : hex;
              syncColorUI(cfg, finalColor, 'picker');
            });
          }

          if (sliderEl) {
            sliderEl.addEventListener('input', (e) => {
              const alpha = parseInt(e.target.value, 10) / 100;
              const hex = pickerEl ? pickerEl.value : '#15181e';
              const finalColor = alpha < 1 ? formatRgba(hex, alpha) : hex;
              syncColorUI(cfg, finalColor, 'slider');
