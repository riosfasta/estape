    <!-- CLIENT SCRIPT -->
    <script is:inline define:vars={{ initialStore: headersStore, availablePages, availablePosts, initialSiteConfig, initialTemplates }}>
      (function() {
        // App State
        let currentStore = initialStore;
        let globalSiteConfig = initialSiteConfig || { brandName: 'Better SaaS', tagline: 'Modern Platform', logoUrl: '', faviconUrl: '/favicon.svg' };
        window.__FP_TEMPLATES__ = initialTemplates || [];
        let activeHeader = currentStore.headers.find(h => h.id === currentStore.activeHeaderId) || currentStore.headers[0];
        let currentTargetInputId = null;
        let currentResourceFilter = 'all';

        // Custom Code Navbar State
        let currentDeviceCodeTab = 'desktop'; // 'desktop' | 'tablet' | 'mobile'
        let currentAssetTab = 'html'; // 'html' | 'css' | 'js'

        // Elements
        const headerSelect = document.getElementById('headerSelect');
        const studioSwitcherBtn = document.getElementById('studioSwitcherBtn');
        const studioMenuFlyout = document.getElementById('studioMenuFlyout');
        const liveHeaderMount = document.getElementById('liveHeaderMount');
        const previewDeviceFrame = document.getElementById('previewDeviceFrame');
        const previewScrollViewport = document.getElementById('previewScrollViewport');
        const scrollSimSlider = document.getElementById('scrollSimSlider');
        const scrollSimVal = document.getElementById('scrollSimVal');
        const setActiveBtn = document.getElementById('setActiveBtn');
        const activeBtnText = document.getElementById('activeBtnText');
        const saveHeaderBtn = document.getElementById('saveHeaderBtn');
        const newHeaderBtn = document.getElementById('newHeaderBtn');
        const duplicateHeaderBtn = document.getElementById('duplicateHeaderBtn');
        const deleteHeaderBtn = document.getElementById('deleteHeaderBtn');
        const resourcePickerModal = document.getElementById('resourcePickerModal');
        const closeResourceModalBtn = document.getElementById('closeResourceModalBtn');
        const resourceSearchInput = document.getElementById('resourceSearchInput');
        const resourceListScroll = document.getElementById('resourceListScroll');

        // Studio Switcher toggle
        studioSwitcherBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          studioMenuFlyout?.classList.toggle('is-open');
        });
        document.addEventListener('click', () => {
          studioMenuFlyout?.classList.remove('is-open');
        });

        // Template Selection UI and Logic
        const chkUseHeaderTemplate = document.getElementById('chkUseHeaderTemplate');
        const headerTemplateDropdownWrap = document.getElementById('headerTemplateDropdownWrap');
        const selectHeaderTemplate = document.getElementById('selectHeaderTemplate');
        const btnOpenSelectedHeaderTemplateStudio = document.getElementById('btnOpenSelectedHeaderTemplateStudio');

        function populateHeaderTemplatesDropdown() {
          if (!selectHeaderTemplate) return;
          const templates = window.__FP_TEMPLATES__ || [];
          selectHeaderTemplate.innerHTML = '';

          const headerTemplates = templates.filter(t => t.category === 'Header' || t.id.includes('header') || t.id.includes('navbar') || t.id.includes('drawer'));
          const otherTemplates = templates.filter(t => t.category !== 'Header' && !t.id.includes('header') && !t.id.includes('navbar') && !t.id.includes('drawer'));

          const optGroupHeader = document.createElement('optgroup');
          optGroupHeader.label = 'Header / Navigation Templates';
          headerTemplates.forEach(t => {
            const opt = document.createElement('option');
            opt.value = t.id;
            opt.textContent = `${t.name} (${t.type === 'global' ? 'Global' : 'Individual'})`;
            optGroupHeader.appendChild(opt);
          });
          selectHeaderTemplate.appendChild(optGroupHeader);

          if (otherTemplates.length > 0) {
            const optGroupOther = document.createElement('optgroup');
            optGroupOther.label = 'Other Templates';
            otherTemplates.forEach(t => {
              const opt = document.createElement('option');
              opt.value = t.id;
              opt.textContent = `${t.name} (${t.category})`;
              optGroupOther.appendChild(opt);
            });
            selectHeaderTemplate.appendChild(optGroupOther);
          }
        }

        populateHeaderTemplatesDropdown();

        chkUseHeaderTemplate?.addEventListener('change', () => {
          activeHeader.useTemplate = chkUseHeaderTemplate.checked;
          if (activeHeader.useTemplate && !activeHeader.selectedTemplateId) {
            activeHeader.selectedTemplateId = selectHeaderTemplate?.value || 'tpl-global-furnisite-navbar';
          }
          if (headerTemplateDropdownWrap) {
            headerTemplateDropdownWrap.style.display = activeHeader.useTemplate ? 'block' : 'none';
          }
          if (btnOpenSelectedHeaderTemplateStudio) {
            btnOpenSelectedHeaderTemplateStudio.href = `/template-editor?id=${activeHeader.selectedTemplateId || selectHeaderTemplate?.value || 'tpl-global-furnisite-navbar'}`;
          }
          renderLivePreview();
        });

        selectHeaderTemplate?.addEventListener('change', () => {
          activeHeader.selectedTemplateId = selectHeaderTemplate.value;
          if (btnOpenSelectedHeaderTemplateStudio) {
            btnOpenSelectedHeaderTemplateStudio.href = `/template-editor?id=${activeHeader.selectedTemplateId}`;
          }
          renderLivePreview();
        });

        // Tab Switching
        const tabBtns = document.querySelectorAll('.tab-btn');
        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            tabBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const targetId = btn.dataset.tab;
            document.querySelectorAll('.control-panel').forEach(p => p.classList.remove('active'));
            const targetPanel = document.getElementById(targetId);
            if (targetPanel) targetPanel.classList.add('active');
          });
        });

        // Viewport Switcher
        const viewportBtns = document.querySelectorAll('.viewport-btn');
        viewportBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            viewportBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const mode = btn.dataset.mode;
            previewDeviceFrame.className = 'preview-device-frame mode-' + mode;

            // Sync with custom code editor if in HTML tab
            if (currentAssetTab === 'html' && (mode === 'desktop' || mode === 'tablet' || mode === 'mobile')) {
              currentDeviceCodeTab = mode;
              updateCodeEditorUI();
            }
          });
        });

        // Toast feedback
        function showToast(msg, isSuccess = true) {
          const toast = document.getElementById('hbToast');
          document.getElementById('toastMsg').textContent = msg;
          toast.className = 'hb-toast show ' + (isSuccess ? 'toast-success' : '');
          setTimeout(() => {
            toast.classList.remove('show');
          }, 3000);
        }

        // Update Active Button display
        function updateActiveButtonState() {
          const isCurrentActive = currentStore.activeHeaderId === activeHeader.id;
          if (isCurrentActive) {
            setActiveBtn.classList.add('is-active-header');
            activeBtnText.textContent = '★ Active on Live Site';
          } else {
            setActiveBtn.classList.remove('is-active-header');
            activeBtnText.textContent = 'Set Active Site Header';
          }
        }

        // Render Live Header HTML & CSS into Preview
        function renderLivePreview() {
          const h = activeHeader;

          // Branch: Template Mode (Render directly from selected GrapesJS block template)
          if (h.useTemplate) {
            const tplId = h.selectedTemplateId || (selectHeaderTemplate ? selectHeaderTemplate.value : 'tpl-global-furnisite-navbar');
