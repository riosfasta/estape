        // New Header
        newHeaderBtn.addEventListener('click', () => {
          const name = prompt('Enter a name for the new header:', 'Custom Header');
          if (!name) return;

          const newId = 'header-' + Date.now();
          const basePreset = currentStore.headers[0];
          const newHeader = JSON.parse(JSON.stringify(basePreset));
          newHeader.id = newId;
          newHeader.name = name;
          newHeader.isDefault = false;
