        // Save Header
        async function saveActiveHeader() {
          try {
            saveHeaderBtn.disabled = true;
            saveHeaderBtn.textContent = 'Saving...';

            const res = await fetch('/api/headers', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
