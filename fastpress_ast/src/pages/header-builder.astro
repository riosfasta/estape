          const isSticky = h.behavior?.sticky;
          const isShrink = h.behavior?.shrinkOnScroll;
          const logoPos = h.layout?.logoPosition || 'left';
          const containerClass = h.layout?.containerType === 'full' ? 'header-container-full' : (h.layout?.containerType === 'wide' ? 'header-container-wide' : 'header-container-boxed');

          const cssVars = `
            --hp-height: ${h.layout?.height || 80}px;
            --hp-shrunk-height: ${h.layout?.shrunkHeight || 58}px;
            --hp-pad-x: ${h.layout?.paddingX || 24}px;
            --hp-bg: ${h.styling?.bgColor || 'rgba(21, 24, 30, 0.94)'};
            --hp-scrolled-bg: ${h.styling?.scrolledBgColor || 'rgba(15, 18, 24, 0.98)'};
            --hp-text: ${h.styling?.textColor || '#f3f4f6'};
            --hp-accent: ${h.styling?.accentColor || '#ff5e3a'};
            --hp-border: ${h.styling?.borderColor || 'rgba(255, 255, 255, 0.08)'};
