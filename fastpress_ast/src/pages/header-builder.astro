          customCodeTextarea.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
              e.preventDefault();
              const start = customCodeTextarea.selectionStart;
              const end = customCodeTextarea.selectionEnd;
              customCodeTextarea.value = customCodeTextarea.value.substring(0, start) + '  ' + customCodeTextarea.value.substring(end);
              customCodeTextarea.selectionStart = customCodeTextarea.selectionEnd = start + 2;
              customCodeTextarea.dispatchEvent(new Event('input', { bubbles: true }));
            }
          });
        }

        // Toolbar: Pick link
        const btnPickLinkCode = document.getElementById('btnPickLinkCode');
        if (btnPickLinkCode) {
          btnPickLinkCode.addEventListener('click', () => {
            openResourceModal('customCodeTextarea');
          });
        }

        // Toolbar: Insert starter template
        const btnInsertStarterCode = document.getElementById('btnInsertStarterCode');
        if (btnInsertStarterCode) {
          btnInsertStarterCode.addEventListener('click', () => {
            const starter = getStarterTemplate(currentAssetTab, currentDeviceCodeTab);
            const currentVal = getActiveCodeValue();
            if (currentVal.trim() && !confirm(`Replace current ${currentAssetTab.toUpperCase()} content with starter template?`)) {
              return;
