        // Toolbar: Clear snippet
        const btnFormatSnippet = document.getElementById('btnFormatSnippet');
        if (btnFormatSnippet) {
          btnFormatSnippet.addEventListener('click', () => {
            if (confirm(`Clear code in current ${currentAssetTab.toUpperCase()} tab?`)) {
              setActiveCodeValue('');
              updateCodeEditorUI();
              renderLivePreview();
              showToast(`Cleared ${currentAssetTab.toUpperCase()} code.`);
            }
          });
        }

        // Media / File Manager Logic
        const mediaPickerModal = document.getElementById('mediaPickerModal');
        const closeMediaModalBtn = document.getElementById('closeMediaModalBtn');
        const btnCancelMediaModal = document.getElementById('btnCancelMediaModal');
        const btnApplySelectedMedia = document.getElementById('btnApplySelectedMedia');
        const mediaSearchInput = document.getElementById('mediaSearchInput');
        const mediaGalleryGrid = document.getElementById('mediaGalleryGrid');
        const mediaDropzone = document.getElementById('mediaDropzone');
        const mediaFileInput = document.getElementById('mediaFileInput');
        const btnRefreshMedia = document.getElementById('btnRefreshMedia');
        const inpDirectMediaUrl = document.getElementById('inpDirectMediaUrl');
        const mediaTotalCount = document.getElementById('mediaTotalCount');
        const selectedMediaLabel = document.getElementById('selectedMediaLabel');

        let currentMediaTargetInputId = null;
        let selectedMediaUrl = '';
        let mediaItemsList = [];

        function openMediaModal(targetInputId) {
          currentMediaTargetInputId = targetInputId;
          selectedMediaUrl = '';
          if (selectedMediaLabel) selectedMediaLabel.textContent = 'No image selected';
          if (mediaPickerModal) mediaPickerModal.classList.add('is-open');

          switchMediaTab('existing');
          loadMediaLibrary();
        }

        function closeMediaModal() {
          if (mediaPickerModal) mediaPickerModal.classList.remove('is-open');
          currentMediaTargetInputId = null;
          selectedMediaUrl = '';
        }

        if (closeMediaModalBtn) closeMediaModalBtn.addEventListener('click', closeMediaModal);
        if (btnCancelMediaModal) btnCancelMediaModal.addEventListener('click', closeMediaModal);
        if (mediaPickerModal) {
          mediaPickerModal.addEventListener('click', (e) => {
            if (e.target === mediaPickerModal) closeMediaModal();
          });
        }

        function switchMediaTab(tabName) {
          document.querySelectorAll('.dialog-tab[data-media-tab]').forEach(t => {
            t.classList.toggle('active', t.dataset.mediaTab === tabName);
          });
          const existingView = document.getElementById('mediaExistingView');
          const uploadView = document.getElementById('mediaUploadView');
          const urlView = document.getElementById('mediaUrlView');
          if (existingView) existingView.style.display = tabName === 'existing' ? 'flex' : 'none';
          if (uploadView) uploadView.style.display = tabName === 'upload' ? 'flex' : 'none';
          if (urlView) urlView.style.display = tabName === 'url' ? 'flex' : 'none';
        }

        document.querySelectorAll('.dialog-tab[data-media-tab]').forEach(tab => {
          tab.addEventListener('click', () => {
            switchMediaTab(tab.dataset.mediaTab);
          });
        });

        async function loadMediaLibrary() {
          if (!mediaGalleryGrid) return;
          mediaGalleryGrid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; color: #9ca3af; padding: 40px; font-size: 0.85rem;">Scanning uploads folder...</div>';
          try {
            const res = await fetch('/api/upload');
            const data = await res.json();
            mediaItemsList = Array.isArray(data) ? data : (data.media || []);
            if (mediaTotalCount) mediaTotalCount.textContent = mediaItemsList.length;
            renderMediaGrid();
          } catch (err) {
            mediaGalleryGrid.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; color: #ef4444; padding: 30px; font-size: 0.82rem;">Failed to load uploads: ${err.message}</div>`;
          }
        }

        if (btnRefreshMedia) btnRefreshMedia.addEventListener('click', loadMediaLibrary);
        if (mediaSearchInput) mediaSearchInput.addEventListener('input', renderMediaGrid);

        function renderMediaGrid() {
          if (!mediaGalleryGrid) return;
          const query = (mediaSearchInput ? mediaSearchInput.value : '').toLowerCase().trim();
          let filtered = mediaItemsList;
          if (query) {
            filtered = filtered.filter(item => (item.fileName || '').toLowerCase().includes(query));
          }

          if (filtered.length === 0) {
            mediaGalleryGrid.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; color: #9ca3af; padding: 40px; font-size: 0.82rem;">No images found. Switch to "Upload New Image" to add one!</div>';
            return;
          }

          mediaGalleryGrid.innerHTML = filtered.map(item => `
            <div class="media-thumb-card ${selectedMediaUrl === item.url ? 'selected' : ''}" data-url="${item.url}" data-name="${item.fileName}" data-size="${item.size || ''}">
              <div class="media-thumb-img-wrap">
                <img src="${item.url}" class="media-thumb-img" alt="${item.fileName}" loading="lazy" />
              </div>
              <div class="media-thumb-caption">
                <span class="media-thumb-name" title="${item.fileName}">${item.fileName}</span>
                <span class="media-thumb-size">${item.size || ''}</span>
              </div>
              <div class="media-selected-badge">✓</div>
            </div>
          `).join('');

          mediaGalleryGrid.querySelectorAll('.media-thumb-card').forEach(card => {
            card.addEventListener('click', () => {
              mediaGalleryGrid.querySelectorAll('.media-thumb-card').forEach(c => c.classList.remove('selected'));
              card.classList.add('selected');
              selectedMediaUrl = card.dataset.url;
              if (selectedMediaLabel) selectedMediaLabel.innerHTML = `Selected: <strong>${card.dataset.name}</strong> (${card.dataset.size})`;
            });

            card.addEventListener('dblclick', () => {
              selectedMediaUrl = card.dataset.url;
              applyMediaSelection();
            });
          });
        }

        function applyMediaSelection() {
          if (!selectedMediaUrl) {
            showToast('Please select or upload an image first.', false);
            return;
          }

          if (currentMediaTargetInputId) {
            const input = document.getElementById(currentMediaTargetInputId);
            if (input) {
              input.value = selectedMediaUrl;
              input.dispatchEvent(new Event('input', { bubbles: true }));

              // If for mega menu card, re-render menu editor to refresh thumbnail preview
              if (currentMediaTargetInputId.startsWith('megaCardImg_')) {
                const pIdx = parseInt(input.dataset.parentIdx, 10);
                if (activeHeader.menu[pIdx]?.megaMenu?.featuredCard) {
                  activeHeader.menu[pIdx].megaMenu.featuredCard.imageUrl = selectedMediaUrl;
                  renderMenuItemsEditor();
                  renderLivePreview();
                }
              }
            }
          }

          closeMediaModal();
          showToast('Image applied successfully!');
        }

        if (btnApplySelectedMedia) btnApplySelectedMedia.addEventListener('click', applyMediaSelection);

        // Upload handling
        if (mediaDropzone && mediaFileInput) {
          mediaDropzone.addEventListener('click', () => mediaFileInput.click());
          mediaDropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            mediaDropzone.classList.add('dragover');
          });
          mediaDropzone.addEventListener('dragleave', () => mediaDropzone.classList.remove('dragover'));
          mediaDropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            mediaDropzone.classList.remove('dragover');
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
              handleFileUpload(e.dataTransfer.files[0]);
            }
          });
          mediaFileInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
              handleFileUpload(e.target.files[0]);
            }
          });
        }

        async function handleFileUpload(file) {
          const statusEl = document.getElementById('uploadStatusMsg');
          if (statusEl) {
            statusEl.style.display = 'block';
            statusEl.style.color = 'var(--hb-accent)';
            statusEl.textContent = `Uploading ${file.name}...`;
          }

          try {
            const formData = new FormData();
            formData.append('file', file);

            const res = await fetch('/api/upload', {
              method: 'POST',
              body: formData,
            });
            const data = await res.json();

            if (data.success && data.url) {
              if (statusEl) {
                statusEl.style.color = '#10b981';
                statusEl.textContent = `✓ Uploaded ${file.name} successfully!`;
              }
              selectedMediaUrl = data.url;
              if (selectedMediaLabel) selectedMediaLabel.innerHTML = `Selected: <strong>${data.fileName || file.name}</strong> (${data.size || ''})`;

              await loadMediaLibrary();
              switchMediaTab('existing');
              showToast(`Uploaded: ${data.fileName || file.name}`);
            } else {
              if (statusEl) {
                statusEl.style.color = '#ef4444';
                statusEl.textContent = `Error: ${data.error || 'Upload failed'}`;
              }
              showToast(data.error || 'Upload failed', false);
            }
          } catch (err) {
            if (statusEl) {
              statusEl.style.color = '#ef4444';
              statusEl.textContent = `Upload error: ${err.message}`;
            }
            showToast('Upload error: ' + err.message, false);
          }
        }

        document.querySelectorAll('.stock-preset-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            selectedMediaUrl = btn.dataset.url;
            if (inpDirectMediaUrl) inpDirectMediaUrl.value = selectedMediaUrl;
            if (selectedMediaLabel) selectedMediaLabel.innerHTML = `Selected: <strong>Stock Image</strong>`;
            applyMediaSelection();
          });
        });

        if (inpDirectMediaUrl) {
          inpDirectMediaUrl.addEventListener('input', (e) => {
            selectedMediaUrl = e.target.value.trim();
            if (selectedMediaUrl && selectedMediaLabel) {
              selectedMediaLabel.innerHTML = `Selected: <strong>Custom URL</strong>`;
            }
          });
        }

        // Wire .pick-media-btn
        document.querySelectorAll('.pick-media-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            openMediaModal(btn.dataset.target);
          });
        });

        // Initialize Form
        populateForm();
      })();
    </script>
    <script is:inline src="/editor-custom-code.js"></script>
  </body>
</html>
