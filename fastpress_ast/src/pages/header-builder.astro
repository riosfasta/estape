        // Populate Form Controls from activeHeader
        function populateForm() {
          const h = activeHeader;
          ensureCustomCode(h);

          // Template Option Setting
          if (chkUseHeaderTemplate) {
            chkUseHeaderTemplate.checked = Boolean(h.useTemplate);
          }
          if (headerTemplateDropdownWrap) {
            headerTemplateDropdownWrap.style.display = h.useTemplate ? 'block' : 'none';
          }
          if (selectHeaderTemplate) {
            if (h.selectedTemplateId) {
              selectHeaderTemplate.value = h.selectedTemplateId;
            } else if (selectHeaderTemplate.options.length > 0) {
              selectHeaderTemplate.selectedIndex = 0;
              if (h.useTemplate) h.selectedTemplateId = selectHeaderTemplate.value;
            }
          }
          if (btnOpenSelectedHeaderTemplateStudio) {
            btnOpenSelectedHeaderTemplateStudio.href = `/template-editor?id=${h.selectedTemplateId || selectHeaderTemplate?.value || 'tpl-global-furnisite-navbar'}`;
          }

          // Layout
          document.querySelectorAll('.radio-card-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.logopos === (h.layout?.logoPosition || 'left'));
          });
          document.getElementById('inputNormalHeight').value = h.layout?.height || 80;
          document.getElementById('valNormalHeight').textContent = (h.layout?.height || 80) + 'px';
          document.getElementById('inputShrunkHeight').value = h.layout?.shrunkHeight || 58;
          document.getElementById('valShrunkHeight').textContent = (h.layout?.shrunkHeight || 58) + 'px';
          document.getElementById('selectContainerType').value = h.layout?.containerType || 'boxed';
          document.getElementById('inputPaddingX').value = h.layout?.paddingX || 24;
          document.getElementById('valPaddingX').textContent = (h.layout?.paddingX || 24) + 'px';

          // Behavior
          document.getElementById('checkSticky').checked = Boolean(h.behavior?.sticky);
          document.getElementById('checkShrink').checked = Boolean(h.behavior?.shrinkOnScroll);
          document.getElementById('inputShrinkOffset').value = h.behavior?.shrinkOffset || 45;
          document.getElementById('valShrinkOffset').textContent = (h.behavior?.shrinkOffset || 45) + 'px';
          document.getElementById('checkGlass').checked = Boolean(h.behavior?.glassmorphism);
          document.getElementById('selectShadow').value = h.behavior?.scrollShadow || 'medium';

          // Logo
          if (!h.logo) h.logo = { text: 'Better SaaS', tagline: '', linkUrl: '/' };
          if (!h.logo.logoSource) {
            h.logo.logoSource = h.logo.imageUrl ? 'custom' : 'default';
          }
          document.getElementById('inputLogoText').value = h.logo?.text || 'Better SaaS';
          document.getElementById('inputLogoTagline').value = h.logo?.tagline || '';
          const inpLogoImg = document.getElementById('inputLogoImg');
          if (inpLogoImg) inpLogoImg.value = h.logo?.imageUrl || '';
          document.getElementById('inputLogoUrl').value = h.logo?.linkUrl || '/';
          document.getElementById('checkLogoScale').checked = Boolean(h.logo?.scaleOnShrink);
          updateGlobalLogoCardUI();

          // Search & Actions
          document.getElementById('checkShowSearch').checked = Boolean(h.actions?.showSearch);
          document.getElementById('inputSearchUrl').value = h.actions?.searchActionUrl || '/blog';

          // Styling - Color Palette with Pickers & Alpha
          COLOR_KEYS.forEach(cfg => {
            const val = h.styling?.[cfg.key] || (
              cfg.key === 'bgColor' ? 'rgba(21, 24, 30, 0.94)' :
              cfg.key === 'scrolledBgColor' ? 'rgba(15, 18, 24, 0.98)' :
              cfg.key === 'accentColor' ? '#ff5e3a' :
              cfg.key === 'textColor' ? '#f3f4f6' : 'rgba(255, 255, 255, 0.08)'
            );
            syncColorUI(cfg, val, 'load');
          });
          document.getElementById('selectFontFamily').value = h.styling?.fontFamily || 'Plus Jakarta Sans';
          document.getElementById('inputFontSize').value = h.styling?.fontSize || '0.86rem';
          if (document.getElementById('selectNavIndicatorStyle')) {
            document.getElementById('selectNavIndicatorStyle').value = h.styling?.navIndicatorStyle || 'underline';
          }

          renderMenuItemsEditor();
          renderActionButtonsEditor();
          updateCodeEditorUI();
          updateActiveButtonState();
          renderLivePreview();
