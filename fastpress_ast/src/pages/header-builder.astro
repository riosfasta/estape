            const tabletContent = cc.tabletHtml || cc.desktopHtml || '<div style="padding: 24px; text-align: center; color: #94a3b8; font-size: 0.85rem;">[Tablet Custom HTML is empty]</div>';
            const mobileContent = cc.mobileHtml || cc.tabletHtml || cc.desktopHtml || '<div style="padding: 24px; text-align: center; color: #94a3b8; font-size: 0.85rem;">[Mobile Custom HTML is empty]</div>';

            liveHeaderMount.innerHTML = `
