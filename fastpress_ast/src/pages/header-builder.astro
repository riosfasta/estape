          document.querySelectorAll('.btn-del-sub').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const pIdx = parseInt(e.currentTarget.dataset.parentIdx, 10);
              const sIdx = parseInt(e.currentTarget.dataset.subIdx, 10);
              activeHeader.menu[pIdx].dropdownItems.splice(sIdx, 1);
              renderMenuItemsEditor();
              renderLivePreview();
