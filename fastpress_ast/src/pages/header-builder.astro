          // Logo Markup - inherits from Web Config if custom imageUrl is empty
          const effectiveLogoImg = (h.logo?.imageUrl && h.logo.imageUrl.trim()) || (globalSiteConfig.logoUrl && globalSiteConfig.logoUrl.trim()) || '';
          const effectiveBrandName = (h.logo?.text && h.logo.text.trim()) || globalSiteConfig.brandName || 'Better SaaS';
          const effectiveTagline = h.logo?.tagline !== undefined && h.logo.tagline !== '' ? h.logo.tagline : (globalSiteConfig.tagline || '');

          const logoHtml = `
            <a href="${h.logo?.linkUrl || '/'}" class="header-brand-link">
              <div class="logo-box">
                ${effectiveLogoImg ? `
                  <img src="${effectiveLogoImg}" alt="${effectiveBrandName}" style="max-height: 38px; max-width: 160px; object-fit: contain; border-radius: 4px;" />
                ` : `
                  <span class="logo-icon-badge">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect width="24" height="24" rx="6" fill="var(--hp-accent)" />
                      <path d="M7 6H13.5C15.433 6 17 7.567 17 9.5C17 10.96 16.104 12.21 14.82 12.72C16.42 13.19 17.5 14.68 17.5 16.5C17.5 18.985 15.485 21 13 21H7V6ZM10 8.5V11.5H13C13.828 11.5 14.5 10.828 14.5 10C14.5 9.172 13.828 8.5 13 8.5H10ZM10 13.5V18.5H13C14.105 18.5 15 17.605 15 16.5C15 15.395 14.105 14.5 13 14.5H10Z" fill="white" />
                    </svg>
                  </span>
                  <div class="logo-text-group">
                    <span class="logo-main-text">${effectiveBrandName}</span>
                    ${effectiveTagline ? `<span class="logo-tagline">${effectiveTagline}</span>` : ''}
                  </div>
                `}
              </div>
            </a>
          `;

          const headerHtml = `
            <header
              class="fastpress-site-header logo-pos-${logoPos} ${isSticky ? 'is-sticky' : ''} ${isShrink ? 'has-shrink' : ''} ${h.behavior?.glassmorphism ? 'has-glass' : ''} shadow-${h.behavior?.scrollShadow || 'none'}"
              id="previewLiveHeader"
              data-nav-indicator="${h.styling?.navIndicatorStyle || 'underline'}"
              style="${cssVars}"
            >
              <div class="header-inner-wrap ${containerClass}">
                ${logoPos !== 'right' ? `<div class="header-logo-area">${logoHtml}</div>` : ''}
                ${logoPos === 'right' ? `<div class="header-actions-area desktop-only-actions"><div class="header-buttons-group">${buttonsHtml}</div></div>` : ''}

                <nav class="header-desktop-nav align-${logoPos}">
                  <ul class="header-nav-list">${menuHtml}</ul>
                </nav>

                ${logoPos === 'center' ? `<div class="header-logo-area logo-centered">${logoHtml}</div>` : ''}

                <div class="header-actions-area">
                  ${h.actions?.showSearch ? `
                    <div class="header-search-wrap">
                      <button type="button" class="search-btn-icon" id="previewSearchBtn" aria-label="Search">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                      </button>
                      <form class="hp-search-form" id="previewSearchForm" action="${h.actions?.searchActionUrl || '/blog'}" method="get">
                        <input type="search" name="q" placeholder="Search keywords..." />
                        <button type="submit" aria-label="Search">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                      </form>
                    </div>
                  ` : ''}
                  ${logoPos !== 'right' ? `<div class="header-buttons-group">${buttonsHtml}</div>` : ''}
                  <button type="button" class="hp-mobile-toggle" id="previewMobileToggle" aria-label="Toggle menu">
                    <span class="bar bar-1"></span>
                    <span class="bar bar-2"></span>
                    <span class="bar bar-3"></span>
                  </button>
                </div>

                ${logoPos === 'right' ? `<div class="header-logo-area logo-right">${logoHtml}</div>` : ''}
              </div>

              <!-- Mobile Drawer -->
              <div class="hp-mobile-drawer" id="previewMobileDrawer">
                <div class="hp-mobile-inner">
                  <ul class="hp-mobile-nav-list">
                    ${(h.menu || []).map(m => {
                      const hasSubs = (m.dropdownItems && m.dropdownItems.length) || (m.megaMenu && m.megaMenu.columns && m.megaMenu.columns.length);
                      return `
                        <li class="hp-mobile-item">
                          <div class="hp-mobile-row">
                            <a href="${m.url}" class="hp-mobile-link">${m.label}</a>
                            ${hasSubs ? `<button type="button" class="hp-mobile-sub-toggle" aria-label="Toggle Submenu">▼</button>` : ''}
                          </div>
                          ${(m.type === 'dropdown' && m.dropdownItems) ? `
                            <ul class="hp-mobile-sub-list">
                              ${m.dropdownItems.map(s => `
                                <li>
                                  <a href="${s.url}" class="hp-mobile-sub-link">
                                    ${s.icon ? `<span>${s.icon}</span>` : ''}
                                    <span>${s.label}</span>
                                  </a>
                                </li>
                              `).join('')}
                            </ul>
                          ` : ''}
                          ${(m.type === 'megamenu' && m.megaMenu?.columns) ? `
                            <div class="hp-mobile-megamenu-panel">
                              ${m.megaMenu.columns.map(col => `
                                <div class="hp-mobile-col">
                                  <div class="hp-mobile-col-title">${col.title}</div>
                                  <ul class="hp-mobile-sub-list is-open" style="display: flex;">
                                    ${(col.items || []).map(mi => `
                                      <li>
                                        <a href="${mi.url}" class="hp-mobile-sub-link">
                                          ${mi.icon ? `<span>${mi.icon}</span>` : ''}
                                          <span>${mi.label}</span>
                                        </a>
                                      </li>
                                    `).join('')}
                                  </ul>
                                </div>
                              `).join('')}
                            </div>
                          ` : ''}
                        </li>
                      `;
                    }).join('')}
                  </ul>

                  ${(h.actions?.buttons && h.actions.buttons.length > 0) ? `
                    <div class="hp-mobile-actions">
                      ${h.actions.buttons.map(b => `
                        <a href="${b.url}" class="header-btn btn-${b.variant || 'primary'} ${b.pill ? 'btn-pill' : ''}" style="width: 100%; justify-content: center;">
                          <span>${b.label}</span>
                        </a>
                      `).join('')}
                    </div>
                  ` : ''}
                </div>
              </div>
            </header>
          `;

          liveHeaderMount.innerHTML = headerHtml;

          // Wire mobile menu toggle in preview
          const pMobToggle = document.getElementById('previewMobileToggle');
          const pMobDrawer = document.getElementById('previewMobileDrawer');
          if (pMobToggle && pMobDrawer) {
            pMobToggle.addEventListener('click', () => {
              const isOpen = pMobDrawer.classList.toggle('is-open');
              pMobToggle.classList.toggle('is-active', isOpen);
            });
          }

          // Wire preview search toggle
          const pSearchBtn = document.getElementById('previewSearchBtn');
          const pSearchForm = document.getElementById('previewSearchForm');
          if (pSearchBtn && pSearchForm) {
            pSearchBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              pSearchForm.classList.toggle('is-active');
              if (pSearchForm.classList.contains('is-active')) {
                const inEl = pSearchForm.querySelector('input');
                if (inEl) inEl.focus();
              }
            });
            document.addEventListener('click', (e) => {
              if (!pSearchForm.contains(e.target) && !pSearchBtn.contains(e.target)) {
                pSearchForm.classList.remove('is-active');
              }
            });
          }

          // Wire mobile sub-toggles
          liveHeaderMount.querySelectorAll('.hp-mobile-sub-toggle').forEach(t => {
            t.addEventListener('click', (e) => {
              e.stopPropagation();
              const p = t.closest('.hp-mobile-item');
              const sub = p?.querySelector('.hp-mobile-sub-list');
              const mega = p?.querySelector('.hp-mobile-megamenu-panel');
              if (sub) sub.classList.toggle('is-open');
              if (mega) mega.classList.toggle('is-open');
              t.classList.toggle('is-active');
            });
          });

          // Wire desktop nav hover intent & click in preview
          let navHoverTimers = new Map();

          liveHeaderMount.querySelectorAll('.nav-item-root').forEach(item => {
            if (item.classList.contains('has-dropdown') || item.classList.contains('has-megamenu')) {
              // Mouse enter: open immediately
              item.addEventListener('mouseenter', () => {
                if (navHoverTimers.has(item)) {
                  clearTimeout(navHoverTimers.get(item));
                  navHoverTimers.delete(item);
                }
                liveHeaderMount.querySelectorAll('.nav-item-root').forEach(other => {
                  if (other !== item) other.classList.remove('is-open');
                });
                item.classList.add('is-open');
              });

              // Mouse leave: 250ms grace period so you can smoothly enter the dropdown
              item.addEventListener('mouseleave', () => {
                const timer = setTimeout(() => {
                  item.classList.remove('is-open');
                  navHoverTimers.delete(item);
                }, 250);
                navHoverTimers.set(item, timer);
              });

              // Click toggle support
              const rootLink = item.querySelector('.nav-root-link');
              if (rootLink) {
                rootLink.addEventListener('click', (e) => {
                  e.preventDefault();
                  e.stopPropagation();
                  const wasOpen = item.classList.contains('is-open');
                  liveHeaderMount.querySelectorAll('.nav-item-root').forEach(i => i.classList.remove('is-open'));
                  if (!wasOpen) item.classList.add('is-open');
                });
              }
            }
          });

          // Re-apply current scroll position
          updateScrollPreview(parseInt(scrollSimSlider.value, 10));
        }

        // Apply scroll simulator to header preview
        function updateScrollPreview(depth) {
          const header = document.getElementById('previewLiveHeader');
          if (!header) return;

          const shrinkOffset = activeHeader.behavior?.shrinkOffset || 45;
          const hasShrink = activeHeader.behavior?.shrinkOnScroll;

          if (depth > 15) {
            header.classList.add('is-scrolled');
          } else {
            header.classList.remove('is-scrolled');
          }

          if (hasShrink) {
            if (depth > shrinkOffset) {
              header.classList.add('is-shrunk');
            } else {
              header.classList.remove('is-shrunk');
            }
          }
        }

        scrollSimSlider.addEventListener('input', (e) => {
          const depth = parseInt(e.target.value, 10);
          scrollSimVal.textContent = depth + 'px';
          updateScrollPreview(depth);
          previewScrollViewport.scrollTop = depth * 2;
        });

        // Also sync scroll from the actual viewport scrolling
        previewScrollViewport.addEventListener('scroll', () => {
          const depth = Math.min(250, Math.round(previewScrollViewport.scrollTop / 2));
          scrollSimSlider.value = depth;
          scrollSimVal.textContent = depth + 'px';
          updateScrollPreview(depth);
        });

        // Color Palette Helpers & State Management
        function parseCssColor(colorStr) {
          if (!colorStr) return { hex: '#15181e', alpha: 1, isRgba: false };
          const s = String(colorStr).trim();

          // Match rgba(r, g, b, a) or rgb(r, g, b)
          const rgbaMatch = s.match(/^rgba?\s*\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)(?:\s*,\s*([\d.]+))?\s*\)$/i);
          if (rgbaMatch) {
            const r = Math.min(255, Math.max(0, parseInt(rgbaMatch[1], 10)));
            const g = Math.min(255, Math.max(0, parseInt(rgbaMatch[2], 10)));
            const b = Math.min(255, Math.max(0, parseInt(rgbaMatch[3], 10)));
            const a = rgbaMatch[4] !== undefined ? Math.min(1, Math.max(0, parseFloat(rgbaMatch[4]))) : 1;
            const hex = '#' + [r, g, b].map(x => x.toString(16).padStart(2, '0')).join('');
            return { hex: hex.toLowerCase(), alpha: a, isRgba: rgbaMatch[4] !== undefined };
          }

          // Match 8-digit hex #rrggbbaa
          if (/^#[0-9a-f]{8}$/i.test(s)) {
            const r = parseInt(s.slice(1, 3), 16);
            const g = parseInt(s.slice(3, 5), 16);
            const b = parseInt(s.slice(5, 7), 16);
            const a = Math.round((parseInt(s.slice(7, 9), 16) / 255) * 100) / 100;
            return { hex: s.slice(0, 7).toLowerCase(), alpha: a, isRgba: true };
          }

          // Match 6-digit hex #rrggbb
          if (/^#[0-9a-f]{6}$/i.test(s)) {
            return { hex: s.toLowerCase(), alpha: 1, isRgba: false };
          }

          // Match 3-digit hex #rgb
          if (/^#[0-9a-f]{3}$/i.test(s)) {
            const hex = '#' + s[1] + s[1] + s[2] + s[2] + s[3] + s[3];
            return { hex: hex.toLowerCase(), alpha: 1, isRgba: false };
          }

          // Named color fallbacks
          if (s.toLowerCase() === 'transparent') {
            return { hex: '#000000', alpha: 0, isRgba: true };
          }
          if (s.toLowerCase() === 'white') {
            return { hex: '#ffffff', alpha: 1, isRgba: false };
          }
          if (s.toLowerCase() === 'black') {
            return { hex: '#000000', alpha: 1, isRgba: false };
          }

          return { hex: '#15181e', alpha: 1, isRgba: false };
        }

        function formatRgba(hex, alpha) {
          const cleanHex = hex.startsWith('#') ? hex : '#' + hex;
          const r = parseInt(cleanHex.slice(1, 3), 16) || 0;
          const g = parseInt(cleanHex.slice(3, 5), 16) || 0;
          const b = parseInt(cleanHex.slice(5, 7), 16) || 0;
          const a = Math.round(alpha * 100) / 100;
          if (a >= 1) return cleanHex.toLowerCase();
          return `rgba(${r}, ${g}, ${b}, ${a})`;
        }

        const COLOR_KEYS = [
          { key: 'bgColor', inputId: 'inputBgColor', pickerId: 'pickerBgColor', swatchId: 'swatchBgColor', sliderId: 'sliderBgColor', badgeId: 'badgeBgColor' },
          { key: 'scrolledBgColor', inputId: 'inputScrolledBgColor', pickerId: 'pickerScrolledBgColor', swatchId: 'swatchScrolledBgColor', sliderId: 'sliderScrolledBgColor', badgeId: 'badgeScrolledBgColor' },
          { key: 'accentColor', inputId: 'inputAccentColor', pickerId: 'pickerAccentColor', swatchId: 'swatchAccentColor', sliderId: 'sliderAccentColor', badgeId: 'badgeAccentColor' },
          { key: 'textColor', inputId: 'inputTextColor', pickerId: 'pickerTextColor', swatchId: 'swatchTextColor', sliderId: 'sliderTextColor', badgeId: 'badgeTextColor' },
          { key: 'borderColor', inputId: 'inputBorderColor', pickerId: 'pickerBorderColor', swatchId: 'swatchBorderColor', sliderId: 'sliderBorderColor', badgeId: 'badgeBorderColor' }
        ];

        const QUICK_THEMES = {
          'dark-saas': {
            bgColor: 'rgba(21, 24, 30, 0.94)',
            scrolledBgColor: 'rgba(15, 18, 24, 0.98)',
            accentColor: '#ff5e3a',
            textColor: '#f3f4f6',
            borderColor: 'rgba(255, 255, 255, 0.08)'
          },
          'luxury-gold': {
            bgColor: '#11141a',
            scrolledBgColor: 'rgba(17, 20, 26, 0.98)',
            accentColor: '#e5a93c',
            textColor: '#ffffff',
            borderColor: 'rgba(229, 169, 60, 0.2)'
          },
          'cyber-blue': {
            bgColor: '#0f172a',
            scrolledBgColor: 'rgba(15, 23, 42, 0.98)',
            accentColor: '#38bdf8',
            textColor: '#f8fafc',
            borderColor: 'rgba(56, 189, 248, 0.2)'
          },
          'emerald-mint': {
            bgColor: '#0c1a17',
            scrolledBgColor: 'rgba(10, 24, 21, 0.98)',
            accentColor: '#10b981',
            textColor: '#ecfdf5',
            borderColor: 'rgba(16, 185, 129, 0.2)'
          },
          'clean-light': {
            bgColor: 'rgba(255, 255, 255, 0.92)',
            scrolledBgColor: 'rgba(255, 255, 255, 0.98)',
            accentColor: '#2563eb',
            textColor: '#0f172a',
            borderColor: 'rgba(0, 0, 0, 0.08)'
          }
        };

        function syncColorUI(cfg, colorValue, fromSource) {
          const parsed = parseCssColor(colorValue);
          const inputEl = document.getElementById(cfg.inputId);
          const pickerEl = document.getElementById(cfg.pickerId);
          const swatchEl = document.getElementById(cfg.swatchId);
          const sliderEl = document.getElementById(cfg.sliderId);
          const badgeEl = document.getElementById(cfg.badgeId);

          if (fromSource !== 'input' && inputEl) {
            inputEl.value = colorValue;
          }
          if (pickerEl) {
            pickerEl.value = parsed.hex;
          }
          if (swatchEl) {
            swatchEl.style.backgroundColor = colorValue;
          }
          if (sliderEl) {
            sliderEl.value = Math.round(parsed.alpha * 100);
          }
          if (badgeEl) {
            badgeEl.textContent = `${Math.round(parsed.alpha * 100)}%`;
          }

          if (activeHeader?.styling) {
            activeHeader.styling[cfg.key] = colorValue;
          }
          renderLivePreview();
        }

        // Custom Code Helper Functions
        function ensureCustomCode(h) {
          if (!h.customCode) {
            h.customCode = {
              enabled: false,
              desktopHtml: '',
              tabletHtml: '',
              mobileHtml: '',
              customCss: '',
              customJs: '',
            };
          }
          if (!h.builderType) {
            h.builderType = h.customCode.enabled ? 'custom-code' : 'visual';
          }
        }

        function getActiveCodeValue() {
          ensureCustomCode(activeHeader);
          const cc = activeHeader.customCode;
          if (currentAssetTab === 'css') return cc.customCss || '';
          if (currentAssetTab === 'js') return cc.customJs || '';
          if (currentDeviceCodeTab === 'desktop') return cc.desktopHtml || '';
          if (currentDeviceCodeTab === 'tablet') return cc.tabletHtml || '';
          if (currentDeviceCodeTab === 'mobile') return cc.mobileHtml || '';
          return '';
        }

        function setActiveCodeValue(val) {
          ensureCustomCode(activeHeader);
          const cc = activeHeader.customCode;
          if (currentAssetTab === 'css') {
            cc.customCss = val;
          } else if (currentAssetTab === 'js') {
            cc.customJs = val;
          } else {
            if (currentDeviceCodeTab === 'desktop') cc.desktopHtml = val;
            else if (currentDeviceCodeTab === 'tablet') cc.tabletHtml = val;
            else if (currentDeviceCodeTab === 'mobile') cc.mobileHtml = val;
          }
        }

        function updateCodeEditorUI() {
          ensureCustomCode(activeHeader);
          const cc = activeHeader.customCode;
          const isCustom = activeHeader.builderType === 'custom-code' && Boolean(cc.enabled);

          const checkEl = document.getElementById('checkEnableCustomCode');
          if (checkEl) checkEl.checked = isCustom;

          // Update active classes on deviceCodeTabs and codeAssetTabs
          document.querySelectorAll('.device-code-tab').forEach(b => {
            b.classList.toggle('active', b.dataset.device === currentDeviceCodeTab);
          });
          document.querySelectorAll('.asset-tab').forEach(b => {
            b.classList.toggle('active', b.dataset.asset === currentAssetTab);
          });

          // Update badge & hint
          const badge = document.getElementById('codeEditorModeBadge');
          const hint = document.getElementById('codeEditorHint');
          const textarea = document.getElementById('customCodeTextarea');
          const charCount = document.getElementById('codeEditorCharCount');

          if (currentAssetTab === 'css') {
            if (badge) badge.textContent = 'GLOBAL CUSTOM CSS';
            if (hint) hint.textContent = 'Injected into page header styles across all viewports';
          } else if (currentAssetTab === 'js') {
            if (badge) badge.textContent = 'INTERACTIVE CUSTOM JS';
            if (hint) hint.textContent = 'Executed on client (container passed as argument)';
          } else {
            const devName = currentDeviceCodeTab.toUpperCase();
            if (badge) badge.textContent = `${devName} HTML`;
            if (hint) hint.textContent = `Rendered on ${currentDeviceCodeTab} screens`;
          }

          const val = getActiveCodeValue();
          if (textarea) {
            textarea.value = val;
            if (charCount) charCount.textContent = `${val.length} characters`;
          }
        }

        function getStarterTemplate(asset, device) {
