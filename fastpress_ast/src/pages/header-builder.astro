        // Resource Link Picker Modal
        function openResourceModal(targetInputId) {
          currentTargetInputId = targetInputId;
          resourcePickerModal.classList.add('is-open');
          resourceSearchInput.value = '';
          renderResourceList();
          resourceSearchInput.focus();
        }

        closeResourceModalBtn.addEventListener('click', () => {
          resourcePickerModal.classList.remove('is-open');
        });
        resourcePickerModal.addEventListener('click', (e) => {
          if (e.target === resourcePickerModal) {
            resourcePickerModal.classList.remove('is-open');
          }
        });

        // Filter tabs in modal
        document.querySelectorAll('.dialog-tab').forEach(tab => {
          tab.addEventListener('click', () => {
            document.querySelectorAll('.dialog-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            currentResourceFilter = tab.dataset.resFilter;
            renderResourceList();
          });
        });
        resourceSearchInput.addEventListener('input', renderResourceList);

        function renderResourceList() {
          const query = (resourceSearchInput.value || '').toLowerCase().trim();
          let items = [];

          if (currentResourceFilter === 'all' || currentResourceFilter === 'pages') {
            availablePages.forEach(p => {
              items.push({ type: 'page', title: p.title, url: p.url, slug: p.slug });
            });
          }
          if (currentResourceFilter === 'all' || currentResourceFilter === 'posts') {
            availablePosts.forEach(p => {
              items.push({ type: 'post', title: p.title, url: p.url, category: p.category, slug: p.slug });
            });
          }

          if (query) {
            items = items.filter(it => 
              it.title.toLowerCase().includes(query) ||
              it.url.toLowerCase().includes(query) ||
              (it.category && it.category.toLowerCase().includes(query))
            );
          }

          if (items.length === 0) {
            resourceListScroll.innerHTML = `<div style="text-align: center; padding: 24px; color: #9ca3af; font-size: 0.85rem;">No matching pages or posts found.</div>`;
            return;
          }

          resourceListScroll.innerHTML = items.map(it => `
            <button type="button" class="resource-item-btn" data-url="${it.url}" data-title="${it.title}">
              <div class="res-info-col">
                <span class="res-title">${it.title}</span>
                <span class="res-url">${it.url}</span>
              </div>
              <span class="res-type-badge ${it.type === 'page' ? 'badge-page' : 'badge-post'}">${it.type}</span>
            </button>
          `).join('');

          // Wire click on resource items
          resourceListScroll.querySelectorAll('.resource-item-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const url = btn.dataset.url;
              const title = btn.dataset.title;

              if (currentTargetInputId === 'customCodeTextarea') {
                const textarea = document.getElementById('customCodeTextarea');
                if (textarea) {
                  const startPos = textarea.selectionStart ?? textarea.value.length;
                  const endPos = textarea.selectionEnd ?? textarea.value.length;
                  const before = textarea.value.substring(0, startPos);
                  const after = textarea.value.substring(endPos);

                  let insertion = url;
                  if (currentAssetTab === 'html') {
                    insertion = `<a href="${url}">${title}</a>`;
                  }
                  textarea.value = before + insertion + after;
                  textarea.selectionStart = textarea.selectionEnd = startPos + insertion.length;
                  textarea.dispatchEvent(new Event('input', { bubbles: true }));
                  textarea.focus();
                }
              } else if (currentTargetInputId) {
                const targetInput = document.getElementById(currentTargetInputId);
                if (targetInput) {
                  targetInput.value = url;
                  targetInput.dispatchEvent(new Event('input', { bubbles: true }));

                  // Also auto-fill title if this is an untitled menu item
                  const parentCard = targetInput.closest('.menu-item-row-card');
                  if (parentCard) {
                    const labelInput = parentCard.querySelector('.item-label-input') || parentCard.querySelector('.sub-label-in') || parentCard.querySelector('.mega-mi-label');
                    if (labelInput && (!labelInput.value || labelInput.value === 'New Link' || labelInput.value === 'Untitled Link')) {
                      labelInput.value = title;
                      labelInput.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                  }
                }
              }

              resourcePickerModal.classList.remove('is-open');
              showToast(`Inserted link: ${url}`);
            });
          });
        }

