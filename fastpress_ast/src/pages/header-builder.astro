            });
            const data = await res.json();
            if (data.success) {
              currentStore.headers = data.headers;
              showToast('Header configuration saved!');
            } else {
              showToast('Error: ' + data.error, false);
            }
          } catch (err) {
            showToast('Save failed: ' + err.message, false);
          } finally {
            saveHeaderBtn.disabled = false;
            saveHeaderBtn.textContent = 'Save Header';
          }
        }
        saveHeaderBtn.addEventListener('click', saveActiveHeader);

        // Set Active Site Header
        setActiveBtn.addEventListener('click', async () => {
          try {
            setActiveBtn.disabled = true;
            const res = await fetch('/api/headers', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ activeHeaderId: activeHeader.id })
            });
            const data = await res.json();
            if (data.success) {
              currentStore.activeHeaderId = activeHeader.id;
              currentStore.headers = data.headers;
              updateActiveButtonState();
              // Update select labels
              Array.from(headerSelect.options).forEach(opt => {
