          // Generate Nav Items Markup
          const menuHtml = (h.menu || []).map(item => {
            const hasDropdown = item.type === 'dropdown' && item.dropdownItems?.length;
            const hasMega = item.type === 'megamenu' && item.megaMenu?.columns?.length;

            let subHtml = '';
            if (hasDropdown) {
              subHtml = `
                <div class="nav-dropdown-flyout">
