        // Delete Header
        deleteHeaderBtn.addEventListener('click', async () => {
          if (currentStore.headers.length <= 1) {
            alert('Cannot delete the only remaining header.');
            return;
          }
          if (!confirm(`Delete header "${activeHeader.name}"?`)) return;

          try {
            const res = await fetch(`/api/headers?id=${activeHeader.id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
              currentStore.headers = data.headers;
              currentStore.activeHeaderId = data.activeHeaderId;
              activeHeader = currentStore.headers[0];

              // Rebuild select options
              headerSelect.innerHTML = '';
              currentStore.headers.forEach(h => {
                const opt = document.createElement('option');
