                                <img src="${item.megaMenu.featuredCard.imageUrl}" style="width: 44px; height: 30px; object-fit: cover; border-radius: 4px; border: 1px solid rgba(255,255,255,0.15);" alt="Thumb" onerror="this.style.display='none'" />
                                <div style="flex: 1; overflow: hidden;">
                                  <div style="font-size: 0.68rem; color: #e2e8f0; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.megaMenu.featuredCard.imageUrl.split('/').pop()}</div>
                                  <div style="font-size: 0.62rem; color: #94a3b8;">Preview attached</div>
                                </div>
                                <button type="button" class="del-mega-card-img" data-parent-idx="${idx}" style="background: transparent; border: none; color: #ef4444; cursor: pointer; font-size: 0.75rem; padding: 2px 4px;" title="Remove Image">✕</button>
                              </div>
                            ` : ''}
                          </div>
                        </div>
                      ` : `
                        <div style="font-size: 0.68rem; color: #94a3b8; font-style: italic;">
                          Switch toggle on to display a banner card on the right side of this mega menu.
                        </div>
                      `}
                    </div>
                  </div>
                ` : ''}
              </div>
            `;
          }).join('');

          // Wire up event listeners inside menu items
          wireMenuEvents();
        }

        function wireMenuEvents() {
          // Label changes
          document.querySelectorAll('.item-label-input').forEach(input => {
            input.addEventListener('input', (e) => {
              const idx = parseInt(e.target.dataset.idx, 10);
              activeHeader.menu[idx].label = e.target.value;
              renderLivePreview();
            });
          });

          // URL changes
          document.querySelectorAll('.item-url-input').forEach(input => {
            input.addEventListener('input', (e) => {
              const idx = parseInt(e.target.dataset.idx, 10);
              activeHeader.menu[idx].url = e.target.value;
              renderLivePreview();
            });
          });

          // Type changes
          document.querySelectorAll('.item-type-select').forEach(sel => {
            sel.addEventListener('change', (e) => {
              const idx = parseInt(e.target.dataset.idx, 10);
              const newType = e.target.value;
              activeHeader.menu[idx].type = newType;
              if (newType === 'dropdown' && !activeHeader.menu[idx].dropdownItems) {
                activeHeader.menu[idx].dropdownItems = [
                  { id: 'sub-1', label: 'Overview', url: '/' },
                  { id: 'sub-2', label: 'All Articles', url: '/blog' }
                ];
              }
              if (newType === 'megamenu' && !activeHeader.menu[idx].megaMenu) {
                activeHeader.menu[idx].megaMenu = {
                  columns: [
                    { title: 'Section 1', items: [{ label: 'Item A', url: '/' }] },
                    { title: 'Section 2', items: [{ label: 'Item B', url: '/blog' }] }
                  ]
                };
              }
              renderMenuItemsEditor();
              renderLivePreview();
            });
          });

          // Move Up / Down / Del
          document.querySelectorAll('.btn-move-up').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const idx = parseInt(e.currentTarget.dataset.idx, 10);
              if (idx > 0) {
                const temp = activeHeader.menu[idx];
                activeHeader.menu[idx] = activeHeader.menu[idx - 1];
                activeHeader.menu[idx - 1] = temp;
                renderMenuItemsEditor();
                renderLivePreview();
              }
            });
          });
          document.querySelectorAll('.btn-move-down').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const idx = parseInt(e.currentTarget.dataset.idx, 10);
              if (idx < activeHeader.menu.length - 1) {
                const temp = activeHeader.menu[idx];
                activeHeader.menu[idx] = activeHeader.menu[idx + 1];
                activeHeader.menu[idx + 1] = temp;
                renderMenuItemsEditor();
                renderLivePreview();
              }
            });
          });
          document.querySelectorAll('.btn-del').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const idx = parseInt(e.currentTarget.dataset.idx, 10);
              activeHeader.menu.splice(idx, 1);
              renderMenuItemsEditor();
              renderLivePreview();
            });
          });

          // Sub items
          document.querySelectorAll('.add-sub-item-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const pIdx = parseInt(e.currentTarget.dataset.parentIdx, 10);
              if (!activeHeader.menu[pIdx].dropdownItems) activeHeader.menu[pIdx].dropdownItems = [];
              activeHeader.menu[pIdx].dropdownItems.push({
                id: 'sub-' + Date.now(),
                label: 'New Link',
                url: '/blog'
              });
              renderMenuItemsEditor();
              renderLivePreview();
            });
