    <!-- TOAST NOTIFICATION -->
    <div class="builder-toast" id="builderToast"></div>

    <!-- PASS SERVER DATA TO CLIENT SCRIPT -->
    <script is:inline define:vars={{ initialFootersStore: footersStore, initialSiteConfig, availablePages, availablePosts, initialTemplates }}>
      window.__FP_FOOTERS_DATA__ = initialFootersStore;
      window.__FP_SITE_CONFIG__ = initialSiteConfig;
      window.__FP_PAGES__ = availablePages;
      window.__FP_POSTS__ = availablePosts;
      window.__FP_TEMPLATES__ = initialTemplates || [];
    </script>

    <!-- SCRIPTS -->
    <script is:inline>
      (function() {
        const store = window.__FP_FOOTERS_DATA__ || { activeFooterId: 'footer-saas-pro', footers: [] };
        let activeFooter = store.footers.find(f => f.id === store.activeFooterId) || store.footers[0];
        let globalSiteConfig = window.__FP_SITE_CONFIG__ || {};
        const availablePages = window.__FP_PAGES__ || [];
        const availablePosts = window.__FP_POSTS__ || [];

        let currentActiveTab = 'tab-presets';
        let currentViewportMode = 'desktop';
        let currentCcDevice = 'desktop';

        // Toast Helper
        function showToast(msg, isSuccess = true) {
          const toast = document.getElementById('builderToast');
          if (!toast) return;
          toast.textContent = msg;
          toast.style.background = isSuccess ? '#10b981' : '#ef4444';
          toast.style.display = 'block';
          clearTimeout(window.__toastTimeout);
          window.__toastTimeout = setTimeout(() => {
            toast.style.display = 'none';
          }, 3200);
        }

        // Studio Menu Toggle
        const studioBtn = document.getElementById('studioSwitcherBtn');
        const studioFlyout = document.getElementById('studioMenuFlyout');
        studioBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          studioFlyout?.classList.toggle('is-open');
        });
        document.addEventListener('click', () => {
          studioFlyout?.classList.remove('is-open');
        });

        // Tab Navigation
        document.querySelectorAll('.tab-btn[data-tab]').forEach(btn => {
          btn.addEventListener('click', () => {
            const tabId = btn.dataset.tab;
            document.querySelectorAll('.tab-btn[data-tab]').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.control-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            const panel = document.getElementById(tabId);
            if (panel) panel.classList.add('active');
            currentActiveTab = tabId;
          });
        });

        // Viewport Switcher
        document.querySelectorAll('.viewport-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const mode = btn.dataset.mode;
            document.querySelectorAll('.viewport-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentViewportMode = mode;
            const frame = document.getElementById('canvasViewportFrame');
            const dimLabel = document.getElementById('canvasViewportDimensions');
            if (frame) {
              frame.className = 'canvas-viewport-frame' + (mode === 'tablet' ? ' is-tablet' : (mode === 'mobile' ? ' is-mobile' : ''));
            }
            if (dimLabel) {
              dimLabel.textContent = mode === 'tablet' ? 'Tablet View (768px)' : (mode === 'mobile' ? 'Mobile View (375px)' : 'Desktop View (100% fluid)');
            }
            renderLivePreview();
          });
        });

        // Template Selection UI and Logic
        const chkUseFooterTemplate = document.getElementById('chkUseFooterTemplate');
        const footerTemplateDropdownWrap = document.getElementById('footerTemplateDropdownWrap');
        const selectFooterTemplate = document.getElementById('selectFooterTemplate');
        const btnOpenSelectedFooterTemplateStudio = document.getElementById('btnOpenSelectedFooterTemplateStudio');

        function populateFooterTemplatesDropdown() {
          if (!selectFooterTemplate) return;
          const templates = window.__FP_TEMPLATES__ || [];
          selectFooterTemplate.innerHTML = '';

          const footerTemplates = templates.filter(t => t.category === 'Footer' || t.id.includes('footer'));
          const otherTemplates = templates.filter(t => t.category !== 'Footer' && !t.id.includes('footer'));

          const optGroupFooter = document.createElement('optgroup');
          optGroupFooter.label = 'Footer Templates';
          footerTemplates.forEach(t => {
            const opt = document.createElement('option');
            opt.value = t.id;
            opt.textContent = `${t.name} (${t.type === 'global' ? 'Global' : 'Individual'})`;
            optGroupFooter.appendChild(opt);
          });
          selectFooterTemplate.appendChild(optGroupFooter);

          if (otherTemplates.length > 0) {
            const optGroupOther = document.createElement('optgroup');
            optGroupOther.label = 'Other Templates';
            otherTemplates.forEach(t => {
              const opt = document.createElement('option');
              opt.value = t.id;
              opt.textContent = `${t.name} (${t.category})`;
              optGroupOther.appendChild(opt);
            });
            selectFooterTemplate.appendChild(optGroupOther);
          }
        }

        populateFooterTemplatesDropdown();

        chkUseFooterTemplate?.addEventListener('change', () => {
          activeFooter.useTemplate = chkUseFooterTemplate.checked;
          if (activeFooter.useTemplate && !activeFooter.selectedTemplateId) {
            activeFooter.selectedTemplateId = selectFooterTemplate?.value || 'tpl-global-furnisite-footer';
          }
          if (footerTemplateDropdownWrap) {
            footerTemplateDropdownWrap.style.display = activeFooter.useTemplate ? 'block' : 'none';
          }
          if (btnOpenSelectedFooterTemplateStudio) {
            btnOpenSelectedFooterTemplateStudio.href = `/template-editor?id=${activeFooter.selectedTemplateId || selectFooterTemplate?.value || 'tpl-global-furnisite-footer'}`;
          }
          renderLivePreview();
        });

        selectFooterTemplate?.addEventListener('change', () => {
          activeFooter.selectedTemplateId = selectFooterTemplate.value;
          if (btnOpenSelectedFooterTemplateStudio) {
            btnOpenSelectedFooterTemplateStudio.href = `/template-editor?id=${activeFooter.selectedTemplateId}`;
          }
          renderLivePreview();
        });

        // Logo Selection UI and Logic
        function updateLogoUI() {
          const badge = document.getElementById('globalLogoStatusBadge');
          const imgThumb = document.getElementById('imgGlobalLogoThumb');
          const txtFallback = document.getElementById('txtGlobalLogoFallback');
          const lblBrand = document.getElementById('lblGlobalLogoBrand');
          const lblStatus = document.getElementById('lblGlobalLogoStatus');

          const btnDefault = document.getElementById('btnLogoSourceDefault');
          const btnCustom = document.getElementById('btnLogoSourceCustom');
          const panelDefault = document.getElementById('secDefaultLogoPanel');
          const panelCustom = document.getElementById('secCustomLogoPanel');
          const customWrap = document.getElementById('customLogoPreviewWrap');
          const imgCustom = document.getElementById('imgCustomLogoThumb');
          const lblCustomPath = document.getElementById('lblCustomLogoPath');

          const gLogo = (globalSiteConfig.logoUrl || '').trim();
          const gBrand = globalSiteConfig.brandName || 'Better SaaS';
          const isCustom = activeFooter.logo?.source === 'custom';
          const customImg = (activeFooter.logo?.imageUrl || '').trim();

          if (lblBrand) lblBrand.textContent = gBrand;

          if (gLogo) {
            if (imgThumb) {
              imgThumb.src = gLogo;
              imgThumb.style.display = 'block';
            }
            if (txtFallback) txtFallback.style.display = 'none';
          } else {
            if (imgThumb) {
              imgThumb.style.display = 'none';
              imgThumb.src = '';
            }
            if (txtFallback) {
              txtFallback.style.display = 'block';
              txtFallback.textContent = gBrand.charAt(0).toUpperCase();
            }
          }

          if (isCustom) {
            if (btnDefault) {
              btnDefault.classList.remove('active');
              btnDefault.style.background = 'transparent';
              btnDefault.style.color = '#94a3b8';
            }
            if (btnCustom) {
              btnCustom.classList.add('active');
              btnCustom.style.background = '#1f2738';
              btnCustom.style.color = '#f8fafc';
            }
            if (panelDefault) panelDefault.style.display = 'none';
            if (panelCustom) panelCustom.style.display = 'block';

            if (customImg) {
              if (customWrap) customWrap.style.display = 'flex';
              if (imgCustom) imgCustom.src = customImg;
              if (lblCustomPath) lblCustomPath.textContent = customImg;
            } else {
              if (customWrap) customWrap.style.display = 'none';
            }
          } else {
            if (btnDefault) {
              btnDefault.classList.add('active');
              btnDefault.style.background = '#1f2738';
              btnDefault.style.color = '#f8fafc';
            }
            if (btnCustom) {
              btnCustom.classList.remove('active');
              btnCustom.style.background = 'transparent';
              btnCustom.style.color = '#94a3b8';
            }
            if (panelDefault) panelDefault.style.display = 'block';
            if (panelCustom) panelCustom.style.display = 'none';

            if (customWrap) customWrap.style.display = 'none';
          }
        }

        function setFooterLogoMode(mode) {
          if (!activeFooter.logo) activeFooter.logo = { source: 'default', imageUrl: '', brandName: '', tagline: '', linkUrl: '/' };
          activeFooter.logo.source = mode;
          const inp = document.getElementById('inputFooterLogoImg');
          if (mode === 'default') {
            activeFooter.logo.imageUrl = '';
            if (inp) inp.value = '';
            updateLogoUI();
            renderLivePreview();
            showToast('✓ Using Default Logo from Web Settings');
          } else {
            updateLogoUI();
            renderLivePreview();
            if (inp && !inp.value) inp.focus();
            showToast('✓ Custom Logo mode active. Upload or pick an image.');
          }
        }

        document.getElementById('btnLogoSourceDefault')?.addEventListener('click', () => setFooterLogoMode('default'));
        document.getElementById('btnLogoSourceCustom')?.addEventListener('click', () => setFooterLogoMode('custom'));
        document.getElementById('btnRevertToDefaultLogo')?.addEventListener('click', () => setFooterLogoMode('default'));
        document.getElementById('btnClearCustomLogoThumb')?.addEventListener('click', () => setFooterLogoMode('default'));

        // Direct File Upload for Footer Logo
        const fileInputLogo = document.getElementById('inputDirectFooterLogoFile');
        const btnUploadLogo = document.getElementById('btnUploadFooterLogoDirect');

        btnUploadLogo?.addEventListener('click', () => {
          fileInputLogo?.click();
        });

        fileInputLogo?.addEventListener('change', async (e) => {
          const file = e.target.files?.[0];
          if (!file) return;

          if (file.size > 200 * 1024) {
            showToast('⚠️ Image exceeds 200 KB limit. Please choose a smaller file.', false);
            fileInputLogo.value = '';
            return;
          }

          const originalBtnHtml = btnUploadLogo.innerHTML;
          btnUploadLogo.disabled = true;
          btnUploadLogo.innerHTML = '⏳ Uploading...';

          try {
            const formData = new FormData();
            formData.append('file', file);
            const res = await fetch('/api/upload', {
              method: 'POST',
              body: formData,
            });
            const data = await res.json();
            if (data.success && data.url) {
              if (!activeFooter.logo) activeFooter.logo = { source: 'custom', imageUrl: '', brandName: '', tagline: '', linkUrl: '/' };
              activeFooter.logo.source = 'custom';
              activeFooter.logo.imageUrl = data.url;
              const inp = document.getElementById('inputFooterLogoImg');
              if (inp) inp.value = data.url;
              updateLogoUI();
              renderLivePreview();
              showToast('✓ Footer logo uploaded successfully!');
            } else {
              showToast('Upload failed: ' + (data.error || 'Unknown error'), false);
            }
          } catch (err) {
            showToast('Upload error: ' + err.message, false);
          } finally {
            btnUploadLogo.disabled = false;
            btnUploadLogo.innerHTML = originalBtnHtml;
            fileInputLogo.value = '';
          }
        });

        document.getElementById('btnOpenWebConfigFromLogo')?.addEventListener('click', () => {
          window.FastPressCustomCode?.open({ scope: 'global', initialTab: 'web-config' });
        });

        window.addEventListener('fastpress:siteConfigUpdated', (e) => {
          if (e.detail) {
            globalSiteConfig = Object.assign(globalSiteConfig, e.detail);
            updateLogoUI();
            renderLivePreview();
            showToast('✓ Footer synced with updated Web Config');
          }
        });

        // Populate Form from activeFooter
        function populateForm() {
          const f = activeFooter;

          // Template Option Setting
          if (chkUseFooterTemplate) {
            chkUseFooterTemplate.checked = Boolean(f.useTemplate);
          }
          if (footerTemplateDropdownWrap) {
            footerTemplateDropdownWrap.style.display = f.useTemplate ? 'block' : 'none';
          }
          if (selectFooterTemplate) {
            if (f.selectedTemplateId) {
              selectFooterTemplate.value = f.selectedTemplateId;
            } else if (selectFooterTemplate.options.length > 0) {
              selectFooterTemplate.selectedIndex = 0;
              if (f.useTemplate) f.selectedTemplateId = selectFooterTemplate.value;
            }
          }
          if (btnOpenSelectedFooterTemplateStudio) {
            btnOpenSelectedFooterTemplateStudio.href = `/template-editor?id=${f.selectedTemplateId || selectFooterTemplate?.value || 'tpl-global-furnisite-footer'}`;
          }

          // Preset cards highlight
          document.querySelectorAll('.preset-card').forEach(c => {
            c.classList.toggle('active', c.dataset.preset === f.id);
          });

          // Layout
          document.querySelectorAll('.radio-card-btn[data-layout]').forEach(b => {
            b.classList.toggle('active', b.dataset.layout === (f.layout?.type || 'columns-with-newsletter'));
          });
          document.getElementById('selectContainerType').value = f.layout?.containerType || 'boxed';
          document.getElementById('inputColumnsCount').value = f.layout?.columnsCount || 3;
          document.getElementById('valColumnsCount').textContent = f.layout?.columnsCount || 3;
          document.getElementById('inputPaddingTop').value = f.layout?.paddingTop || 64;
          document.getElementById('valPaddingTop').textContent = (f.layout?.paddingTop || 64) + 'px';
          document.getElementById('inputPaddingBottom').value = f.layout?.paddingBottom || 32;
          document.getElementById('valPaddingBottom').textContent = (f.layout?.paddingBottom || 32) + 'px';
          document.getElementById('checkBackToTop').checked = Boolean(f.layout?.showBackToTop !== false);

          // Logo & Bio
          if (!f.logo) f.logo = { source: 'default', imageUrl: '', brandName: 'Better SaaS', tagline: '', linkUrl: '/' };
          if (!f.logo.source) {
            f.logo.source = f.logo.imageUrl ? 'custom' : 'default';
          }
          document.getElementById('inputBrandName').value = f.logo?.brandName || 'Better SaaS';
          document.getElementById('inputTagline').value = f.logo?.tagline || '';
          document.getElementById('inputLogoUrl').value = f.logo?.linkUrl || '/';
          const inpLogoImg = document.getElementById('inputFooterLogoImg');
          if (inpLogoImg) inpLogoImg.value = f.logo?.imageUrl || '';
          updateLogoUI();

          document.getElementById('checkAboutEnabled').checked = Boolean(f.about?.enabled !== false);
          document.getElementById('inputAboutDesc').value = f.about?.description || '';
          document.getElementById('inputAboutEmail').value = f.about?.email || '';
          document.getElementById('inputAboutPhone').value = f.about?.phone || '';
          document.getElementById('inputAboutAddress').value = f.about?.address || '';

          // Newsletter
          document.getElementById('checkNewsletterEnabled').checked = Boolean(f.newsletter?.enabled);
          document.getElementById('inputNewsletterTitle').value = f.newsletter?.title || 'Stay in the Loop';
          document.getElementById('inputNewsletterDesc').value = f.newsletter?.description || '';
          document.getElementById('inputNewsletterPlaceholder').value = f.newsletter?.placeholder || '';
          document.getElementById('inputNewsletterButtonText').value = f.newsletter?.buttonText || 'Subscribe';
          document.getElementById('inputNewsletterActionUrl').value = f.newsletter?.actionUrl || '#';

          // Social & Bottom Bar
          document.getElementById('checkSocialEnabled').checked = Boolean(f.social?.enabled !== false);
          document.getElementById('checkBottomBarEnabled').checked = Boolean(f.bottomBar?.enabled !== false);
          document.getElementById('checkBottomBarYear').checked = Boolean(f.bottomBar?.showYear !== false);
          document.getElementById('inputBottomBarCompany').value = f.bottomBar?.companyName || 'Better Corp Inc.';
          document.getElementById('inputBottomBarCopyright').value = f.bottomBar?.copyrightText || 'All Rights Reserved.';

          // Styling
          document.getElementById('inputBgColor').value = f.styling?.bgColor || '#0f1219';
          document.getElementById('pickerBgColor').value = f.styling?.bgColor || '#0f1219';
          document.getElementById('inputHeadingColor').value = f.styling?.headingColor || '#f8fafc';
          document.getElementById('pickerHeadingColor').value = f.styling?.headingColor || '#f8fafc';
          document.getElementById('inputTextColor').value = f.styling?.textColor || '#94a3b8';
          document.getElementById('pickerTextColor').value = f.styling?.textColor || '#94a3b8';
          document.getElementById('inputAccentColor').value = f.styling?.accentColor || '#ff5e3a';
          document.getElementById('pickerAccentColor').value = f.styling?.accentColor || '#ff5e3a';
