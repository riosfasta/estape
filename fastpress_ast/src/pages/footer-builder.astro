            const tplId = f.selectedTemplateId || (selectFooterTemplate ? selectFooterTemplate.value : 'tpl-global-furnisite-footer');
            const foundTpl = (window.__FP_TEMPLATES__ || []).find(t => t.id === tplId);
            if (foundTpl) {
              container.innerHTML = `
                <div class="template-footer-render-outer" style="position: relative; width: 100%;">
                  <div style="position: absolute; top: 12px; right: 16px; z-index: 50; display: inline-flex; align-items: center; gap: 8px; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(6px); border: 1px solid rgba(99, 102, 241, 0.45); padding: 5px 12px; border-radius: 9999px; box-shadow: 0 4px 14px rgba(0,0,0,0.35);">
                    <span style="width: 7px; height: 7px; border-radius: 50%; background: #10b981;"></span>
                    <span style="font-size: 0.72rem; color: #c7d2fe; font-weight: 700;">Template: ${foundTpl.name}</span>
                    <a href="/template-editor?id=${foundTpl.id}" target="_blank" style="color: #ffffff; background: #6366f1; padding: 2px 8px; border-radius: 4px; font-size: 0.68rem; font-weight: 700; text-decoration: none; margin-left: 4px;">Edit in Studio &rarr;</a>
                  </div>
                  <style>${foundTpl.css || ''}</style>
                  ${foundTpl.html}
                </div>
              `;
              return;
            } else {
              container.innerHTML = `
                <div style="padding: 40px; text-align: center; color: #94a3b8; background: #0f1219; border: 1px dashed #334155; border-radius: 8px; margin: 20px;">
                  <div style="font-size: 1.1rem; font-weight: 700; color: #f8fafc; margin-bottom: 6px;">Template Not Found (${tplId})</div>
                  <div style="font-size: 0.85rem;">Please select an available footer template from the dropdown list.</div>
                </div>
              `;
              return;
            }
          }

          const isCustomCode = (f.builderType === 'custom-code' || f.customCode?.enabled);

          // Effective Logo & Brand
          const effectiveLogo = (f.logo?.source === 'custom')
            ? (f.logo?.imageUrl ? f.logo.imageUrl.trim() : '')
            : (globalSiteConfig.logoUrl ? globalSiteConfig.logoUrl.trim() : (f.logo?.imageUrl ? f.logo.imageUrl.trim() : ''));

          const effectiveBrand = (f.logo?.brandName && f.logo?.brandName.trim()) || globalSiteConfig.brandName || 'Better SaaS';
          const effectiveTag = f.logo?.tagline !== undefined && f.logo?.tagline !== '' ? f.logo.tagline : (globalSiteConfig.tagline || '');
          const currentYear = new Date().getFullYear();

          const activeSocial = (f.social?.links || []).filter(s => s.enabled && s.href);

          const maxW = f.layout?.containerType === 'full' ? '100%' : (f.layout?.containerType === 'wide' ? '1440px' : '1200px');
          const colsCount = f.layout?.columnsCount || 3;

          if (isCustomCode) {
            const cc = f.customCode || {};
            let htmlToRender = cc.desktopHtml || '<div style="padding: 40px; text-align: center; color: #64748b;">Custom Code Footer (Empty)</div>';
            if (currentViewportMode === 'tablet' && cc.tabletHtml) htmlToRender = cc.tabletHtml;
            if (currentViewportMode === 'mobile' && cc.mobileHtml) htmlToRender = cc.mobileHtml;

            container.innerHTML = `
              <div style="background: ${f.styling?.bgColor || '#0f1219'}; color: ${f.styling?.textColor || '#94a3b8'}; font-family: '${f.styling?.fontFamily || 'Plus Jakarta Sans'}', sans-serif;">
                <style>${cc.customCss || ''}</style>
                <div style="max-width: ${maxW}; margin: 0 auto; padding-inline: 1.5rem;">
                  ${htmlToRender}
                </div>
              </div>
            `;
            return;
          }

          // Visual Layout Renderer
          let mainContentHtml = '';

          // Brand markup
          const brandMarkup = `
            <a href="${f.logo?.linkUrl || '/'}" style="display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; margin-bottom: 1rem;">
              ${effectiveLogo ? `
                <img src="${effectiveLogo}" alt="${effectiveBrand}" style="max-height: 38px; width: auto; object-fit: contain;" />
              ` : `
                <span style="display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; background: linear-gradient(135deg, #ff5e3a 0%, #ff8c42 100%); color: #ffffff; font-size: 1.25rem; font-weight: 800; border-radius: 10px; box-shadow: 0 4px 12px rgba(255, 94, 58, 0.3);">${effectiveBrand.charAt(0).toUpperCase()}</span>
              `}
              <div style="display: flex; flex-direction: column;">
                <span style="font-size: 1.15rem; font-weight: 800; color: ${f.styling?.headingColor || '#f8fafc'}; line-height: 1.2; letter-spacing: -0.02em;">${effectiveBrand}</span>
                ${effectiveTag ? `<span style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: ${f.styling?.mutedColor || '#64748b'};">${effectiveTag}</span>` : ''}
              </div>
            </a>
          `;

          // Social icons markup
          const socialMarkup = activeSocial.length > 0 ? `
            <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
              ${activeSocial.map(s => `
                <a href="${s.href}" target="_blank" style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; color: ${f.styling?.textColor || '#94a3b8'}; background: rgba(255, 255, 255, 0.05); border: 1px solid ${f.styling?.borderColor || 'rgba(255,255,255,0.08)'}; text-decoration: none; transition: all 0.2s;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    ${socialSvgMap[s.name] || socialSvgMap.Facebook}
                  </svg>
                </a>
              `).join('')}
            </div>
          ` : '';

          if (f.layout?.type === 'centered') {
            mainContentHtml = `
              <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.25rem; margin-bottom: 2.5rem;">
                ${brandMarkup}
                ${f.about?.enabled && f.about?.description ? `<p style="color: ${f.styling?.textColor || '#94a3b8'}; line-height: 1.6; max-width: 500px; margin: 0 auto;">${f.about.description}</p>` : ''}
                <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem;">
                  ${(f.columns || []).flatMap(c => c.links || []).map(l => `
                    <a href="${l.url}" style="color: ${f.styling?.textColor || '#94a3b8'}; text-decoration: none; font-size: 0.88rem; transition: color 0.15s;">${l.label}</a>
                  `).join('')}
                </div>
                ${f.social?.enabled ? socialMarkup : ''}
              </div>
            `;
          } else if (f.layout?.type === 'simple-inline') {
            mainContentHtml = `
              <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem;">
                <div>${brandMarkup}</div>
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;">
                  ${(f.columns || []).flatMap(c => c.links || []).map(l => `
                    <a href="${l.url}" style="color: ${f.styling?.textColor || '#94a3b8'}; text-decoration: none; font-size: 0.88rem;">${l.label}</a>
                  `).join('')}
                </div>
                <div>${f.social?.enabled ? socialMarkup : ''}</div>
              </div>
            `;
          } else {
            // Multi-Column (with or without newsletter)
            const hasNewsletter = (f.layout?.type === 'columns-with-newsletter' && f.newsletter?.enabled);
            const isMob = currentViewportMode === 'mobile';
            const isTab = currentViewportMode === 'tablet';

            let gridTemplate = isMob ? '1fr' : (isTab ? 'repeat(2, 1fr)' : (hasNewsletter ? `1.2fr repeat(${colsCount - 1}, 1fr) 1.4fr` : `1.4fr repeat(${colsCount}, 1fr)`));

            mainContentHtml = `
              <div style="display: grid; grid-template-columns: ${gridTemplate}; gap: 2.5rem; margin-bottom: 3rem;">
                <!-- Brand & About -->
                ${f.about?.enabled ? `
                  <div>
                    ${brandMarkup}
                    ${f.about.description ? `<p style="color: ${f.styling?.textColor || '#94a3b8'}; line-height: 1.6; margin-bottom: 1.25rem; max-width: 340px;">${f.about.description}</p>` : ''}
                    ${(f.about.email || f.about.phone || f.about.address) ? `
                      <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem;">
                        ${f.about.email ? `
                          <a href="mailto:${f.about.email}" style="display: inline-flex; align-items: center; gap: 0.6rem; color: ${f.styling?.textColor || '#94a3b8'}; text-decoration: none; font-size: 0.84rem;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="${f.styling?.accentColor || '#ff5e3a'}" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            <span>${f.about.email}</span>
                          </a>
                        ` : ''}
                        ${f.about.phone ? `
                          <a href="tel:${f.about.phone}" style="display: inline-flex; align-items: center; gap: 0.6rem; color: ${f.styling?.textColor || '#94a3b8'}; text-decoration: none; font-size: 0.84rem;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="${f.styling?.accentColor || '#ff5e3a'}" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            <span>${f.about.phone}</span>
                          </a>
                        ` : ''}
                        ${f.about.address ? `
                          <div style="display: inline-flex; align-items: center; gap: 0.6rem; color: ${f.styling?.textColor || '#94a3b8'}; font-size: 0.84rem;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="${f.styling?.accentColor || '#ff5e3a'}" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            <span>${f.about.address}</span>
                          </div>
                        ` : ''}
                      </div>
                    ` : ''}
                    ${f.social?.enabled ? socialMarkup : ''}
                  </div>
                ` : ''}

                <!-- Columns -->
                ${(f.columns || []).map(col => `
                  <div>
                    <h4 style="font-size: 0.92rem; font-weight: 700; color: ${f.styling?.headingColor || '#f8fafc'}; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.25rem;">${col.title}</h4>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
                      ${(col.links || []).map(link => `
                        <li>
                          <a href="${link.url}" target="${link.target || '_self'}" style="color: ${f.styling?.textColor || '#94a3b8'}; text-decoration: none; font-size: 0.88rem; transition: color 0.15s;">
                            ${link.label}
                          </a>
                        </li>
                      `).join('')}
                    </ul>
                  </div>
                `).join('')}

                <!-- Newsletter Column -->
                ${hasNewsletter ? `
                  <div>
                    <h4 style="font-size: 0.92rem; font-weight: 700; color: ${f.styling?.headingColor || '#f8fafc'}; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.25rem;">${f.newsletter.title}</h4>
                    <p style="color: ${f.styling?.textColor || '#94a3b8'}; line-height: 1.6; margin-bottom: 1rem; font-size: 0.86rem;">${f.newsletter.description}</p>
                    <form onsubmit="event.preventDefault(); alert('Test: Subscription submitted!');" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                      <input type="email" placeholder="${f.newsletter.placeholder || 'Enter your email...'}" required style="flex: 1; min-width: 160px; padding: 0.75rem 1rem; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid ${f.styling?.borderColor || 'rgba(255,255,255,0.1)'}; color: #fff; font-size: 0.85rem; outline: none;" />
                      <button type="submit" style="padding: 0.75rem 1.25rem; border-radius: 8px; background: ${f.styling?.accentColor || '#ff5e3a'}; color: #fff; font-weight: 600; font-size: 0.85rem; border: none; cursor: pointer; white-space: nowrap;">
                        ${f.newsletter.buttonText || 'Subscribe'}
                      </button>
                    </form>
                  </div>
                ` : ''}
              </div>
            `;
          }

          // Bottom Bar markup
          const bottomBarHtml = f.bottomBar?.enabled ? `
            <div style="padding-top: 1.75rem; border-top: 1px solid ${f.styling?.borderColor || 'rgba(255,255,255,0.08)'}; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; font-size: 0.8rem;">
              <p style="color: ${f.styling?.mutedColor || '#64748b'}; margin: 0;">
                &copy; ${f.bottomBar.showYear !== false ? currentYear : ''} ${f.bottomBar.companyName}. ${f.bottomBar.copyrightText}
              </p>

              ${f.bottomBar.links && f.bottomBar.links.length > 0 ? `
                <div style="display: flex; flex-wrap: wrap; gap: 1.25rem;">
                  ${f.bottomBar.links.map(l => `
                    <a href="${l.url}" style="color: ${f.styling?.mutedColor || '#64748b'}; text-decoration: none; transition: color 0.15s;">${l.label}</a>
                  `).join('')}
                </div>
              ` : ''}

              ${f.layout?.showBackToTop !== false ? `
                <a href="#canvasScrollContainer" onclick="document.getElementById('canvasScrollContainer').scrollTo({top: 0, behavior: 'smooth'}); return false;" style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 6px; color: ${f.styling?.textColor || '#94a3b8'}; background: rgba(255,255,255,0.05); border: 1px solid ${f.styling?.borderColor || 'rgba(255,255,255,0.08)'}; text-decoration: none;" title="Scroll to top">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
                </a>
              ` : ''}
            </div>
          ` : '';

          container.innerHTML = `
            <footer style="background-color: ${f.styling?.bgColor || '#0f1219'}; color: ${f.styling?.textColor || '#94a3b8'}; font-family: '${f.styling?.fontFamily || 'Plus Jakarta Sans'}', sans-serif; font-size: ${f.styling?.fontSize || '0.88rem'}; border-top: 1px solid ${f.styling?.borderColor || 'rgba(255,255,255,0.08)'}; padding-top: ${f.layout?.paddingTop || 64}px; padding-bottom: ${f.layout?.paddingBottom || 32}px; box-sizing: border-box;">
              <div style="max-width: ${maxW}; margin: 0 auto; padding-inline: 1.5rem;">
                ${mainContentHtml}
                ${bottomBarHtml}
              </div>
            </footer>
          `;
        }

        // ==========================================
        // RESOURCE PICKER MODAL (PAGES & BLOG POSTS)
        // ==========================================
        let currentResourceTargetInputId = null;
        let selectedResourceUrl = null;
        let currentResourceType = 'pages';

        const resourceModal = document.getElementById('resourcePickerModal');
        const resList = document.getElementById('resourceItemsList');
        const inputSearchRes = document.getElementById('inputSearchResources');

        function openResourceModal(targetInputId) {
          currentResourceTargetInputId = targetInputId;
          selectedResourceUrl = null;
          if (resourceModal) resourceModal.classList.add('is-open');
          renderResourceList();
        }

        function closeResourceModal() {
          if (resourceModal) resourceModal.classList.remove('is-open');
          currentResourceTargetInputId = null;
          selectedResourceUrl = null;
        }

        document.getElementById('btnCloseResourceModal')?.addEventListener('click', closeResourceModal);
        document.getElementById('btnCancelResourceModal')?.addEventListener('click', closeResourceModal);
        resourceModal?.addEventListener('click', (e) => {
          if (e.target === resourceModal) closeResourceModal();
        });

        document.querySelectorAll('.res-tab-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.res-tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentResourceType = btn.dataset.resType;
            renderResourceList();
          });
        });

        inputSearchRes?.addEventListener('input', () => {
          renderResourceList();
        });

        function renderResourceList() {
          if (!resList) return;
          const q = (inputSearchRes?.value || '').toLowerCase().trim();
          const items = currentResourceType === 'pages' ? availablePages : availablePosts;

          const filtered = items.filter(it => (it.title || '').toLowerCase().includes(q) || (it.url || '').toLowerCase().includes(q));

          if (filtered.length === 0) {
            resList.innerHTML = '<div style="padding: 20px; text-align: center; color: #64748b; font-size: 0.8rem;">No items found.</div>';
            return;
          }

          resList.innerHTML = filtered.map(item => `
            <div class="res-item-row" data-url="${item.url}" style="padding: 8px 12px; background: #0c0f17; border: 1px solid #1c2433; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; transition: all 0.15s;">
              <div>
                <div style="font-size: 0.82rem; font-weight: 600; color: #f3f4f6;">${item.title}</div>
                <div style="font-size: 0.72rem; color: #64748b; font-family: monospace;">${item.url}</div>
              </div>
              <span style="font-size: 0.72rem; color: #ff5e3a;">Pick ➔</span>
            </div>
          `).join('');

          resList.querySelectorAll('.res-item-row').forEach(row => {
            row.addEventListener('click', () => {
              resList.querySelectorAll('.res-item-row').forEach(r => {
                r.style.borderColor = '#1c2433';
                r.style.background = '#0c0f17';
              });
              row.style.borderColor = '#ff5e3a';
              row.style.background = '#1a2233';
              selectedResourceUrl = row.dataset.url;
            });
          });
        }

        document.getElementById('btnSelectResource')?.addEventListener('click', () => {
          if (!selectedResourceUrl) {
            showToast('Please select a page or post first.', false);
            return;
          }
          if (currentResourceTargetInputId) {
            const input = document.getElementById(currentResourceTargetInputId);
            if (input) {
              input.value = selectedResourceUrl;
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
          closeResourceModal();
          showToast('✓ Link URL applied!');
        });

        // ==========================================
        // MEDIA PICKER MODAL
        // ==========================================
        let currentMediaTargetInputId = null;
        let selectedMediaUrl = null;

        const mediaModal = document.getElementById('mediaPickerModal');
        const mediaGrid = document.getElementById('mediaGrid');
        const mediaFileInput = document.getElementById('mediaFileInput');
        const mediaDropzone = document.getElementById('mediaDropzone');

        function openMediaModal(targetInputId) {
          currentMediaTargetInputId = targetInputId;
          selectedMediaUrl = null;
          if (mediaModal) mediaModal.classList.add('is-open');
          loadMediaList();
        }

        function closeMediaModal() {
          if (mediaModal) mediaModal.classList.remove('is-open');
          currentMediaTargetInputId = null;
          selectedMediaUrl = null;
        }

        document.getElementById('btnCloseMediaModal')?.addEventListener('click', closeMediaModal);
        document.getElementById('btnCancelMediaModal')?.addEventListener('click', closeMediaModal);
        mediaModal?.addEventListener('click', (e) => {
          if (e.target === mediaModal) closeMediaModal();
        });

        document.querySelectorAll('.pick-media-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            openMediaModal(btn.dataset.target);
          });
        });

        async function loadMediaList() {
          if (!mediaGrid) return;
          mediaGrid.innerHTML = '<div style="grid-column: 1/-1; padding: 20px; text-align: center; color: #64748b;">Loading images...</div>';
          try {
            const res = await fetch('/api/upload');
            const data = await res.json();
            if (Array.isArray(data) && data.length > 0) {
              mediaGrid.innerHTML = data.map(item => `
                <div class="media-thumb-item" data-url="${item.url}" style="height: 80px; background: #0c0f17; border: 1px solid #1c2433; border-radius: 6px; overflow: hidden; cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative;">
                  <img src="${item.url}" alt="${item.fileName}" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                </div>
              `).join('');

              mediaGrid.querySelectorAll('.media-thumb-item').forEach(thumb => {
                thumb.addEventListener('click', () => {
                  mediaGrid.querySelectorAll('.media-thumb-item').forEach(t => t.style.border = '1px solid #1c2433');
                  thumb.style.border = '2px solid #ff5e3a';
                  selectedMediaUrl = thumb.dataset.url;
                });
              });
            } else {
              mediaGrid.innerHTML = '<div style="grid-column: 1/-1; padding: 20px; text-align: center; color: #64748b;">No uploaded images found. Click above to upload one!</div>';
            }
          } catch {
            mediaGrid.innerHTML = '<div style="grid-column: 1/-1; padding: 20px; text-align: center; color: #ef4444;">Failed to load media.</div>';
          }
        }

        mediaDropzone?.addEventListener('click', () => mediaFileInput?.click());
        mediaFileInput?.addEventListener('change', async (e) => {
          const file = e.target.files?.[0];
          if (!file) return;

          if (file.size > 200 * 1024) {
            showToast('⚠️ Image exceeds 200 KB limit.', false);
            mediaFileInput.value = '';
            return;
          }

          try {
            const formData = new FormData();
            formData.append('file', file);
            const res = await fetch('/api/upload', {
              method: 'POST',
              body: formData,
            });
            const data = await res.json();
            if (data.success && data.url) {
              showToast('✓ Image uploaded!');
              loadMediaList();
              selectedMediaUrl = data.url;
            } else {
              showToast('Upload error: ' + (data.error || 'Failed'), false);
            }
          } catch (err) {
            showToast('Error uploading image: ' + err.message, false);
          } finally {
            mediaFileInput.value = '';
          }
        });

        document.getElementById('btnApplySelectedMedia')?.addEventListener('click', () => {
          if (!selectedMediaUrl) {
            showToast('Please select or upload an image first.', false);
            return;
          }
          if (currentMediaTargetInputId) {
            const input = document.getElementById(currentMediaTargetInputId);
            if (input) {
              input.value = selectedMediaUrl;
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
          closeMediaModal();
          showToast('✓ Image applied!');
        });

        // ==========================================
        // FOOTER MANAGEMENT (SAVE, ACTIVATE, DUPLICATE, DELETE)
        // ==========================================
        function updateActiveButtonState() {
          const btn = document.getElementById('setActiveBtn');
          const btnText = document.getElementById('activeBtnText');
          if (!btn || !btnText) return;

          const isActive = store.activeFooterId === activeFooter.id;
          btn.classList.toggle('is-active', isActive);
          btnText.textContent = isActive ? '★ Active on Live Site' : 'Set Active Site Footer';
        }

        // Switch Footer from select
        document.getElementById('footerSelect')?.addEventListener('change', (e) => {
          const id = e.target.value;
          const found = store.footers.find(f => f.id === id);
          if (found) {
            activeFooter = JSON.parse(JSON.stringify(found));
            populateForm();
            showToast(`✓ Switched to ${found.name}`);
          }
        });

        // Save Footer
        document.getElementById('saveFooterBtn')?.addEventListener('click', async () => {
          const btn = document.getElementById('saveFooterBtn');
          btn.disabled = true;
          btn.innerHTML = '<span>Saving...</span>';

          try {
            const res = await fetch('/api/footers', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(activeFooter),
            });
            const data = await res.json();
            if (data.success) {
              store.footers = data.footers;
              store.activeFooterId = data.activeFooterId;
              refreshFooterSelect();
              updateActiveButtonState();
              showToast('✓ Footer saved successfully!');
            } else {
              showToast('Failed to save footer: ' + (data.error || 'Unknown error'), false);
            }
          } catch (err) {
            showToast('Save error: ' + err.message, false);
          } finally {
            btn.disabled = false;
            btn.innerHTML = '<span>Save Footer</span>';
          }
        });

        // Set Active Site Footer
        document.getElementById('setActiveBtn')?.addEventListener('click', async () => {
          if (store.activeFooterId === activeFooter.id) return;

          try {
            const res = await fetch('/api/footers', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ activeFooterId: activeFooter.id }),
            });
            const data = await res.json();
            if (data.success) {
              store.activeFooterId = activeFooter.id;
              store.footers = data.footers;
              refreshFooterSelect();
              updateActiveButtonState();
              showToast('★ This footer is now ACTIVE on the live website!');
            }
          } catch (err) {
            showToast('Failed to activate footer: ' + err.message, false);
          }
        });

        // Duplicate Footer
        document.getElementById('duplicateFooterBtn')?.addEventListener('click', async () => {
          try {
            const res = await fetch('/api/footers', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'duplicate', id: activeFooter.id }),
            });
            const data = await res.json();
            if (data.success && data.footer) {
              store.footers.push(data.footer);
              activeFooter = JSON.parse(JSON.stringify(data.footer));
              refreshFooterSelect();
              populateForm();
              showToast(`✓ Duplicated as "${data.footer.name}"`);
            }
          } catch (err) {
            showToast('Failed to duplicate: ' + err.message, false);
          }
        });

        // Delete Footer
        document.getElementById('deleteFooterBtn')?.addEventListener('click', async () => {
          if (store.footers.length <= 1) {
            showToast('Cannot delete the only remaining footer.', false);
            return;
          }
          if (!confirm(`Are you sure you want to delete "${activeFooter.name}"?`)) return;

          try {
            const res = await fetch(`/api/footers?id=${encodeURIComponent(activeFooter.id)}`, {
              method: 'DELETE',
            });
            const data = await res.json();
            if (data.success) {
              store.footers = data.footers;
              store.activeFooterId = data.activeFooterId;
              activeFooter = JSON.parse(JSON.stringify(store.footers.find(f => f.id === store.activeFooterId) || store.footers[0]));
              refreshFooterSelect();
              populateForm();
              showToast('✓ Footer deleted successfully.');
            } else {
              showToast('Delete failed: ' + (data.error || 'Unknown error'), false);
            }
          } catch (err) {
            showToast('Delete error: ' + err.message, false);
          }
        });

        // New Footer
        document.getElementById('newFooterBtn')?.addEventListener('click', () => {
          const newId = 'footer-' + Date.now();
          const newFooter = {
            id: newId,
            name: `Custom Footer ${store.footers.length + 1}`,
            isActive: false,
            builderType: 'visual',
            layout: {
              type: 'columns-with-newsletter',
              containerType: 'boxed',
              columnsCount: 3,
              paddingTop: 64,
              paddingBottom: 32,
              showBackToTop: true,
            },
            styling: {
              bgColor: '#0f1219',
              textColor: '#94a3b8',
              headingColor: '#f8fafc',
              mutedColor: '#64748b',
              accentColor: '#ff5e3a',
              borderColor: 'rgba(255, 255, 255, 0.08)',
              fontFamily: 'Plus Jakarta Sans',
              fontSize: '0.88rem',
            },
            logo: {
              source: 'default',
              imageUrl: '',
              brandName: 'Better SaaS',
              tagline: 'Modern Platform',
              linkUrl: '/',
            },
            about: {
              enabled: true,
              description: 'The modern visual website builder and CMS for high-performance Astro web applications.',
              email: 'hello@example.com',
              phone: '+1 (555) 123-4567',
              address: '',
            },
            columns: [
              {
                id: 'col-1',
                title: 'Company',
                links: [
                  { id: 'l1', label: 'Home', url: '/' },
                  { id: 'l2', label: 'About Us', url: '/tentang-kami' },
                  { id: 'l3', label: 'Blog', url: '/blog' },
                ],
              },
              {
                id: 'col-2',
                title: 'Product',
                links: [
                  { id: 'l4', label: 'Editor', url: '/editor' },
                  { id: 'l5', label: 'Header Builder', url: '/header-builder' },
                  { id: 'l6', label: 'Footer Builder', url: '/footer-builder' },
                ],
              },
            ],
            newsletter: {
              enabled: true,
              title: 'Newsletter',
              description: 'Subscribe to receive product updates.',
              buttonText: 'Subscribe',
              placeholder: 'Enter your email address...',
              actionUrl: '#',
            },
            social: {
              enabled: true,
              links: [
                { name: 'Facebook', href: 'https://facebook.com', enabled: true },
                { name: 'Twitter', href: 'https://twitter.com', enabled: true },
                { name: 'LinkedIn', href: 'https://linkedin.com', enabled: true },
              ],
            },
            bottomBar: {
              enabled: true,
              companyName: 'Better Corp Inc.',
              copyrightText: 'All Rights Reserved.',
              showYear: true,
              links: [
                { id: 'b1', label: 'Privacy Policy', url: '/#' },
                { id: 'b2', label: 'Terms of Service', url: '/#' },
              ],
            },
            customCode: {
              enabled: false,
              desktopHtml: '',
              tabletHtml: '',
              mobileHtml: '',
              customCss: '',
              customJs: '',
            },
          };

          store.footers.push(newFooter);
          activeFooter = newFooter;
          refreshFooterSelect();
          populateForm();
          showToast(`✓ Created "${newFooter.name}". Remember to click "Save Footer" to persist.`);
        });

        // Restore Presets
        document.getElementById('btnRestoreDefaultPresets')?.addEventListener('click', async () => {
          if (!confirm('Restore default starter presets?')) return;
          try {
            const res = await fetch('/api/footers', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'restore_presets' }),
            });
            const data = await res.json();
            if (data.success) {
              store.footers = data.footers;
              refreshFooterSelect();
              showToast('✓ Default presets restored successfully!');
            }
          } catch (err) {
            showToast('Failed to restore presets: ' + err.message, false);
          }
        });

        function refreshFooterSelect() {
          const select = document.getElementById('footerSelect');
          if (!select) return;
          select.innerHTML = store.footers.map(f => `
            <option value="${f.id}" ${f.id === activeFooter.id ? 'selected' : ''}>
              ${f.name} ${f.id === store.activeFooterId ? '★ (Active Site)' : ''}
            </option>
          `).join('');
        }

        // Initialize Form on load
        populateForm();
      })();
    </script>
    <script is:inline src="/editor-custom-code.js"></script>
  </body>
</html>
