                <div class="field-row">
                  <textarea class="textarea-input" id="inputCustomHtml" rows="10" placeholder="<div>Custom footer markup...</div>" style="font-family: monospace; font-size: 0.78rem;"></textarea>
                </div>

                <div class="field-row">
                  <label class="field-label">Custom CSS (&lt;style&gt;)</label>
                  <textarea class="textarea-input" id="inputCustomCss" rows="6" placeholder=".my-footer { ... }" style="font-family: monospace; font-size: 0.78rem;"></textarea>
                </div>

                <div class="field-row">
                  <label class="field-label">Custom JavaScript (&lt;script&gt;)</label>
