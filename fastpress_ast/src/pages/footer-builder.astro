                  <button type="button" class="tab-btn active cc-device-btn" data-cc-device="desktop">Desktop HTML</button>
                  <button type="button" class="tab-btn cc-device-btn" data-cc-device="tablet">Tablet HTML</button>
                  <button type="button" class="tab-btn cc-device-btn" data-cc-device="mobile">Mobile HTML</button>
