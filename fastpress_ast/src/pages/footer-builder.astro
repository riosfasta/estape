    <!-- MODAL: RESOURCE / LINK PICKER -->
    <div class="fp-modal-overlay" id="resourcePickerModal">
      <div class="fp-modal-card">
        <div class="fp-modal-header">
          <div class="fp-modal-title">Pick Workspace Page or Blog Post</div>
          <button type="button" class="fp-modal-close" id="btnCloseResourceModal">&times;</button>
        </div>
        <div class="fp-modal-body">
          <div style="display: flex; gap: 8px; margin-bottom: 14px;">
            <button type="button" class="tab-btn active res-tab-btn" data-res-type="pages">Pages ({availablePages.length})</button>
            <button type="button" class="tab-btn res-tab-btn" data-res-type="posts">Blog Posts ({availablePosts.length})</button>
          </div>
          <input type="text" class="text-input" id="inputSearchResources" placeholder="Search pages or posts by title or URL..." style="margin-bottom: 12px;" />

          <div id="resourceItemsList" style="display: flex; flex-direction: column; gap: 6px; max-height: 320px; overflow-y: auto;">
            <!-- Dynamically populated -->
          </div>
