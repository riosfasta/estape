    <!-- MODAL: MEDIA PICKER -->
    <div class="fp-modal-overlay" id="mediaPickerModal">
      <div class="fp-modal-card">
        <div class="fp-modal-header">
          <div class="fp-modal-title">Select or Upload Image</div>
          <button type="button" class="fp-modal-close" id="btnCloseMediaModal">&times;</button>
        </div>
        <div class="fp-modal-body">
          <input type="file" id="mediaFileInput" accept="image/*" style="display: none;" />
          <div style="border: 2px dashed #232a3b; border-radius: 8px; padding: 24px; text-align: center; cursor: pointer; margin-bottom: 16px; background: rgba(255,255,255,0.02);" id="mediaDropzone">
            <div style="font-size: 1.5rem; margin-bottom: 6px;">📁</div>
            <div style="font-size: 0.84rem; font-weight: 600; color: #f3f4f6;">Click to upload image file</div>
            <div style="font-size: 0.72rem; color: #94a3b8; margin-top: 4px;">PNG, JPG, SVG, WebP up to 200 KB</div>
          </div>
          <div class="control-group-title">Existing Project Media</div>
          <div id="mediaGrid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-height: 240px; overflow-y: auto;">
            <!-- Loaded via /api/upload -->
          </div>
        </div>
        <div class="fp-modal-footer">
          <button type="button" class="tb-btn tb-btn-subtle" id="btnCancelMediaModal">Cancel</button>
          <button type="button" class="tb-btn tb-btn-save" id="btnApplySelectedMedia">Apply Selected Image</button>
        </div>
      </div>
