        <div class="fp-modal-footer">
          <button type="button" class="tb-btn tb-btn-subtle" id="btnCancelResourceModal">Cancel</button>
          <button type="button" class="tb-btn tb-btn-save" id="btnSelectResource">Select Link</button>
