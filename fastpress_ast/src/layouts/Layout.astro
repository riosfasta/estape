    <script is:inline>
      function initFastPressPopups() {
        const overlays = document.querySelectorAll('.fastpress-popup-overlay');
        overlays.forEach(overlay => {
          const id = overlay.dataset.popupId;
          const timeEnabled = overlay.dataset.timeEnabled === 'true';
          const timeDelay = parseInt(overlay.dataset.timeDelay, 10) || 5;
          const scrollEnabled = overlay.dataset.scrollEnabled === 'true';
          const scrollPercent = parseInt(overlay.dataset.scrollPercent, 10) || 50;
          const frequency = overlay.dataset.frequency || 'session';

          // Frequency checks
          if (frequency === 'session' && sessionStorage.getItem('fp_popup_dismissed_' + id)) {
            return;
          }
          if (frequency === 'once_7d') {
            const last = localStorage.getItem('fp_popup_shown_' + id);
            if (last && (Date.now() - parseInt(last, 10)) < 7 * 24 * 60 * 60 * 1000) {
              return;
            }
          }

          let isTriggered = false;

          function openPopup() {
            if (isTriggered) return;
            isTriggered = true;
            overlay.style.display = 'flex';
            overlay.style.opacity = '0';
            requestAnimationFrame(() => {
              overlay.style.opacity = '1';
            });
            localStorage.setItem('fp_popup_shown_' + id, Date.now().toString());
          }

          function closePopup() {
            overlay.style.opacity = '0';
            setTimeout(() => {
              overlay.style.display = 'none';
            }, 250);
            sessionStorage.setItem('fp_popup_dismissed_' + id, '1');
          }

          // Universal Close Button Listeners
          overlay.querySelectorAll('[data-close-popup="true"], [data-close-id], .popup-close-trigger, .fastpress-popup-close-btn')
            .forEach(btn => btn.addEventListener('click', closePopup));

          // Backdrop click (only when backdrop overlay is enabled)
          overlay.addEventListener('click', (e) => {
            if (e.target === overlay && overlay.dataset.showBackdrop !== 'false') closePopup();
          });

          // Escape key
          window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && overlay.style.display === 'flex') {
              closePopup();
            }
          });

          // Universal Form submit handler
          overlay.querySelectorAll('form, .fastpress-popup-form').forEach(form => {
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              const btn = form.querySelector('button[type="submit"]') || form.querySelector('button');
              if (btn) btn.textContent = '✓ Subscribed!';
              const successEl = overlay.querySelector('.fastpress-popup-success');
              if (successEl) successEl.style.display = 'block';
              setTimeout(closePopup, 1600);
            });
          });

          if (window.location.search.includes('previewPopup') || window.location.search.includes('popupPreview')) {
            setTimeout(openPopup, 50);
          }

          if (timeEnabled) {
            setTimeout(openPopup, timeDelay * 1000);
          }

          if (scrollEnabled) {
            function checkScroll() {
              if (isTriggered) {
                window.removeEventListener('scroll', checkScroll);
                return;
              }
              const scrollable = document.documentElement.scrollHeight - window.innerHeight;
              if (scrollable <= 0) return;
              const currentPct = (window.scrollY / scrollable) * 100;
              if (currentPct >= scrollPercent) {
                openPopup();
                window.removeEventListener('scroll', checkScroll);
              }
            }
            window.addEventListener('scroll', checkScroll, { passive: true });
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFastPressPopups);
      } else {
        initFastPressPopups();
      }
      document.addEventListener('astro:page-load', initFastPressPopups);
    </script>

    <!-- FastPress Gravity Forms Client Runtime (Anti-Spam & Conditional Logic) -->
    <script is:inline>
      function initFastPressForms() {
        const forms = document.querySelectorAll('.fp-ajax-form');
        forms.forEach(form => {
          if (form.getAttribute('data-fp-initialized') === 'true') return;
          form.setAttribute('data-fp-initialized', 'true');

          // Initialize render timestamp token for Method 2 bot detection
          const tsInput = form.querySelector('._fp_form_ts');
          if (tsInput) {
            tsInput.value = Date.now().toString();
          }

          // Conditional logic handler
          const conditionalWrappers = form.querySelectorAll('[data-conditional]');
          function evaluateConditionalLogic() {
            conditionalWrappers.forEach(wrap => {
              try {
                const condData = JSON.parse(wrap.getAttribute('data-conditional') || '{}');
                if (!condData || !condData.enabled || !Array.isArray(condData.rules) || condData.rules.length === 0) {
                  wrap.style.display = '';
                  return;
                }

                const action = condData.action || 'show';
                const logicType = condData.logicType || 'all';
                let passedCount = 0;

                condData.rules.forEach(rule => {
                  let fieldVal = '';
                  const matchingInputs = form.querySelectorAll(`[name="${rule.fieldId}"], [name="${rule.fieldId}[]"]`);
                  if (matchingInputs.length > 0) {
                    const first = matchingInputs[0];
                    if (first.type === 'radio') {
                      const checked = form.querySelector(`[name="${rule.fieldId}"]:checked`);
                      fieldVal = checked ? checked.value : '';
                    } else if (first.type === 'checkbox') {
                      const checkedBoxes = Array.from(form.querySelectorAll(`[name="${rule.fieldId}[]"]:checked`)).map(cb => cb.value);
                      fieldVal = checkedBoxes.join(',');
                    } else {
                      fieldVal = first.value || '';
                    }
                  }

                  const targetVal = (rule.value || '').trim().toLowerCase();
                  const currentVal = (fieldVal || '').trim().toLowerCase();

                  let ruleMet = false;
                  switch (rule.operator) {
                    case 'is':
                      ruleMet = currentVal === targetVal;
                      break;
                    case 'is_not':
                      ruleMet = currentVal !== targetVal;
                      break;
                    case 'contains':
                      ruleMet = currentVal.includes(targetVal);
                      break;
                    case 'not_contains':
                      ruleMet = !currentVal.includes(targetVal);
                      break;
                    case 'greater_than':
                      ruleMet = parseFloat(currentVal) > parseFloat(targetVal);
                      break;
                    case 'less_than':
                      ruleMet = parseFloat(currentVal) < parseFloat(targetVal);
                      break;
                    case 'is_empty':
                      ruleMet = currentVal === '';
                      break;
                    case 'is_not_empty':
                      ruleMet = currentVal !== '';
                      break;
                    default:
                      ruleMet = currentVal === targetVal;
                  }

                  if (ruleMet) passedCount++;
                });

                const rulesMatch = logicType === 'all'
                  ? (passedCount === condData.rules.length)
                  : (passedCount > 0);

                const shouldShow = action === 'show' ? rulesMatch : !rulesMatch;
                wrap.style.display = shouldShow ? '' : 'none';

                // Prevent hidden inputs from triggering native HTML5 required validation
                wrap.querySelectorAll('input, select, textarea').forEach(inp => {
                  if (!shouldShow) {
                    if (inp.hasAttribute('required')) {
                      inp.setAttribute('data-was-required', 'true');
                      inp.removeAttribute('required');
                    }
                  } else {
                    if (inp.getAttribute('data-was-required') === 'true') {
                      inp.setAttribute('required', 'required');
                      inp.removeAttribute('data-was-required');
                    }
                  }
                });
              } catch (e) {
                console.error('FastPress Forms conditional error:', e);
              }
            });
          }

          // Run evaluations initially and on any input change
          evaluateConditionalLogic();
          form.addEventListener('input', evaluateConditionalLogic);
          form.addEventListener('change', evaluateConditionalLogic);

          // Handle form submission via AJAX to /api/forms/submit
          form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const submitBtn = form.querySelector('.fp-submit-btn');
            const btnText = submitBtn?.querySelector('.fp-btn-text');
            const btnSpinner = submitBtn?.querySelector('.fp-btn-spinner');
            const alertBox = form.querySelector('.fp-form-alert');

            // Reset alert
            if (alertBox) {
              alertBox.style.display = 'none';
              alertBox.className = 'fp-form-alert';
            }

            if (submitBtn) submitBtn.disabled = true;
            if (btnText) btnText.style.display = 'none';
            if (btnSpinner) btnSpinner.style.display = 'inline';

            try {
              const formData = new FormData(form);
              const resp = await fetch(form.action || '/api/forms/submit', {
                method: 'POST',
                body: formData
              });

              const result = await resp.json();

              if (!resp.ok || result.error) {
                throw new Error(result.error || 'Submission failed');
              }

              // Success display
              if (alertBox) {
                alertBox.style.display = 'block';
                alertBox.style.background = '#064e3b';
                alertBox.style.color = '#a7f3d0';
                alertBox.style.border = '1px solid #059669';
                alertBox.innerHTML = result.message || '🎉 Thank you! Your message has been sent successfully.';
              }

              // Optional redirect
              if (result.redirectUrl) {
                setTimeout(() => {
                  window.location.href = result.redirectUrl;
                }, 1200);
              } else {
                form.reset();
                evaluateConditionalLogic();
              }
            } catch (err) {
              if (alertBox) {
                alertBox.style.display = 'block';
                alertBox.style.background = '#7f1d1d';
                alertBox.style.color = '#fecaca';
                alertBox.style.border = '1px solid #dc2626';
                alertBox.innerHTML = '⚠️ ' + (err.message || 'An error occurred while submitting.');
              }
            } finally {
              if (submitBtn) submitBtn.disabled = false;
              if (btnText) btnText.style.display = 'inline';
              if (btnSpinner) btnSpinner.style.display = 'none';
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFastPressForms);
      } else {
        initFastPressForms();
      }
      document.addEventListener('astro:page-load', initFastPressForms);
    </script>

    <!-- Global Body End Scripts (All pages & posts) -->
    {(customCode?.bodyEndScripts || customCode?.bodyScripts) && (
      <Fragment set:html={customCode.bodyEndScripts || customCode.bodyScripts} />
    )}

    <!-- Page-Specific Body End Scripts (This page only) -->
    {(resolvedPageCode?.bodyEndScripts || resolvedPageCode?.bodyScripts) && (
      <Fragment set:html={resolvedPageCode.bodyEndScripts || resolvedPageCode.bodyScripts} />
    )}

    <!-- Nav Menu Interactive Runtime -->
    <script src="/nav-menu.js" is:inline></script>
    <!-- Products Loop Interactive Runtime -->
    <script src="/products-loop.js" is:inline></script>
  </body>
</html>

<style>
  #mainContent {
    flex: 1 0 auto;
    width: 100%;
  }
</style>
