---
import Layout from '../layouts/Layout.astro';
import { getProducts, getProductCategoriesArray, type Product } from '../../../data/products';
import { getProductCategories, slugifyCategory } from '../../../data/product-categories';
import { buildPrimaryBuyUrl } from '../../../data/product-layouts';
import { syncGlobalTemplates, cleanLiveContent } from '../../../data/templates';

interface Props {
  products?: Product[];
  categories?: any[];
  customProductsPage?: any;
}

const {
  products = getProducts().filter((p) => p.status !== 'draft'),
  categories = getProductCategories(),
  customProductsPage,
} = Astro.props;

const allProducts = products;
const masterCategories = categories;

const isCustomBuilderPage = Boolean(
  customProductsPage && customProductsPage.isCustom && customProductsPage.html && customProductsPage.html.trim().length > 0
);

interface CatalogCategoryTab {
  name: string;
  slug: string;
  count: number;
}

const categoryMap = new Map<string, CatalogCategoryTab>();

for (const cat of masterCategories) {
  const name = String(cat.name || '').trim();
  if (!name) continue;
  categoryMap.set(name.toLowerCase(), {
    name,
    slug: cat.slug || slugifyCategory(name),
    count: 0,
  });
}

for (const product of allProducts) {
  const prodCats = getProductCategoriesArray(product);
  for (const catName of prodCats) {
    const key = catName.toLowerCase();
    const existing = categoryMap.get(key);
    if (existing) {
      existing.count += 1;
    } else {
      categoryMap.set(key, {
        name: catName,
        slug: slugifyCategory(catName),
        count: 1,
      });
    }
  }
}

const categoryTabs = Array.from(categoryMap.values()).filter(
  (c) => c.slug !== 'uncategorized' || c.count > 0
);

const initialCategoryRaw = Astro.url.searchParams.get('category') || 'all';
const initialCategoryLower = initialCategoryRaw.trim().toLowerCase();
const matchedInitialTab = categoryTabs.find(
  (c) => c.name.toLowerCase() === initialCategoryLower || c.slug.toLowerCase() === initialCategoryLower
);
const activeInitialCategory = matchedInitialTab ? matchedInitialTab.name.toLowerCase() : 'all';

function productMatchesCategory(product: Product, categoryLower: string): boolean {
  if (!categoryLower || categoryLower === 'all') return true;
  const prodCats = getProductCategoriesArray(product);
  return prodCats.some(
    (c) => c.toLowerCase() === categoryLower || slugifyCategory(c) === categoryLower
  );
}

const initialVisibleCount =
  activeInitialCategory === 'all'
    ? allProducts.length
    : allProducts.filter((p) => productMatchesCategory(p, activeInitialCategory)).length;

const customPageHtml = isCustomBuilderPage
  ? cleanLiveContent(syncGlobalTemplates(customProductsPage.html))
  : '';
const customPageCss = isCustomBuilderPage ? String(customProductsPage.css || '') : '';
---

<Layout
  title={customProductsPage?.title || 'Shop All Products | Apparel & Signature Goods Catalog'}
  description={customProductsPage?.description || 'Browse our full catalog of curated apparel, heavyweight tees, French terry hoodies, and outerwear.'}
  keywords={customProductsPage?.keywords || 'products, apparel, streetwear, tees, hoodies, outerwear'}
  schema={customProductsPage?.schema || ''}
  pageCustomCode={customProductsPage?.customCode}
  activePage="products"
>
  {isCustomBuilderPage ? (
    <>
      {customPageCss && <style is:global set:html={customPageCss} />}
      <div class="custom-builder-page" set:html={customPageHtml} />
    </>
  ) : (
    <>
      <section class="products-hero">
        <div class="hero-container">
          <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <ol class="breadcrumb-list">
              <li><a href="/">Home</a></li>
              <li aria-hidden="true">/</li>
              <li class="breadcrumb-current">Products</li>
            </ol>
          </nav>

          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Curated Apparel &amp; Essentials</span>
          </div>

          <h1 class="hero-title">All Products &amp; Goods</h1>
          <p class="hero-subtitle">
            Explore premium quality goods and digital assets designed for performance, aesthetic excellence, and long-lasting durability.
          </p>

          <!-- Search & Sort Controls -->
          <div class="catalog-controls">
            <div class="search-input-wrap">
              <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
              <input
                type="search"
                id="catalogSearchInput"
                class="catalog-search-input"
                placeholder="Search products by name, category, or tag..."
                aria-label="Search products"
              />
              <button type="button" id="clearSearchBtn" class="search-clear-btn" style="display: none;" aria-label="Clear search">&times;</button>
            </div>

            <div class="sort-wrap">
              <label for="catalogSortSelect">Sort by:</label>
              <select id="catalogSortSelect" class="catalog-sort-select">
                <option value="featured">Featured &amp; Bestsellers</option>
                <option value="price-asc">Price: Low to High</option>
                <option value="price-desc">Price: High to Low</option>
                <option value="rating">Highest Rated</option>
                <option value="title-asc">Name: A to Z</option>
              </select>
            </div>
          </div>

          <!-- Category Filter Tabs -->
          <div class="category-pills-bar" id="categoryPillsBar" role="tablist" aria-label="Product Categories">
            <button
              type="button"
              role="tab"
              aria-selected={activeInitialCategory === 'all' ? 'true' : 'false'}
              class={`cat-pill-btn ${activeInitialCategory === 'all' ? 'active' : ''}`}
              data-category="all"
              data-slug="all"
            >
              <span>All Products</span>
              <span class="cat-pill-count">{allProducts.length}</span>
            </button>
            {categoryTabs.map((cat) => {
              const isSelected = activeInitialCategory === cat.name.toLowerCase();
              return (
                <button
                  type="button"
                  role="tab"
                  aria-selected={isSelected ? 'true' : 'false'}
                  class={`cat-pill-btn ${isSelected ? 'active' : ''}`}
                  data-category={cat.name}
                  data-slug={cat.slug}
                >
                  <span>{cat.name}</span>
                  <span class="cat-pill-count">{cat.count}</span>
                </button>
              );
            })}
          </div>
        </div>
      </section>

      <section class="products-grid-section">
        <div class="hero-container">
          <div class="catalog-meta-bar">
            <span id="resultsCounter">
              Showing <strong id="visibleCount">{initialVisibleCount}</strong> of {allProducts.length} products
            </span>
          </div>

          <!-- Products Grid -->
          <div class="products-grid" id="productsGrid">
            {allProducts.map((product, idx) => {
              const categoriesList = getProductCategoriesArray(product);
              const categorySlugsList = categoriesList.map((c) => slugifyCategory(c));
              const primaryCategory = categoriesList[0] || 'General';
              const hasDiscount = Number(product.compareAtPrice || 0) > Number(product.price || 0);
              const discountPct = hasDiscount
                ? Math.round(((Number(product.compareAtPrice) - Number(product.price)) / Number(product.compareAtPrice)) * 100)
                : 0;
              const buyUrl = buildPrimaryBuyUrl(product);
              const detailUrl = `/products/${product.slug}`;
              const hoverImage = product.gallery && product.gallery.length > 1 ? product.gallery[1] : null;
              const matchesInitial = productMatchesCategory(product, activeInitialCategory);
              const safeVtId = `product-card-${String(product.id || idx).replace(/[^a-zA-Z0-9_-]/g, '_')}`;
              const isCriticalImage = idx < 2;

              return (
                <article
                  class="product-card"
                  style={`view-transition-name: ${safeVtId}; view-transition-class: product-card;${matchesInitial ? '' : ' display: none;'}`}
                  data-id={product.id}
                  data-title={product.title.toLowerCase()}
                  data-category={primaryCategory}
                  data-categories={JSON.stringify(categoriesList.map((c) => c.toLowerCase()))}
                  data-category-slugs={JSON.stringify(categorySlugsList)}
                  data-tags={(product.tags || []).join(' ').toLowerCase()}
                  data-desc={`${product.subtitle || ''} ${product.description || ''}`.toLowerCase()}
                  data-price={product.price}
                  data-rating={product.rating}
                  data-featured={product.featured ? '1' : '0'}
                  data-index={idx}
                >
                  <div class="product-media-wrap">
                    <img
                      src={product.image}
                      alt={product.title}
                      class="product-img-main"
                      fetchpriority={isCriticalImage ? 'high' : undefined}
                      loading={isCriticalImage ? undefined : 'lazy'}
                      decoding="async"
                    />
                    {hoverImage && (
                      <img
                        src={hoverImage}
                        alt={`${product.title} alternate view`}
                        class="product-img-hover"
                        fetchpriority="low"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <div class="card-badges-top">
                      {hasDiscount && (
                        <span class="badge-discount">-{discountPct}% OFF</span>
                      )}
                      {product.featured && (
                        <span class="badge-featured">&#9733; Bestseller</span>
                      )}
                    </div>
                    <span class="card-category-tag">
                      {primaryCategory}
                      {categoriesList.length > 1 ? ` +${categoriesList.length - 1}` : ''}
                    </span>
                  </div>

                  <div class="product-card-body">
                    <div class="product-rating-row">
                      <span class="stars-stars" aria-label={`Rated ${product.rating} out of 5`}>
                        &#9733; <span class="rating-num">{Number(product.rating || 5).toFixed(1)}</span>
                      </span>
                      <span class="reviews-count">({product.reviewsCount || 0} reviews)</span>
                    </div>

                    <h2 class="product-card-title">
                      <a href={detailUrl} class="card-link">{product.title}</a>
                    </h2>

                    <p class="product-card-sub">
                      {product.subtitle || product.description}
                    </p>

                    <div class="product-card-footer">
                      <div class="product-price-block">
                        <span class="current-price">{product.currency || '$'}{Number(product.price || 0).toFixed(2)}</span>
                        {hasDiscount && (
                          <span class="compare-price">{product.currency || '$'}{Number(product.compareAtPrice || 0).toFixed(2)}</span>
                        )}
                      </div>

                      <div class="card-actions-group">
                        <a href={detailUrl} class="btn-card-detail">View Details</a>
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Empty State -->
          <div id="catalogEmptyState" class="catalog-empty-state" style="display: none;">
            <div class="empty-icon-box">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
            </div>
            <h3>No products found</h3>
            <p>Try searching with another keyword or resetting the category filter.</p>
            <button type="button" id="resetCatalogFiltersBtn" class="btn-reset-filters">Reset All Filters</button>
          </div>
        </div>
      </section>
    </>
  )}
</Layout>

<style>
  .products-hero {
    background: radial-gradient(circle at 50% 0%, rgba(255, 94, 58, 0.12) 0%, transparent 60%), #0c0e14;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 48px 20px 32px;
  }

  .hero-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    margin-bottom: 16px;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #9ca3af;
  }

  .breadcrumb-list a:hover {
    color: var(--color-primary);
  }

  .breadcrumb-current {
    color: #ffffff;
    font-weight: 600;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 94, 58, 0.15);
    border: 1px solid rgba(255, 94, 58, 0.3);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 14px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: #9ca3af;
    max-width: 640px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .catalog-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .search-input-wrap {
    position: relative;
    flex: 1;
    min-width: 280px;
    max-width: 520px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #6b7280;
  }

  .catalog-search-input {
    width: 100%;
    background: #141722;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 12px 36px 12px 42px;
    color: #ffffff;
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .catalog-search-input:focus {
    border-color: var(--color-primary);
  }

  .search-clear-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #9ca3af;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .sort-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #9ca3af;
    font-size: 0.88rem;
  }

  .catalog-sort-select {
    background: #141722;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 0.88rem;
    outline: none;
  }

  .category-pills-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cat-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #141722;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #9ca3af;
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .cat-pill-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .cat-pill-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
  }

  .cat-pill-count {
    background: rgba(0, 0, 0, 0.25);
    padding: 2px 8px;
    border-radius: 9999px;
    font-size: 0.75rem;
  }

  .products-grid-section {
    background: #0c0e14;
    padding: 36px 20px 80px;
  }

  .catalog-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    color: #9ca3af;
    font-size: 0.9rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 28px;
  }

  .product-card {
    background: #141722;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 94, 58, 0.3);
  }

  .product-media-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #0d1017;
  }

  .product-img-main, .product-img-hover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-img-hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .product-card:hover .product-img-hover {
    opacity: 1;
  }

  .product-card:hover .product-img-main {
    transform: scale(1.05);
  }

  .card-badges-top {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 2;
  }

  .badge-discount {
    background: #ef4444;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
  }

  .badge-featured {
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
  }

  .card-category-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(17, 20, 28, 0.85);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    z-index: 2;
  }

  .product-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: #f59e0b;
    margin-bottom: 8px;
  }

  .reviews-count {
    color: #9ca3af;
    font-size: 0.76rem;
  }

  .product-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.35;
    margin-bottom: 6px;
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover {
    color: var(--color-primary);
  }

  .product-card-sub {
    font-size: 0.88rem;
    color: #9ca3af;
    line-height: 1.5;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .current-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
  }

  .compare-price {
    font-size: 0.85rem;
    color: #6b7280;
    text-decoration: line-through;
    margin-left: 6px;
  }

  .btn-card-detail {
    background: rgba(255, 94, 58, 0.15);
    color: var(--color-primary);
    border: 1px solid rgba(255, 94, 58, 0.3);
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-card-detail:hover {
    background: var(--color-primary);
    color: #ffffff;
  }

  .catalog-empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #9ca3af;
  }

  .empty-icon-box {
    margin: 0 auto 16px;
    color: #6b7280;
  }

  .btn-reset-filters {
    margin-top: 16px;
    background: var(--color-primary);
    color: #ffffff;
    border: none;
    padding: 10px 22px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<script>
  function initCatalog() {
    const searchInput = document.getElementById('catalogSearchInput') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const sortSelect = document.getElementById('catalogSortSelect') as HTMLSelectElement | null;
    const catButtons = document.querySelectorAll('.cat-pill-btn');
    const grid = document.getElementById('productsGrid');
    const emptyState = document.getElementById('catalogEmptyState');
    const visibleCounter = document.getElementById('visibleCount');
    const resetBtn = document.getElementById('resetCatalogFiltersBtn');

    if (!grid) return;

    let currentCategory = 'all';
    let currentSearch = '';

    function filterAndSort() {
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.product-card'));
      let visible = 0;

      cards.forEach((card) => {
        const title = card.dataset.title || '';
        const desc = card.dataset.desc || '';
        const tags = card.dataset.tags || '';
        let catsArr: string[] = [];
        try {
          if (card.dataset.categories) catsArr = JSON.parse(card.dataset.categories);
        } catch {}

        const matchesCat =
          currentCategory === 'all' ||
          catsArr.includes(currentCategory.toLowerCase()) ||
          card.dataset.category?.toLowerCase() === currentCategory.toLowerCase();

        const searchLower = currentSearch.toLowerCase().trim();
        const matchesSearch =
          !searchLower ||
          title.includes(searchLower) ||
          desc.includes(searchLower) ||
          tags.includes(searchLower);

        if (matchesCat && matchesSearch) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCounter) visibleCounter.textContent = String(visible);
      if (emptyState) emptyState.style.display = visible === 0 ? 'block' : 'none';

      // Sort
      const sortVal = sortSelect?.value || 'featured';
      cards.sort((a, b) => {
        const priceA = Number(a.dataset.price || 0);
        const priceB = Number(b.dataset.price || 0);
        const ratingA = Number(a.dataset.rating || 0);
        const ratingB = Number(b.dataset.rating || 0);
        const titleA = a.dataset.title || '';
        const titleB = b.dataset.title || '';

        switch (sortVal) {
          case 'price-asc': return priceA - priceB;
          case 'price-desc': return priceB - priceA;
          case 'rating': return ratingB - ratingA;
          case 'title-asc': return titleA.localeCompare(titleB);
          default: return Number(b.dataset.featured || 0) - Number(a.dataset.featured || 0);
        }
      });

      cards.forEach((c) => grid.appendChild(c));
    }

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      if (clearSearchBtn) clearSearchBtn.style.display = currentSearch ? 'block' : 'none';
      filterAndSort();
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      if (clearSearchBtn) clearSearchBtn.style.display = 'none';
      filterAndSort();
    });

    sortSelect?.addEventListener('change', filterAndSort);

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = (btn as HTMLElement).dataset.category || 'all';
        filterAndSort();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      if (clearSearchBtn) clearSearchBtn.style.display = 'none';
      currentCategory = 'all';
      catButtons.forEach((b) => b.classList.remove('active'));
      catButtons[0]?.classList.add('active');
      filterAndSort();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalog);
  } else {
    initCatalog();
  }
  document.addEventListener('astro:page-load', initCatalog);
</script>
