---
const features = [
  {
    title: 'Strategy',
    description: 'Lorem ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry standard.',
    icon: `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>`,
  },
  {
    title: 'Branding',
    description: 'Lorem ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry standard.',
    icon: `<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>`,
  },
];
---

<section class="about-section py-section" id="about" aria-label="About Us">
  <div class="container">
    <div class="about-grid">
      <!-- Left Column: Story & Introduction -->
      <div class="about-info">
        <h2 class="section-title section-title-line">ABOUT US</h2>
        <p class="about-text">
          Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium,
          totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae
          dicta sunt explicabo. Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit.
        </p>
      </div>

      <!-- Right Column: Strategy & Branding Features -->
      <div class="about-features">
        {features.map((feature) => (
          <div class="feature-item">
            <div class="feature-icon-wrapper" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-primary)"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={feature.icon}
              />
            </div>
            <div class="feature-content">
              <h3 class="feature-title">{feature.title}</h3>
              <p class="feature-desc">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr 1.35fr;
      gap: 4.5rem;
    }
  }

  .about-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-text {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .about-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 600px) {
    .about-features {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background-color: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 94, 58, 0.15);
  }

  .feature-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 0.5rem;
  }

  .feature-desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-text);
  }
</style>
