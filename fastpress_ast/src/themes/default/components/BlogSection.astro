---
import { getPosts } from '../../../data/posts';

const posts = getPosts();
---

<section class="blog-section py-section" id="blog" aria-label="Latest Articles">
  <div class="container">
    <div class="section-center-head">
      <h2 class="section-title section-title-line">Contents</h2>
      <p class="section-subtitle">
        Discover fresh ideas, design inspirations, and strategic perspectives from our creative team.
      </p>
    </div>

    <div class="blog-grid">
      {posts.map((post) => (
        <article class="blog-card">
          <a href={`/blog/${post.slug}`} class="blog-media" tabindex="-1" aria-hidden="true">
            <img
              src={post.image}
              alt={post.title}
              class="blog-img"
              loading="lazy"
            />
            <span class="card-badge">{post.category}</span>
          </a>
          <div class="blog-body">
            <h3 class="blog-title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h3>
            <p class="blog-excerpt">{post.excerpt}</p>
            <a href={`/blog/${post.slug}`} class="blog-readmore">
              <span>Read More</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- View All Articles Link -->
    <div class="blog-all-cta">
      <a href="/blog" class="btn btn-outline-primary">
        <span>Lihat Semua Artikel &amp; Filter Dinamis</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .blog-section {
    background-color: var(--color-bg-light);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .blog-card {
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.06);
    border-color: rgba(255, 94, 58, 0.25);
  }

  .blog-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-dark-alt);
  }

  .blog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-img {
    transform: scale(1.05);
  }

  .card-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: rgba(21, 24, 30, 0.85);
    backdrop-filter: blur(8px);
    color: var(--color-white);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .blog-body {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;
  }

  .blog-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-heading);
    line-height: 1.4;
  }

  .blog-title a:hover {
    color: var(--color-primary);
  }

  .blog-excerpt {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .blog-readmore {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-primary);
  }

  .blog-readmore:hover {
    color: var(--color-primary-hover);
    gap: 0.65rem;
  }

  /* CTA */
  .blog-all-cta {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
  }

  .btn-outline-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: transparent;
    transition: var(--transition);
  }

  .btn-outline-primary:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 94, 58, 0.25);
  }
</style>
