---
interface Props {
  isPreview?: boolean;
  previewTheme?: string;
}

const { isPreview = false, previewTheme = 'furnisite' } = Astro.props;
const prefix = isPreview ? `/preview/${previewTheme}` : '';
---

<section class="furnisite-hero">
  <div class="furnisite-hero-bg">
    <img
      src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=2000&q=85"
      alt="Infurnish Living Room Interior"
      class="furnisite-hero-img"
    />
    <div class="furnisite-hero-overlay"></div>
  </div>

  <div class="fs-container furnisite-hero-content-wrap">
    <div class="furnisite-hero-content">
      <h1 class="furnisite-hero-title">
        New Collections<br />Have Arrived
      </h1>
      <p class="furnisite-hero-subtitle">
        Explore furniture designed to transform your space — now with up to 30% off
      </p>
      <div class="furnisite-hero-actions">
        <a href={prefix ? `${prefix}/products` : '/products'} class="fs-btn fs-btn-dark fs-btn-lg furnisite-hero-btn">
          Explore the Collection
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .furnisite-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #f4f1ea;
  }

  @media (min-width: 768px) {
    .furnisite-hero {
      min-height: 600px;
    }
  }

  @media (min-width: 1200px) {
    .furnisite-hero {
      min-height: 660px;
    }
  }

  .furnisite-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .furnisite-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .furnisite-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 20, 22, 0.45) 0%,
      rgba(20, 20, 22, 0.25) 50%,
      rgba(20, 20, 22, 0.55) 100%
    );
  }

  .furnisite-hero-content-wrap {
    position: relative;
    z-index: 2;
    padding-top: 60px;
    padding-bottom: 60px;
  }

  .furnisite-hero-content {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    color: #ffffff;
  }

  .furnisite-hero-title {
    font-family: var(--fs-font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }

  @media (min-width: 768px) {
    .furnisite-hero-title {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .furnisite-hero-title {
      font-size: 4rem;
    }
  }

  .furnisite-hero-subtitle {
    font-family: var(--fs-font-body);
    font-size: 1.05rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 28px;
    line-height: 1.6;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.25);
  }

  @media (min-width: 768px) {
    .furnisite-hero-subtitle {
      font-size: 1.18rem;
    }
  }

  .furnisite-hero-actions {
    display: flex;
    justify-content: center;
  }

  .furnisite-hero-btn {
    border-radius: 4px;
    padding: 14px 34px;
    font-size: 0.95rem;
    letter-spacing: 0.3px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }
</style>
