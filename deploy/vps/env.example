# Copy this file to /etc/bugmega/deploy.env on the VPS, then edit it.
# Keep the real file on the server only. Do not commit real secrets.

APP_NAME='BugMega'
APP_DOMAIN='bugmega.com'
APP_URL='https://bugmega.com'
PORT='8080'

# GitHub repository used by deploy.sh for updates.
REPO_URL='https://github.com/riosfasta/estape.git'
REPO_BRANCH='main'

APP_USER='bugmega'
APP_GROUP='bugmega'
APP_ROOT='/opt/bugmega'
APP_DIR='/opt/bugmega/app'
BIN_DIR='/opt/bugmega/bin'
APP_ENV_FILE='/etc/bugmega/bugmega.env'
SERVICE_NAME='bugmega'
UPLOAD_DIR='/var/lib/bugmega/uploads'

# The local Windows machine uses Go 1.26.4, so the VPS defaults to the same version.
GO_VERSION='1.26.4'
# Optional. Paste the go tarball SHA256 if you want checksum verification.
GO_SHA256=''

# MongoDB official packages currently target Debian 12 Bookworm for MongoDB 8.0.
INSTALL_MONGODB='true'
MONGO_VERSION='8.0'
MONGO_REPO_CODENAME='bookworm'
MONGO_URI='mongodb://127.0.0.1:27017/'
MONGO_DB_NAME='bugmarking'

ENABLE_NGINX='true'
ENABLE_CERTBOT='false'
CERTBOT_EMAIL='admin@example.com'

JWT_SECRET=''
OWNER_NAME='Platform Owner'
OWNER_EMAIL='owner@bugmega.local'
OWNER_PASSWORD='ChangeMe123!'

SMTP_HOST=''
SMTP_PORT='587'
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM='no-reply@bugmega.local'

GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GOOGLE_REDIRECT_URL=''

STRIPE_PUBLISHABLE_KEY=''
STRIPE_SECRET_KEY=''
STRIPE_WEBHOOK_SECRET=''

PAYPAL_CLIENT_ID=''
PAYPAL_CLIENT_SECRET=''
PAYPAL_WEBHOOK_ID=''
PAYPAL_MODE='sandbox'

FCM_PROJECT_ID=''
FCM_SERVICE_ACCOUNT_FILE='/etc/bugmega/firebase-service-account.json'
FCM_SERVICE_ACCOUNT_JSON=''

BACKUP_DIR='/var/backups/bugmega'
BACKUP_RETENTION_DAYS='14'
