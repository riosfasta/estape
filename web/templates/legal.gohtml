<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }} | {{ .AppName }}</title>
  {{ if .FaviconURL }}<link rel="icon" href="{{ .FaviconURL }}">{{ end }}
  <link rel="stylesheet" href="/static/css/styles.css?v=20260719-0013">
</head>
<body class="public-page">
  <header class="public-nav">
    <a class="brand" href="/">
      {{ if .NavLogoURL }}<span class="brand-mark brand-image"><img src="{{ .NavLogoURL }}" alt=""></span>{{ else }}<span class="brand-mark">{{ .NavBrandInitial }}</span>{{ end }}
      {{ .NavBrandName }}
    </a>
    <nav>
      {{ range .NavItems }}
      <a href="{{ .URL }}">{{ .Label }}</a>
      {{ end }}
    </nav>
    {{ if and .NavButtonText .NavButtonURL }}
    <div class="nav-actions"><a class="btn {{ .NavButtonClass }}" href="{{ .NavButtonURL }}">{{ .NavButtonText }}</a></div>
    {{ end }}
  </header>
  <main class="legal-page" style="--public-page-width: {{ if .PageWidth }}{{ .PageWidth }}{{ else }}840px{{ end }};">
    {{ .HTML }}
  </main>
  <footer class="public-footer compact">
    <span>&copy; {{ .Year }} {{ .AppName }}</span>
    <a href="/legal/terms-of-service">Terms</a>
    <a href="/legal/privacy-policy">Privacy</a>
  </footer>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script>window.lucide && lucide.createIcons();</script>
</body>
</html>
