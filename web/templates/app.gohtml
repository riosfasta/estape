<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .AppName }} Workspace</title>
  {{ if .FaviconURL }}<link rel="icon" href="{{ .FaviconURL }}">{{ end }}
  <script>
    (function () {
      var saved = localStorage.getItem('bugmega_theme') || 'system';
      var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = saved === 'system' ? (prefersDark ? 'dark' : 'light') : saved;
    })();
  </script>
  <link rel="stylesheet" href="/static/css/checkout.css?v=20260905-1">
  <link rel="stylesheet" href="/static/css/styles.css?v=20260905-3">
  <link rel="stylesheet" href="/static/css/marketplace.css?v=20260906-3">
  <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-W8Y0879PES"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-W8Y0879PES');
</script>
<meta name="google-site-verification" content="DJyhtitM6w31YPmsP38ZtJTdI3KEIXT4xRh4OmKJU34" />
</head>
<body class="workspace-page">
  <div id="app">
    <div class="route-loading-overlay route-loading-initial" data-route-loading role="status" aria-live="polite">
      <div class="route-loading-card">
        <span class="route-loading-spinner" aria-hidden="true"></span>
        <span>Loading page...</span>
      </div>
    </div>
  </div>
  <script type="module" src="/static/js/app.js?v=20260906-3"></script>
  <script async src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script async src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js"></script>
</body>
</html>
